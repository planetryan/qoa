; sha.final: betegarria (0x80, zeroak) eta luzera bitetan (8 byte, big-endian); laburpena H-n geratzen da.
; aldatzen ditu R0-R7
sha.final:
SETR0 96
LDR5 R0
ADDR0 R5 (8)
LDR0 R0
MULR7 R0 (8)
SETR0 128
C sha.byte
sha.final.pad:
ADDR0 R5 (9)
LDR0 R0
IEQR0 (56) sha.final.len
SETR0 0
C sha.byte
J sha.final.pad
sha.final.len:
SETR6 56
sha.final.lb:
SHRR0 R7 R6
ANDR0 R0 (255)
C sha.byte
SUBR6 R6 (8)
IGTR6 R29 sha.final.lb
RET

; sha.put: laburpenaren 32 byteak irteerara (big-endian). aldatzen ditu R0-R3
sha.put:
SETR0 96
LDR2 R0
ADDR3 R2 (8)
sha.put.w:
LDR1 R2
SHRR0 R1 (24)
PUTCR0
SHRR0 R1 (16)
ANDR0 R0 (255)
PUTCR0
SHRR0 R1 (8)
ANDR0 R0 (255)
PUTCR0
ANDR0 R1 (255)
PUTCR0
ADDR2 R2 R31
ILTR2 R3 sha.put.w
RET

; sha.hex: laburpena 64 digitu hamaseitar gisa (letra txikiz, sha256sum-ek bezala). aldatzen ditu R0-R4
sha.hex:
SETR0 96
LDR2 R0
ADDR3 R2 (8)
sha.hex.w:
LDR1 R2
SETR4 28
sha.hex.d:
SHRR0 R1 R4
ANDR0 R0 (15)
ILTR0 (10) sha.hex.dig
ADDR0 R0 (87)
J sha.hex.out
sha.hex.dig:
ADDR0 R0 (48)
sha.hex.out:
PUTCR0
SUBR4 R4 (4)
IGTR4 R29 sha.hex.d
ADDR2 R2 R31
ILTR2 R3 sha.hex.w
RET

