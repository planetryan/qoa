; ---------------------------------------------------------------- eragiketa konplexuak (izena eremuen araberakoa)
; op.0: Gate { q, gate }
op.0:
C ru32
PUSHR0
SETR0 15
SETR1 2
C rtag
RCR4 R0
C pname
POPR0
C pq
ILTR4 (10) op.0.r
ILTR4 (14) op.0.one
C ff
C ff
op.0.one:
C ff
op.0.r:
RET

; listq: R8 qubit, R9-tik aurrera (u32 bakoitza) -> " q.." bakoitzeko. aldatzen ditu R0-R3
listq:
PUSHR9
RCR3 R8
listq.n:
IEQR3 R30 listq.r
RCR0 R9
C u32at
C pq
ADDR9 R9 (4)
SUBR3 R3 R31
J listq.n
listq.r:
POPR9
RET

; skipv: u32 zerrenda bat jauzi -> R8 kopurua, R9 lehen elementuaren helbidea. aldatzen ditu R0-R4
skipv:
SETR0 4
C rlen
RCR8 R0
LDR9 (5)
MULR0 R0 (4)
ADDR1 R9 R0
ST R1 (5)
RET

; op.1: Controlled { controls, q, gate }: CNOT, CY, CH, CSX, CU, CRX, CRY, CRZ, CCX, MCX
op.1:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
C skipv
C ru32
RCR10 R0
SETR0 15
SETR1 2
C rtag
RCR11 R0
ILTR11 (10) op.1.np
ILTR11 (14) op.1.p1
C rf64
ST R0 (30)
ST R1 (31)
C rf64
ST R0 (32)
ST R1 (33)
C rf64
ST R0 (34)
ST R1 (35)
J op.1.np
op.1.p1:
C rf64
ST R0 (30)
ST R1 (31)
op.1.np:
IEQR8 R31 op.1.one
INER11 R31 op.1.bad
IEQR8 R30 op.1.bad
SETR0 24
INER8 (2) op.1.many
SETR0 23
op.1.many:
C pname
C listq
RCR0 R10
C pq
J op.1.done
op.1.one:
SETR0 15
IEQR11 (1) op.1.n
SETR0 16
IEQR11 (2) op.1.n
SETR0 17
IEQR11 (0) op.1.n
SETR0 18
IEQR11 (8) op.1.n
SETR0 19
IEQR11 (14) op.1.n
SETR0 20
IEQR11 (10) op.1.n
SETR0 21
IEQR11 (11) op.1.n
SETR0 22
IEQR11 (12) op.1.n
J op.1.bad
op.1.n:
C pname
C listq
RCR0 R10
C pq
ILTR11 (10) op.1.done
LDR0 (30)
LDR1 (31)
C pnum
INER11 (14) op.1.done
LDR0 (32)
LDR1 (33)
C pnum
LDR0 (34)
LDR1 (35)
C pnum
J op.1.done
op.1.bad:
SETR0 1
C bad
op.1.done:
POPR11
POPR10
POPR9
POPR8
RET

; op.2: PhaseAll { qubits, theta }: CZ (π), CPHASE, MCZ (π)
op.2:
PUSHR8
PUSHR9
C skipv
C rf64
ST R0 (30)
ST R1 (31)
INER8 (2) op.2.many
SETR0 25
LDR1 (30)
IEQR1 (3.141592653589793) op.2.two
SETR0 26
op.2.two:
C pname
C listq
LDR0 (30)
IEQR0 (3.141592653589793) op.2.done
LDR1 (31)
C pnum
J op.2.done
op.2.many:
IEQR8 R30 op.2.bad
LDR1 (30)
INER1 (3.141592653589793) op.2.bad
SETR0 27
C pname
C listq
J op.2.done
op.2.bad:
SETR0 2
C bad
op.2.done:
POPR9
POPR8
RET

; op.3: Swap { a, b, controls }: SWAP, CSWAP
op.3:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
C ru32
RCR10 R0
C ru32
RCR11 R0
C skipv
IEQR8 R30 op.3.swap
INER8 R31 op.3.bad
SETR0 29
C pname
C listq
J op.3.ab
op.3.swap:
SETR0 28
C pname
op.3.ab:
RCR0 R10
C pq
RCR0 R11
C pq
J op.3.done
op.3.bad:
SETR0 3
C bad
op.3.done:
POPR11
POPR10
POPR9
POPR8
RET

; op.8: Measure { q, basis, dest }: MEASURE (Z) edo MEASUREIN
op.8:
C ru32
PUSHR0
SETR0 3
SETR1 3
C rtag
RCR4 R0
SETR0 34
IEQR4 (2) op.8.z
SETR0 35
op.8.z:
C pname
POPR0
C pq
IEQR4 (2) op.8.d
IEQR27 R30 op.8.d
PRINT " "
ADDR0 R4 R31
C pname
op.8.d:
J fdest

; op.49: JumpIf { src, value, to }: JUMPIFZERO, JUMPIFONE
op.49:
PUSHR8
PUSHR9
SETR0 2
SETR1 5
C rtag
RCR8 R0
C ru32
RCR9 R0
C rf64
ST R0 (30)
C ru64
ST R0 (31)
LDR1 (30)
SETR0 91
IEQR1 R30 op.49.n
SETR0 92
IEQR1 R31 op.49.n
SETR0 4
C bad
J op.49.done
op.49.n:
C pname
RCR0 R9
IEQR8 R30 op.49.reg
C pc
J op.49.l
op.49.reg:
C pr
op.49.l:
LDR0 (31)
C plab
op.49.done:
POPR9
POPR8
RET

; op.57: Print { text, newline }: PRINT, PRINTLN
op.57:
C rstr
PUSHR0
PUSHR1
C rbool
SETR2 103
IEQR0 R30 op.57.n
SETR2 104
op.57.n:
RCR0 R2
C pname
POPR1
POPR0
J ptext

; op.66: Stream { stderr }: STREAM 1 edo 2
op.66:
SETR0 2
C need
C rbool
PUSHR0
SETR0 113
C pname
POPR0
ADDR0 R0 R31
J pword

; fskip: usize bat irakurri, ezer idatzi gabe (LOOPSTART-en amaiera, LOOPEND-en hasiera). aldatzen ditu R0-R4
fskip:
J ru64

; fbyte: u8 bat zenbaki gisa (EXIT). aldatzen ditu R0-R2
fbyte:
C rb
J pword

; ---------------------------------------------------------------- programa
; body: programaren eremuak eta eragiketak (lehen pasaldia, idatzi gabe): hasierak, jauzi-helburuak eta
; c-tokenak. gero lerroak, soberako byteak, testu-formarik gabeko eragiketak eta bertsioa
body:
C rstr
ST R0 (15)
ST R1 (16)
C ru32
ST R0 (11)
C ru32
ST R0 (12)
C ru32
ST R0 (13)
C rbool
C ru32
ST R0 (14)
SETR0 4
C rlen
ST R0 (9)
RCR8 R0
C alloc
ST R0 (8)
ADDR0 R8 R31
C alloc
ST R0 (10)
SETR27 0
SETR9 0
body.op:
IEQR9 R8 body.lines
ST R9 (20)
LDR0 (8)
ADDR0 R0 R9
LDR1 (5)
STR1 R0
C op
ADDR9 R9 R31
J body.op
body.lines:
SETR0 4
C rlen
RCR8 R0
body.l:
IEQR8 R30 body.end
C ru32
SUBR8 R8 R31
J body.l
body.end:
LDR0 (5)
LDR1 (6)
IEQR0 R1 body.bad
SUBR1 R1 R0
SETR0 12
J fail
body.bad:
LDR0 (21)
IEQR0 R30 body.nan
SUBR1 R0 R31
LDR2 (22)
SETR0 14
J fail
body.nan:
LDR0 (23)
IEQR0 R30 body.version
SUBR1 R0 R31
SETR0 16
J fail
body.version:
LDR0 (7)
ILTR0 R25 body.old
RET
body.old:
RCR1 R0
RCR2 R25
SETR0 15
J fail

; printall: goiburua, behar bada CREG lerroa, eta eragiketa bakoitza bere etiketarekin (bigarren pasaldia)
printall:
SETR27 1
LDR0 (11)
IEQR0 R30 printall.m
PF "QINIT {}\n" R0
printall.m:
LDR0 (12)
IEQR0 R30 printall.b
LDR1 (13)
PF "QMODE {} {}\n" R0 R1
printall.b:
; adierazitako bitak eragiketek erakusten dituztenak baino gehiago badira: CREG bits N
LDR0 (14)
IEQR0 R30 printall.ops
LDR1 (11)
ADDR2 R26 R31
IGTR1 R2 printall.k
RCR1 R2
printall.k:
IEQR0 R1 printall.ops
PF "CREG bits {}\n" R0
printall.ops:
LDR8 (9)
SETR9 0
printall.op:
IEQR9 R8 printall.end
LDR0 (10)
ADDR0 R0 R9
LDR0 R0
IEQR0 R30 printall.nolab
RCR0 R9
C plabel
printall.nolab:
LDR0 (8)
ADDR0 R0 R9
LDR0 R0
ST R0 (5)
ST R9 (20)
C op
PUTC (10)
ADDR9 R9 R31
J printall.op
printall.end:
LDR0 (10)
ADDR0 R0 R8
LDR0 R0
IEQR0 R30 printall.done
RCR0 R8
C plabel
printall.done:
; programa hutsa: qoa-k lerro huts bat idazten du
LDR0 (11)
LDR1 (12)
ADDR0 R0 R1
LDR1 (14)
ADDR0 R0 R1
ADDR0 R0 R8
INER0 R30 printall.r
PUTC (10)
printall.r:
RET

; ---------------------------------------------------------------- erroreak
; fail: R0 = errorea, R1 eta R2 xehetasunak -> "error: FITXATEGIA: mezua" errore-irteerara, eta EXIT 1.
; qoa-ren mezu berberak (src/program.rs, src/qx.rs eta src/disasm.rs)
fail:
RCR8 R0
RCR9 R1
RCR10 R2
STREAM 2
IEQR28 R31 fail.eu
PRINT "error: "
J fail.name
fail.eu:
PRINT "errorea: "
fail.name:
C printname
PRINT ": "
ILTR8 (5) fail.plain
IEQR8 (5) fail.plain
IEQR8 (6) fail.plain
IEQR28 R31 fail.peu
PRINT "corrupt QOA binary: "
J fail.plain
fail.peu:
PRINT "QOA bitar hondatua: "
fail.plain:
IEQR28 R31 fail.msgeu
IEQR8 (1) fail.e1
IEQR8 (2) fail.e2
IEQR8 (3) fail.e3
IEQR8 (4) fail.e4
IEQR8 (5) fail.e5
IEQR8 (6) fail.e6
IEQR8 (7) fail.e7
IEQR8 (8) fail.e8
IEQR8 (9) fail.e9
IEQR8 (10) fail.e10
IEQR8 (11) fail.e11
IEQR8 (12) fail.e12
IEQR8 (14) fail.e14
IEQR8 (15) fail.e15
PRINT "operation 0x"
RCR0 R9
C phex
PRINT " holds a number that is not finite"
J fail.end
fail.e1:
PRINT "the file is too short to be a QOA binary"
J fail.end
fail.e2:
PRINT "this binary was built by QOA 0.3.x, whose format is not supported; recompile the .qoa source with `qoa compile`"
J fail.end
fail.e3:
PRINT "not a QOA binary (the QOAX header is missing)"
J fail.end
fail.e4:
PF "binary format version {} is not supported by this QOA (it reads versions 1 to 4)" R9
J fail.end
fail.e5:
PRINT "corrupt QOA binary: the file ends before its SHA-256 checksum"
J fail.end
fail.e6:
PRINT "corrupt QOA binary: its SHA-256 checksum does not match, so the file was changed or damaged after it was written; build it again from its source"
J fail.end
fail.e7:
PRINT "the file ends in the middle of the program"
J fail.end
fail.e8:
PF "a list of {} items does not fit in the rest of the file" R9
J fail.end
fail.e9:
PRINT "unknown "
C what
PF " (number {})" R10
J fail.end
fail.e10:
PF "{} where only 0 or 1 fits" R9
J fail.end
fail.e11:
PRINT "a text that is not valid UTF-8"
J fail.end
fail.e12:
PF "{} unexpected bytes after the program" R9
J fail.end
fail.e14:
PRINT "operation 0x"
RCR0 R9
C phex
PRINT " ("
C kind
PRINT ") has no QOA text form"
J fail.end
fail.e15:
SETR0 2
IEQR10 (2) fail.e15r
SETR0 3
fail.e15r:
IEQR0 (2) fail.e15a
PF "version {} cannot hold QOA 0.4.4 instructions" R9
J fail.end
fail.e15a:
PF "version {} cannot hold QOA 0.4.3 instructions" R9
J fail.end
fail.msgeu:
IEQR8 (1) fail.u1
IEQR8 (2) fail.u2
IEQR8 (3) fail.u3
IEQR8 (4) fail.u4
IEQR8 (5) fail.u5
IEQR8 (6) fail.u6
IEQR8 (7) fail.u7
IEQR8 (8) fail.u8
IEQR8 (9) fail.u9
IEQR8 (10) fail.u10
IEQR8 (11) fail.u11
IEQR8 (12) fail.u12
IEQR8 (14) fail.u14
IEQR8 (15) fail.u15
PRINT "0x"
RCR0 R9
C phex
PRINT " eragiketak zenbaki ez-finitu bat du"
J fail.end
fail.u1:
PRINT "fitxategia laburregia da QOA bitar bat izateko"
J fail.end
fail.u2:
PRINT "bitar hau QOA 0.3.x-ek sortu zuen, eta haren formatua ez da onartzen; konpilatu berriz .qoa iturburua `qoa compile`-rekin"
J fail.end
fail.u3:
PRINT "ez da QOA bitar bat (QOAX goiburua falta da)"
J fail.end
fail.u4:
PF "{}. bertsioko formatu bitarra ez du QOA honek onartzen (1. bertsiotik 4.era irakurtzen ditu)" R9
J fail.end
fail.u5:
PRINT "QOA bitar hondatua: fitxategia bere SHA-256 laburpena baino lehen amaitzen da"
J fail.end
fail.u6:
PRINT "QOA bitar hondatua: haren SHA-256 laburpena ez dator bat, beraz fitxategia idatzi ondoren aldatu edo hondatu da; eraiki berriz bere iturburutik"
J fail.end
fail.u7:
PRINT "fitxategia programaren erdian amaitzen da"
J fail.end
fail.u8:
PF "{} elementuko zerrenda bat ez da fitxategiaren gainerakoan sartzen" R9
J fail.end
fail.u9:
C what
PF " ezezaguna ({}. zenbakia)" R10
J fail.end
fail.u10:
PF "{} 0 edo 1 bakarrik doan lekuan" R9
J fail.end
fail.u11:
PRINT "utf-8 baliozkoa ez den testu bat"
J fail.end
fail.u12:
PF "{} byte espero gabe programaren ondoren" R9
J fail.end
fail.u14:
PRINT "0x"
RCR0 R9
C phex
PRINT " eragiketak ("
C kind
PRINT ") ez du QOA testu-formarik"
J fail.end
fail.u15:
SETR0 2
IEQR10 (2) fail.u15r
SETR0 3
fail.u15r:
IEQR0 (2) fail.u15a
PF "{}. bertsioak ezin ditu QOA 0.4.4-ko aginduak izan" R9
J fail.end
fail.u15a:
PF "{}. bertsioak ezin ditu QOA 0.4.3-ko aginduak izan" R9
fail.end:
PUTC (10)
EXIT 1

; what: R9 = zer den (rtag-en R1) -> haren izena. aldatzen ditu R0
what:
IEQR28 R31 what.eu
IEQR9 (2) what.gate
IEQR9 (3) what.basis
IEQR9 (4) what.dest
IEQR9 (5) what.source
IEQR9 (6) what.count
IEQR9 (7) what.value
IEQR9 (8) what.cmp
PRINT "operation"
RET
what.gate:
PRINT "gate"
RET
what.basis:
PRINT "basis"
RET
what.dest:
PRINT "destination"
RET
what.source:
PRINT "source"
RET
what.count:
PRINT "count"
RET
what.value:
PRINT "value"
RET
what.cmp:
PRINT "comparison"
RET
what.eu:
IEQR9 (2) what.ugate
IEQR9 (3) what.ubasis
IEQR9 (4) what.udest
IEQR9 (5) what.usource
IEQR9 (6) what.ucount
IEQR9 (7) what.uvalue
IEQR9 (8) what.ucmp
PRINT "eragiketa"
RET
what.ugate:
PRINT "ate"
RET
what.ubasis:
PRINT "oinarri"
RET
what.udest:
PRINT "helburu"
RET
what.usource:
PRINT "iturri"
RET
what.ucount:
PRINT "kopuru"
RET
what.uvalue:
PRINT "balio"
RET
what.ucmp:
PRINT "konparazio"
RET

; kind: R10 = testu-formarik gabeko eragiketaren mota -> haren izena. aldatzen ditu R0
kind:
IEQR28 R31 kind.eu
IEQR10 (1) kind.ctl
IEQR10 (2) kind.ph
IEQR10 (3) kind.sw
PRINT "jump on a value"
RET
kind.ctl:
PRINT "controlled gate"
RET
kind.ph:
PRINT "multi-qubit phase"
RET
kind.sw:
PRINT "multi-controlled swap"
RET
kind.eu:
IEQR10 (1) kind.uctl
IEQR10 (2) kind.uph
IEQR10 (3) kind.usw
PRINT "balio baten araberako jauzia"
RET
kind.uctl:
PRINT "ate kontrolatua"
RET
kind.uph:
PRINT "qubit anitzeko fasea"
RET
kind.usw:
PRINT "kontrol anitzeko trukaketa"
RET

