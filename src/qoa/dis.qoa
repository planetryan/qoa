; sha.byte: R0 = byte bat laburpenera. R0 bakarrik aldatzen du
sha.byte:
PUSHR1
PUSHR2
PUSHR3
SETR1 96
LDR1 R1
ADDR2 R1 (9)
LDR2 R2
ADDR2 R2 R1
ADDR2 R2 (16)
STR0 R2
ADDR2 R1 (8)
LDR0 R2
ADDR0 R0 R31
STR0 R2
ADDR2 R1 (9)
LDR0 R2
ADDR0 R0 R31
STR0 R2
ILTR0 (64) sha.byte.done
ST (0) R2
C sha.block
sha.byte.done:
POPR3
POPR2
POPR1
RET

; sha.block: 64 byteko blokea egoerara. aldatzen ditu R0-R3
