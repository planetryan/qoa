; QOA-ren desmihiztatzailea, QOAn idatzia (QOA 0.4.8). programa honek .qx bitar bat irakurtzen du eta
; `qoa export --to qoa --long-names`-ek idazten duen QOA arrunt kanonikoa idazten du, byte berberak:
; goiburua (QINIT, QMODE, behar denean CREG), eragiketa bakoitza bere izen nagusiarekin, eta jauzien
; helburuak `addr_0x..` etiketekin. fitxategia hondatuta badago, `qoa`-ren errore berberak ematen ditu.
;
;   qoa export --to qoa --long-names --self-hosted programa.qx     (qoa-k fitxategia eta izena ematen dizkio)
;   qoa run src/qoa/dis.qoa --quiet -- programa.qx < programa.qx
;
;   src/qoa/dis.qg: programa bera glifo-sintaxian, fitxategi honetatik sortua lerroz lerro
;   (qoa export --to glyph --keep-source src/qoa/dis.qoa); ez editatu eskuz, proba batek bat datozela egiaztatzen du
;
; sarrera: .qx-a sarrera estandarrean; 0. argumentua fitxategi-izena da (mezuetarako).
; irteera: QOA testua irteera estandarrean; erroreak errore-irteeran, eta EXIT 1.
;
; formatua (src/qx.rs): "QOAX", u16 bertsioa, programa, eta 4. bertsiotik 32 byteko SHA-256 bat. programa:
; izena (u64 luzera eta utf-8), qubitak, moduak, muga (u32), muga adierazita (u8), bitak (u32), eragiketak
; (u64 kopurua; bakoitza u32 aldaera eta eremuak) eta lerroak. zenbaki osoak little-endian, f64 bere 8
; byteak. f64-a zehazki berreraikitzen da: mantisa osoa bider 2^k, 2^64-ko urratsetan (biderketa eta
; zatiketa zehatzak dira bi-ren berreturekin).
;
; mihiztatzaileak ez bezala, honek ez du programaren edukia berriz mihiztatuta egiaztatzen (`qoa`-k kargatzean
; egiten duena): formatua, osotasuna eta aldaeren zenbakiak egiaztatzen ditu.
;
; erregistroen ohitura:
;   R0-R7   argumentuak, emaitzak eta behin-behinekoak: edozein deik alda ditzake
;   R8-R24  deiek gordetzen dituzte: erabiltzen dituen errutinak PUSH/POP egiten ditu
;   R25 behar den formatu-bertsioa   R26 c-tokenen indize handiena (-1 bat ere ez)   R27 1 inprimatzean
;   R28 hizkuntza (1 euskara, 0 ingelesa)   R29 = -1   R30 = 0   R31 = 1
;
; memoria-mapa (gelaxkak; idatzi gabeak 0):
;   0 HP hurrengo gelaxka librea   1 NAMEP 2 NAMEN fitxategi-izena   3 DATA 4 NDATA sarrerako byteak
;   5 POS irakurtzeko hurrengo bytearen helbidea   6 END programaren amaiera   7 VER bertsioa
;   8 OPV eragiketa bakoitzaren hasiera   9 NOPS   10 MARK jauzi-helburuak (NOPS + 1)
;   11 NQ 12 NM 13 CUTOFF 14 NBITS   15 PNAME 16 PNAMEN programaren izena   19 NAMES izenen taula
;   20 PC uneko eragiketa   21 BAD testu-formarik gabeko lehen eragiketa (pc + 1, 0 bat ere ez)
;   22 BADKIND haren mota   23 NAN zenbaki ez-finitua duen lehen eragiketa (pc + 1)
;   30-35 parametroak (balioa, -0 marka) x3
;   96 SHA SHA-256-aren egoera   1000-tik aurrera: memoria dinamikoa

; ---------------------------------------------------------------- nagusia
main:
SETR29 -1
SETR30 0
SETR31 1
GETLANGR28
SETR25 1
SETR26 -1
SETR27 0
SETR0 1000
ST R0 (0)
C readname
C readall
C names
C head
C body
C printall
EXIT 0

; ---------------------------------------------------------------- memoria
; alloc: R0 = gelaxka-kopurua -> R0 = haien hasiera. aldatzen ditu R0-R3
alloc:
SETR1 0
LDR2 R1
ADDR3 R2 R0
STR3 R1
RCR0 R2
RET

; ---------------------------------------------------------------- sarrera
; readname: 0. argumentua (fitxategi-izena) memoriara. argumenturik ez badago, erabilera azaldu
readname:
ARGCR0
IGTR0 R30 readname.ok
STREAM 2
IEQR28 R31 readname.eu
PLN "usage: qoa export --to qoa --long-names --self-hosted FILE.qx (or: qoa run src/qoa/dis.qoa --quiet -- FILE.qx < FILE.qx)"
EXIT 2
readname.eu:
PLN "erabilera: qoa export --to qoa --long-names --self-hosted FITXATEGIA.qx (edo: qoa run src/qoa/dis.qoa --quiet -- FITXATEGIA.qx < FITXATEGIA.qx)"
EXIT 2
readname.ok:
LDR4 (0)
ST R4 (1)
SETR5 0
SETR6 0
readname.next:
ARGBYTER0 R6 R5
IEQR0 R29 readname.done
ADDR1 R4 R5
STR0 R1
ADDR5 R5 R31
J readname.next
readname.done:
ST R5 (2)
ADDR1 R4 R5
ST R1 (0)
RET

; readall: sarrera osoa memoriara, byte bat gelaxka bakoitzean. aldatzen ditu R0-R5
readall:
LDR4 (0)
RCR5 R4
readall.next:
GCR0
IEQR0 R29 readall.done
STR0 R5
ADDR5 R5 R31
J readall.next
readall.done:
ST R4 (3)
SUBR1 R5 R4
ST R1 (4)
ST R5 (0)
RET

; printname: fitxategi-izena uneko irteerara. aldatzen ditu R0-R2
printname:
LDR1 (1)
LDR2 (2)
ADDR2 R1 R2
printname.next:
IEQR1 R2 printname.done
LDR0 R1
PUTCR0
ADDR1 R1 R31
J printname.next
printname.done:
RET

; ---------------------------------------------------------------- goiburua eta osotasuna
; head: magia, bertsioa eta (4. bertsiotik) SHA-256-a; POS eta END ezarri. aldatzen ditu R0-R11
head:
LDR8 (3)
LDR9 (4)
ILTR9 (6) head.short
LDR0 R8
ADDR1 R8 R31
LDR1 R1
ADDR2 R8 (2)
LDR2 R2
ADDR3 R8 (3)
LDR3 R3
; QOA 0.3-ren magiak: QEXE, OEXE, QX\0\0
IEQR0 (81) head.q
IEQR0 (79) head.o
J head.notqoax
head.q:
INER1 (88) head.qe
IEQR2 R30 head.qx0
J head.notqoax
head.qx0:
IEQR3 R30 head.old
J head.notqoax
head.qe:
INER1 (69) head.qoax
INER2 (88) head.notqoax
IEQR3 (69) head.old
J head.notqoax
head.o:
INER1 (69) head.notqoax
INER2 (88) head.notqoax
IEQR3 (69) head.old
J head.notqoax
head.qoax:
INER1 (79) head.notqoax
INER2 (65) head.notqoax
INER3 (88) head.notqoax
; bertsioa
ADDR0 R8 (4)
LDR0 R0
ADDR1 R8 (5)
LDR1 R1
MULR1 R1 (256)
ADDR10 R0 R1
ST R10 (7)
IEQR10 R30 head.version
IGTR10 (4) head.version
ADDR0 R8 (6)
ST R0 (5)
ADDR0 R8 R9
ST R0 (6)
ILTR10 (4) head.done
; SHA-256: azken 32 byteak aurreko guztienak dira
SUBR11 R9 (32)
ILTR11 (6) head.nosum
C sha.init
SETR10 0
head.sum:
IEQR10 R11 head.final
ADDR0 R8 R10
LDR0 R0
C sha.byte
ADDR10 R10 R31
J head.sum
head.final:
C sha.final
; H hitzak (big-endian) fitxategiko 32 byteekin
LDR4 (96)
ADDR5 R8 R11
SETR6 0
head.cmp:
IEQR6 (8) head.ok
ADDR0 R4 R6
LDR7 R0
MULR1 R6 (4)
ADDR1 R5 R1
LDR0 R1
MULR0 R0 (16777216)
ADDR1 R1 R31
LDR2 R1
MULR2 R2 (65536)
ADDR0 R0 R2
ADDR1 R1 R31
LDR2 R1
MULR2 R2 (256)
ADDR0 R0 R2
ADDR1 R1 R31
LDR2 R1
ADDR0 R0 R2
INER0 R7 head.badsum
ADDR6 R6 R31
J head.cmp
head.ok:
ADDR0 R8 R11
ST R0 (6)
head.done:
RET
head.short:
SETR0 1
J fail
head.old:
SETR0 2
J fail
head.notqoax:
SETR0 3
J fail
head.version:
RCR1 R10
SETR0 4
J fail
head.nosum:
SETR0 5
J fail
head.badsum:
SETR0 6
J fail

; ---------------------------------------------------------------- irakurketa
; rb: -> R0 = hurrengo bytea. aldatzen ditu R0-R2
rb:
LDR1 (5)
LDR2 (6)
ILTR1 R2 rb.ok
SETR0 7
J fail
rb.ok:
LDR0 R1
ADDR1 R1 R31
ST R1 (5)
RET

; ru32: -> R0 = u32 (little-endian). aldatzen ditu R0-R3
ru32:
C rb
RCR3 R0
C rb
MULR0 R0 (256)
ADDR3 R3 R0
C rb
MULR0 R0 (65536)
ADDR3 R3 R0
C rb
MULR0 R0 (16777216)
ADDR0 R3 R0
RET

; ru64: -> R0 = u64 (2^53-tik gora ez da zehatza: ez du QOA-k sortzen). aldatzen ditu R0-R4
ru64:
C ru32
RCR4 R0
C ru32
MULR0 R0 (4294967296)
ADDR0 R0 R4
RET

; rf64: -> R0 = f64 zehatza, R1 = 1 -0 bada (R0 orduan 0), bestela 0. aldatzen ditu R0-R7
rf64:
C ru32
RCR5 R0
C rb
RCR6 R0
C rb
MULR0 R0 (256)
ADDR6 R6 R0
C rb
RCR7 R0
C rb
RCR4 R0
SETR1 0
ILTR4 (128) rf64.pos
SETR1 1
SUBR4 R4 (128)
rf64.pos:
; berretzailea: 7. bytearen 7 bitak eta 6.aren goiko 4ak
MULR4 R4 (16)
SHRR2 R7 (4)
ADDR4 R4 R2
ANDR7 R7 (15)
; mantisa: 52 bit
MULR6 R6 (4294967296)
ADDR5 R5 R6
MULR7 R7 (281474976710656)
ADDR5 R5 R7
IEQR4 (2047) rf64.nan
IEQR4 R30 rf64.sub
ADDR5 R5 (4503599627370496)
SUBR4 R4 (1075)
J rf64.scale
rf64.sub:
SETR4 -1074
rf64.scale:
IGTR4 (63) rf64.up64
IGTR4 R30 rf64.up1
ILTR4 (-63) rf64.dn64
ILTR4 R30 rf64.dn1
IEQR1 R30 rf64.plus
IEQR5 R30 rf64.negzero
SUBR0 R30 R5
SETR1 0
RET
rf64.negzero:
SETR0 0
RET
rf64.plus:
RCR0 R5
RET
rf64.up64:
MULR5 R5 (18446744073709551616)
SUBR4 R4 (64)
J rf64.scale
rf64.up1:
MULR5 R5 (2)
SUBR4 R4 R31
J rf64.scale
rf64.dn64:
DIVR5 R5 (18446744073709551616)
ADDR4 R4 (64)
J rf64.scale
rf64.dn1:
DIVR5 R5 (2)
ADDR4 R4 R31
J rf64.scale
; berretzailea 2047 (infinitua edo NaN): qoa-k irakurtzen du eta gero baztertzen; hemen lehena gorde eta jarraitu
rf64.nan:
LDR0 (23)
INER0 R30 rf64.nan.r
LDR0 (20)
ADDR0 R0 R31
ST R0 (23)
rf64.nan.r:
SETR0 0
SETR1 0
RET

; rbool: -> R0 = 0 edo 1 (u8). aldatzen ditu R0-R2
rbool:
C rb
IGTR0 R31 rbool.bad
RET
rbool.bad:
RCR1 R0
SETR0 10
J fail

; rtag: R0 = aldaera-kopurua, R1 = zer den (mezuetarako) -> R0 = aldaera. aldatzen ditu R0-R3
rtag:
PUSHR8
PUSHR9
RCR8 R0
RCR9 R1
C ru32
ILTR0 R8 rtag.ok
RCR2 R0
RCR1 R9
SETR0 9
J fail
rtag.ok:
POPR9
POPR8
RET

; rlen: R0 = elementu bakoitzaren byte txikienak -> R0 = zerrendaren luzera, fitxategian sartzen dela
; egiaztatuta (luzera * txikiena <= geratzen diren byteak). aldatzen ditu R0-R4
rlen:
PUSHR8
RCR8 R0
C ru64
LDR1 (6)
LDR2 (5)
SUBR1 R1 R2
MULR2 R0 R8
IGTR2 R1 rlen.big
POPR8
RET
rlen.big:
RCR1 R0
SETR0 8
J fail

; rstr: testu bat -> R0 = haren lehen bytearen helbidea, R1 = luzera; utf-8 zorrotza. aldatzen ditu R0-R7
rstr:
SETR0 1
C rlen
RCR1 R0
LDR0 (5)
ADDR2 R0 R1
ST R2 (5)
PUSHR0
PUSHR1
C utf8
POPR1
POPR0
RET

; utf8: R0 = helbidea, R1 = luzera: rust-en from_utf8 bezain zorrotz. aldatzen ditu R0-R5
utf8:
ADDR1 R0 R1
utf8.next:
IEQR0 R1 utf8.ok
LDR2 R0
ILTR2 (128) utf8.one
ILTR2 (194) utf8.bad
ILTR2 (224) utf8.two
ILTR2 (240) utf8.three
ILTR2 (245) utf8.four
J utf8.bad
utf8.one:
ADDR0 R0 R31
J utf8.next
utf8.two:
SETR3 128
SETR4 191
SETR5 1
J utf8.cont
utf8.three:
SETR3 128
SETR4 191
INER2 (224) utf8.t2
SETR3 160
utf8.t2:
INER2 (237) utf8.t3
SETR4 159
utf8.t3:
SETR5 2
J utf8.cont
utf8.four:
SETR3 128
SETR4 191
INER2 (240) utf8.f2
SETR3 144
utf8.f2:
INER2 (244) utf8.f3
SETR4 143
utf8.f3:
SETR5 3
utf8.cont:
ADDR0 R0 R31
IEQR0 R1 utf8.bad
LDR2 R0
ILTR2 R3 utf8.bad
IGTR2 R4 utf8.bad
SETR3 128
SETR4 191
SUBR5 R5 R31
IGTR5 R30 utf8.cont
ADDR0 R0 R31
J utf8.next
utf8.ok:
RET
utf8.bad:
SETR0 11
J fail

; u32at: R0 = helbidea -> R0 = han dagoen u32-a (lau byte). aldatzen ditu R0-R2
u32at:
LDR1 R0
ADDR0 R0 R31
LDR2 R0
MULR2 R2 (256)
ADDR1 R1 R2
ADDR0 R0 R31
LDR2 R0
MULR2 R2 (65536)
ADDR1 R1 R2
ADDR0 R0 R31
LDR2 R0
MULR2 R2 (16777216)
ADDR0 R1 R2
RET

; need: R0 = eragiketak behar duen formatu-bertsioa. R25 eguneratzen du
need:
IGTR0 R25 need.up
RET
need.up:
RCR25 R0
RET

; ---------------------------------------------------------------- inprimatzea
; R27 0 denean (lehen pasaldia) ez da ezer idazten, baina c-tokenak (R26) eta jauzi-helburuak (MARK) beti
; jasotzen dira

; pname: R0 = izenaren zenbakia (izenen taulan). aldatzen ditu R0, R1
pname:
IEQR27 R30 pname.r
LDR1 (19)
MULR0 R0 (16)
ADDR1 R1 R0
pname.c:
LDR0 R1
IEQR0 R30 pname.r
PUTCR0
ADDR1 R1 R31
J pname.c
pname.r:
RET

; pq / po / pr / pc: R0 = zenbakia -> " q3" / " o3" / " R3" / " c3". R0 bakarrik aldatzen dute
pq:
IEQR27 R30 pq.r
PF " q{}" R0
pq.r:
RET

po:
IEQR27 R30 po.r
PF " o{}" R0
po.r:
RET

pr:
IEQR27 R30 pr.r
PF " R{}" R0
pr.r:
RET

pc:
IGTR0 R26 pc.max
J pc.out
pc.max:
RCR26 R0
pc.out:
IEQR27 R30 pc.r
PF " c{}" R0
pc.r:
RET

; pnum: R0 = zenbakia, R1 = -0 marka -> " " eta rust-en `{}` (-0 "-0" da). R0 bakarrik aldatzen du
pnum:
IEQR27 R30 pnum.r
IEQR1 R31 pnum.neg
PF " {}" R0
RET
pnum.neg:
PRINT " -0"
pnum.r:
RET

; pimm: " (zenbakia)". R0 bakarrik aldatzen du
pimm:
IEQR27 R30 pimm.r
IEQR1 R31 pimm.neg
PF " ({})" R0
RET
pimm.neg:
PRINT " (-0)"
pimm.r:
RET

; pword: R0 = zenbaki osoa -> " 42". R0 bakarrik aldatzen du
pword:
IEQR27 R30 pword.r
PF " {}" R0
pword.r:
RET

; phex: R0 = zenbaki osoa -> hamaseitarrez, letra txikiz. aldatzen ditu R0-R2
phex:
SETR2 0
phex.d:
ANDR1 R0 (15)
PUSHR1
ADDR2 R2 R31
SHRR0 R0 (4)
IGTR0 R30 phex.d
phex.p:
POPR1
ILTR1 (10) phex.dig
ADDR1 R1 (87)
J phex.out
phex.dig:
ADDR1 R1 (48)
phex.out:
PUTCR1
SUBR2 R2 R31
IGTR2 R30 phex.p
RET

; plab: R0 = jauzi-helburua -> " addr_0x..", eta helburua markatu. aldatzen ditu R0-R2
plab:
LDR1 (9)
IGTR0 R1 plab.print
IGTR0 R29 plab.mark
J plab.print
plab.mark:
LDR1 (10)
ADDR1 R1 R0
ST R31 R1
plab.print:
IEQR27 R30 plab.r
PRINT " addr_0x"
C phex
plab.r:
RET

; plabel: R0 = helbidea -> "addr_0x..:" lerro bat. aldatzen ditu R0-R2
plabel:
PRINT "addr_0x"
C phex
PLN ":"
RET

; ptext: R0 = helbidea, R1 = luzera -> ` "testua"` (\\, \", \n eta \t ihes eginda). aldatzen ditu R0-R3
ptext:
IEQR27 R30 ptext.r
ADDR1 R0 R1
PRINT " "
PUTC (34)
ptext.next:
IEQR0 R1 ptext.end
LDR2 R0
IEQR2 (92) ptext.bs
IEQR2 (34) ptext.q
IEQR2 (10) ptext.nl
IEQR2 (9) ptext.tab
PUTCR2
J ptext.adv
ptext.bs:
PUTC (92)
PUTC (92)
J ptext.adv
ptext.q:
PUTC (92)
PUTC (34)
J ptext.adv
ptext.nl:
PUTC (92)
PUTC (110)
J ptext.adv
ptext.tab:
PUTC (92)
PUTC (116)
ptext.adv:
ADDR0 R0 R31
J ptext.next
ptext.end:
PUTC (34)
ptext.r:
RET

; ---------------------------------------------------------------- eremuak: irakurri eta idatzi
; fq / fo / fr / fc: u32 bat qubit, modu, erregistro edo bit gisa. aldatzen dituzte R0-R3
fq:
C ru32
J pq

fo:
C ru32
J po

fr:
C ru32
J pr

fc:
C ru32
J pc

; ff: f64 bat zenbaki gisa. aldatzen ditu R0-R7
ff:
C rf64
J pnum

; fw: u32 bat zenbaki oso gisa; fw64: u64 bat. aldatzen dituzte R0-R4
fw:
C ru32
J pword

fw64:
C ru64
J pword

; fqs / fos / frs / fcs: u32 zerrenda bat qubit, modu, erregistro edo bit gisa. aldatzen dituzte R0-R5
fqs:
SETR0 4
C rlen
RCR5 R0
fqs.n:
IEQR5 R30 fqs.r
C fq
SUBR5 R5 R31
J fqs.n
fqs.r:
RET

fos:
SETR0 4
C rlen
RCR5 R0
fos.n:
IEQR5 R30 fos.r
C fo
SUBR5 R5 R31
J fos.n
fos.r:
RET

frs:
SETR0 4
C rlen
RCR5 R0
frs.n:
IEQR5 R30 frs.r
C fr
SUBR5 R5 R31
J frs.n
frs.r:
RET

fcs:
SETR0 4
C rlen
RCR5 R0
fcs.n:
IEQR5 R30 fcs.r
C fc
SUBR5 R5 R31
J fcs.n
fcs.r:
RET

; fdest: Dest (Own: ezer ez; Bit: " -> c3"; Reg: " -> R3"). aldatzen ditu R0-R4
fdest:
SETR0 3
SETR1 4
C rtag
IEQR0 R30 fdest.r
RCR4 R0
IEQR27 R30 fdest.v
PRINT " ->"
fdest.v:
IEQR4 R31 fc
J fr
fdest.r:
RET

; fsrc: Source (Reg: " R3"; Bit: " c3"). aldatzen ditu R0-R3
fsrc:
SETR0 2
SETR1 5
C rtag
IEQR0 R30 fr
J fc

; fval: Val (Reg: " R3"; Num: " (2.5)"). aldatzen ditu R0-R7
fval:
SETR0 2
SETR1 7
C rtag
IEQR0 R30 fr
C rf64
J pimm

; fbasis: Basis -> " X" / " Y" / " Z". aldatzen ditu R0-R3
fbasis:
SETR0 3
SETR1 3
C rtag
ADDR0 R0 R31
IEQR27 R30 fbasis.r
PRINT " "
J pname
fbasis.r:
RET

; fopt: Option<u32> erregistro bat (EXPECT, BELLCHECK, MEANPHOTON). aldatzen ditu R0-R3
fopt:
C rb
IEQR0 R30 fopt.r
IEQR0 R31 fr
RCR1 R0
SETR0 10
J fail
fopt.r:
RET

; flab: usize jauzi-helburu bat. aldatzen ditu R0-R4
flab:
C ru64
J plab

; ftext: testu bat. aldatzen ditu R0-R7
ftext:
C rstr
J ptext

; fcount: Count (Lit: " 3"; Reg: " R3"). aldatzen ditu R0-R4
fcount:
SETR0 2
SETR1 6
C rtag
IEQR0 R30 fw64
J fr

; bad: R0 = mota: testu-formarik gabeko eragiketa bat; lehena gorde (gorputza irakurri ondoren salatzen da,
; qoa-k bezala). aldatzen ditu R0, R1
bad:
LDR1 (21)
INER1 R30 bad.r
LDR1 (20)
ADDR1 R1 R31
ST R1 (21)
ST R0 (22)
bad.r:
RET

; ---------------------------------------------------------------- izenak
; names: aginduen izen nagusiak memoriara, 16 gelaxka bakoitza (0-z amaituak). aldatzen ditu R0-R3
names:
SETR0 1888
C alloc
ST R0 (19)
