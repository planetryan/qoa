; sha.byte: R0 = byte bat laburpenera. R0 bakarrik aldatzen du
sha_byte:
PUSH#1;
PUSH#2;
PUSH#3;
#1<=96;
#1<=LXP@(#1);
#2<=#1+9;
#2<=LXP@(#2);
#2_+#1;
#2_+16;
LXP@(#2)<=#0;
#2<=#1+8;
#0<=LXP@(#2);
#0_+#31;
LXP@(#2)<=#0;
#2<=#1+9;
#0<=LXP@(#2);
#0_+#31;
LXP@(#2)<=#0;
ILT#0,(64),sha_byte_done;
LXP@(#2)<=0;
&sha_block;
sha_byte_done:
POP#3;
POP#2;
POP#1;
^;

; sha.block: 64 byteko blokea egoerara. aldatzen ditu R0-R3
sha_block:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
PUSH#13;
PUSH#14;
PUSH#15;
PUSH#16;
PUSH#17;
PUSH#18;
