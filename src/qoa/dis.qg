; listq: R8 qubit, R9-tik aurrera (u32 bakoitza) -> " q.." bakoitzeko. aldatzen ditu R0-R3
listq:
PUSH#9;
#3<=#8;
listq_n:
IEQ#3,#30,listq_r;
#0<=#9;
&u32at;
&pq;
#9_+4;
#3-=>#31;
>listq_n;
listq_r:
POP#9;
^;

; skipv: u32 zerrenda bat jauzi -> R8 kopurua, R9 lehen elementuaren helbidea. aldatzen ditu R0-R4
skipv:
#0<=4;
&rlen;
#8<=#0;
#9<=LXP@(5);
#0<=#0*4;
#1<=#9+#0;
LXP@(5)<=#1;
^;

