#0<=1;
&bad;
op_1_done:
POP#11;
POP#10;
POP#9;
POP#8;
^;

; op.2: PhaseAll { qubits, theta }: CZ (π), CPHASE, MCZ (π)
op_2:
PUSH#8;
PUSH#9;
&skipv;
&rf64;
LXP@(30)<=#0;
LXP@(31)<=#1;
INE#8,(2),op_2_many;
#0<=25;
#1<=LXP@(30);
IEQ#1,(3.141592653589793),op_2_two;
#0<=26;
op_2_two:
&pname;
&listq;
#0<=LXP@(30);
IEQ#0,(3.141592653589793),op_2_done;
#1<=LXP@(31);
&pnum;
>op_2_done;
op_2_many:
IEQ#8,#30,op_2_bad;
#1<=LXP@(30);
INE#1,(3.141592653589793),op_2_bad;
#0<=27;
&pname;
&listq;
>op_2_done;
op_2_bad:
#0<=2;
&bad;
op_2_done:
POP#9;
POP#8;
^;

; op.3: Swap { a, b, controls }: SWAP, CSWAP
op_3:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
&ru32;
#10<=#0;
&ru32;
#11<=#0;
&skipv;
IEQ#8,#30,op_3_swap;
INE#8,#31,op_3_bad;
#0<=29;
&pname;
&listq;
>op_3_ab;
op_3_swap:
#0<=28;
&pname;
op_3_ab:
#0<=#10;
&pq;
#0<=#11;
&pq;
>op_3_done;
op_3_bad:
#0<=3;
&bad;
op_3_done:
POP#11;
POP#10;
POP#9;
POP#8;
^;

; op.8: Measure { q, basis, dest }: MEASURE (Z) edo MEASUREIN
op_8:
&ru32;
PUSH#0;
#0<=3;
#1<=3;
&rtag;
#4<=#0;
#0<=34;
IEQ#4,(2),op_8_z;
#0<=35;
op_8_z:
&pname;
POP#0;
&pq;
IEQ#4,(2),op_8_d;
IEQ#27,#30,op_8_d;
PRINT" ";
#0<=#4+#31;
&pname;
op_8_d:
>fdest;

; op.49: JumpIf { src, value, to }: JUMPIFZERO, JUMPIFONE
op_49:
PUSH#8;
PUSH#9;
#0<=2;
#1<=5;
&rtag;
#8<=#0;
&ru32;
#9<=#0;
&rf64;
LXP@(30)<=#0;
&ru64;
LXP@(31)<=#0;
#1<=LXP@(30);
#0<=91;
IEQ#1,#30,op_49_n;
#0<=92;
IEQ#1,#31,op_49_n;
#0<=4;
&bad;
>op_49_done;
op_49_n:
&pname;
#0<=#9;
IEQ#8,#30,op_49_reg;
&pc;
>op_49_l;
op_49_reg:
&pr;
op_49_l:
#0<=LXP@(31);
&plab;
op_49_done:
