; op.66: Stream { stderr }: STREAM 1 edo 2
op_66:
#0<=2;
&need;
&rbool;
PUSH#0;
#0<=113;
&pname;
POP#0;
#0_+#31;
>pword;

; fskip: usize bat irakurri, ezer idatzi gabe (LOOPSTART-en amaiera, LOOPEND-en hasiera). aldatzen ditu R0-R4
fskip:
>ru64;

; fbyte: u8 bat zenbaki gisa (EXIT). aldatzen ditu R0-R2
fbyte:
&rb;
>pword;

; ---------------------------------------------------------------- programa
; body: programaren eremuak eta eragiketak (lehen pasaldia, idatzi gabe): hasierak, jauzi-helburuak eta
; c-tokenak. gero lerroak, soberako byteak, testu-formarik gabeko eragiketak eta bertsioa
body:
&rstr;
LXP@(15)<=#0;
LXP@(16)<=#1;
&ru32;
LXP@(11)<=#0;
&ru32;
LXP@(12)<=#0;
&ru32;
LXP@(13)<=#0;
&rbool;
&ru32;
LXP@(14)<=#0;
#0<=4;
&rlen;
LXP@(9)<=#0;
#8<=#0;
&alloc;
LXP@(8)<=#0;
#0<=#8+#31;
&alloc;
LXP@(10)<=#0;
#27<=0;
#9<=0;
body_op:
IEQ#9,#8,body_lines;
LXP@(20)<=#9;
#0<=LXP@(8);
#0_+#9;
#1<=LXP@(5);
LXP@(#0)<=#1;
&op;
#9_+#31;
>body_op;
body_lines:
#0<=4;
&rlen;
#8<=#0;
body_l:
IEQ#8,#30,body_end;
&ru32;
#8-=>#31;
>body_l;
body_end:
#0<=LXP@(5);
#1<=LXP@(6);
IEQ#0,#1,body_bad;
#1-=>#0;
#0<=12;
>fail;
body_bad:
#0<=LXP@(21);
IEQ#0,#30,body_nan;
#1<=#0-#31;
#2<=LXP@(22);
#0<=14;
>fail;
body_nan:
#0<=LXP@(23);
IEQ#0,#30,body_version;
#1<=#0-#31;
#0<=16;
>fail;
body_version:
#0<=LXP@(7);
ILT#0,#25,body_old;
^;
body_old:
#1<=#0;
#2<=#25;
#0<=15;
>fail;

; printall: goiburua, behar bada CREG lerroa, eta eragiketa bakoitza bere etiketarekin (bigarren pasaldia)
printall:
#27<=1;
#0<=LXP@(11);
IEQ#0,#30,printall_m;
PF"QINIT {}\n"/#0;
printall_m:
#0<=LXP@(12);
IEQ#0,#30,printall_b;
#1<=LXP@(13);
PF"QMODE {} {}\n"/#0,#1;
printall_b:
; adierazitako bitak eragiketek erakusten dituztenak baino gehiago badira: CREG bits N
#0<=LXP@(14);
IEQ#0,#30,printall_ops;
#1<=LXP@(11);
#2<=#26+#31;
IGT#1,#2,printall_k;
#1<=#2;
printall_k:
IEQ#0,#1,printall_ops;
PF"CREG bits {}\n"/#0;
printall_ops:
#8<=LXP@(9);
#9<=0;
printall_op:
IEQ#9,#8,printall_end;
#0<=LXP@(10);
#0_+#9;
#0<=LXP@(#0);
IEQ#0,#30,printall_nolab;
#0<=#9;
&plabel;
printall_nolab:
#0<=LXP@(8);
#0_+#9;
#0<=LXP@(#0);
LXP@(5)<=#0;
LXP@(20)<=#9;
&op;
PUTC/(10);
#9_+#31;
>printall_op;
printall_end:
#0<=LXP@(10);
#0_+#8;
#0<=LXP@(#0);
IEQ#0,#30,printall_done;
#0<=#8;
&plabel;
printall_done:
; programa hutsa: qoa-k lerro huts bat idazten du
#0<=LXP@(11);
#1<=LXP@(12);
#0_+#1;
#1<=LXP@(14);
#0_+#1;
#0_+#8;
INE#0,#30,printall_r;
PUTC/(10);
printall_r:
^;

; ---------------------------------------------------------------- erroreak
; fail: R0 = errorea, R1 eta R2 xehetasunak -> "error: FITXATEGIA: mezua" errore-irteerara, eta EXIT 1.
; qoa-ren mezu berberak (src/program.rs, src/qx.rs eta src/disasm.rs)
fail:
#8<=#0;
#9<=#1;
#10<=#2;
STREAM/2;
IEQ#28,#31,fail_eu;
PRINT"error: ";
>fail_name;
fail_eu:
PRINT"errorea: ";
fail_name:
&printname;
PRINT": ";
ILT#8,(5),fail_plain;
IEQ#8,(5),fail_plain;
IEQ#8,(6),fail_plain;
IEQ#28,#31,fail_peu;
PRINT"corrupt QOA binary: ";
>fail_plain;
fail_peu:
PRINT"QOA bitar hondatua: ";
fail_plain:
IEQ#28,#31,fail_msgeu;
IEQ#8,(1),fail_e1;
IEQ#8,(2),fail_e2;
IEQ#8,(3),fail_e3;
IEQ#8,(4),fail_e4;
IEQ#8,(5),fail_e5;
IEQ#8,(6),fail_e6;
IEQ#8,(7),fail_e7;
IEQ#8,(8),fail_e8;
IEQ#8,(9),fail_e9;
IEQ#8,(10),fail_e10;
IEQ#8,(11),fail_e11;
IEQ#8,(12),fail_e12;
IEQ#8,(14),fail_e14;
IEQ#8,(15),fail_e15;
PRINT"operation 0x";
#0<=#9;
&phex;
PRINT" holds a number that is not finite";
>fail_end;
fail_e1:
PRINT"the file is too short to be a QOA binary";
>fail_end;
fail_e2:
PRINT"this binary was built by QOA 0.3.x, whose format is not supported; recompile the .qoa source with `qoa compile`";
>fail_end;
fail_e3:
PRINT"not a QOA binary (the QOAX header is missing)";
>fail_end;
fail_e4:
PF"binary format version {} is not supported by this QOA (it reads versions 1 to 4)"/#9;
>fail_end;
fail_e5:
PRINT"corrupt QOA binary: the file ends before its SHA-256 checksum";
>fail_end;
fail_e6:
PRINT"corrupt QOA binary: its SHA-256 checksum does not match, so the file was changed or damaged after it was written; build it again from its source";
>fail_end;
fail_e7:
PRINT"the file ends in the middle of the program";
>fail_end;
fail_e8:
PF"a list of {} items does not fit in the rest of the file"/#9;
>fail_end;
fail_e9:
PRINT"unknown ";
&what;
PF" (number {})"/#10;
>fail_end;
fail_e10:
PF"{} where only 0 or 1 fits"/#9;
>fail_end;
fail_e11:
PRINT"a text that is not valid UTF-8";
>fail_end;
fail_e12:
PF"{} unexpected bytes after the program"/#9;
>fail_end;
fail_e14:
PRINT"operation 0x";
#0<=#9;
&phex;
PRINT" (";
&kind;
PRINT") has no QOA text form";
>fail_end;
fail_e15:
#0<=2;
IEQ#10,(2),fail_e15r;
#0<=3;
fail_e15r:
IEQ#0,(2),fail_e15a;
PF"version {} cannot hold QOA 0.4.4 instructions"/#9;
>fail_end;
fail_e15a:
PF"version {} cannot hold QOA 0.4.3 instructions"/#9;
>fail_end;
fail_msgeu:
IEQ#8,(1),fail_u1;
IEQ#8,(2),fail_u2;
IEQ#8,(3),fail_u3;
IEQ#8,(4),fail_u4;
IEQ#8,(5),fail_u5;
IEQ#8,(6),fail_u6;
IEQ#8,(7),fail_u7;
IEQ#8,(8),fail_u8;
IEQ#8,(9),fail_u9;
IEQ#8,(10),fail_u10;
IEQ#8,(11),fail_u11;
IEQ#8,(12),fail_u12;
IEQ#8,(14),fail_u14;
IEQ#8,(15),fail_u15;
PRINT"0x";
#0<=#9;
&phex;
PRINT" eragiketak zenbaki ez-finitu bat du";
>fail_end;
fail_u1:
PRINT"fitxategia laburregia da QOA bitar bat izateko";
>fail_end;
fail_u2:
PRINT"bitar hau QOA 0.3.x-ek sortu zuen, eta haren formatua ez da onartzen; konpilatu berriz .qoa iturburua `qoa compile`-rekin";
>fail_end;
fail_u3:
PRINT"ez da QOA bitar bat (QOAX goiburua falta da)";
>fail_end;
fail_u4:
PF"{}. bertsioko formatu bitarra ez du QOA honek onartzen (1. bertsiotik 4.era irakurtzen ditu)"/#9;
>fail_end;
fail_u5:
PRINT"QOA bitar hondatua: fitxategia bere SHA-256 laburpena baino lehen amaitzen da";
>fail_end;
fail_u6:
PRINT"QOA bitar hondatua: haren SHA-256 laburpena ez dator bat, beraz fitxategia idatzi ondoren aldatu edo hondatu da; eraiki berriz bere iturburutik";
>fail_end;
fail_u7:
PRINT"fitxategia programaren erdian amaitzen da";
>fail_end;
fail_u8:
PF"{} elementuko zerrenda bat ez da fitxategiaren gainerakoan sartzen"/#9;
>fail_end;
fail_u9:
&what;
PF" ezezaguna ({}. zenbakia)"/#10;
>fail_end;
fail_u10:
PF"{} 0 edo 1 bakarrik doan lekuan"/#9;
>fail_end;
fail_u11:
PRINT"utf-8 baliozkoa ez den testu bat";
>fail_end;
fail_u12:
PF"{} byte espero gabe programaren ondoren"/#9;
>fail_end;
fail_u14:
PRINT"0x";
#0<=#9;
&phex;
PRINT" eragiketak (";
&kind;
PRINT") ez du QOA testu-formarik";
>fail_end;
fail_u15:
#0<=2;
IEQ#10,(2),fail_u15r;
#0<=3;
fail_u15r:
IEQ#0,(2),fail_u15a;
PF"{}. bertsioak ezin ditu QOA 0.4.4-ko aginduak izan"/#9;
>fail_end;
fail_u15a:
PF"{}. bertsioak ezin ditu QOA 0.4.3-ko aginduak izan"/#9;
fail_end:
PUTC/(10);
EXIT/1;

; what: R9 = zer den (rtag-en R1) -> haren izena. aldatzen ditu R0
what:
