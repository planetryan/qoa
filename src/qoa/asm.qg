LXP@(#2)<=#3;
#0<=LXP@(#3);
^;
ex_peek_end:
LXP@(#2)<=#3;
#0<=-1;
^;

; ex.skip: karaktere bat aurrera. aldatzen ditu R1, R2
ex_skip:
#1<=53;
#2<=LXP@(#1);
#2_+#31;
LXP@(#1)<=#2;
^;

; ex.failed: -> R1 = 1 errore bat badago. aldatzen ditu R1
ex_failed:
#1<=55;
#1<=LXP@(#1);
^;

ex_expr:
PUSH#8;
&ex_term;
&ex_failed;
INE#1,#30,ex_expr_ret;
#8<=#0;
ex_expr_loop:
&ex_peek;
#1<=43;
IEQ#0,#1,ex_expr_add;
#1<=45;
IEQ#0,#1,ex_expr_sub;
>ex_expr_ret;
ex_expr_add:
&ex_skip;
&ex_term;
&ex_failed;
INE#1,#30,ex_expr_ret;
#8_+#0;
>ex_expr_loop;
ex_expr_sub:
&ex_skip;
&ex_term;
&ex_failed;
INE#1,#30,ex_expr_ret;
#8-=>#0;
>ex_expr_loop;
ex_expr_ret:
#0<=#8;
POP#8;
^;

ex_term:
PUSH#8;
&ex_unary;
&ex_failed;
INE#1,#30,ex_term_ret;
#8<=#0;
ex_term_loop:
&ex_peek;
#1<=42;
IEQ#0,#1,ex_term_mul;
#1<=47;
IEQ#0,#1,ex_term_div;
>ex_term_ret;
ex_term_mul:
&ex_skip;
&ex_unary;
&ex_failed;
INE#1,#30,ex_term_ret;
#8<=#8*#0;
>ex_term_loop;
ex_term_div:
&ex_skip;
&ex_unary;
&ex_failed;
INE#1,#30,ex_term_ret;
INE#0,#30,ex_term_divide;
#0<=3;
&ex_err;
>ex_term_ret;
ex_term_divide:
#8<=#8/#0;
>ex_term_loop;
ex_term_ret:
#0<=#8;
POP#8;
^;

; ex.unary: habiaraketa zenbatu (expr.rs-eko MAX_DEPTH bera) eta ex.signed exekutatu
ex_unary:
#1<=89;
#2<=LXP@(#1);
#2_+#31;
LXP@(#1)<=#2;
IGT#2,(100),ex_unary_deep;
&ex_signed;
#1<=89;
#2<=LXP@(#1);
#2-=>#31;
LXP@(#1)<=#2;
^;
