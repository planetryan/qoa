; ---------------------------------------------------------------- .qx irteera
; pu32 / pu64: R0 = zenbaki osoa -> 4 / 8 byte irteerara (PUTC). aldatzen ditu R0-R3
pu32:
#3<=4;
>pubytes;
pu64:
#3<=8;
pubytes:
#1<=255;
#2<=8;
pubytes_next:
IEQ#3,#30,pubytes_done;
PUSH#0;
#0<=#0&#1;
&qxb;
POP#0;
#0<=#0>>#2;
#3-=>#31;
>pubytes_next;
pubytes_done:
^;

