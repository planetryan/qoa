IEQ#8,#9,decimal_exp;
; e/E, zeinua, digituak (asetuta 10^9-n)
#8_+#31;
#17<=1;
#0<=LXP@(#8);
#1<=43;
IEQ#0,#1,decimal_esign;
#1<=45;
INE#0,#1,decimal_edig;
