#0<=#16-#0;
#3<=#14>>#0;
#5<=#31<<#0;
#5-=>#31;
#4<=#14&#5;
#5<=#0-#31;
#5<=#31<<#5;
#6<=1;
IGT#4,#5,bigdec_rounding;
#6<=-1;
ILT#4,#5,bigdec_rounding;
#6<=0;
IEQ#15,#30,bigdec_rounding;
#6<=1;
