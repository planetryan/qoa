#14_+#16;
bigdec_nobit:
#0<=#12;
&bshr1;
#17-=>#31;
; 2^k: goiko zatian 2^27..2^0, gero berriz 2^27..2^0 behekoan
#0<=28;
IEQ#17,#0,bigdec_lowhalf;
#0<=0.5;
#16<=#16*#0;
>bigdec_bit;
bigdec_lowhalf:
#16<=134217728;
>bigdec_bit;
