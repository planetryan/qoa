; zatiketa bitez bit: D * 2^55-etik behera
#0<=#12;
#1<=55;
&bshl;
#14<=0;
#15<=0;
#16<=134217728;
#17<=56;
bigdec_bit:
IEQ#17,#30,bigdec_round;
#0<=#11;
#1<=#12;
&bcmp;
ILT#0,#30,bigdec_nobit;
