#5<=LXP@(#5);
#6<=#2+#4;
#6<=LXP@(#6);
INE#5,#6,streq_no;
#4_+#31;
>streq_next;
streq_no:
#0<=0;
^;

; findrange: R0, R1 = testua -> R0 = ".." lehenaren posizioa (indizea), edo -1. aldatzen ditu R0-R5
findrange:
#2<=0;
#5<=46;
findrange_next:
