PRINT"(2)";
^;
mexpr_7:
PRINT"unknown name '";
#0<=7;
&mtext;
PRINT"' in expression";
^;
mexpr_8:
PRINT"unexpected '";
#0<=7;
&mchar;
PRINT"' in expression";
^;
mexpr_10:
PRINT"the expression nests more than 100 levels deep";
^;
mexpr_eu:
#1<=1;
IEQ#5,#1,mexpr_eu1;
#1<=2;
IEQ#5,#1,mexpr_eu2;
#1<=3;
IEQ#5,#1,mexpr_eu3;
#1<=4;
IEQ#5,#1,mexpr_eu4;
