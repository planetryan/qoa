STX#1"MCX||q:controls+ q:target|0|0|||MCX controls... target|MCX kontrolak... helburua|";
STX#1"MCZ||q:qubits+|0|0|||MCZ qubits...|MCZ qubitak...|";
STX#1"BELL|ENTANGLEBELL EBELL EB|q:a q:b|0|0|||BELL a b|BELL a b|B";
STX#1"GHZ|ENTANGLEMULTI EMULTI EM|q:qubits+|0|0|||GHZ qubits...|GHZ qubitak...|";
STX#1"CLUSTER|ENTANGLECLUSTER ECLUSTER ECR|q:qubits+|0|0|||CLUSTER qubits...|CLUSTER qubitak...|CL";
STX#1"ESWAP|ENTANGLESWAP ESP|q:a q:b q:c q:d|0|0|||ESWAP a b c d|ESWAP a b c d|";
STX#1"MEASURE|MEAS M QMEAS QM APPLYQNDMEASUREMENT AQND AQAD AQNM|q:qubit d:to?|1|0|||MEASURE qubit [-> to]|MEASURE qubita [-> helmuga]|";
STX#1"MEASUREIN|MEASUREINBASIS MEASB MIB|q:qubit b:basis d:to?|0|0|||MEASUREIN qubit basis [-> to]|MEASUREIN qubita oinarria [-> helmuga]|MI";
STX#1"MEASUREALL|MALL||0|0|||MEASUREALL|MEASUREALL|MA";
STX#1"RESET|RST RSTQ QRESET QR|q:qubit|1|0|||RESET qubit|RESET qubita|";
STX#1"RESETALL|RSTALL RSA||0|0|||RESETALL|RESETALL|RA";
STX#1"TOBASIS|APPLYMEASUREMENTBASISCHANGE AMBC|q:qubit b:basis|1|0|||TOBASIS qubit basis|TOBASIS qubita oinarria|TB";
STX#1"DISPLACE|APPLYDISPLACEMENT ADISP AD|o:mode f:re f:im?|0|0|||DISPLACE mode re [im]|DISPLACE modua re [im]|D";
