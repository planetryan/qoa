; QOA-ren mihiztatzailea, QOAn idatzia (QOA 0.4.8). QOA-k QOA eraikitzen du: programa honek .qoa iturburu
; bat .qx bitar bihurtzen du, `qoa compile`-k bezala, byte berberak idatziz, eta akatsak daudenean errore
; berberak inprimatzen ditu, testu berberarekin, bi hizkuntzetan.
;
;   qoa compile --assembler src/qoa/asm.qoa programa.qoa      (qoa-k iturburua eta izena ematen dizkio)
;   qoa compile --self-hosted programa.qoa                  (qoa binarioan sartutako kopia bera; qoa tools)
;   qoa compile src/qoa/asm.qoa                               (mihiztatzailea bera, rust-en mihiztatzailearekin)
;   qoa run src/qoa/asm.qx --quiet -- programa.qoa < programa.qoa > programa.qx
;
;   src/qoa/asm.qg: programa bera glifo-sintaxian, fitxategi honetatik sortua lerroz lerro
;   (qoa export --to glyph --keep-source src/qoa/asm.qoa); ez editatu eskuz, proba batek bat datozela egiaztatzen du
;
; sarrera: iturburua sarrera estandarrean; 0. argumentua fitxategi-izena da (.qx-an gordetzen da).
; irteera: .qx-a irteera estandarrean; erroreak errore-irteeran, eta EXIT 1.
;
; erregistroen ohitura:
;   R0-R7   argumentuak, emaitzak eta behin-behinekoak: edozein deik alda ditzake
;   R8-R24  deiek gordetzen dituzte: erabiltzen dituen errutinak PUSH/POP egiten ditu
;   R28 hizkuntza (1 euskara, 0 ingelesa)   R29 = -1   R30 = 0   R31 = 1
;
; memoria-mapa (gelaxkak; idatzi gabeak 0):
;   0 HP hurrengo gelaxka librea (ez da inoiz askatzen)
;   1 NAMEP 2 NAMEN fitxategi-izena (byteak)        3 CHP 4 CHN iturburua kode-puntutan
;   5 LINEP 6 NLINES lerroak: [hasiera, amaiera)   7 MAXLEN lerro luzeena
;   8 SPECP 9 NSPECS aginduak (24 gelaxka bakoitza) 10 MNHT 11 MNMASK izen eta ezizenen hash-taula
;   13 LNV eragiketen lerroak 14 NOPS eragiketa-kopurua
;   15 DIAGV diagnostikoak 16 NDIAG                 17 FIXV jauzi-zuzenketak
;   18 LBLHT etiketak 19 HTMASK 20 LNHT etiketa-izenak (1. pasaldia)
;   21 NAMEDHT izendun erregistroak 22 NAMEDV haien ordena   23 LOOPP 24 LOOPN begizta-pila
;   25 DECLQ (-1 ez) 26 DECLMN (-1 ez) 27 DECLMC 28 DECLMD
;   29 MAXQ 30 MAXM 31 MAXB (-1 ez)   32 QREP 33 QLINE 34 QLIMREP
;   35 NEXTQ 36 NEXTC 37 NEXTO   38 FMT (formatua ken 1)   39 CURLINE
;   40 TOKP 41 NTOK uneko lerroaren tokenak   42 SCR1 43 SCR2 44 DIGP lerro-luzerako bufferrak
;   45 BEST 46 NBEST 47 SEQ diagnostiko txikienak   48 FNAMES adierazpenetako izenak
;   49 ALPHAP 50 NALPHA 51 ALNUMP 52 NALNUM unicode-taulak
;   53 EPOS 54 EEND 55 EERR 56 ESRC 57 ESRCN 58 EP1 59 EP2 60 EP3   adierazpenaren egoera
;   61 OCUR 62 OEND 63 OTAIL 64 OHEAD   eragiketen byte-korrontea
;   65 P10 10^0..10^22   66 BIGR 67 BIGD 68 BIGT bigint-ak   69 P2_32 70 N2_32 71 P2_64 72 N2_64
;   73 VALP balioak (eragigai bakoitzeko 4 gelaxka) 74 GRPP taldeak 75 TP 76 NT 77 ABP geziak
;   78 LISTP 79 NLIST   84 CONSTHT konstanteak 85 NEXTR 86 CONSTV haien ordena 87 "value" 88 "->" (forma laburrak)
;   89 EDEPTH adierazpenaren habiaraketa (ex.unary aktiboak)   96 SHA SHA-256-aren egoera (sha.init)
;   1000-tik aurrera: memoria dinamikoa

; ---------------------------------------------------------------- nagusia
main:
#29<=-1;
#30<=0;
#31<=1;
GETLANG#28;
#0<=0;
#1<=1000;
LXP@(#0)<=#1;
&readname;
&readsource;
&decode;
&splitlines;
&setup;
&isaload;
&seal;
#0<=16;
#0<=LXP@(#0);
IGT#0,#30,main_fail;
&pass1;
&fit;
&clash;
&pass2;
&post;
#0<=16;
#0<=LXP@(#0);
IGT#0,#30,main_fail;
&output;
EXIT/0;
main_fail:
&report;
EXIT/1;

; ---------------------------------------------------------------- memoria
; alloc: R0 = gelaxka-kopurua -> R0 = haien hasiera. aldatzen ditu R0-R3
alloc:
#1<=0;
#2<=LXP@(#1);
#3<=#2+#0;
LXP@(#1)<=#3;
#0<=#2;
^;

; vnew: -> R0 = bektore huts baten goiburua [kopurua, lehen zatia, azken zatia, azkenean erabilitakoak].
; zati bakoitza 4096 gelaxka: [hurrengoa, 4095 balio]. aldatzen ditu R0-R5
vnew:
#0<=4;
&alloc;
#4<=#0;
#0<=4096;
&alloc;
#5<=#4+#31;
LXP@(#5)<=#0;
#5_+#31;
LXP@(#5)<=#0;
#0<=#4;
^;

; vpush: R0 = goiburua, R1 = balioa. aldatzen ditu R0-R7
vpush:
#6<=#0;
#7<=#1;
#2<=3;
#2<=#6+#2;
#5<=LXP@(#2);
#3<=4095;
ILT#5,#3,vpush_room;
#0<=4096;
&alloc;
#2<=2;
#2<=#6+#2;
#3<=LXP@(#2);
LXP@(#3)<=#0;
LXP@(#2)<=#0;
#5<=0;
vpush_room:
#2<=2;
#2<=#6+#2;
#3<=LXP@(#2);
#4<=#3+#5;
#4_+#31;
LXP@(#4)<=#7;
#5_+#31;
#2<=3;
#2<=#6+#2;
LXP@(#2)<=#5;
#5<=LXP@(#6);
#5_+#31;
LXP@(#6)<=#5;
^;

; vfirst: R0 = goiburua -> R0 = lehen balioaren helbidea, R1 = zati horren amaiera (erabilitakoen ondoren),
; R2 = geratzen diren balioak. vnext-ekin batera: R0 = uneko helbidea. aldatzen ditu R0-R4
vfirst:
#2<=LXP@(#0);
#3<=#0+#31;
#3<=LXP@(#3);
#0<=#3+#31;
#4<=4096;
#1<=#3+#4;
^;

; vnext: R0 = uneko helbidea, R1 = zatiaren amaiera -> hurrengo balioaren helbidea R0-n (eta R1 eguneratua).
; aldatzen ditu R0, R1, R3, R4
vnext:
#0_+#31;
ILT#0,#1,vnext_ok;
#4<=4096;
#3<=#1-#4;
#3<=LXP@(#3);
#0<=#3+#31;
#1<=#3+#4;
vnext_ok:
^;

; htfind: R0 = taula, R1 = gakoa (kode-puntuak), R2 = luzera, R3 = maskara -> R0 = zirrikituaren helbidea,
; R1 = erregistroa (0 ez badago). erregistroen lehen bi gelaxkak: gakoaren helbidea eta luzera.
; aldatzen ditu R0-R7
htfind:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
#8<=#0;
#9<=#1;
#10<=#2;
#11<=#3;
#4<=0;
#5<=0;
#7<=16777215;
#3<=31;
htfind_h:
IEQ#5,#10,htfind_probe;
#6<=#9+#5;
#6<=LXP@(#6);
#4<=#4*#3;
#4_+#6;
#4<=#4&#7;
#5_+#31;
>htfind_h;
htfind_probe:
#4<=#4&#11;
htfind_next:
#0<=#8+#4;
#1<=LXP@(#0);
IEQ#1,#30,htfind_done;
#2<=LXP@(#1);
#3<=#1+#31;
#3<=LXP@(#3);
INE#3,#10,htfind_skip;
#5<=0;
htfind_cmp:
IEQ#5,#10,htfind_done;
#6<=#2+#5;
#6<=LXP@(#6);
#7<=#9+#5;
#7<=LXP@(#7);
INE#6,#7,htfind_skip;
#5_+#31;
>htfind_cmp;
htfind_skip:
#4_+#31;
#4<=#4&#11;
>htfind_next;
htfind_done:
POP#11;
POP#10;
POP#9;
POP#8;
^;

; ---------------------------------------------------------------- eragiketen byte-korrontea
; zatiak: [hurrengoa, amaiera, 65534 byte]. OCUR hurrengo bytearen helbidea da, OEND zatiaren amaiera

; ostart: lehen zatia sortu. aldatzen ditu R0-R3
ostart:
#0<=65536;
&alloc;
#1<=63;
LXP@(#1)<=#0;
#1<=64;
LXP@(#1)<=#0;
#1<=2;
#2<=#0+#1;
#1<=61;
LXP@(#1)<=#2;
#1<=65536;
#3<=#0+#1;
#1<=62;
LXP@(#1)<=#3;
^;

; ochunk: zati berria; aurrekoaren amaiera gorde. -> R2 = OCUR berria. aldatzen ditu R0-R3
ochunk:
#0<=65536;
&alloc;
#1<=63;
#2<=LXP@(#1);
LXP@(#2)<=#0;
#3<=#2+#31;
#2<=61;
#2<=LXP@(#2);
LXP@(#3)<=#2;
LXP@(#1)<=#0;
#1<=2;
#2<=#0+#1;
#1<=65536;
#3<=#0+#1;
#1<=62;
LXP@(#1)<=#3;
#1<=61;
LXP@(#1)<=#2;
^;

; ob: R0 = byte bat korrontera. aldatzen ditu R0-R3
ob:
#1<=61;
#2<=LXP@(#1);
#3<=62;
#3<=LXP@(#3);
ILT#2,#3,ob_put;
PUSH#0;
&ochunk;
POP#0;
ob_put:
LXP@(#2)<=#0;
#2_+#31;
#1<=61;
LXP@(#1)<=#2;
^;

; oreserve: R0 = byte-kopurua, zati berean jarraian egon behar dutenak -> R0 = lehenaren helbidea.
; aldatzen ditu R0-R4
oreserve:
#1<=61;
#2<=LXP@(#1);
#4<=#2+#0;
#3<=62;
#3<=LXP@(#3);
IGT#4,#3,oreserve_new;
#0<=#2;
^;
oreserve_new:
&ochunk;
#0<=#2;
^;

; ou32: R0 = zenbaki osoa (0..2^32-1) -> 4 byte, txikiena lehenik. aldatzen ditu R0-R7
ou32:
#4<=#0;
#6<=255;
#7<=8;
*4{
#0<=#4&#6;
&ob;
#4<=#4>>#7;
}
^;

; ou64: R0 = zenbaki osoa (0..2^53) -> 8 byte. aldatzen ditu R0-R7
ou64:
#4<=#0;
#6<=255;
#7<=8;
*8{
#0<=#4&#6;
&ob;
#4<=#4>>#7;
}
^;

; ou64hl: R0 = goiko 32 bitak, R1 = beheko 32 bitak -> 8 byte. aldatzen ditu R0-R7
ou64hl:
PUSH#8;
#8<=#0;
#0<=#1;
&ou32;
#0<=#8;
&ou32;
POP#8;
^;

; okind: R0 = enum-aldaera (u32). ou32 bera
okind:
>ou32;

; of64: R0 = x (finitua, ±0 edo ±inf) -> haren 8 byte ieee 754. aldatzen ditu R0-R7
of64:
PUSH#8;
PUSH#9;
PUSH#10;
#8<=0;
#9<=#0;
ILT#0,#30,of64_neg;
INE#0,#30,of64_abs;
; zeroaren zeinua: (±0)^-1 = ±inf
#1<=#0^#29;
IGT#1,#30,of64_zero;
#8<=1;
>of64_zero;
of64_neg:
#8<=1;
#9<=#0*#29;
of64_abs:
#1<=(1.7976931348623157e308);
IGT#9,#1,of64_inf;
; R9 = y * 2^e, 1 <= y < 2
#10<=0;
#2<=4294967296;
#3<=(2.3283064365386963e-10);
#4<=2;
#5<=0.5;
of64_d32:
ILT#9,#2,of64_d1;
#9<=#9*#3;
#6<=32;
#10_+#6;
>of64_d32;
of64_d1:
ILT#9,#4,of64_u32;
#9<=#9*#5;
#10_+#31;
>of64_d1;
of64_u32:
IGT#9,#3,of64_u1;
IEQ#9,#3,of64_u1;
#9<=#9*#2;
#6<=32;
#10-=>#6;
>of64_u32;
of64_u1:
IGT#9,#31,of64_normed;
IEQ#9,#31,of64_normed;
#9<=#9*#4;
#10-=>#31;
>of64_u1;
of64_normed:
#6<=-1022;
ILT#10,#6,of64_sub;
; normala: alborapena e + 1023, zatikia (y - 1) * 2^52
#6<=1023;
#6<=#10+#6;
#9-=>#31;
#7<=4503599627370496;
#9<=#9*#7;
>of64_out;
of64_sub:
; azpinormala: zatikia |x| * 2^1074 = y * 2^(e + 1074)
#7<=1074;
#7<=#10+#7;
of64_sub2:
IEQ#7,#30,of64_subdone;
#9<=#9*#4;
#7-=>#31;
>of64_sub2;
of64_subdone:
#6<=0;
>of64_out;
of64_zero:
#6<=0;
#9<=0;
>of64_out;
of64_inf:
#6<=2047;
#9<=0;
of64_out:
; R6 = alborapena, R9 = zatikia (< 2^52), R8 = zeinua
#10<=#6;
#4<=255;
#5<=8;
*6{
#0<=#9&#4;
&ob;
#9<=#9>>#5;
}
; 6. bytea: zatikiaren 4 bit eta alborapenaren 4 bit baxuenak
#4<=15;
#0<=#9&#4;
#1<=#10&#4;
#4<=16;
#1<=#1*#4;
#0_+#1;
&ob;
; 7. bytea: zeinua eta alborapenaren 7 bit altuenak
#4<=4;
#0<=#10>>#4;
#4<=128;
#1<=#8*#4;
#0_+#1;
&ob;
POP#10;
POP#9;
POP#8;
^;

; obcp: R0 = kode-puntua -> haren utf-8 byteak korrontera. aldatzen ditu R0-R7
obcp:
#1<=128;
ILT#0,#1,ob;
#4<=#0;
#1<=2048;
ILT#4,#1,obcp_2;
#1<=65536;
ILT#4,#1,obcp_3;
#1<=18;
#0<=#4>>#1;
#1<=240;
#0_+#1;
&ob;
#5<=12;
>obcp_tail;
obcp_3:
#1<=12;
#0<=#4>>#1;
#1<=224;
#0_+#1;
&ob;
#5<=6;
>obcp_tail;
obcp_2:
#1<=6;
#0<=#4>>#1;
#1<=192;
#0_+#1;
&ob;
#5<=0;
>obcp_last;
obcp_tail:
; jarraipen-byteak: 10xxxxxx, R5 = desplazamendua
#0<=#4>>#5;
#1<=63;
#0<=#0&#1;
#1<=128;
#0_+#1;
&ob;
#1<=6;
#5-=>#1;
ILT#5,#30,obcp_done;
IEQ#5,#30,obcp_last;
>obcp_tail;
obcp_last:
#1<=63;
#0<=#4&#1;
#1<=128;
#0_+#1;
&ob;
obcp_done:
^;

; u8len: R0 = kode-puntua -> R0 = haren utf-8 byte-kopurua. aldatzen ditu R0, R1
u8len:
#1<=128;
ILT#0,#1,u8len_1;
#1<=2048;
ILT#0,#1,u8len_2;
#1<=65536;
ILT#0,#1,u8len_3;
#0<=4;
^;
u8len_1:
#0<=1;
^;
u8len_2:
#0<=2;
^;
u8len_3:
#0<=3;
^;

; ostr: R0 = kode-puntuen helbidea, R1 = kopurua -> String bincode: u64 byte-luzera eta utf-8 byteak.
; aldatzen ditu R0-R7
ostr:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
#8<=#0;
#9<=#1;
#10<=0;
#11<=0;
ostr_len:
IEQ#11,#9,ostr_write;
#0<=#8+#11;
#0<=LXP@(#0);
&u8len;
#10_+#0;
#11_+#31;
>ostr_len;
ostr_write:
#0<=#10;
&ou64;
#11<=0;
ostr_bytes:
IEQ#11,#9,ostr_done;
#0<=#8+#11;
#0<=LXP@(#0);
&obcp;
#11_+#31;
>ostr_bytes;
ostr_done:
POP#11;
POP#10;
POP#9;
POP#8;
^;

; opbegin: eragiketa berria hasi: haren lerroa gorde eta kopurua handitu. -> R0 = eragiketaren indizea.
; aldatzen ditu R0-R7
opbegin:
#0<=13;
#0<=LXP@(#0);
#1<=39;
#1<=LXP@(#1);
&vpush;
#1<=14;
#0<=LXP@(#1);
#2<=#0+#31;
LXP@(#1)<=#2;
^;

; setv2: programak gutxienez 2. formatua behar du (QOA 0.4.3-ko aginduak). aldatzen ditu R0
setv2:
#0<=38;
#0<=LXP@(#0);
INE#0,#30,setv2_done;
#0<=38;
LXP@(#0)<=#31;
setv2_done:
^;

; setv3: programak 3. formatua behar du (QOA 0.4.4-ko (zenbaki) eragigaiak). aldatzen ditu R0
setv3:
#0<=38;
LXP@(#0)<=2;
^;

; ---------------------------------------------------------------- sarrera
; readname: 0. argumentua (fitxategi-izena) memoriara, byteak. argumenturik ez badago, erabilera azaldu
readname:
ARGC#0;
IGT#0,#30,readname_ok;
STREAM/2;
IEQ#28,#31,readname_eu;
PLN"usage: qoa compile --assembler src/qoa/asm.qoa FILE.qoa (or: qoa run src/qoa/asm.qx --quiet -- FILE.qoa < FILE.qoa > FILE.qx)";
EXIT/2;
readname_eu:
PLN"erabilera: qoa compile --assembler src/qoa/asm.qoa FITXATEGIA.qoa (edo: qoa run src/qoa/asm.qx --quiet -- FITXATEGIA.qoa < FITXATEGIA.qoa > FITXATEGIA.qx)";
EXIT/2;
readname_ok:
#0<=0;
#4<=LXP@(#0);
#0<=1;
LXP@(#0)<=#4;
#5<=0;
#6<=0;
readname_next:
ARGBYTE#0,#6,#5;
IEQ#0,#29,readname_done;
#1<=#4+#5;
LXP@(#1)<=#0;
#5_+#31;
>readname_next;
readname_done:
#0<=2;
LXP@(#0)<=#5;
#1<=#4+#5;
#0<=0;
LXP@(#0)<=#1;
^;

; readsource: sarrera osoa memoriara (byte bat gelaxka bakoitzean). -> SRC: R0 helbidea, gordeta 80/81-n
readsource:
#0<=0;
#4<=LXP@(#0);
#5<=#4;
readsource_next:
GC#0;
IEQ#0,#29,readsource_done;
LXP@(#5)<=#0;
#5_+#31;
>readsource_next;
readsource_done:
#0<=80;
LXP@(#0)<=#4;
#1<=#5-#4;
#0<=81;
LXP@(#0)<=#1;
#0<=0;
LXP@(#0)<=#5;
^;

; decode: utf-8 byteak kode-puntu bihurtu, rust-en from_utf8 bezain zorrotz. baliogabea bada, `qoa compile`-ren
; errore bera: "cannot read X: stream did not contain valid UTF-8"
decode:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
#0<=80;
#8<=LXP@(#0);
#0<=81;
#9<=LXP@(#0);
#9<=#8+#9;
#0<=#9;
#0-=>#8;
#0_+#31;
&alloc;
#10<=#0;
#1<=3;
LXP@(#1)<=#10;
#11<=#10;
decode_next:
IEQ#8,#9,decode_done;
#0<=LXP@(#8);
#8_+#31;
#1<=128;
ILT#0,#1,decode_put;
; lehen bytea: luzera eta bigarrenaren mugak
#1<=194;
ILT#0,#1,decode_bad;
#1<=224;
ILT#0,#1,decode_two;
#1<=240;
ILT#0,#1,decode_three;
#1<=245;
ILT#0,#1,decode_four;
>decode_bad;
decode_two:
#1<=31;
#12<=#0&#1;
#2<=128;
#3<=191;
#4<=0;
>decode_cont;
decode_three:
#1<=15;
#12<=#0&#1;
#2<=128;
#3<=191;
#4<=1;
#1<=224;
INE#0,#1,decode_three2;
#2<=160;
decode_three2:
#1<=237;
INE#0,#1,decode_cont;
#3<=159;
>decode_cont;
decode_four:
#1<=7;
#12<=#0&#1;
#2<=128;
#3<=191;
#4<=2;
#1<=240;
INE#0,#1,decode_four2;
#2<=144;
decode_four2:
#1<=244;
INE#0,#1,decode_cont;
#3<=143;
decode_cont:
; bigarren bytea [R2, R3] tartean, gero R4 jarraipen-byte gehiago 128..191 tartean
IEQ#8,#9,decode_bad;
#0<=LXP@(#8);
#8_+#31;
ILT#0,#2,decode_bad;
IGT#0,#3,decode_bad;
#1<=63;
#0<=#0&#1;
#1<=64;
#12<=#12*#1;
#12_+#0;
decode_more:
IEQ#4,#30,decode_cp;
IEQ#8,#9,decode_bad;
#0<=LXP@(#8);
#8_+#31;
#1<=128;
ILT#0,#1,decode_bad;
#1<=191;
IGT#0,#1,decode_bad;
#1<=63;
#0<=#0&#1;
#1<=64;
#12<=#12*#1;
#12_+#0;
#4-=>#31;
>decode_more;
decode_cp:
#0<=#12;
decode_put:
LXP@(#11)<=#0;
#11_+#31;
>decode_next;
decode_bad:
STREAM/2;
IEQ#28,#31,decode_eu;
PRINT"error: cannot read ";
&printname;
PLN": stream did not contain valid UTF-8";
EXIT/1;
decode_eu:
PRINT"errorea: ezin da ";
&printname;
PLN" irakurri: stream did not contain valid UTF-8";
EXIT/1;
decode_done:
#0<=#11-#10;
#1<=4;
LXP@(#1)<=#0;
#0<=0;
LXP@(#0)<=#11;
POP#12;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; splitlines: str::lines() bezala: \n-n banatu, \n aurreko \r bakarra kendu, amaierako \n-k ez du lerro hutsik sortzen
splitlines:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
#0<=3;
#8<=LXP@(#0);
#0<=4;
#9<=LXP@(#0);
#9<=#8+#9;
; \n-ak zenbatu taularen tamainarako
#10<=1;
#1<=#8;
#2<=10;
splitlines_count:
IEQ#1,#9,splitlines_alloc;
#0<=LXP@(#1);
#1_+#31;
INE#0,#2,splitlines_count;
#10_+#31;
>splitlines_count;
splitlines_alloc:
#0<=2;
#0<=#10*#0;
&alloc;
#10<=#0;
#1<=5;
LXP@(#1)<=#10;
#11<=0;
#12<=0;
; R8 = lerroaren hasiera, R1 = kurtsorea
#1<=#8;
splitlines_scan:
IEQ#1,#9,splitlines_end;
#0<=LXP@(#1);
#2<=10;
IEQ#0,#2,splitlines_nl;
#1_+#31;
>splitlines_scan;
splitlines_nl:
; lerroa [R8, R1), aurreko \r bat kenduta
#3<=#1;
IEQ#3,#8,splitlines_store;
#4<=#3-#31;
#4<=LXP@(#4);
#2<=13;
INE#4,#2,splitlines_store;
#3-=>#31;
splitlines_store:
#2<=2;
#2<=#11*#2;
#2<=#10+#2;
LXP@(#2)<=#8;
#2_+#31;
LXP@(#2)<=#3;
#4<=#3-#8;
ILT#4,#12,splitlines_short;
#12<=#4;
splitlines_short:
#11_+#31;
#1_+#31;
#8<=#1;
>splitlines_scan;
splitlines_end:
; azken lerroa \n gabe (bere \r-arekin)
IEQ#8,#9,splitlines_done;
#2<=2;
#2<=#11*#2;
#2<=#10+#2;
LXP@(#2)<=#8;
#2_+#31;
LXP@(#2)<=#9;
#4<=#9-#8;
ILT#4,#12,splitlines_short2;
#12<=#4;
splitlines_short2:
#11_+#31;
splitlines_done:
#0<=6;
LXP@(#0)<=#11;
#0<=7;
LXP@(#0)<=#12;
POP#12;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; printname: fitxategi-izena uneko irteerara (byteak). aldatzen ditu R0-R3
printname:
#0<=1;
#1<=LXP@(#0);
#0<=2;
#2<=LXP@(#0);
#2<=#1+#2;
printname_next:
IEQ#1,#2,printname_done;
#0<=LXP@(#1);
PUTC#0;
#1_+#31;
>printname_next;
printname_done:
^;

; setup: bufferrak, hash-taulak, bektoreak eta konstanteak
setup:
PUSH#8;
PUSH#9;
; lerro-luzerako bufferrak: MAXLEN + 64
#0<=7;
#8<=LXP@(#0);
#0<=64;
#8_+#0;
#0<=#8;
&alloc;
#1<=42;
LXP@(#1)<=#0;
#0<=#8;
&alloc;
#1<=43;
LXP@(#1)<=#0;
#0<=#8;
&alloc;
#1<=44;
LXP@(#1)<=#0;
; hash-taulen maskara: 2^k - 1 >= 2 * (lerroak + 1), gutxienez 63
#0<=6;
#8<=LXP@(#0);
#8_+#31;
#8_+#8;
#9<=64;
setup_mask:
IGT#9,#8,setup_masked;
#9_+#9;
>setup_mask;
setup_masked:
#0<=#9-#31;
#1<=19;
LXP@(#1)<=#0;
#0<=#9;
&alloc;
#1<=18;
LXP@(#1)<=#0;
#0<=#9;
&alloc;
#1<=20;
LXP@(#1)<=#0;
#0<=#9;
&alloc;
#1<=21;
LXP@(#1)<=#0;
; begizta-pila: lerro bakoitzeko gehienez bat, 5 gelaxka
#0<=6;
#0<=LXP@(#0);
#0_+#31;
#1<=5;
#0<=#0*#1;
&alloc;
#1<=23;
LXP@(#1)<=#0;
; bektoreak
&vnew;
#1<=13;
LXP@(#1)<=#0;
&vnew;
#1<=15;
LXP@(#1)<=#0;
&vnew;
#1<=17;
LXP@(#1)<=#0;
&vnew;
#1<=22;
LXP@(#1)<=#0;
&ostart;
; egoera: -1 = ez dago
#0<=25;
LXP@(#0)<=#29;
#0<=26;
LXP@(#0)<=#29;
#0<=29;
LXP@(#0)<=#29;
#0<=30;
LXP@(#0)<=#29;
#0<=31;
LXP@(#0)<=#29;
; 10^0 .. 10^22, zehatzak
#0<=23;
&alloc;
#1<=65;
LXP@(#1)<=#0;
#1<=1;
#2<=10;
*23{
LXP@(#0)<=#1;
#1<=#1*#2;
#0_+#31;
}
; bigint-ak: 300 gelaxka bakoitza (24 biteko 299 zati)
#0<=300;
&alloc;
#1<=66;
LXP@(#1)<=#0;
#0<=300;
&alloc;
#1<=67;
LXP@(#1)<=#0;
#0<=300;
