message_75:
IEQ#28,#31,message_75_eu;
PRINT"a seal is SEAL sha256: followed by 64 hexadecimal digits in lower case; `qoa seal ";
&printname;
PRINT"` writes it";
^;
message_75_eu:
PRINT"zigilu bat SEAL sha256: da eta gero 64 digitu hamaseitar letra txikiz; `qoa seal ";
&printname;
PRINT"`-k idazten du";
^;
message_76:
IEQ#28,#31,message_76_eu;
&printname;
PRINT" was changed after it was sealed: the SHA-256 of the lines above the seal is ";
&sha_hex;
PRINT", the seal says ";
&sealclaim;
PRINT". If the change is yours, seal it again with `qoa seal ";
&printname;
PRINT"`";
^;
message_76_eu:
&printname;
PRINT" aldatu egin da zigilatu ondoren: zigiluaren gaineko lerroen SHA-256-a ";
&sha_hex;
PRINT" da, zigiluak ";
&sealclaim;
PRINT" dio. aldaketa zurea bada, zigilatu berriz `qoa seal ";
&printname;
PRINT"`-rekin";
^;
; sealclaim: zigiluak dioen laburpena (iturburuko 64 byteak). aldatzen ditu R0-R2
sealclaim:
#0<=96;
#0<=LXP@(#0);
#0_+208;
#0<=LXP@(#0);
#1<=64;
>printbytes;
