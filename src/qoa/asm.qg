; mfunc: funtzioaren izena (7. gelaxka: 4 sqrt .. 9 ln). aldatzen ditu R0, R1
mfunc:
#0<=7;
#0<=#6+#0;
#0<=LXP@(#0);
#1<=4;
IEQ#0,#1,mfunc_sqrt;
#1<=5;
IEQ#0,#1,mfunc_sin;
#1<=6;
IEQ#0,#1,mfunc_cos;
#1<=7;
IEQ#0,#1,mfunc_tan;
#1<=8;
