LXP@(#1)<=#0;
; eragigaien balioak eta taldeak: gehienez 8 eragigai
#0<=64;
&alloc;
#1<=73;
LXP@(#1)<=#0;
#0<=32;
&alloc;
#1<=74;
LXP@(#1)<=#0;
; konstanteak: hash-taula [gakoa, luzera, balioa], ordena [izena, luzera, lerroa, zutabea, luzera]
#0<=19;
#0<=LXP@(#0);
#0_+#31;
&alloc;
#1<=84;
LXP@(#1)<=#0;
&vnew;
#1<=86;
LXP@(#1)<=#0;
#0<=0;
#1<=LXP@(#0);
#2<=87;
LXP@(#2)<=#1;
STX#1"value";
#2<=88;
LXP@(#2)<=#1;
STX#1"->";
LXP@(#0)<=#1;
; adierazpenetako izenak
&fnames;
#1<=48;
LXP@(#1)<=#0;
POP#9;
POP#8;
^;

; fnames: adierazpenetako konstante eta funtzioen izenak, 0-z amaituak, ordena honetan (1..9):
; pi tau e sqrt sin cos tan exp ln (π kode-puntu gisa bereizten da, 960). -> R0 = hasiera
fnames:
#0<=0;
#1<=LXP@(#0);
#2<=#1;
STX#1"pi";
STX#1"tau";
STX#1"e";
STX#1"sqrt";
STX#1"sin";
STX#1"cos";
STX#1"tan";
STX#1"exp";
STX#1"ln";
LXP@(#0)<=#1;
#0<=#2;
^;

; ---------------------------------------------------------------- testua
; isws: R0 = kode-puntua -> R0 = 1 unicode-ko White_Space bada (char::is_whitespace), bestela 0. aldatzen ditu R0, R1
isws:
#1<=32;
IEQ#0,#1,isws_yes;
IGT#0,#1,isws_high;
#1<=9;
ILT#0,#1,isws_no;
#1<=13;
IGT#0,#1,isws_no;
>isws_yes;
isws_high:
#1<=133;
ILT#0,#1,isws_no;
IEQ#0,#1,isws_yes;
#1<=160;
IEQ#0,#1,isws_yes;
#1<=5760;
IEQ#0,#1,isws_yes;
#1<=8192;
ILT#0,#1,isws_no;
#1<=8202;
IGT#0,#1,isws_h2;
>isws_yes;
isws_h2:
#1<=8232;
IEQ#0,#1,isws_yes;
#1<=8233;
IEQ#0,#1,isws_yes;
#1<=8239;
IEQ#0,#1,isws_yes;
#1<=8287;
IEQ#0,#1,isws_yes;
#1<=12288;
IEQ#0,#1,isws_yes;
isws_no:
#0<=0;
^;
isws_yes:
#0<=1;
^;

; isdigit: R0 -> R0 = 1 ascii digitua bada. aldatzen ditu R0, R1
isdigit:
#1<=48;
ILT#0,#1,isws_no;
#1<=57;
IGT#0,#1,isws_no;
>isws_yes;

; isalpha: R0 -> R0 = 1 ascii letra bada. aldatzen ditu R0, R1
isalpha:
#1<=65;
ILT#0,#1,isws_no;
#1<=90;
IGT#0,#1,isalpha_low;
>isws_yes;
isalpha_low:
#1<=97;
ILT#0,#1,isws_no;
#1<=122;
IGT#0,#1,isws_no;
>isws_yes;

; isalnum: R0 -> R0 = 1 ascii letra edo digitua bada. aldatzen ditu R0-R2
isalnum:
#2<=#0;
&isdigit;
IEQ#0,#31,isws_yes;
#0<=#2;
>isalpha;

; upper / lower: R0 = kode-puntua -> ascii maiuskula/minuskula. aldatzen ditu R0, R1
upper:
#1<=97;
ILT#0,#1,upper_done;
#1<=122;
IGT#0,#1,upper_done;
#1<=32;
#0-=>#1;
upper_done:
^;
lower:
#1<=65;
ILT#0,#1,lower_done;
#1<=90;
IGT#0,#1,lower_done;
#1<=32;
#0_+#1;
lower_done:
^;

; copyup / copylow: R0 = iturria, R1 = luzera, R2 = helburua: kopia ascii maiuskulaz/minuskulaz.
; aldatzen ditu R0-R6
copyup:
#6<=0;
>copycase;
copylow:
#6<=1;
copycase:
#3<=#0;
#4<=#1;
#5<=#2;
copycase_next:
IEQ#4,#30,copycase_done;
#0<=LXP@(#3);
IEQ#6,#31,copycase_low;
&upper;
>copycase_put;
copycase_low:
&lower;
copycase_put:
LXP@(#5)<=#0;
#3_+#31;
#5_+#31;
#4-=>#31;
>copycase_next;
copycase_done:
^;

; textcopy: R0 = iturria, R1 = luzera -> R0 = kopia iraunkorra memoria dinamikoan. aldatzen ditu R0-R6
textcopy:
#5<=#0;
#6<=#1;
#0<=#1;
#0_+#31;
