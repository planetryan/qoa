#1<=LXP@(#1);
#3<=#4+#2;
LXP@(#3)<=#1;
#2_+#31;
>textcopy_next;
textcopy_done:
#0<=#4;
^;

; streq: R0, R1 = lehen testua; R2, R3 = bigarrena -> R0 = 1 berdinak badira. aldatzen ditu R0-R6
streq:
INE#1,#3,streq_no;
#4<=0;
streq_next:
