IEQ#5,#1,mexpr_eu8;
IEQ#5,(10),mexpr_eu10;
PRINT"'";
#0<=7;
&mtext;
PRINT"' ez da zenbaki bat";
^;
mexpr_eu1:
PRINT"ustekabeko '";
#0<=7;
&mchar;
PRINT"' '";
#0<=8;
&mtext;
PRINT"' adierazpenean";
^;
mexpr_eu2:
