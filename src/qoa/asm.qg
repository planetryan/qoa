; lookup: R0, R1 = mnemonikoa (kode-puntuak) -> R0 = zehaztapena, edo 0 ez badago (maiuskula/minuskula
; berdin). aldatzen ditu R0-R7
; lookup: R0, R1 = izena -> R0 = zehaztapena (edo 0), izen labur leunak barne. aldatzen ditu R0-R7
lookup:
&lookupraw;
IGT#0,#29,lookup_pos;
#0<=#30-#0;
lookup_pos:
^;

; reserved: R0, R1 = izena -> R0 = zehaztapena 0.4.4-ko izen edo ezizen bat bada (izen labur leunak ez dira
; erreserbatzen: asm.rs-eko isa::reserved bezala), bestela 0. aldatzen ditu R0-R7
reserved:
&lookupraw;
IGT#0,#29,reserved_done;
#0<=0;
reserved_done:
^;

; lookupraw: lookup bezala, baina izen labur leunen zehaztapena negatiboan
lookupraw:
PUSH#8;
#8<=#1;
#2<=42;
#2<=LXP@(#2);
&copyup;
#0<=10;
#0<=LXP@(#0);
#1<=42;
#1<=LXP@(#1);
#2<=#8;
#3<=2047;
&htfind;
#0<=#1;
IEQ#0,#30,lookupraw_done;
#0_+#31;
#0_+#31;
#0<=LXP@(#0);
lookupraw_done:
POP#8;
^;

; builders: buildtext irakurri eta zehaztapen bakoitzari eraikitzailea eman; agindu bizi bakoitzak bat behar du
builders:
PUSH#8;
PUSH#9;
PUSH#10;
&buildtext;
#8<=#0;
builders_next:
#0<=LXP@(#8);
INE#0,#30,builders_byte;
; erregistroen artean 0 bat; bi jarraian amaiera dira
#8_+#31;
#0<=LXP@(#8);
IEQ#0,#30,builders_check;
>builders_next;
builders_byte:
#1<=32;
INE#0,#1,builders_word;
#8_+#31;
>builders_next;
builders_word:
; izena
#9<=#8;
builders_scan:
#0<=LXP@(#8);
#1<=32;
IEQ#0,#1,builders_name;
#8_+#31;
>builders_scan;
builders_name:
#0<=#9;
#1<=#8-#9;
&lookup;
IEQ#0,#30,builders_unknown;
#10<=#0;
#8_+#31;
&buildnum;
#1<=14;
#1<=#10+#1;
LXP@(#1)<=#0;
&buildnum;
#1<=15;
#1<=#10+#1;
LXP@(#1)<=#0;
>builders_next;
builders_unknown:
STREAM/2;
PRINT"src/qoa/asm.qoa: buildtext names an instruction that is not in the table: ";
#0<=#9;
#1<=#8-#9;
&printbytes;
PLN"";
EXIT/70;
builders_check:
; agindu bizi guztiek eraikitzailea dute
#0<=9;
#9<=LXP@(#0);
#0<=8;
#8<=LXP@(#0);
builders_each:
IEQ#9,#30,builders_done;
#0<=5;
#0<=#8+#0;
#0<=LXP@(#0);
IEQ#0,#31,builders_skip;
#0<=14;
#0<=#8+#0;
#0<=LXP@(#0);
INE#0,#30,builders_skip;
STREAM/2;
PRINT"src/qoa/asm.qoa: buildtext has no builder for ";
#0<=LXP@(#8);
#1<=#8+#31;
#1<=LXP@(#1);
&printbytes;
PLN"";
EXIT/70;
builders_skip:
#0<=24;
#8_+#0;
#9-=>#31;
>builders_each;
builders_done:
POP#10;
POP#9;
POP#8;
^;

; buildnum: R8 = kurtsorea -> R0 = hurrengo zenbaki hamartarra (hutsuneak saltatuta), R8 haren ondoren
buildnum:
#0<=LXP@(#8);
#1<=32;
INE#0,#1,buildnum_start;
#8_+#31;
>buildnum;
buildnum_start:
#2<=0;
buildnum_next:
#0<=LXP@(#8);
#1<=48;
ILT#0,#1,buildnum_done;
#1<=57;
IGT#0,#1,buildnum_done;
#1<=48;
#0-=>#1;
#1<=10;
#2<=#2*#1;
#2_+#0;
#8_+#31;
>buildnum_next;
buildnum_done:
#0<=#2;
^;

; printbytes: R0 = helbidea, R1 = luzera -> byteak uneko irteerara. aldatzen ditu R0-R2
printbytes:
#1<=#0+#1;
printbytes_next:
IEQ#0,#1,printbytes_done;
#2<=LXP@(#0);
PUTC#2;
#0_+#31;
>printbytes_next;
printbytes_done:
^;

; printtext: R0 = kode-puntuen helbidea, R1 = kopurua -> uneko irteerara (utf-8). aldatzen ditu R0-R2
printtext:
#1<=#0+#1;
printtext_next:
IEQ#0,#1,printtext_done;
#2<=LXP@(#0);
CO#2;
#0_+#31;
>printtext_next;
printtext_done:
^;

