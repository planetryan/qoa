&ex_skip;
&ex_unary;
; -x zeinu-bita aldatuta: -1 * x (0-tik -0)
#0<=#0*#29;
^;
ex_unary_pos:
&ex_skip;
>ex_unary;

ex_power:
PUSH#8;
&ex_atom;
&ex_failed;
INE#1,#30,ex_power_ret;
#8<=#0;
&ex_peek;
#1<=94;
INE#0,#1,ex_power_ret;
&ex_skip;
&ex_unary;
&ex_failed;
