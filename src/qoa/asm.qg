; uniranges: R0 = testua -> R0 = [a, b] bikoteen taula, R1 = kopurua. aldatzen ditu R0-R7
uniranges:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
#8<=#0;
; bikote-kopurua: '-' bakoitzeko bat
#9<=0;
#1<=#8;
#2<=45;
uniranges_count:
#0<=LXP@(#1);
INE#0,#30,uniranges_c1;
#3<=#1+#31;
#3<=LXP@(#3);
IEQ#3,#30,uniranges_alloc;
uniranges_c1:
INE#0,#2,uniranges_c2;
#9_+#31;
uniranges_c2:
#1_+#31;
>uniranges_count;
uniranges_alloc:
#0<=2;
#0<=#9*#0;
&alloc;
#10<=#0;
#11<=#0;
uniranges_next:
#0<=LXP@(#8);
INE#0,#30,uniranges_num;
#1<=#8+#31;
#1<=LXP@(#1);
IEQ#1,#30,uniranges_done;
uniranges_sep:
#8_+#31;
>uniranges_next;
uniranges_num:
#1<=32;
IEQ#0,#1,uniranges_sep;
#1<=45;
IEQ#0,#1,uniranges_sep;
; zenbaki hamaseitar bat
#2<=0;
uniranges_hex:
#0<=LXP@(#8);
&digitval;
ILT#0,#30,uniranges_put;
#1<=16;
#2<=#2*#1;
#2_+#0;
#8_+#31;
>uniranges_hex;
uniranges_put:
LXP@(#11)<=#2;
#11_+#31;
>uniranges_next;
uniranges_done:
#0<=#10;
#1<=#9;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; inranges: R0 = kode-puntua, R1 = taula, R2 = kopurua -> R0 = 1 tarte batean badago (bilaketa bitarra).
; aldatzen ditu R0-R7
inranges:
#3<=#0;
#4<=0;
#5<=#2;
inranges_loop:
ILT#4,#5,inranges_mid;
#0<=0;
^;
inranges_mid:
#6<=#4+#5;
#6<=#6>>#31;
#7<=#6+#6;
#7<=#1+#7;
#0<=LXP@(#7);
ILT#3,#0,inranges_left;
#7_+#31;
#0<=LXP@(#7);
IGT#3,#0,inranges_right;
#0<=1;
^;
inranges_left:
#5<=#6;
>inranges_loop;
inranges_right:
#4<=#6+#31;
>inranges_loop;

; isletter: R0 -> R0 = 1 char::is_alphabetic bada. aldatzen ditu R0-R7
isletter:
#1<=128;
ILT#0,#1,isalpha;
#1<=50;
#1<=LXP@(#1);
IGT#1,#30,isletter_ready;
PUSH#0;
&alphatext;
&uniranges;
#2<=49;
LXP@(#2)<=#0;
#2<=50;
LXP@(#2)<=#1;
POP#0;
isletter_ready:
#1<=49;
#1<=LXP@(#1);
#2<=50;
#2<=LXP@(#2);
>inranges;

; isalnumu: R0 -> R0 = 1 char::is_alphanumeric bada. aldatzen ditu R0-R7
isalnumu:
#1<=128;
ILT#0,#1,isalnum;
#1<=52;
#1<=LXP@(#1);
IGT#1,#30,isalnumu_ready;
PUSH#0;
&alnumtext;
&uniranges;
#2<=51;
LXP@(#2)<=#0;
#2<=52;
LXP@(#2)<=#1;
POP#0;
isalnumu_ready:
#1<=51;
#1<=LXP@(#1);
#2<=52;
#2<=LXP@(#2);
>inranges;

; ---------------------------------------------------------------- diagnostikoak
; diagnostiko bakoitza (24 gelaxka): 0 lerroa 1 zutabea 2 luzera 3 mezua 4-13 parametroak (p0..p9)
; 14 laguntza 15-18 laguntzaren parametroak (h0..h3) 19 sekuentzia. testu-parametroak bikoteak dira
; [helbidea, luzera], kopia iraunkorrak

; diagat: R0 = lerroa, R1 = zutabea, R2 = luzera, R3 = mezua -> R0 = diagnostikoa. aldatzen ditu R0-R7
diagat:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
#8<=#0;
#9<=#1;
#10<=#2;
#11<=#3;
#0<=24;
&alloc;
LXP@(#0)<=#8;
#1<=#0+#31;
LXP@(#1)<=#9;
#1_+#31;
LXP@(#1)<=#10;
#1_+#31;
LXP@(#1)<=#11;
#1<=47;
#2<=LXP@(#1);
#3<=#2+#31;
LXP@(#1)<=#3;
#1<=19;
#1<=#0+#1;
LXP@(#1)<=#2;
#8<=#0;
#0<=15;
#0<=LXP@(#0);
#1<=#8;
&vpush;
#0<=16;
#1<=LXP@(#0);
#1_+#31;
LXP@(#0)<=#1;
#0<=#8;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; diagtok: R0 = tokena, R1 = mezua -> R0 = diagnostikoa uneko lerroan, tokenaren zutabean, luzera
; max(karaktereak, 1). aldatzen ditu R0-R7
diagtok:
#3<=#1;
#1<=#0+#31;
#2<=LXP@(#1);
IGT#2,#30,diagtok_len;
#2<=1;
diagtok_len:
#1_+#31;
#1<=LXP@(#1);
#0<=39;
#0<=LXP@(#0);
>diagat;

; diagtext: R0 = tokena, R1 = mezua -> diagtok, eta tokenaren testua p0-p1-en. aldatzen ditu R0-R7
diagtext:
PUSH#8;
PUSH#9;
#9<=#0;
&diagtok;
#8<=#0;
#0<=LXP@(#9);
#1<=#9+#31;
#1<=LXP@(#1);
&textcopy;
#2<=4;
#2<=#8+#2;
