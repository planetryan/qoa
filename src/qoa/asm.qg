; mtext: R0 = gelaxka -> R6-ko testu-parametroa (kode-puntuak). aldatzen ditu R0-R3
mtext:
#3<=#6+#0;
#0<=LXP@(#3);
#3_+#31;
#1<=LXP@(#3);
>printtext;

; mbytes: R0 = gelaxka -> byteen parametroa (taulako izena). aldatzen ditu R0-R3
mbytes:
#3<=#6+#0;
#0<=LXP@(#3);
#3_+#31;
#1<=LXP@(#3);
>printbytes;

; mnum: R0 = gelaxka -> zenbakia (osoak hamartarrik gabe, besteak rust-ek bezala). aldatzen ditu R0
mnum:
#0<=#6+#0;
#0<=LXP@(#0);
PF"{}"/#0;
^;

; mchar: R0 = gelaxka -> karaktere bat (kode-puntua; r erregistroa R gisa). aldatzen ditu R0
mchar:
#0<=#6+#0;
#0<=LXP@(#0);
INE#0,(114),mchar_out;
#0<=82;
mchar_out:
CO#0;
^;

; mquote: komatxo bikoitza. aldatzen ditu R0
mquote:
#0<=34;
PUTC#0;
^;

; mspec: R0 = gelaxka -> agindu-zehaztapenaren izena. aldatzen ditu R0-R3
mspec:
#0<=#6+#0;
#3<=LXP@(#0);
#0<=LXP@(#3);
#1<=#3+#31;
#1<=LXP@(#1);
>printbytes;

; mreason / musage: R0 = gelaxka -> zehaztapenaren kentze-arrazoia / erabilera, uneko hizkuntzan. aldatzen ditu R0-R3
mreason:
#2<=6;
>mspectext;
musage:
#2<=10;
mspectext:
#0<=#6+#0;
#3<=LXP@(#0);
INE#28,#31,mspectext_en;
#0<=2;
#2_+#0;
mspectext_en:
#3_+#2;
#0<=LXP@(#3);
#1<=#3+#31;
#1<=LXP@(#1);
>printbytes;

; mwhat: R0 = gelaxka -> "QINIT" (0) edo "QMODE" (1). aldatzen ditu R0
mwhat:
#0<=#6+#0;
#0<=LXP@(#0);
IEQ#0,#30,mwhat_q;
PRINT"QMODE";
^;
mwhat_q:
PRINT"QINIT";
^;

; mexpected: beharrezkoak (5) eta guztiak (6): "2" edo "1-2". aldatzen ditu R0-R2
mexpected:
#0<=5;
#0<=#6+#0;
#1<=LXP@(#0);
#0_+#31;
#2<=LXP@(#0);
IEQ#1,#2,mexpected_one;
PF"{}-{}"/#1,#2;
^;
mexpected_one:
PF"{}"/#1;
^;

; mu64at: R0 = gelaxka -> u64 zenbakia (goikoak, behekoak). aldatzen ditu R0-R5
mu64at:
#2<=#6+#0;
#0<=LXP@(#2);
#2_+#31;
#1<=LXP@(#2);
; mu64: R0 = goikoak, R1 = behekoak -> zenbaki hamartarra (100-119 gelaxkak). aldatzen ditu R0-R5
mu64:
IGT#0,#30,mu64_big;
PF"{}"/#1;
^;
mu64_big:
#4<=0;
mu64_loop:
#2<=10;
#3<=#0/#2;
#5<=0;
#3<=#3>>#5;
#5<=#3*#2;
#5<=#0-#5;
#2<=4294967296;
#5<=#5*#2;
#5_+#1;
#2<=10;
#1<=#5/#2;
#0<=0;
#1<=#1>>#0;
#0<=#1*#2;
#5-=>#0;
#0<=100;
#0_+#4;
LXP@(#0)<=#5;
#4_+#31;
#0<=#3;
IGT#0,#30,mu64_loop;
IGT#1,#30,mu64_loop;
mu64_print:
#4-=>#31;
#0<=100;
#0_+#4;
#0<=LXP@(#0);
#2<=48;
#0_+#2;
PUTC#0;
IGT#4,#30,mu64_print;
^;

; mexpr: adierazpenaren errorea (6 kodea, 7.. parametroak), expr.rs-en testuekin. aldatzen ditu R0-R5
mexpr:
#0<=6;
#0<=#6+#0;
#5<=LXP@(#0);
IEQ#28,#31,mexpr_eu;
#1<=1;
IEQ#5,#1,mexpr_1;
#1<=2;
