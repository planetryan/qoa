#3<=#0;
#4<=#1;
#5<=0;
islabel_next:
IEQ#5,#4,isws_yes;
#0<=#3+#5;
#0<=LXP@(#0);
#1<=95;
IEQ#0,#1,islabel_ok;
#1<=46;
IEQ#0,#1,islabel_ok;
IEQ#5,#30,islabel_first;
&isalnum;
IEQ#0,#30,streq_no;
>islabel_ok;
islabel_first:
&isalpha;
IEQ#0,#30,streq_no;
islabel_ok:
#5_+#31;
>islabel_next;

; parseu32: R0, R1 = testua -> R0 = 1 eta R1 = balioa, `str::parse::<u32>()` bezala (aukerako '+',
; digituak, gainezkarik gabe); bestela R0 = 0. aldatzen ditu R0-R6
parseu32:
&parsedec;
IEQ#0,#30,parseu32_done;
IGT#1,#30,streq_no;
parseu32_done:
#1<=#2;
^;

; parsedec: R0, R1 = testua -> R0 = 1, R1 = goiko 32 bitak, R2 = behekoak, `u64` hamartar bezala; bestela
; R0 = 0. aldatzen ditu R0-R6
parsedec:
#5<=10;
>parseradix;
; parsehex: R0, R1 = testua -> `u64::from_str_radix(_, 16)` bezala. aldatzen ditu R0-R6
parsehex:
#5<=16;
parseradix:
PUSH#8;
PUSH#9;
PUSH#10;
#3<=#0;
#4<=#1;
IEQ#4,#30,parseradix_bad;
#0<=LXP@(#3);
#1<=43;
INE#0,#1,parseradix_start;
#3_+#31;
#4-=>#31;
IEQ#4,#30,parseradix_bad;
parseradix_start:
#8<=0;
#9<=0;
parseradix_next:
IEQ#4,#30,parseradix_ok;
#0<=LXP@(#3);
&digitval;
ILT#0,#30,parseradix_bad;
ILT#0,#5,parseradix_digit;
>parseradix_bad;
parseradix_digit:
; (R8, R9) = (R8, R9) * oinarria + digitua, 32 biteko bi zatitan
#9<=#9*#5;
#9_+#0;
#1<=4294967296;
#2<=32;
#10<=#9>>#2;
#2<=#10*#1;
#9-=>#2;
#8<=#8*#5;
#8_+#10;
ILT#8,#1,parseradix_fits;
>parseradix_bad;
parseradix_fits:
#3_+#31;
#4-=>#31;
>parseradix_next;
parseradix_ok:
#0<=1;
#1<=#8;
#2<=#9;
POP#10;
POP#9;
POP#8;
^;
parseradix_bad:
#0<=0;
POP#10;
POP#9;
POP#8;
^;

; digitval: R0 = kode-puntua -> R0 = haren balioa digitu hamaseitar gisa (0..15), edo -1. aldatzen ditu R0, R1
digitval:
#1<=48;
ILT#0,#1,digitval_no;
#1<=57;
IGT#0,#1,digitval_alpha;
#1<=48;
#0-=>#1;
^;
digitval_alpha:
&lower;
#1<=97;
ILT#0,#1,digitval_no;
#1<=102;
IGT#0,#1,digitval_no;
#1<=87;
#0-=>#1;
^;
digitval_no:
#0<=-1;
^;

; parseint: R0, R1 = testua -> asm.rs-ko parse_int: "0x"/"0X" hamaseitarra, bestela hamartarra (u64).
; R0 = 1, R1 = goikoak, R2 = behekoak; edo R0 = 0. aldatzen ditu R0-R6
parseint:
#2<=2;
ILT#1,#2,parsedec;
#2<=LXP@(#0);
#3<=48;
INE#2,#3,parsedec;
#2<=#0+#31;
#2<=LXP@(#2);
#3<=120;
IEQ#2,#3,parseint_hex;
#3<=88;
INE#2,#3,parsedec;
parseint_hex:
#2<=2;
#0_+#2;
#1-=>#2;
>parsehex;

; ---------------------------------------------------------------- lerroak eta tokenak
; stripcomment: R0 = lerroaren hasiera, R1 = amaiera -> R0 = iruzkinaren hasiera (edo amaiera).
; byteka, asm.rs bezala: komatxo bakoitzak testu-egoera aldatzen du. aldatzen ditu R0-R5
stripcomment:
#2<=#0;
#3<=0;
stripcomment_next:
IEQ#2,#1,stripcomment_end;
#4<=LXP@(#2);
#5<=34;
INE#4,#5,stripcomment_other;
#3<=#31-#3;
>stripcomment_skip;
stripcomment_other:
IEQ#3,#31,stripcomment_skip;
#5<=59;
IEQ#4,#5,stripcomment_here;
#5<=35;
IEQ#4,#5,stripcomment_here;
#5<=47;
INE#4,#5,stripcomment_skip;
#4<=#2+#31;
IEQ#4,#1,stripcomment_skip;
#4<=LXP@(#4);
IEQ#4,#5,stripcomment_here;
stripcomment_skip:
#2_+#31;
>stripcomment_next;
stripcomment_here:
#0<=#2;
^;
stripcomment_end:
#0<=#1;
^;

; tokenize: R0 = hasiera, R1 = amaiera (iruzkinik gabe) -> tokenak TOKP/NTOK-en ([testua, luzera, zutabea]
; bakoitza). R0 = 0 ondo; 1 testu batek amaierako komatxoa falta badu, eta R1 = haren zutabea.
; aldatzen ditu R0-R7
tokenize:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
PUSH#13;
#8<=#0;
#9<=#1;
#0<=#9-#8;
#0_+#31;
#1<=3;
#0<=#0*#1;
&alloc;
#1<=40;
LXP@(#1)<=#0;
#10<=#0;
#11<=0;
#12<=#8;
tokenize_next:
IEQ#12,#9,tokenize_done;
#0<=LXP@(#12);
#1<=44;
IEQ#0,#1,tokenize_sep;
&isws;
IEQ#0,#30,tokenize_start;
tokenize_sep:
#12_+#31;
>tokenize_next;
tokenize_start:
#13<=#12;
#0<=LXP@(#12);
#1<=34;
IEQ#0,#1,tokenize_string;
#1<=45;
INE#0,#1,tokenize_word;
#2<=#12+#31;
IEQ#2,#9,tokenize_word;
#2<=LXP@(#2);
#1<=62;
INE#2,#1,tokenize_word;
#1<=2;
#12_+#1;
>tokenize_push;
tokenize_string:
#12_+#31;
tokenize_sloop:
ILT#12,#9,tokenize_sin;
>tokenize_unterminated;
tokenize_sin:
#0<=LXP@(#12);
#1<=34;
IEQ#0,#1,tokenize_sclose;
#1<=92;
INE#0,#1,tokenize_sstep;
#12_+#31;
tokenize_sstep:
#12_+#31;
>tokenize_sloop;
tokenize_sclose:
#12_+#31;
>tokenize_push;
tokenize_word:
; parentesien sakonera: 0-n bakarrik bereizten dute hutsuneek, komek eta -> geziak
#7<=0;
tokenize_wloop:
IEQ#12,#9,tokenize_push;
#0<=LXP@(#12);
#1<=40;
INE#0,#1,tokenize_wclose;
#7_+#31;
>tokenize_wstep;
tokenize_wclose:
#1<=41;
INE#0,#1,tokenize_wsep;
#7-=>#31;
>tokenize_wstep;
tokenize_wsep:
INE#7,#30,tokenize_wstep;
#1<=44;
IEQ#0,#1,tokenize_push;
#1<=45;
INE#0,#1,tokenize_wws;
#2<=#12+#31;
IEQ#2,#9,tokenize_wws;
#2<=LXP@(#2);
#1<=62;
IEQ#2,#1,tokenize_push;
tokenize_wws:
PUSH#7;
&isws;
POP#7;
IEQ#0,#31,tokenize_push;
tokenize_wstep:
#12_+#31;
>tokenize_wloop;
tokenize_push:
#1<=3;
#1<=#11*#1;
#1<=#10+#1;
LXP@(#1)<=#13;
#1_+#31;
#2<=#12-#13;
LXP@(#1)<=#2;
#1_+#31;
#2<=#13-#8;
#2_+#31;
LXP@(#1)<=#2;
#11_+#31;
>tokenize_next;
tokenize_done:
#1<=41;
LXP@(#1)<=#11;
&shortforms;
#0<=0;
>tokenize_ret;
tokenize_unterminated:
#1<=41;
LXP@(#1)<=#11;
#0<=1;
#1<=#13-#8;
#1_+#31;
tokenize_ret:
POP#13;
POP#12;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; ---------------------------------------------------------------- forma laburrak (0.4.5)
; shortforms: asm.rs-eko short_forms bezala, tokenetan: agindu bat bere lehen eragigaiari itsatsita (`Hq0`,
; `SETR1 5`), eragigai hori mota horretako erregistro arrunta bada, eta emaitza bideratzen duten aginduetan `.`
; `->`-ren ordez (`M q0.c0`). aldatzen ditu R0-R7
shortforms:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
PUSH#13;
PUSH#14;
#0<=40;
#8<=LXP@(#0);
#0<=41;
#9<=LXP@(#0);
IEQ#9,#30,sf_done;
#10<=0;
#0<=LXP@(#8);
#1<=#8+#31;
#1<=LXP@(#1);
&endscolon;
IEQ#0,#30,sf_at;
#10<=1;
sf_at:
ILT#10,#9,sf_head;
>sf_done;
sf_head:
#11<=#10*3;
#11<=#8+#11;
#0<=LXP@(#11);
#1<=#11+#31;
#1<=LXP@(#1);
&lookup;
INE#0,#30,sf_known;
#0<=LXP@(#11);
#1<=#11+#31;
#1<=LXP@(#1);
&glued;
IEQ#0,#30,sf_known;
; R12 = k: lehen k karaktereak agindua, gainerakoa eragigai berri bat
#12<=#0;
#0<=#10+#31;
&tokins;
#11<=#10*3;
#11<=#8+#11;
#13<=LXP@(#11);
#0<=#11+#31;
#14<=LXP@(#0);
LXP@(#0)<=#12;
#0<=#11+2;
#7<=LXP@(#0);
#1<=#11+3;
#0<=#13+#12;
LXP@(#1)<=#0;
#1_+#31;
#0<=#14-#12;
LXP@(#1)<=#0;
#1_+#31;
#0<=#7+#12;
LXP@(#1)<=#0;
sf_known:
#0<=41;
#9<=LXP@(#0);
#11<=#10*3;
#11<=#8+#11;
#0<=LXP@(#11);
#1<=#11+#31;
#1<=LXP@(#1);
&lookup;
IEQ#0,#30,sf_done;
; bideratzen du: eragigaien artean d mota
#1<=#0+2;
#1<=LXP@(#1);
#2<=#0+3;
#2<=LXP@(#2);
sf_kinds:
IEQ#2,#30,sf_done;
#0<=LXP@(#1);
IEQ#0,(100),sf_routes;
#1_+5;
#2-=>#31;
>sf_kinds;
sf_routes:
#1<=#10+#31;
ILT#1,#9,sf_ascan;
>sf_done;
; at-en ondoren -> tokenik ez
sf_ascan:
IEQ#1,#9,sf_split;
#2<=#1*3;
#2<=#8+#2;
#3<=#2+#31;
#3<=LXP@(#3);
INE#3,(2),sf_anext;
#3<=LXP@(#2);
#4<=LXP@(#3);
INE#4,(45),sf_anext;
#3_+#31;
#4<=LXP@(#3);
IEQ#4,(62),sf_done;
sf_anext:
#1_+#31;
>sf_ascan;
; azken tokena `.` bakar batean: aurrekoa, ->, ondorengoa
sf_split:
#11<=#9-#31;
#11<=#11*3;
#11<=#8+#11;
#13<=LXP@(#11);
#0<=#11+#31;
#14<=LXP@(#0);
#0<=#13;
#1<=#14;
&singledot;
IEQ#0,#29,sf_done;
#12<=#0;
#0<=#11+2;
#7<=LXP@(#0);
#6<=#11;
IEQ#12,#30,sf_arrow;
#0<=#11+#31;
LXP@(#0)<=#12;
#6<=#11+3;
sf_arrow:
#0<=88;
#0<=LXP@(#0);
LXP@(#6)<=#0;
#1<=#6+#31;
LXP@(#1)<=2;
#1_+#31;
#0<=#7+#12;
LXP@(#1)<=#0;
#6_+3;
#0<=#12+#31;
IEQ#0,#14,sf_count;
#1<=#13+#0;
LXP@(#6)<=#1;
#1<=#14-#0;
#2<=#6+#31;
LXP@(#2)<=#1;
#1<=#7+#0;
#2_+#31;
LXP@(#2)<=#1;
#6_+3;
sf_count:
#0<=#6-#8;
#0<=#0/3;
#1<=41;
LXP@(#1)<=#0;
sf_done:
POP#14;
POP#13;
POP#12;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; tokins: R0 = j -> tokenak j-tik aurrera posizio bat eskuinera (j-ren kopia bat geratzen da), NTOK + 1.
; aldatzen ditu R0-R5
tokins:
#1<=40;
#1<=LXP@(#1);
#2<=41;
#3<=LXP@(#2);
#4<=#3+#31;
LXP@(#2)<=#4;
tokins_loop:
#3-=>#31;
ILT#3,#0,tokins_done;
#4<=#3*3;
#4<=#1+#4;
#5<=LXP@(#4);
#2<=#4+3;
LXP@(#2)<=#5;
#4_+#31;
#5<=LXP@(#4);
#2<=#4+3;
LXP@(#2)<=#5;
#4_+#31;
#5<=LXP@(#4);
#2<=#4+3;
LXP@(#2)<=#5;
>tokins_loop;
tokins_done:
^;

; singledot: R0, R1 = testua -> R0 = `.` bakar baten posizioa (ez `..` baten zatia), edo -1. aldatzen ditu R0-R4
singledot:
#2<=0;
singledot_next:
IEQ#2,#1,singledot_no;
#3<=#0+#2;
#4<=LXP@(#3);
INE#4,(46),singledot_step;
IEQ#2,#30,singledot_after;
#4<=#3-#31;
#4<=LXP@(#4);
IEQ#4,(46),singledot_step;
singledot_after:
#4<=#2+#31;
IEQ#4,#1,singledot_yes;
#4<=#3+#31;
#4<=LXP@(#4);
IEQ#4,(46),singledot_step;
singledot_yes:
#0<=#2;
^;
singledot_step:
#2_+#31;
>singledot_next;
singledot_no:
#0<=-1;
^;

; glued: R0, R1 = tokena -> R0 = k, lehen k karaktereak agindu bat badira eta gainerakoa haren lehen eragigaiaren
; motako erregistro arrunta (q0) edo tarte bat (q0..q3), aukeran `.` eta helburua ondoren; bestela 0.
; aldatzen ditu R0-R7
glued:
PUSH#8;
PUSH#9;
PUSH#10;
PUSH#11;
PUSH#12;
PUSH#13;
#8<=#0;
#9<=#1;
#2<=0;
glued_ascii:
IEQ#2,#9,glued_start;
#0<=#8+#2;
#0<=LXP@(#0);
IGT#0,(127),glued_no;
#2_+#31;
>glued_ascii;
glued_start:
#10<=#9-#31;
glued_try:
ILT#10,#31,glued_no;
#0<=#8;
#1<=#10;
&lookup;
IEQ#0,#30,glued_step;
#1<=#0+3;
#1<=LXP@(#1);
IEQ#1,#30,glued_step;
#1<=#0+2;
#1<=LXP@(#1);
#11<=LXP@(#1);
; gainerakoa: R12, R13 (`.` bakarra arte)
#12<=#8+#10;
#13<=#9-#10;
#0<=#12;
#1<=#13;
&singledot;
IEQ#0,#29,glued_reg;
#13<=#0;
glued_reg:
#0<=#11;
#1<=#12;
#2<=#13;
&gluereg;
INE#0,#30,glued_yes;
glued_step:
#10-=>#31;
>glued_try;
glued_yes:
#0<=#10;
>glued_ret;
glued_no:
#0<=0;
glued_ret:
POP#13;
POP#12;
POP#11;
POP#10;
POP#9;
POP#8;
^;

; gluereg: R0 = eragigai-mota, R1, R2 = testua -> R0 = 1 mota horretako erregistro bat (q0) edo tarte bat (q0..q3)
; bada. aldatzen ditu R0-R7
gluereg:
PUSH#8;
PUSH#9;
PUSH#10;
#8<=#0;
#9<=#1;
#10<=#2;
; lehen ".."
#3<=0;
gluereg_find:
#4<=#3+#31;
ILT#4,#10,gluereg_look;
>gluereg_whole;
gluereg_look:
#5<=#9+#3;
#6<=LXP@(#5);
INE#6,(46),gluereg_fstep;
#5_+#31;
#6<=LXP@(#5);
IEQ#6,(46),gluereg_range;
gluereg_fstep:
#3_+#31;
>gluereg_find;
gluereg_range:
; [0, R3) eta [R3+2, luzera)
PUSH#3;
#0<=#8;
#1<=#9;
#2<=#3;
#3<=1;
&gluepart;
POP#3;
IEQ#0,#30,gluereg_ret;
#0<=#8;
#1<=#9+#3;
#1_+2;
#2<=#10-#3;
#2-=>2;
#3<=0;
&gluepart;
>gluereg_ret;
gluereg_whole:
#0<=#8;
#1<=#9;
#2<=#10;
#3<=1;
&gluepart;
gluereg_ret:
POP#10;
POP#9;
POP#8;
^;

; gluepart: R0 = mota, R1, R2 = testua, R3 = 1 lehena bada -> R0 = 1 mota horren letra eta digituak badira (edo,
; lehena ez bada, digituak bakarrik). aldatzen ditu R0-R7
gluepart:
IEQ#2,#30,gluepart_no;
#4<=LXP@(#1);
; R5 = letra egokia
#5<=0;
INE#0,(113),gluepart_o;
IEQ#4,(113),gluepart_l;
IEQ#4,(81),gluepart_l;
gluepart_o:
INE#0,(111),gluepart_c;
IEQ#4,(111),gluepart_l;
IEQ#4,(79),gluepart_l;
gluepart_c:
IEQ#0,(99),gluepart_cc;
INE#0,(118),gluepart_r;
gluepart_cc:
IEQ#4,(99),gluepart_l;
IEQ#4,(67),gluepart_l;
gluepart_r:
IEQ#0,(114),gluepart_rr;
IEQ#0,(120),gluepart_rr;
IEQ#0,(118),gluepart_rr;
>gluepart_kind;
gluepart_rr:
IEQ#4,(114),gluepart_l;
IEQ#4,(82),gluepart_l;
>gluepart_kind;
gluepart_l:
#5<=1;
gluepart_kind:
; letrarekin: gutxienez digitu bat; digituarekin (lehena ez bada): onartua
IEQ#5,#30,gluepart_num;
ILT#2,(2),gluepart_no;
>gluepart_digits;
gluepart_num:
INE#3,#30,gluepart_no;
ILT#4,(48),gluepart_no;
IGT#4,(57),gluepart_no;
gluepart_digits:
#6<=1;
gluepart_d:
IEQ#6,#2,gluepart_yes;
#7<=#1+#6;
#7<=LXP@(#7);
ILT#7,(48),gluepart_no;
IGT#7,(57),gluepart_no;
#6_+#31;
>gluepart_d;
gluepart_yes:
#0<=1;
^;
gluepart_no:
#0<=0;
^;

; ---------------------------------------------------------------- agindu-taula
; zehaztapen bakoitza (24 gelaxka): 0 izena 1 luzera 2 eragigaiak 3 kopurua 4 hedapena (q0..q3) 5 kendua
; 6-7 kentzearen arrazoia ingelesez 8-9 euskaraz 10-11 erabilera ingelesez 12-13 euskaraz 14 eraikitzailea
; 15 parametroa 16 ezizenak ([helbidea, luzera] bikoteak) 17 ezizen-kopurua.
; eragigai bakoitza (5 gelaxka): 0 mota (karakterea) 1-2 izena 3 aukerakoa 4 errepikapena (0 bat, 1 bat edo
; gehiago, 2 zero edo gehiago). izen-taulako erregistroak: [gakoa, luzera, zehaztapena]

; isatext: src/isa.rs-eko taula testu gisa memoriara. erregistro bakoitza: izena|ezizenak|eragigaiak|hedapena|
; kendua|arrazoia (en)|arrazoia (eu)|erabilera (en)|erabilera (eu)|izen labur leuna; erregistro hutsak amaitzen
; du. -> R0 = hasiera
isatext:
#0<=0;
#1<=LXP@(#0);
#2<=#1;
; @isa-begin
STX#1"QINIT|QI INITQUBIT IQ QINITQ|i:qubits|0|0|||QINIT qubits|QINIT qubitak|";
STX#1"QMODE|MODES|i:modes i:cutoff?|0|0|||QMODE modes [cutoff]|QMODE moduak [muga]|QO";
STX#1"QREG||w:name i:size i:first?|0|0|||QREG name size [first]|QREG izena size [first]|";
STX#1"CREG||w:name i:size i:first?|0|0|||CREG name size [first]|CREG izena size [first]|";
STX#1"OREG||w:name i:size i:first?|0|0|||OREG name size [first]|OREG izena size [first]|";
STX#1"RREG||w:name i:size i:first?|0|0|||RREG name size [first]|RREG izena size [first]|";
STX#1"CONST||w:name f:value|0|0|||CONST name value|CONST izena balioa|";
STX#1"H|HAD APPLYHADAMARD|q:qubit|1|0|||H qubit|H qubita|";
STX#1"X|APPLYBITFLIP|q:qubit|1|0|||X qubit|X qubita|";
STX#1"Y||q:qubit|1|0|||Y qubit|Y qubita|";
STX#1"Z|APPLYPHASEFLIP|q:qubit|1|0|||Z qubit|Z qubita|";
STX#1"S|APPLYSGATE|q:qubit|1|0|||S qubit|S qubita|";
STX#1"SDG|SDAG|q:qubit|1|0|||SDG qubit|SDG qubita|";
STX#1"T|APPLYTGATE|q:qubit|1|0|||T qubit|T qubita|";
STX#1"TDG|TDAG|q:qubit|1|0|||TDG qubit|TDG qubita|";
STX#1"SX|SQRTX|q:qubit|1|0|||SX qubit|SX qubita|";
STX#1"SXDG|SXDAG|q:qubit|1|0|||SXDG qubit|SXDG qubita|";
STX#1"PHASE|P PHASESHIFT SETPHASE SETP SPH PSE U1|q:qubit f:angle|1|0|||PHASE qubit angle|PHASE qubita angelua|";
STX#1"RX||q:qubit f:angle|1|0|||RX qubit angle|RX qubita angelua|";
STX#1"RY||q:qubit f:angle|1|0|||RY qubit angle|RY qubita angelua|";
STX#1"RZ||q:qubit f:angle|1|0|||RZ qubit angle|RZ qubita angelua|";
STX#1"U|U3|q:qubit f:theta f:phi f:lambda|1|0|||U qubit theta phi lambda|U qubita theta phi lambda|";
STX#1"ROT|APPLYROTATION AR|q:qubit b:axis f:angle|1|0|||ROT qubit axis angle|ROT qubita ardatza angelua|";
STX#1"MROT|APPLYMULTIQUBITROTATION AMQR|b:axis f:angle q:qubits+|0|0|||MROT axis angle qubits...|MROT ardatza angelua qubitak...|";
STX#1"GATE|APPLYGATE AGATE AG|g:name q:qubit|0|0|||GATE name qubit|GATE izena qubita|G";
STX#1"CNOT|CX CONTROLLEDNOT CN ENTANGLE|q:control q:target|0|0|||CNOT control target|CNOT kontrola helburua|";
STX#1"CY||q:control q:target|0|0|||CY control target|CY kontrola helburua|";
STX#1"CZ||q:control q:target|0|0|||CZ control target|CZ kontrola helburua|";
STX#1"CH||q:control q:target|0|0|||CH control target|CH kontrola helburua|";
STX#1"CSX||q:control q:target|0|0|||CSX control target|CSX kontrola helburua|";
STX#1"CU|CU3|q:control q:target f:theta f:phi f:lambda|0|0|||CU control target theta phi lambda|CU kontrola helburua theta phi lambda|";
STX#1"CPHASE|CP CONTROLLEDPHASEROTATION APPLYCPHASE CPR CU1|q:control q:target f:angle|0|0|||CPHASE control target angle|CPHASE kontrola helburua angelua|";
STX#1"CRX||q:control q:target f:angle|0|0|||CRX control target angle|CRX kontrola helburua angelua|";
STX#1"CRY||q:control q:target f:angle|0|0|||CRY control target angle|CRY kontrola helburua angelua|";
STX#1"CRZ||q:control q:target f:angle|0|0|||CRZ control target angle|CRZ kontrola helburua angelua|";
STX#1"SWAP||q:a q:b|0|0|||SWAP a b|SWAP a b|";
STX#1"CSWAP|CONTROLLEDSWAP CS FREDKIN|q:control q:a q:b|0|0|||CSWAP control a b|CSWAP kontrola a b|";
