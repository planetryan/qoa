; ---------------------------------------------------------------- adierazpenak
; expr.rs bezala, eragiketa berak ordena berean (ieee 754 bit berberak):
;   expr = term (('+' | '-') term)*     term = unary (('*' | '/') unary)*
;   unary = ('-' | '+') unary | power   power = atom ('^' unary)?
;   atom = zenbakia | konstantea | funtzioa '(' expr ')' | '(' expr ')'
; egoera: EPOS (53) uneko helbidea, EEND (54), EERR (55) errore-kodea (0 ondo), ESRC/ESRCN (56-57) adierazpen
; osoa, EP1 (58) karakterea, EP2-EP3 (59-60) testua. kodeak: 1 ustekabeko karakterea amaieran, 2 ez finitua,
; 3 zeroz zatitzea, 4 goizegi amaitu da, 5 ')' falta, 6 funtzioak parentesiak behar ditu (EP1 = funtzioa),
; 7 izen ezezaguna, 8 ustekabeko karakterea, 9 ez da zenbaki bat, 10 100 maila baino gehiago habiaratuta

; evalexpr: R0, R1 = testua -> R0 = 1 eta R1 = balioa, edo R0 = 0 (EERR eta parametroak)
evalexpr:
#2<=89;
LXP@(#2)<=#30;
#2<=53;
LXP@(#2)<=#0;
#3<=#0+#1;
#2<=54;
LXP@(#2)<=#3;
#2<=55;
LXP@(#2)<=#30;
#2<=56;
LXP@(#2)<=#0;
#2<=57;
LXP@(#2)<=#1;
&ex_expr;
#1<=55;
#1<=LXP@(#1);
INE#1,#30,evalexpr_fail;
PUSH#0;
&ex_peek;
#2<=#0;
POP#0;
IEQ#2,#29,evalexpr_end;
; ustekabeko karakterea amaieran
#1<=58;
LXP@(#1)<=#2;
#1<=55;
#2<=1;
LXP@(#1)<=#2;
>evalexpr_fail;
evalexpr_end:
; finitua: x - x = 0
#1<=#0-#0;
IEQ#1,#30,evalexpr_ok;
#1<=55;
#2<=2;
LXP@(#1)<=#2;
>evalexpr_fail;
evalexpr_ok:
#1<=#0;
#0<=1;
^;
evalexpr_fail:
#0<=0;
^;

; ex.err: R0 = errore-kodea. aldatzen ditu R1
ex_err:
#1<=55;
LXP@(#1)<=#0;
^;

; ex.peek: hutsuneak saltatu -> R0 = hurrengo karakterea, edo -1 amaieran. aldatzen ditu R0-R3
ex_peek:
