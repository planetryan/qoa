STX#1"MODEPHASE|DYNAMICPHASECOMPENSATION DPC DPCMP PHASEROT|o:mode f:angle|0|0|||MODEPHASE mode angle|MODEPHASE modua angelua|PH";
STX#1"KERR|APPLYKERRNONLINEARITY AKNL|o:mode f:kappa f:time?|0|0|||KERR mode kappa [time]|KERR modua kappa [denbora]|K";
STX#1"CROSSKERR|CROSSPHASEMODULATION CPM CPMOD|o:a o:b f:kappa|0|0|||CROSSKERR a b kappa|CROSSKERR a b kappa|XK";
STX#1"BS|BEAMSPLITTER|o:a o:b f:theta f:phi?|0|0|||BS a b theta [phi]|BS a b theta [phi]|";
STX#1"MODESWAP|OPTICALROUTING OROUTE OPTR|o:a o:b|0|0|||MODESWAP a b|MODESWAP a b|MS";
STX#1"ADDPHOTON|PHOTONADDITION PADD PA|o:mode|0|0|||ADDPHOTON mode|ADDPHOTON modua|";
STX#1"SUBPHOTON|APPLYPHOTONSUBTRACTION APSUB APS|o:mode|0|0|||SUBPHOTON mode|SUBPHOTON modua|PS";
STX#1"LOSS|PHOTONLOSS PHOTONLOSSSIMULATE PLS PLSIM SETOPTICALATTENUATION SOATT SOA|o:mode f:probability|0|0|||LOSS mode probability|LOSS modua probabilitatea|L";
STX#1"FOCK||o:mode i:photons|0|0|||FOCK mode photons|FOCK modua fotoiak|F";
