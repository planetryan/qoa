; expect-output: same
; expect-output: 7 49 3 12
; expect-only: 00 11
Q{2}; #C{2};
bell::{ HQ[0]; CXQ[0],Q[1]; };
::bell; MQ.#C;
#1<=#C; ??#C[0]{ #1-=>2; }; !!#C[0]{ #1-=>1; }; #1_+1;
#2<=#1*2; ??#2{ PF"never\n"; };
#2<=#C[0]+#C[1];
#3<=#2-#2; !!#3{ PF"same\n"; };
#4<=7; #5<=#4^2; LXP@(100)<=#4; #6<=LXP@(100); #7<=sqrt(9); #8<=#7*4;
PF"{} {} {} {}\n"%#6%#5%#7%#8;
