; CONST, RREG eta (zenbaki) eragigaiak: erregistro bat zenbaki batekin kargatu gabe
; expect-output: sum=7 dist=12.5 sq=1.4142135623730951 mem=42 pushed=65 total=3
; expect-output: loop=0 1 2 3 4
; expect-output: big
CONST newline 10
CONST half newline/20
CONST letter 65
RREG acc 2
RREG i 1 8
SET acc[0] 3
ADD acc[1] acc[0] (4)
MULR2 (newline) (1.25)
SQRTR3 (2)
ST (42) (100)
LDR4 (100)
PUSH (letter)
POPR5
ADDR6 (half) (2.5)
PF "sum={} dist={} sq={} mem={} pushed={} total={}\n" acc[1] R2 R3 R4 R5 R6
PRINT "loop="
SET i 0
next:
PF "{}" i
ADD i i (1)
IEQ i (5) done
CO (32)
J next
done:
CO (newline)
IGT (newline) (half) yes
PLN "small"
J end
yes:
PLN "big"
end:
