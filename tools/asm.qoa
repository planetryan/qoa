REGSET R0 4
CALL mnum
PRINT ". qubita ez da existitzen: QINIT-ek "
REGSET R0 5
CALL mnum
PRINT " qubit adierazi ditu (q0..q"
REGSET R0 6
CALL mnum
PRINT ")"
RETSUB
message.47:
IFEQ R28 R31 message.47.eu
PRINT "qubit index too large (a state vector cannot hold more than 64 qubits)"
RETSUB
message.47.eu:
PRINT "qubit-indize handiegia (egoera-bektore batek ezin ditu 64 qubit baino gehiago gorde)"
RETSUB
message.48:
IFEQ R28 R31 message.48.eu
PRINT "mode "
REGSET R0 4
CALL mnum
PRINT " does not exist: QMODE declared "
REGSET R0 5
CALL mnum
PRINT " mode(s)"
RETSUB
