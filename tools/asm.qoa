PRINT "expected an index like "
REGSET R0 4
CALL mtext
PRINT "[1] or "
REGSET R0 4
CALL mtext
PRINT "[0..2]"
RETSUB
message.23.eu:
REGSET R0 4
CALL mtext
PRINT "[1] edo "
REGSET R0 4
CALL mtext
PRINT "[0..2] bezalako indize bat espero zen"
RETSUB
