ADDR11 R8 R11
LDR0 R11
ADDR1 R11 R31
LDR1 R1
C lookup
INER0 R30 sf.known
LDR0 R11
ADDR1 R11 R31
LDR1 R1
C glued
IEQR0 R30 sf.known
; R12 = k: lehen k karaktereak agindua, gainerakoa eragigai berri bat
RCR12 R0
ADDR0 R10 R31
C tokins
MULR11 R10 (3)
ADDR11 R8 R11
LDR13 R11
ADDR0 R11 R31
LDR14 R0
STR12 R0
ADDR0 R11 (2)
LDR7 R0
ADDR1 R11 (3)
ADDR0 R13 R12
STR0 R1
ADDR1 R1 R31
SUBR0 R14 R12
STR0 R1
ADDR1 R1 R31
ADDR0 R7 R12
STR0 R1
sf.known:
SETR0 41
LDR9 R0
MULR11 R10 (3)
ADDR11 R8 R11
LDR0 R11
ADDR1 R11 R31
LDR1 R1
C lookup
IEQR0 R30 sf.done
; bideratzen du: eragigaien artean d mota
ADDR1 R0 (2)
LDR1 R1
ADDR2 R0 (3)
LDR2 R2
sf.kinds:
IEQR2 R30 sf.done
LDR0 R1
IEQR0 (100) sf.routes
ADDR1 R1 (5)
SUBR2 R2 R31
J sf.kinds
sf.routes:
ADDR1 R10 R31
ILTR1 R9 sf.ascan
J sf.done
; at-en ondoren -> tokenik ez
