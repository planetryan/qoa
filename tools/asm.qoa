helptext:
REGCOPY R6 R0
REGSET R1 14
ADD R1 R6 R1
LOAD R5 R1
REGSET R1 2
IFEQ R5 R1 helptext.2
REGSET R1 3
IFEQ R5 R1 helptext.3
REGSET R1 8
IFEQ R5 R1 helptext.8
REGSET R1 11
IFEQ R5 R1 helptext.11
REGSET R1 14
IFEQ R5 R1 helptext.14
REGSET R1 24
IFEQ R5 R1 helptext.24
REGSET R1 25
IFEQ R5 R1 helptext.25
REGSET R1 41
IFEQ R5 R1 helptext.41
REGSET R1 42
IFEQ R5 R1 helptext.42
REGSET R1 43
IFEQ R5 R1 helptext.43
REGSET R1 44
IFEQ R5 R1 helptext.44
REGSET R1 45
IFEQ R5 R1 helptext.45
REGSET R1 54
IFEQ R5 R1 helptext.54
REGSET R1 58
IFEQ R5 R1 helptext.58
REGSET R1 60
IFEQ R5 R1 helptext.60
REGSET R1 61
IFEQ R5 R1 helptext.61
REGSET R1 90
IFEQ R5 R1 helptext.90
REGSET R1 124
IFEQ R5 R1 helptext.124
REGSET R1 160
IFEQ R5 R1 helptext.160
RETSUB
helptext.2:
IFEQ R28 R31 helptext.2.eu
PRINT "it was first defined on line "
REGSET R0 15
CALL mnum
RETSUB
helptext.2.eu:
PRINT "lehen aldiz "
REGSET R0 15
CALL mnum
PRINT ". lerroan definitu zen"
RETSUB
helptext.3:
IFEQ R28 R31 helptext.3.eu
PRINT "labels start with a letter or _ and contain letters, digits, _ or ."
RETSUB
helptext.3.eu:
PRINT "etiketak letra batekin edo _-rekin hasten dira, eta letrak, digituak, _ edo . dituzte"
RETSUB
helptext.8:
IFEQ R28 R31 helptext.8.eu
PRINT "since QOA 0.4, QINIT takes the qubit count once (QINIT 3); it no longer allocates one qubit per line"
RETSUB
helptext.8.eu:
PRINT "QOA 0.4-tik aurrera, QINIT-ek qubit-kopurua hartzen du behin (QINIT 3); jada ez du lerro bakoitzeko qubit bat sortzen"
RETSUB
helptext.11:
IFEQ R28 R31 helptext.11.eu
PRINT "for example: QINIT 3"
RETSUB
helptext.11.eu:
PRINT "adibidez: QINIT 3"
RETSUB
helptext.14:
IFEQ R28 R31 helptext.14.eu
PRINT "for example: QMODE 2 6"
RETSUB
helptext.14.eu:
PRINT "adibidez: QMODE 2 6"
RETSUB
helptext.24:
IFEQ R28 R31 helptext.24.eu
PRINT "did you mean "
REGSET R0 15
CALL mspec
PRINT "?"
RETSUB
helptext.24.eu:
REGSET R0 15
CALL mspec
PRINT " esan nahi zenuen?"
RETSUB
helptext.25:
IFEQ R28 R31 helptext.25.eu
REGSET R0 15
CALL mreason
RETSUB
helptext.25.eu:
REGSET R0 15
CALL mreason
RETSUB
helptext.41:
IFEQ R28 R31 helptext.41.eu
PRINT "write a qubit as q3 (or just 3)"
RETSUB
helptext.41.eu:
PRINT "idatzi qubit bat q3 gisa (edo 3 besterik ez)"
RETSUB
helptext.42:
IFEQ R28 R31 helptext.42.eu
PRINT "write an optical mode as o1 (or just 1)"
RETSUB
helptext.42.eu:
PRINT "idatzi modu optiko bat o1 gisa (edo 1 besterik ez)"
RETSUB
helptext.43:
IFEQ R28 R31 helptext.43.eu
PRINT "write a classical bit as c0"
RETSUB
helptext.43.eu:
PRINT "idatzi bit klasiko bat c0 gisa"
RETSUB
helptext.44:
IFEQ R28 R31 helptext.44.eu
PRINT "write a register as R2 (or just 2)"
RETSUB
helptext.44.eu:
PRINT "idatzi erregistro bat R2 gisa (edo 2 besterik ez)"
RETSUB
helptext.45:
IFEQ R28 R31 helptext.45.eu
PRINT "QINIT (line "
REGSET R0 15
CALL mnum
PRINT ") takes the number of qubits; this program needs at least "
REGSET R0 16
CALL mnum
PRINT ". Later uses of missing qubits are not reported again"
RETSUB
helptext.45.eu:
PRINT "QINIT-ek ("
REGSET R0 15
CALL mnum
PRINT ". lerroa) qubit-kopurua hartzen du; programa honek gutxienez "
REGSET R0 16
CALL mnum
PRINT " behar ditu. Falta diren qubiten hurrengo erabilerak ez dira berriz jakinarazten"
RETSUB
helptext.54:
IFEQ R28 R31 helptext.54.eu
PRINT "write a classical bit as c0 or a register as R2"
RETSUB
helptext.54.eu:
PRINT "idatzi bit klasiko bat c0 gisa edo erregistro bat R2 gisa"
RETSUB
helptext.58:
IFEQ R28 R31 helptext.58.eu
PRINT "GATE takes one of: h x y z s sdg t tdg sx sxdg (two-qubit gates have their own instructions)"
RETSUB
helptext.58.eu:
PRINT "GATE-k hauetako bat hartzen du: h x y z s sdg t tdg sx sxdg (bi qubiteko ateek beren agindu propioak dituzte)"
RETSUB
helptext.60:
IFEQ R28 R31 helptext.60.eu
PRINT "raise the cutoff with QMODE"
RETSUB
helptext.60.eu:
PRINT "handitu muga QMODE bidez"
RETSUB
helptext.61:
IFEQ R28 R31 helptext.61.eu
PRINT "route it to a register, e.g. COUNT o0 -> R1"
RETSUB
helptext.61.eu:
PRINT "bideratu erregistro batera, adib. COUNT o0 -> R1"
RETSUB
helptext.90:
IFEQ R28 R31 helptext.90.eu
PRINT "usage: "
REGSET R0 15
CALL musage
RETSUB
helptext.90.eu:
PRINT "erabilera: "
REGSET R0 15
CALL musage
RETSUB
helptext.124:
IFEQ R28 R31 helptext.124.eu
PRINT "`qoa isa` lists every instruction"
RETSUB
helptext.124.eu:
PRINT "`qoa isa`-k agindu guztiak zerrendatzen ditu"
RETSUB
helptext.160:
IFEQ R28 R31 helptext.160.eu
PRINT "declare a larger cutoff, e.g. QMODE 1 16"
RETSUB
helptext.160.eu:
PRINT "adierazi muga handiago bat, adib. QMODE 1 16"
RETSUB

; mtext: R0 = gelaxka -> R6-ko testu-parametroa (kode-puntuak). aldatzen ditu R0-R3
mtext:
ADD R3 R6 R0
LOAD R0 R3
ADD R3 R3 R31
LOAD R1 R3
JUMP printtext

; mbytes: R0 = gelaxka -> byteen parametroa (taulako izena). aldatzen ditu R0-R3
mbytes:
ADD R3 R6 R0
LOAD R0 R3
ADD R3 R3 R31
LOAD R1 R3
JUMP printbytes

; mnum: R0 = gelaxka -> zenbakia (osoak hamartarrik gabe, besteak rust-ek bezala). aldatzen ditu R0
mnum:
ADD R0 R6 R0
LOAD R0 R0
PRINTF "{}" R0
RETSUB

; mchar: R0 = gelaxka -> karaktere bat (kode-puntua; r erregistroa R gisa). aldatzen ditu R0
mchar:
ADD R0 R6 R0
LOAD R0 R0
IFNE R0 (114) mchar.out
REGSET R0 82
mchar.out:
CHAROUT R0
RETSUB

; mquote: komatxo bikoitza. aldatzen ditu R0
mquote:
REGSET R0 34
PUTC R0
RETSUB

; mspec: R0 = gelaxka -> agindu-zehaztapenaren izena. aldatzen ditu R0-R3
mspec:
ADD R0 R6 R0
LOAD R3 R0
LOAD R0 R3
ADD R1 R3 R31
LOAD R1 R1
JUMP printbytes

; mreason / musage: R0 = gelaxka -> zehaztapenaren kentze-arrazoia / erabilera, uneko hizkuntzan. aldatzen ditu R0-R3
mreason:
REGSET R2 6
JUMP mspectext
musage:
REGSET R2 10
mspectext:
ADD R0 R6 R0
LOAD R3 R0
IFNE R28 R31 mspectext.en
REGSET R0 2
ADD R2 R2 R0
mspectext.en:
ADD R3 R3 R2
LOAD R0 R3
ADD R1 R3 R31
LOAD R1 R1
JUMP printbytes

; mwhat: R0 = gelaxka -> "QINIT" (0) edo "QMODE" (1). aldatzen ditu R0
mwhat:
ADD R0 R6 R0
LOAD R0 R0
IFEQ R0 R30 mwhat.q
PRINT "QMODE"
RETSUB
mwhat.q:
PRINT "QINIT"
RETSUB

; mexpected: beharrezkoak (5) eta guztiak (6): "2" edo "1-2". aldatzen ditu R0-R2
mexpected:
REGSET R0 5
ADD R0 R6 R0
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
IFEQ R1 R2 mexpected.one
PRINTF "{}-{}" R1 R2
RETSUB
mexpected.one:
PRINTF "{}" R1
RETSUB

; mu64at: R0 = gelaxka -> u64 zenbakia (goikoak, behekoak). aldatzen ditu R0-R5
mu64at:
ADD R2 R6 R0
LOAD R0 R2
ADD R2 R2 R31
LOAD R1 R2
; mu64: R0 = goikoak, R1 = behekoak -> zenbaki hamartarra (100-119 gelaxkak). aldatzen ditu R0-R5
mu64:
IFGT R0 R30 mu64.big
PRINTF "{}" R1
RETSUB
mu64.big:
REGSET R4 0
mu64.loop:
REGSET R2 10
DIV R3 R0 R2
REGSET R5 0
SHR R3 R3 R5
MUL R5 R3 R2
SUB R5 R0 R5
REGSET R2 4294967296
MUL R5 R5 R2
ADD R5 R5 R1
REGSET R2 10
DIV R1 R5 R2
REGSET R0 0
SHR R1 R1 R0
MUL R0 R1 R2
SUB R5 R5 R0
REGSET R0 100
ADD R0 R0 R4
STORE R5 R0
ADD R4 R4 R31
REGCOPY R0 R3
IFGT R0 R30 mu64.loop
IFGT R1 R30 mu64.loop
mu64.print:
SUB R4 R4 R31
REGSET R0 100
ADD R0 R0 R4
LOAD R0 R0
REGSET R2 48
ADD R0 R0 R2
PUTC R0
IFGT R4 R30 mu64.print
RETSUB

; mexpr: adierazpenaren errorea (6 kodea, 7.. parametroak), expr.rs-en testuekin. aldatzen ditu R0-R5
mexpr:
REGSET R0 6
ADD R0 R6 R0
LOAD R5 R0
IFEQ R28 R31 mexpr.eu
REGSET R1 1
IFEQ R5 R1 mexpr.1
REGSET R1 2
IFEQ R5 R1 mexpr.2
REGSET R1 3
IFEQ R5 R1 mexpr.3
REGSET R1 4
IFEQ R5 R1 mexpr.4
REGSET R1 5
IFEQ R5 R1 mexpr.5
REGSET R1 6
IFEQ R5 R1 mexpr.6
REGSET R1 7
IFEQ R5 R1 mexpr.7
REGSET R1 8
IFEQ R5 R1 mexpr.8
IFEQ R5 (10) mexpr.10
PRINT "'"
REGSET R0 7
CALL mtext
PRINT "' is not a number"
RETSUB
mexpr.1:
PRINT "unexpected '"
REGSET R0 7
CALL mchar
PRINT "' in expression '"
REGSET R0 8
CALL mtext
PRINT "'"
RETSUB
mexpr.2:
PRINT "expression '"
REGSET R0 8
CALL mtext
PRINT "' is not a finite number"
RETSUB
mexpr.3:
PRINT "division by zero in expression"
RETSUB
mexpr.4:
PRINT "expression ended early"
RETSUB
mexpr.5:
PRINT "missing ')' in expression"
RETSUB
mexpr.6:
CALL mfunc
PRINT " needs parentheses, e.g. "
CALL mfunc
PRINT "(2)"
RETSUB
mexpr.7:
PRINT "unknown name '"
REGSET R0 7
CALL mtext
PRINT "' in expression"
RETSUB
mexpr.8:
PRINT "unexpected '"
REGSET R0 7
CALL mchar
PRINT "' in expression"
RETSUB
mexpr.10:
PRINT "the expression nests more than 100 levels deep"
RETSUB
mexpr.eu:
REGSET R1 1
IFEQ R5 R1 mexpr.eu1
REGSET R1 2
IFEQ R5 R1 mexpr.eu2
REGSET R1 3
IFEQ R5 R1 mexpr.eu3
REGSET R1 4
IFEQ R5 R1 mexpr.eu4
REGSET R1 5
IFEQ R5 R1 mexpr.eu5
REGSET R1 6
IFEQ R5 R1 mexpr.eu6
REGSET R1 7
IFEQ R5 R1 mexpr.eu7
REGSET R1 8
IFEQ R5 R1 mexpr.eu8
IFEQ R5 (10) mexpr.eu10
PRINT "'"
REGSET R0 7
CALL mtext
PRINT "' ez da zenbaki bat"
RETSUB
mexpr.eu1:
PRINT "ustekabeko '"
REGSET R0 7
CALL mchar
PRINT "' '"
REGSET R0 8
CALL mtext
PRINT "' adierazpenean"
RETSUB
mexpr.eu2:
PRINT "'"
REGSET R0 8
CALL mtext
PRINT "' adierazpena ez da zenbaki finitu bat"
RETSUB
mexpr.eu3:
PRINT "zeroz zatitzea adierazpenean"
RETSUB
mexpr.eu4:
PRINT "adierazpena goizegi amaitu da"
RETSUB
mexpr.eu5:
PRINT "')' falta da adierazpenean"
RETSUB
mexpr.eu6:
CALL mfunc
PRINT "-k parentesiak behar ditu, adib. "
CALL mfunc
PRINT "(2)"
RETSUB
mexpr.eu7:
PRINT "'"
REGSET R0 7
CALL mtext
PRINT "' izen ezezaguna adierazpenean"
RETSUB
mexpr.eu8:
PRINT "ustekabeko '"
REGSET R0 7
CALL mchar
PRINT "' adierazpenean"
RETSUB
mexpr.eu10:
PRINT "adierazpenak 100 maila baino gehiago ditu bata bestearen barruan"
RETSUB

; mfunc: funtzioaren izena (7. gelaxka: 4 sqrt .. 9 ln). aldatzen ditu R0, R1
mfunc:
REGSET R0 7
ADD R0 R6 R0
LOAD R0 R0
REGSET R1 4
IFEQ R0 R1 mfunc.sqrt
REGSET R1 5
IFEQ R0 R1 mfunc.sin
REGSET R1 6
IFEQ R0 R1 mfunc.cos
REGSET R1 7
IFEQ R0 R1 mfunc.tan
REGSET R1 8
IFEQ R0 R1 mfunc.exp
PRINT "ln"
RETSUB
mfunc.sqrt:
PRINT "sqrt"
RETSUB
mfunc.sin:
PRINT "sin"
RETSUB
mfunc.cos:
PRINT "cos"
RETSUB
mfunc.tan:
PRINT "tan"
RETSUB
mfunc.exp:
PRINT "exp"
RETSUB
