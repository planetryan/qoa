SUBR4 R4 (4)
IGTR4 R29 sha.hex.d
ADDR2 R2 R31
ILTR2 R3 sha.hex.w
RET

; qxb: R0 = .qx-aren byte bat: irteerara eta laburpenera. R0 bakarrik aldatzen du
qxb:
PUTCR0
J sha.byte

; outname: fitxategi-izena .qx-ra (printname bezala, laburpenarekin). aldatzen ditu R0-R2
