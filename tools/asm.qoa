; uniranges: R0 = testua -> R0 = [a, b] bikoteen taula, R1 = kopurua. aldatzen ditu R0-R7
uniranges:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
; bikote-kopurua: '-' bakoitzeko bat
REGSET R9 0
REGCOPY R1 R8
REGSET R2 45
uniranges.count:
LOAD R0 R1
IFNE R0 R30 uniranges.c1
ADD R3 R1 R31
LOAD R3 R3
IFEQ R3 R30 uniranges.alloc
uniranges.c1:
IFNE R0 R2 uniranges.c2
ADD R9 R9 R31
uniranges.c2:
ADD R1 R1 R31
JUMP uniranges.count
uniranges.alloc:
REGSET R0 2
MUL R0 R9 R0
CALL alloc
REGCOPY R10 R0
REGCOPY R11 R0
uniranges.next:
LOAD R0 R8
IFNE R0 R30 uniranges.num
ADD R1 R8 R31
LOAD R1 R1
IFEQ R1 R30 uniranges.done
uniranges.sep:
ADD R8 R8 R31
JUMP uniranges.next
uniranges.num:
REGSET R1 32
IFEQ R0 R1 uniranges.sep
REGSET R1 45
IFEQ R0 R1 uniranges.sep
; zenbaki hamaseitar bat
REGSET R2 0
uniranges.hex:
LOAD R0 R8
CALL digitval
IFLT R0 R30 uniranges.put
REGSET R1 16
MUL R2 R2 R1
ADD R2 R2 R0
ADD R8 R8 R31
JUMP uniranges.hex
uniranges.put:
STORE R2 R11
ADD R11 R11 R31
JUMP uniranges.next
uniranges.done:
REGCOPY R0 R10
REGCOPY R1 R9
POP R11
POP R10
POP R9
POP R8
RETSUB

; inranges: R0 = kode-puntua, R1 = taula, R2 = kopurua -> R0 = 1 tarte batean badago (bilaketa bitarra).
; aldatzen ditu R0-R7
inranges:
REGCOPY R3 R0
REGSET R4 0
REGCOPY R5 R2
inranges.loop:
IFLT R4 R5 inranges.mid
REGSET R0 0
RETSUB
inranges.mid:
ADD R6 R4 R5
SHR R6 R6 R31
ADD R7 R6 R6
ADD R7 R1 R7
LOAD R0 R7
IFLT R3 R0 inranges.left
ADD R7 R7 R31
LOAD R0 R7
IFGT R3 R0 inranges.right
REGSET R0 1
RETSUB
inranges.left:
REGCOPY R5 R6
JUMP inranges.loop
inranges.right:
ADD R4 R6 R31
JUMP inranges.loop

; isletter: R0 -> R0 = 1 char::is_alphabetic bada. aldatzen ditu R0-R7
isletter:
REGSET R1 128
IFLT R0 R1 isalpha
REGSET R1 50
LOAD R1 R1
IFGT R1 R30 isletter.ready
PUSH R0
CALL alphatext
CALL uniranges
REGSET R2 49
STORE R0 R2
REGSET R2 50
STORE R1 R2
POP R0
isletter.ready:
REGSET R1 49
LOAD R1 R1
REGSET R2 50
LOAD R2 R2
JUMP inranges

; isalnumu: R0 -> R0 = 1 char::is_alphanumeric bada. aldatzen ditu R0-R7
isalnumu:
REGSET R1 128
IFLT R0 R1 isalnum
REGSET R1 52
LOAD R1 R1
IFGT R1 R30 isalnumu.ready
PUSH R0
CALL alnumtext
CALL uniranges
REGSET R2 51
STORE R0 R2
REGSET R2 52
STORE R1 R2
POP R0
isalnumu.ready:
REGSET R1 51
LOAD R1 R1
REGSET R2 52
LOAD R2 R2
JUMP inranges

; ---------------------------------------------------------------- diagnostikoak
; diagnostiko bakoitza (24 gelaxka): 0 lerroa 1 zutabea 2 luzera 3 mezua 4-13 parametroak (p0..p9)
; 14 laguntza 15-18 laguntzaren parametroak (h0..h3) 19 sekuentzia. testu-parametroak bikoteak dira
; [helbidea, luzera], kopia iraunkorrak

; diagat: R0 = lerroa, R1 = zutabea, R2 = luzera, R3 = mezua -> R0 = diagnostikoa. aldatzen ditu R0-R7
diagat:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGCOPY R11 R3
REGSET R0 24
CALL alloc
STORE R8 R0
ADD R1 R0 R31
STORE R9 R1
ADD R1 R1 R31
STORE R10 R1
ADD R1 R1 R31
STORE R11 R1
REGSET R1 47
LOAD R2 R1
ADD R3 R2 R31
STORE R3 R1
REGSET R1 19
ADD R1 R0 R1
STORE R2 R1
REGCOPY R8 R0
REGSET R0 15
LOAD R0 R0
REGCOPY R1 R8
CALL vpush
REGSET R0 16
LOAD R1 R0
ADD R1 R1 R31
STORE R1 R0
REGCOPY R0 R8
POP R11
POP R10
POP R9
POP R8
RETSUB

; diagtok: R0 = tokena, R1 = mezua -> R0 = diagnostikoa uneko lerroan, tokenaren zutabean, luzera
; max(karaktereak, 1). aldatzen ditu R0-R7
diagtok:
REGCOPY R3 R1
ADD R1 R0 R31
LOAD R2 R1
IFGT R2 R30 diagtok.len
REGSET R2 1
diagtok.len:
ADD R1 R1 R31
LOAD R1 R1
REGSET R0 39
LOAD R0 R0
JUMP diagat

; diagtext: R0 = tokena, R1 = mezua -> diagtok, eta tokenaren testua p0-p1-en. aldatzen ditu R0-R7
diagtext:
PUSH R8
PUSH R9
REGCOPY R9 R0
CALL diagtok
REGCOPY R8 R0
LOAD R0 R9
ADD R1 R9 R31
LOAD R1 R1
CALL textcopy
REGSET R2 4
ADD R2 R8 R2
STORE R0 R2
ADD R1 R9 R31
LOAD R1 R1
ADD R2 R2 R31
STORE R1 R2
REGCOPY R0 R8
POP R9
POP R8
RETSUB

; dset: R0 = diagnostikoa, R1 = gelaxka (4 = p0, 14 = laguntza, 15 = h0, ...), R2 = balioa. aldatzen ditu R7
dset:
ADD R7 R0 R1
STORE R2 R7
RETSUB

; dtext: R0 = diagnostikoa, R1 = gelaxka, R2 = testua, R3 = luzera -> kopia gelaxka eta hurrengoan.
; aldatzen ditu R0-R7
dtext:
PUSH R8
PUSH R9
PUSH R10
ADD R8 R0 R1
REGCOPY R9 R3
REGCOPY R0 R2
REGCOPY R1 R3
CALL textcopy
STORE R0 R8
ADD R8 R8 R31
STORE R9 R8
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- lehen pasaldia
; QINIT eta QMODE bilatu (gero indizeak berehala egiaztatzeko), izendun erregistroak adierazi, eta etiketa-izenak
; bildu (izen hutsak ez dira erregistro gisa irakurtzen)
pass1:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGSET R8 0
pass1.line:
REGSET R0 6
LOAD R0 R0
IFEQ R8 R0 pass1.done
