REGSET R0 0
JUMP ou64

; patch64: R0 = balioa (< 2^53), R1 = lehen bytearen helbidea -> 8 byte, txikiena lehenik. aldatzen ditu R0-R4
patch64:
REGSET R2 255
REGSET R3 8
LOOPSTART 8
ANDBITS R4 R0 R2
STORE R4 R1
SHR R0 R0 R3
ADD R1 R1 R31
LOOPEND
RETSUB

; gatename: R0, R1 = izena -> R0 = atearen aldaera (Gate::from_name, minuskulaz), edo -1. aldatzen ditu R0-R7
gatename:
PUSH R8
PUSH R9
PUSH R10
REGCOPY R8 R0
REGCOPY R9 R1
REGSET R2 43
LOAD R2 R2
CALL copylow
REGSET R0 0
LOAD R1 R0
REGCOPY R10 R1
STORETEXT R1 "h 0 x 1 not 1 y 2 z 3 s 4 sdg 5 sdag 5 t 6 tdg 7 tdag 7 sx 8 sxdg 9 "
; taula memoria dinamikoan geratzen da: hurrengo esleipenek gelaxka hutsak behar dituzte
STORE R1 R0
gatename.word:
LOAD R0 R10
IFEQ R0 R30 gatename.none
REGCOPY R3 R10
gatename.scan:
LOAD R0 R10
REGSET R1 32
IFEQ R0 R1 gatename.cmp
ADD R10 R10 R31
JUMP gatename.scan
gatename.cmp:
SUB R4 R10 R3
ADD R10 R10 R31
LOAD R5 R10
REGSET R1 48
SUB R5 R5 R1
REGSET R1 2
ADD R10 R10 R1
PUSH R5
REGCOPY R2 R3
REGCOPY R3 R4
REGSET R0 43
LOAD R0 R0
REGCOPY R1 R9
CALL streq
POP R5
IFEQ R0 R31 gatename.found
JUMP gatename.word
gatename.found:
REGCOPY R0 R5
JUMP gatename.ret
gatename.none:
REGSET R0 -1
gatename.ret:
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- amaiera: etiketak, begiztak, zuzenketak
post:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
; erregistro-izen bat ezin da etiketa bat ere izan (`JUMP data` anbiguoa litzateke)
REGSET R0 22
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
post.named:
IFEQ R10 R30 post.loops
LOAD R11 R8
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
CALL lblfind
IFEQ R1 R30 post.nstep
REGSET R0 5
ADD R0 R11 R0
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 4
CALL diagat
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
REGSET R1 4
CALL dtext
post.nstep:
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP post.named
post.loops:
; itxi gabeko begiztak, kanpokoenetik
REGSET R8 0
post.loop:
REGSET R0 24
LOAD R0 R0
IFEQ R8 R0 post.fix
REGSET R0 5
MUL R0 R8 R0
REGSET R1 23
LOAD R1 R1
ADD R0 R1 R0
REGSET R1 2
ADD R0 R0 R1
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 5
CALL diagat
ADD R8 R8 R31
JUMP post.loop
post.fix:
; jauzi-helburuak ebatzi
REGSET R0 17
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
post.fnext:
IFEQ R10 R30 post.done
LOAD R11 R8
ADD R0 R11 R31
LOAD R0 R0
REGSET R1 2
ADD R1 R11 R1
LOAD R1 R1
CALL lblfind
IFEQ R1 R30 post.nolabel
REGSET R0 2
ADD R0 R1 R0
LOAD R0 R0
LOAD R1 R11
CALL patch64
JUMP post.fstep
post.nolabel:
REGSET R0 3
ADD R0 R11 R0
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 6
CALL diagat
ADD R2 R11 R31
LOAD R2 R2
REGSET R3 2
ADD R3 R11 R3
LOAD R3 R3
REGSET R1 4
CALL dtext
post.fstep:
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP post.fnext
post.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- .qx irteera
; pu32 / pu64: R0 = zenbaki osoa -> 4 / 8 byte irteerara (PUTC). aldatzen ditu R0-R3
pu32:
REGSET R3 4
JUMP pubytes
pu64:
REGSET R3 8
pubytes:
REGSET R1 255
REGSET R2 8
pubytes.next:
IFEQ R3 R30 pubytes.done
PUSH R0
ANDBITS R0 R0 R1
PUTC R0
POP R0
SHR R0 R0 R2
SUB R3 R3 R31
JUMP pubytes.next
pubytes.done:
RETSUB

; output: "QOAX", formatuaren bertsioa (1; 2 0.4.3-ko aginduekin; 3 0.4.4-ko (zenbaki) eragigaiekin), eta
; Program bincode-rekin
output:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
STREAM 1
REGSET R0 81
PUTC R0
REGSET R0 79
PUTC R0
REGSET R0 65
PUTC R0
REGSET R0 88
PUTC R0
REGSET R0 38
LOAD R0 R0
ADD R0 R0 R31
PUTC R0
PUTC R30
; name: String
REGSET R0 2
LOAD R0 R0
CALL pu64
CALL printname
; n_qubits, n_modes, cutoff, cutoff_declared, n_bits
REGSET R0 25
LOAD R8 R0
IFNE R8 R29 output.q
REGSET R0 29
LOAD R8 R0
ADD R8 R8 R31
output.q:
REGSET R0 26
LOAD R9 R0
REGSET R10 8
REGSET R11 0
IFEQ R9 R29 output.m
REGSET R0 27
LOAD R10 R0
REGSET R0 28
LOAD R11 R0
JUMP output.bits
output.m:
REGSET R0 30
LOAD R9 R0
ADD R9 R9 R31
output.bits:
REGSET R0 31
LOAD R12 R0
ADD R12 R12 R31
IFLT R8 R12 output.write
REGCOPY R12 R8
output.write:
REGCOPY R0 R8
CALL pu32
REGCOPY R0 R9
CALL pu32
REGCOPY R0 R10
CALL pu32
PUTC R11
REGCOPY R0 R12
CALL pu32
; ops: Vec<Op>
REGSET R0 14
LOAD R0 R0
CALL pu64
REGSET R0 64
LOAD R8 R0
output.chunk:
; zati honen amaiera: azkena bada OCUR, bestela gordetakoa
ADD R9 R8 R31
LOAD R9 R9
REGSET R0 63
LOAD R0 R0
IFNE R8 R0 output.data
REGSET R0 61
LOAD R9 R0
output.data:
REGSET R0 2
ADD R10 R8 R0
output.byte:
IFEQ R10 R9 output.nextchunk
LOAD R0 R10
PUTC R0
ADD R10 R10 R31
JUMP output.byte
output.nextchunk:
LOAD R8 R8
IFNE R8 R30 output.chunk
; lines: Vec<u32>
REGSET R0 14
LOAD R0 R0
CALL pu64
REGSET R0 13
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
output.line:
IFEQ R10 R30 output.done
LOAD R0 R8
CALL pu32
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP output.line
output.done:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- erroreen txostena
; asm.rs bezala: (lerroa, zutabea) ordenan (ordena egonkorra: sortu ziren ordena berdinketetan), gehienez 30,
; gainerakoak lerro batean; gero "N error(s) in IZENA"

; dless: R0, R1 = diagnostikoak -> R0 = 1 lehena lehenago badoa. aldatzen ditu R0-R5
dless:
LOAD R2 R0
LOAD R3 R1
IFLT R2 R3 dless.yes
IFGT R2 R3 dless.no
ADD R2 R0 R31
LOAD R2 R2
ADD R3 R1 R31
LOAD R3 R3
IFLT R2 R3 dless.yes
IFGT R2 R3 dless.no
REGSET R4 19
ADD R2 R0 R4
LOAD R2 R2
ADD R3 R1 R4
LOAD R3 R3
IFLT R2 R3 dless.yes
dless.no:
REGSET R0 0
RETSUB
dless.yes:
REGSET R0 1
RETSUB

report:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
; BEST: 31 txikienak, ordenatuta
REGSET R0 31
CALL alloc
REGCOPY R11 R0
REGSET R12 0
REGSET R0 15
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
report.scan:
IFEQ R10 R30 report.print
LOAD R13 R8
; txertatze-posizioa: atzetik aurrera
REGCOPY R7 R12
report.place:
IFEQ R7 R30 report.put
ADD R0 R11 R7
SUB R0 R0 R31
LOAD R1 R0
REGCOPY R0 R13
PUSH R7
CALL dless
POP R7
IFEQ R0 R30 report.put
; mugitu bat atzera (31. postutik kanpora erortzen bada, galdu)
REGSET R0 31
IFEQ R7 R0 report.shift
ADD R0 R11 R7
SUB R1 R0 R31
LOAD R1 R1
STORE R1 R0
report.shift:
SUB R7 R7 R31
JUMP report.place
report.put:
REGSET R0 31
IFEQ R7 R0 report.skip
ADD R0 R11 R7
STORE R13 R0
REGSET R0 31
IFEQ R12 R0 report.skip
ADD R12 R12 R31
report.skip:
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP report.scan
report.print:
STREAM 2
REGSET R8 0
REGSET R0 30
IFLT R12 R0 report.count
REGCOPY R12 R0
REGSET R0 31
REGSET R1 16
LOAD R1 R1
IFGT R1 R12 report.count
REGSET R12 30
report.count:
; R12 = erakusten direnak (gehienez 30); R13 = 1 laburpen-lerroa behar bada
REGSET R13 0
REGSET R0 16
LOAD R0 R0
REGSET R1 30
IFGT R0 R1 report.more
JUMP report.each
report.more:
REGSET R13 1
report.each:
IFEQ R8 R12 report.summary
ADD R0 R11 R8
LOAD R0 R0
CALL render
ADD R8 R8 R31
JUMP report.each
report.summary:
IFEQ R13 R30 report.total
; `... and N more error(s) not shown`, 31.aren lerroan
REGSET R0 30
ADD R0 R11 R0
LOAD R0 R0
LOAD R0 R0
REGSET R1 1
REGSET R2 0
REGSET R3 7
CALL diagat
REGSET R1 16
LOAD R2 R1
REGSET R1 1
SUB R2 R2 R1
REGSET R1 30
SUB R2 R2 R1
REGSET R1 4
CALL dset
CALL render
report.total:
ADD R0 R12 R13
IFEQ R28 R31 report.eu
PRINTF "{} error(s) in " R0
CALL printname
PRINTLN ""
JUMP report.done
report.eu:
PRINTF "{} errore " R0
CALL printname
PRINTLN " fitxategian"
report.done:
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; render: R0 = diagnostikoa -> asm::render-en formatua
;   error: mezua
;     --> izena:lerroa:zutabea
;      |
;    3 | CNOT q0 q0
;      |         ^^
;     = help: laguntza
render:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
IFEQ R28 R31 render.eu
PRINT "error: "
JUMP render.msg
render.eu:
PRINT "errorea: "
render.msg:
REGCOPY R0 R8
CALL message
PRINTLN ""
PRINT "  --> "
CALL printname
LOAD R9 R8
ADD R10 R8 R31
LOAD R10 R10
PRINTF ":{}:{}\n" R9 R10
; iturburuko lerroa, badago
IFLT R9 R31 render.help
REGSET R0 6
LOAD R0 R0
IFGT R9 R0 render.help
; R11 = lerro-zenbakiaren digituak
REGSET R11 0
REGCOPY R0 R9
REGSET R1 10
render.digits:
ADD R11 R11 R31
DIV R0 R0 R1
REGSET R2 0
SHR R0 R0 R2
IFGT R0 R30 render.digits
PRINT " "
REGCOPY R0 R11
CALL spaces
PRINTLN " |"
PRINTF " {} | " R9
REGSET R0 5
LOAD R0 R0
SUB R1 R9 R31
ADD R1 R1 R1
ADD R0 R0 R1
LOAD R2 R0
ADD R0 R0 R31
LOAD R1 R0
SUB R1 R1 R2
REGCOPY R0 R2
PUSH R2
PUSH R1
CALL printtext
PRINTLN ""
PRINT " "
REGCOPY R0 R11
CALL spaces
PRINT " | "
POP R1
POP R2
; zutabe-1 karaktere: tabulazioak bere horretan, besteak hutsune
SUB R10 R10 R31
IFLT R10 R1 render.pad
REGCOPY R10 R1
render.pad:
IFEQ R10 R30 render.carets
LOAD R0 R2
REGSET R3 9
IFEQ R0 R3 render.tab
PRINT " "
JUMP render.padstep
render.tab:
PUTC R3
render.padstep:
ADD R2 R2 R31
SUB R10 R10 R31
JUMP render.pad
render.carets:
REGSET R0 2
ADD R0 R8 R0
LOAD R10 R0
render.caret:
IFEQ R10 R30 render.caretdone
PRINT "^"
SUB R10 R10 R31
JUMP render.caret
render.caretdone:
PRINTLN ""
render.help:
REGSET R0 14
ADD R0 R8 R0
LOAD R0 R0
IFEQ R0 R30 render.end
IFEQ R28 R31 render.heu
PRINT "  = help: "
JUMP render.hmsg
render.heu:
PRINT "  = laguntza: "
render.hmsg:
REGCOPY R0 R8
CALL helptext
PRINTLN ""
render.end:
PRINTLN ""
POP R11
POP R10
POP R9
POP R8
RETSUB

; spaces: R0 = kopurua -> hainbat hutsune. aldatzen ditu R0
spaces:
IFEQ R0 R30 spaces.done
PRINT " "
SUB R0 R0 R31
JUMP spaces
spaces.done:
RETSUB

; ---------------------------------------------------------------- mezuak
; asm.rs eta expr.rs-eko mezu berberak, bi hizkuntzetan. R6 = diagnostikoa mezu-errutina guztietan

; message / helptext: R0 = diagnostikoa -> haren mezua / laguntza uneko irteerara. aldatzen ditu R0-R6
message:
REGCOPY R6 R0
REGSET R1 3
ADD R1 R6 R1
LOAD R5 R1
REGSET R1 1
IFEQ R5 R1 message.1
REGSET R1 2
IFEQ R5 R1 message.2
REGSET R1 3
IFEQ R5 R1 message.3
REGSET R1 4
IFEQ R5 R1 message.4
REGSET R1 5
IFEQ R5 R1 message.5
REGSET R1 6
IFEQ R5 R1 message.6
REGSET R1 7
IFEQ R5 R1 message.7
REGSET R1 8
IFEQ R5 R1 message.8
REGSET R1 9
IFEQ R5 R1 message.9
REGSET R1 10
IFEQ R5 R1 message.10
REGSET R1 11
IFEQ R5 R1 message.11
REGSET R1 12
IFEQ R5 R1 message.12
REGSET R1 13
IFEQ R5 R1 message.13
REGSET R1 14
IFEQ R5 R1 message.14
REGSET R1 15
IFEQ R5 R1 message.15
REGSET R1 16
IFEQ R5 R1 message.16
REGSET R1 17
IFEQ R5 R1 message.17
REGSET R1 18
IFEQ R5 R1 message.18
REGSET R1 19
IFEQ R5 R1 message.19
REGSET R1 20
IFEQ R5 R1 message.20
REGSET R1 21
IFEQ R5 R1 message.21
REGSET R1 22
IFEQ R5 R1 message.22
REGSET R1 23
IFEQ R5 R1 message.23
REGSET R1 24
IFEQ R5 R1 message.24
REGSET R1 25
IFEQ R5 R1 message.25
REGSET R1 26
IFEQ R5 R1 message.26
REGSET R1 27
IFEQ R5 R1 message.27
REGSET R1 28
IFEQ R5 R1 message.28
REGSET R1 29
IFEQ R5 R1 message.29
REGSET R1 30
IFEQ R5 R1 message.30
REGSET R1 31
IFEQ R5 R1 message.31
REGSET R1 32
IFEQ R5 R1 message.32
REGSET R1 33
IFEQ R5 R1 message.33
REGSET R1 34
IFEQ R5 R1 message.34
REGSET R1 35
IFEQ R5 R1 message.35
REGSET R1 36
IFEQ R5 R1 message.36
REGSET R1 37
IFEQ R5 R1 message.37
REGSET R1 38
IFEQ R5 R1 message.38
REGSET R1 39
IFEQ R5 R1 message.39
REGSET R1 40
IFEQ R5 R1 message.40
REGSET R1 41
IFEQ R5 R1 message.41
REGSET R1 42
IFEQ R5 R1 message.42
REGSET R1 43
IFEQ R5 R1 message.43
REGSET R1 44
IFEQ R5 R1 message.44
REGSET R1 45
IFEQ R5 R1 message.45
REGSET R1 46
IFEQ R5 R1 message.46
REGSET R1 47
IFEQ R5 R1 message.47
REGSET R1 48
IFEQ R5 R1 message.48
REGSET R1 49
IFEQ R5 R1 message.49
REGSET R1 50
IFEQ R5 R1 message.50
REGSET R1 51
IFEQ R5 R1 message.51
REGSET R1 52
IFEQ R5 R1 message.52
REGSET R1 53
IFEQ R5 R1 message.53
REGSET R1 54
IFEQ R5 R1 message.54
REGSET R1 55
IFEQ R5 R1 message.55
REGSET R1 56
IFEQ R5 R1 message.56
REGSET R1 57
IFEQ R5 R1 message.57
REGSET R1 58
IFEQ R5 R1 message.58
REGSET R1 59
IFEQ R5 R1 message.59
REGSET R1 60
IFEQ R5 R1 message.60
REGSET R1 61
IFEQ R5 R1 message.61
REGSET R1 62
IFEQ R5 R1 message.62
REGSET R1 63
IFEQ R5 R1 message.63
REGSET R1 64
IFEQ R5 R1 message.64
REGSET R1 65
IFEQ R5 R1 message.65
REGSET R1 66
IFEQ R5 R1 message.66
REGSET R1 70
IFEQ R5 R1 message.70
REGSET R1 71
IFEQ R5 R1 message.71
REGSET R1 72
IFEQ R5 R1 message.72
REGSET R1 73
IFEQ R5 R1 message.73
REGSET R1 74
IFEQ R5 R1 message.74
RETSUB
message.70:
IFEQ R28 R31 message.70.eu
PRINT "CONST takes a name and a value, like CONST newline 10"
RETSUB
message.70.eu:
PRINT "CONST-ek izen bat eta balio bat hartzen ditu, CONST newline 10 bezala"
RETSUB
message.71:
IFEQ R28 R31 message.71.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' cannot name a constant: use letters, digits and _, not an instruction, an operand like q3, or a constant like pi"
RETSUB
message.71.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' ezin da konstante-izena izan: erabili letrak, digituak eta _, ez agindu bat, q3 bezalako eragigai bat edo pi bezalako konstante bat"
RETSUB
message.72:
IFEQ R28 R31 message.72.eu
PRINT "constant '"
REGSET R0 4
CALL mtext
PRINT "' is defined twice"
RETSUB
message.72.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' konstantea bi aldiz definituta dago"
RETSUB
message.73:
IFEQ R28 R31 message.73.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' is both a constant and a register; rename one of them"
RETSUB
message.73.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' konstantea eta erregistroa da aldi berean; aldatu baten izena"
RETSUB
message.74:
IFEQ R28 R31 message.74.eu
REGSET R0 4
CALL mtext
PRINT " needs R"
REGSET R0 6
CALL mnum
PRINT "..R"
REGSET R0 7
CALL mnum
PRINT ", but the registers are R0..R31"
RETSUB
message.74.eu:
REGSET R0 4
CALL mtext
PRINT "-k R"
REGSET R0 6
CALL mnum
PRINT "..R"
REGSET R0 7
CALL mnum
PRINT " behar ditu, baina erregistroak R0..R31 dira"
RETSUB
message.1:
IFEQ R28 R31 message.1.eu
PRINT "text is missing its closing "
CALL mquote
RETSUB
message.1.eu:
PRINT "testuari amaierako "
CALL mquote
PRINT " falta zaio"
RETSUB
message.2:
IFEQ R28 R31 message.2.eu
PRINT "label '"
REGSET R0 4
CALL mtext
PRINT "' is defined twice"
RETSUB
message.2.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' etiketa bi aldiz definituta dago"
RETSUB
message.3:
IFEQ R28 R31 message.3.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' is not a valid label name"
RETSUB
message.3.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' ez da etiketa-izen baliozkoa"
RETSUB
message.4:
IFEQ R28 R31 message.4.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' is both a register and a label; rename one of them"
RETSUB
message.4.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' erregistroa eta etiketa da aldi berean; aldatu baten izena"
RETSUB
message.5:
IFEQ R28 R31 message.5.eu
PRINT "LOOPSTART has no matching LOOPEND"
RETSUB
message.5.eu:
PRINT "LOOPSTART-ek ez du LOOPEND parekorik"
RETSUB
message.6:
IFEQ R28 R31 message.6.eu
PRINT "no label named '"
REGSET R0 4
CALL mtext
PRINT "'"
RETSUB
message.6.eu:
PRINT "ez dago '"
REGSET R0 4
CALL mtext
PRINT "' izeneko etiketarik"
RETSUB
message.7:
IFEQ R28 R31 message.7.eu
PRINT "... and "
REGSET R0 4
CALL mnum
PRINT " more error(s) not shown"
RETSUB
message.7.eu:
PRINT "... eta erakusten ez diren beste "
REGSET R0 4
CALL mnum
PRINT " errore"
RETSUB
message.8:
IFEQ R28 R31 message.8.eu
PRINT "QINIT appears more than once"
RETSUB
message.8.eu:
PRINT "QINIT behin baino gehiagotan agertzen da"
RETSUB
message.9:
IFEQ R28 R31 message.9.eu
PRINT "more than 64 qubits cannot be simulated as a state vector"
RETSUB
message.9.eu:
PRINT "64 qubit baino gehiago ezin dira egoera-bektore gisa simulatu"
RETSUB
message.10:
IFEQ R28 R31 message.10.eu
PRINT "expected a qubit count, found '"
REGSET R0 4
CALL mtext
PRINT "'"
RETSUB
message.10.eu:
PRINT "qubit-kopuru bat espero zen, baina '"
REGSET R0 4
CALL mtext
PRINT "' dago"
RETSUB
message.11:
IFEQ R28 R31 message.11.eu
PRINT "QINIT takes one number: the qubit count"
RETSUB
message.11.eu:
PRINT "QINIT-ek zenbaki bat hartzen du: qubit-kopurua"
RETSUB
message.12:
IFEQ R28 R31 message.12.eu
PRINT "QMODE appears more than once"
RETSUB
message.12.eu:
PRINT "QMODE behin baino gehiagotan agertzen da"
RETSUB
message.13:
IFEQ R28 R31 message.13.eu
PRINT "the cutoff must be at least 2 (room for 0 and 1 photons)"
RETSUB
message.13.eu:
PRINT "mugak gutxienez 2 izan behar du (0 eta 1 fotoirentzako lekua)"
RETSUB
message.14:
IFEQ R28 R31 message.14.eu
PRINT "QMODE takes the mode count and an optional cutoff"
RETSUB
message.14.eu:
PRINT "QMODE-k modu-kopurua eta aukerako muga bat hartzen ditu"
RETSUB
message.15:
IFEQ R28 R31 message.15.eu
REGSET R0 4
CALL mspec
PRINT " takes a name, a size and an optional first index, like "
REGSET R0 4
CALL mspec
PRINT " data 3"
RETSUB
message.15.eu:
REGSET R0 4
CALL mspec
PRINT "-k izen bat, tamaina bat eta aukerako lehen indize bat hartzen ditu, "
REGSET R0 4
CALL mspec
PRINT " data 3 bezala"
RETSUB
message.16:
IFEQ R28 R31 message.16.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' cannot name a register: use letters, digits and _, not an instruction, an operand like q3, or a constant like pi"
RETSUB
message.16.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' ezin da erregistro-izena izan: erabili letrak, digituak eta _, ez agindu bat, q3 bezalako eragigai bat edo pi bezalako konstante bat"
RETSUB
message.17:
IFEQ R28 R31 message.17.eu
PRINT "register '"
REGSET R0 4
CALL mtext
PRINT "' is declared twice"
RETSUB
message.17.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' erregistroa bi aldiz adierazita dago"
RETSUB
message.18:
IFEQ R28 R31 message.18.eu
PRINT "expected a size from 1 to 4096, found '"
REGSET R0 4
CALL mtext
PRINT "'"
RETSUB
message.18.eu:
PRINT "1 eta 4096 arteko tamaina bat espero zen, baina '"
REGSET R0 4
CALL mtext
PRINT "' dago"
RETSUB
message.19:
IFEQ R28 R31 message.19.eu
PRINT "expected a first index from 0 to 4095, found '"
REGSET R0 4
CALL mtext
PRINT "'"
RETSUB
message.19.eu:
PRINT "0 eta 4095 arteko lehen indize bat espero zen, baina '"
REGSET R0 4
CALL mtext
PRINT "' dago"
RETSUB
message.20:
IFEQ R28 R31 message.20.eu
REGSET R0 4
CALL mtext
PRINT " ("
REGSET R0 6
CALL mchar
REGSET R0 7
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 8
CALL mnum
PRINT ") overlaps "
REGSET R0 9
CALL mtext
PRINT " ("
REGSET R0 6
CALL mchar
REGSET R0 11
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 12
CALL mnum
PRINT ")"
RETSUB
message.20.eu:
REGSET R0 4
CALL mtext
PRINT " ("
REGSET R0 6
CALL mchar
REGSET R0 7
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 8
CALL mnum
PRINT ") "
REGSET R0 9
CALL mtext
PRINT "-rekin gainjartzen da ("
REGSET R0 6
CALL mchar
REGSET R0 11
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 12
CALL mnum
PRINT ")"
RETSUB
message.21:
IFEQ R28 R31 message.21.eu
REGSET R0 4
CALL mtext
PRINT " needs "
REGSET R0 6
CALL mchar
REGSET R0 7
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 8
CALL mnum
PRINT ", but "
REGSET R0 9
CALL mwhat
PRINT " declares "
REGSET R0 10
CALL mnum
RETSUB
message.21.eu:
REGSET R0 4
CALL mtext
PRINT "-k "
REGSET R0 6
CALL mchar
REGSET R0 7
CALL mnum
PRINT ".."
REGSET R0 6
CALL mchar
REGSET R0 8
CALL mnum
PRINT " behar ditu, baina "
REGSET R0 9
CALL mwhat
PRINT "-k "
REGSET R0 10
CALL mnum
PRINT " adierazten ditu"
RETSUB
message.22:
IFEQ R28 R31 message.22.eu
REGSET R0 4
CALL mtext
PRINT " has "
REGSET R0 6
CALL mnum
PRINT " element(s); index "
REGSET R0 7
CALL mnum
PRINT " is past the end"
RETSUB
message.22.eu:
REGSET R0 4
CALL mtext
PRINT "-k "
REGSET R0 6
CALL mnum
PRINT " elementu ditu; "
REGSET R0 7
CALL mnum
PRINT " indizea amaieratik kanpo dago"
RETSUB
