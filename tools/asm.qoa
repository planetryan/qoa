ADDR2 R8 R2
ADDR3 R2 R31
LDR3 R3
INER3 (2) sf.anext
LDR3 R2
LDR4 R3
INER4 (45) sf.anext
ADDR3 R3 R31
LDR4 R3
IEQR4 (62) sf.done
sf.anext:
ADDR1 R1 R31
J sf.ascan
; azken tokena `.` bakar batean: aurrekoa, ->, ondorengoa
sf.split:
SUBR11 R9 R31
MULR11 R11 (3)
ADDR11 R8 R11
LDR13 R11
ADDR0 R11 R31
LDR14 R0
RCR0 R13
RCR1 R14
C singledot
IEQR0 R29 sf.done
RCR12 R0
ADDR0 R11 (2)
LDR7 R0
RCR6 R11
IEQR12 R30 sf.arrow
ADDR0 R11 R31
STR12 R0
ADDR6 R11 (3)
sf.arrow:
SETR0 88
LDR0 R0
STR0 R6
ADDR1 R6 R31
ST (2) R1
ADDR1 R1 R31
ADDR0 R7 R12
STR0 R1
ADDR6 R6 (3)
ADDR0 R12 R31
IEQR0 R14 sf.count
ADDR1 R13 R0
STR1 R6
SUBR1 R14 R0
ADDR2 R6 R31
STR1 R2
ADDR1 R7 R0
ADDR2 R2 R31
STR1 R2
ADDR6 R6 (3)
sf.count:
SUBR0 R6 R8
DIVR0 R0 (3)
SETR1 41
STR0 R1
sf.done:
POPR14
POPR13
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; tokins: R0 = j -> tokenak j-tik aurrera posizio bat eskuinera (j-ren kopia bat geratzen da), NTOK + 1.
