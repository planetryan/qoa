ADD R0 R0 R31
CALL alloc
REGSET R1 75
STORE R0 R1
REGCOPY R12 R0
REGCOPY R0 R11
ADD R0 R0 R31
CALL alloc
REGSET R1 77
STORE R0 R1
REGCOPY R13 R0
; R14 = tokenak, R15 = zain dagoen gezia (0 ez), R16 = indizea
REGSET R14 0
REGSET R15 0
REGSET R16 0
match.tok:
IFEQ R16 R11 match.tokdone
REGSET R0 3
MUL R0 R16 R0
ADD R7 R10 R0
ADD R0 R7 R31
LOAD R0 R0
REGSET R1 2
IFNE R0 R1 match.plain
LOAD R0 R7
LOAD R1 R0
REGSET R2 45
IFNE R1 R2 match.plain
ADD R0 R0 R31
LOAD R1 R0
REGSET R2 62
IFNE R1 R2 match.plain
; -> gezia
IFEQ R15 R30 match.arrow
REGCOPY R0 R7
REGSET R1 27
CALL diagtok
JUMP match.fail
match.arrow:
REGCOPY R15 R7
JUMP match.next
match.plain:
ADD R0 R13 R14
STORE R15 R0
REGSET R15 0
REGSET R0 3
MUL R0 R14 R0
ADD R2 R12 R0
REGCOPY R0 R7
REGSET R1 3
CALL copyraw
ADD R14 R14 R31
match.next:
ADD R16 R16 R31
JUMP match.tok
match.tokdone:
REGSET R0 76
STORE R14 R0
IFEQ R15 R30 match.groups
REGCOPY R0 R15
REGSET R1 28
CALL diagtok
JUMP match.fail
match.groups:
; R11 = eragigai-kopurua, R12 = errepikatzen dena (-1 ez), R16 = beharrezkoak
REGSET R0 3
ADD R0 R8 R0
LOAD R11 R0
REGSET R0 2
ADD R0 R8 R0
LOAD R10 R0
REGSET R12 -1
REGSET R16 0
REGSET R15 0
match.scan:
IFEQ R15 R11 match.scanned
REGSET R0 5
MUL R0 R15 R0
ADD R0 R10 R0
REGSET R1 3
ADD R1 R0 R1
LOAD R1 R1
IFNE R1 R30 match.opt
ADD R16 R16 R31
match.opt:
REGSET R1 4
ADD R1 R0 R1
LOAD R1 R1
IFEQ R1 R30 match.snext
IFNE R12 R29 match.snext
REGCOPY R12 R15
match.snext:
ADD R15 R15 R31
JUMP match.scan
match.scanned:
; taldeak hutsik
REGSET R15 0
match.clear:
IFEQ R15 R11 match.cleared
REGSET R0 74
LOAD R0 R0
ADD R1 R15 R15
ADD R0 R0 R1
STORE R30 R0
ADD R0 R0 R31
STORE R30 R0
ADD R15 R15 R31
JUMP match.clear
match.cleared:
IFNE R12 R29 match.variadic
IFLT R14 R16 match.count
IFGT R14 R11 match.count
REGSET R15 0
match.fixed:
IFEQ R15 R14 match.arrows
REGSET R0 74
LOAD R0 R0
ADD R1 R15 R15
ADD R0 R0 R1
STORE R15 R0
ADD R0 R0 R31
STORE R31 R0
ADD R15 R15 R31
JUMP match.fixed
match.count:
; R14 = aurkitutakoak: gutxiegi edo gehiegi
REGCOPY R0 R9
IFLT R14 R16 match.countat
REGSET R0 3
MUL R0 R11 R0
REGSET R1 75
LOAD R1 R1
ADD R0 R1 R0
match.countat:
REGSET R1 29
IFLT R14 R16 match.countmsg
REGSET R1 30
match.countmsg:
CALL diagtok
REGCOPY R7 R0
REGSET R1 4
REGCOPY R2 R8
CALL dset
REGSET R1 5
REGCOPY R2 R16
CALL dset
REGSET R1 6
REGCOPY R2 R11
CALL dset
REGSET R1 7
REGCOPY R2 R14
CALL dset
REGSET R1 14
REGSET R2 90
CALL dset
REGSET R1 15
REGCOPY R2 R8
CALL dset
JUMP match.fail
match.variadic:
; R16 = gutxienekoa: v + ondorengoak (+1 bat edo gehiago bada)
SUB R16 R11 R31
REGSET R0 5
MUL R0 R12 R0
ADD R0 R10 R0
REGSET R1 4
ADD R0 R0 R1
LOAD R0 R0
IFNE R0 R31 match.vmin
ADD R16 R16 R31
match.vmin:
IFLT R14 R16 match.vfew
; v aurrekoak banan, errepikatzen dena, ondorengoak banan
REGSET R15 0
match.vbefore:
IFEQ R15 R12 match.vmid
REGSET R0 74
LOAD R0 R0
ADD R1 R15 R15
ADD R0 R0 R1
STORE R15 R0
ADD R0 R0 R31
STORE R31 R0
ADD R15 R15 R31
JUMP match.vbefore
match.vmid:
; ondorengoak: R11 - R12 - 1
SUB R7 R11 R12
SUB R7 R7 R31
SUB R6 R14 R7
REGSET R0 74
LOAD R0 R0
ADD R1 R12 R12
ADD R0 R0 R1
STORE R12 R0
ADD R0 R0 R31
SUB R1 R6 R12
STORE R1 R0
REGSET R15 0
match.vafter:
IFEQ R15 R7 match.arrows
ADD R1 R12 R15
ADD R1 R1 R31
REGSET R0 74
LOAD R0 R0
ADD R1 R1 R1
ADD R0 R0 R1
ADD R2 R6 R15
STORE R2 R0
ADD R0 R0 R31
STORE R31 R0
ADD R15 R15 R31
JUMP match.vafter
match.vfew:
REGCOPY R0 R9
IFEQ R14 R30 match.vfewat
REGSET R0 3
SUB R1 R14 R31
MUL R0 R1 R0
REGSET R1 75
LOAD R1 R1
ADD R0 R1 R0
match.vfewat:
REGSET R1 31
CALL diagtok
REGSET R1 4
REGCOPY R2 R8
CALL dset
REGSET R1 14
REGSET R2 90
CALL dset
REGSET R1 15
REGCOPY R2 R8
CALL dset
JUMP match.fail
match.arrows:
; gezia helmuga baten aurretik bakarrik
REGSET R15 0
match.agroup:
IFEQ R15 R11 match.ok
REGSET R0 74
LOAD R0 R0
ADD R1 R15 R15
ADD R0 R0 R1
LOAD R16 R0
ADD R0 R0 R31
LOAD R6 R0
ADD R6 R6 R16
match.atok:
IFEQ R16 R6 match.anext
ADD R0 R13 R16
LOAD R0 R0
IFEQ R0 R30 match.astep
REGSET R1 5
MUL R1 R15 R1
ADD R1 R10 R1
LOAD R1 R1
REGSET R2 100
IFEQ R1 R2 match.astep
REGSET R1 32
CALL diagtok
REGSET R1 4
REGCOPY R2 R8
CALL dset
REGSET R1 14
REGSET R2 90
CALL dset
REGSET R1 15
REGCOPY R2 R8
CALL dset
JUMP match.fail
match.astep:
ADD R16 R16 R31
JUMP match.atok
match.anext:
ADD R15 R15 R31
JUMP match.agroup
match.ok:
REGSET R0 1
JUMP match.ret
match.fail:
REGSET R0 0
match.ret:
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- eragigaiak
; balio bakoitza VALP-n (4 gelaxka): [mota, a, b, c]. motak: 0 falta da, 1 indizea (a), 2 indizeak (a = helbidea,
; b = kopurua), 3 helmuga (a = 1 bita / 2 erregistroa, b = n), 4 iturria (a = 0 erregistroa / 1 bita, b = n),
; 5 zenbakia (a), 6 osoa (a = goikoak, b = behekoak), 7 kopurua (a = 0 literala / 1 erregistroa, b, c),
; 8 etiketa (a, b = testua), 9 testua (a, b = kode-puntuak), 10 oinarria (a = 0 X / 1 Y / 2 Z), 11 izena (a, b),
; 12 zenbakia erregistro baten lekuan (a, `(1)`)

; operand: R0 = zehaztapena, R1 = eragigaiaren zenbakia -> haren taldea irakurri. R0 = 1 ondo, 0 errorea
operand:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
REGCOPY R8 R0
REGCOPY R9 R1
; R10 = eragigai-zehaztapena, R11 = balioa, R12 = lehen tokena, R13 = kopurua
REGSET R0 2
ADD R0 R8 R0
LOAD R0 R0
REGSET R1 5
MUL R1 R9 R1
ADD R10 R0 R1
REGSET R0 73
LOAD R0 R0
REGSET R1 4
MUL R1 R9 R1
ADD R11 R0 R1
REGSET R0 74
LOAD R0 R0
ADD R1 R9 R9
ADD R0 R0 R1
LOAD R12 R0
ADD R0 R0 R31
LOAD R13 R0
REGSET R0 3
MUL R12 R12 R0
REGSET R0 75
LOAD R0 R0
ADD R12 R0 R12
STORE R30 R11
IFEQ R13 R30 operand.ok
LOAD R14 R10
REGSET R0 4
ADD R0 R10 R0
LOAD R0 R0
IFEQ R0 R30 operand.single
; zerrenda: tarteak zabalduta, memoria dinamikoaren amaieran jarraian (bitartean ez da ezer esleitzen)
REGSET R0 0
LOAD R0 R0
REGSET R1 1
ADD R1 R11 R1
STORE R0 R1
operand.ltok:
IFEQ R13 R30 operand.ldone
REGCOPY R0 R12
REGCOPY R1 R14
CALL indexlist
IFEQ R0 R30 operand.fail
operand.lput:
REGSET R0 0
LOAD R3 R0
STORE R1 R3
ADD R3 R3 R31
STORE R3 R0
ADD R1 R1 R31
IFGT R1 R2 operand.lstep
JUMP operand.lput
operand.lreg:
REGCOPY R0 R12
REGSET R1 114
CALL index
IFEQ R0 R30 operand.fail
REGCOPY R2 R1
JUMP operand.lput
operand.lstep:
REGSET R0 3
ADD R12 R12 R0
SUB R13 R13 R31
JUMP operand.ltok
operand.ldone:
REGSET R0 2
STORE R0 R11
REGSET R0 0
LOAD R0 R0
REGSET R1 1
ADD R1 R11 R1
LOAD R2 R1
SUB R0 R0 R2
ADD R1 R1 R31
STORE R0 R1
JUMP operand.ok
operand.single:
REGSET R0 113
IFEQ R14 R0 operand.idx
REGSET R0 111
IFEQ R14 R0 operand.idx
REGSET R0 114
IFEQ R14 R0 operand.idx
REGSET R0 99
IFEQ R14 R0 operand.idx
REGSET R0 120
IFEQ R14 R0 operand.xval
REGSET R0 100
IFEQ R14 R0 operand.dest
REGSET R0 118
IFEQ R14 R0 operand.source
REGSET R0 102
IFEQ R14 R0 operand.float
REGSET R0 105
IFEQ R14 R0 operand.int
REGSET R0 110
IFEQ R14 R0 operand.count
REGSET R0 108
IFEQ R14 R0 operand.label
REGSET R0 115
IFEQ R14 R0 operand.text
REGSET R0 107
IFEQ R14 R0 operand.char
REGSET R0 98
IFEQ R14 R0 operand.basis
; g: ate-izena
REGSET R0 11
STORE R0 R11
LOAD R0 R12
ADD R1 R11 R31
STORE R0 R1
ADD R0 R12 R31
LOAD R0 R0
ADD R1 R1 R31
STORE R0 R1
JUMP operand.ok
operand.xval:
; x: parentesi artean zenbaki bat (`(1)`), bestela erregistro bat
LOAD R0 R12
LOAD R0 R0
REGSET R1 40
IFNE R0 R1 operand.xreg
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL evalexpr
IFEQ R0 R30 operand.ferr
REGSET R0 12
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
JUMP operand.ok
operand.xreg:
REGSET R14 114
operand.idx:
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL findrange
IFLT R0 R30 operand.idx2
REGCOPY R0 R12
REGSET R1 33
CALL diagtok
REGSET R1 4
REGCOPY R2 R8
CALL dset
JUMP operand.fail
operand.idx2:
REGCOPY R0 R12
REGCOPY R1 R14
CALL index
IFEQ R0 R30 operand.fail
REGSET R0 1
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
JUMP operand.ok
operand.dest:
REGCOPY R0 R12
CALL dest
IFEQ R0 R30 operand.fail
REGSET R0 3
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
ADD R0 R0 R31
STORE R2 R0
JUMP operand.ok
operand.source:
REGCOPY R0 R12
CALL dest
IFEQ R0 R30 operand.fail
REGSET R0 4
STORE R0 R11
; Source: Reg = 0, Bit = 1 (Dest-en Bit = 1, Reg = 2)
REGSET R0 2
SUB R1 R0 R1
ADD R0 R11 R31
STORE R1 R0
ADD R0 R0 R31
STORE R2 R0
JUMP operand.ok
operand.float:
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL evalexpr
IFEQ R0 R30 operand.ferr
REGSET R0 5
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
JUMP operand.ok
operand.ferr:
REGCOPY R0 R12
REGSET R1 34
CALL diagtok
REGCOPY R13 R0
CALL opname
REGCOPY R0 R13
CALL experr
JUMP operand.fail
operand.int:
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL parseint
IFEQ R0 R30 operand.ierr
operand.intok:
REGSET R0 6
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
ADD R0 R0 R31
STORE R2 R0
JUMP operand.ok
operand.ierr:
REGCOPY R0 R12
REGSET R1 35
CALL diagtok
REGCOPY R13 R0
CALL opname
LOAD R2 R12
ADD R3 R12 R31
LOAD R3 R3
REGCOPY R0 R13
REGSET R1 6
CALL dtext
JUMP operand.fail
operand.count:
LOAD R0 R12
LOAD R0 R0
REGSET R1 82
IFEQ R0 R1 operand.creg
REGSET R1 114
IFEQ R0 R1 operand.creg
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL parseint
IFEQ R0 R30 operand.cerr
REGSET R0 7
STORE R0 R11
ADD R0 R11 R31
STORE R30 R0
ADD R0 R0 R31
STORE R1 R0
ADD R0 R0 R31
STORE R2 R0
JUMP operand.ok
operand.creg:
REGCOPY R0 R12
REGSET R1 114
CALL index
IFEQ R0 R30 operand.fail
REGSET R0 7
STORE R0 R11
ADD R0 R11 R31
STORE R31 R0
ADD R0 R0 R31
STORE R1 R0
JUMP operand.ok
operand.cerr:
REGCOPY R0 R12
REGSET R1 36
CALL diagtext
JUMP operand.fail
operand.label:
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL islabel
IFEQ R0 R31 operand.lok
REGCOPY R0 R12
REGSET R1 37
CALL diagtext
JUMP operand.fail
operand.lok:
REGSET R0 8
STORE R0 R11
LOAD R0 R12
ADD R1 R11 R31
STORE R0 R1
ADD R0 R12 R31
LOAD R0 R0
ADD R1 R1 R31
STORE R0 R1
JUMP operand.ok
operand.text:
REGCOPY R0 R12
CALL string
IFEQ R0 R30 operand.fail
REGSET R0 9
STORE R0 R11
ADD R0 R11 R31
STORE R1 R0
ADD R0 R0 R31
STORE R2 R0
JUMP operand.ok
operand.char:
LOAD R0 R12
LOAD R0 R0
REGSET R1 34
IFNE R0 R1 operand.code
REGCOPY R0 R12
CALL string
IFEQ R0 R30 operand.fail
IFEQ R2 R31 operand.onechar
REGCOPY R0 R12
REGSET R1 38
CALL diagtok
JUMP operand.fail
operand.onechar:
LOAD R2 R1
REGSET R1 0
JUMP operand.intok
operand.code:
LOAD R0 R12
ADD R1 R12 R31
LOAD R1 R1
CALL parseint
IFEQ R0 R30 operand.kerr
IFGT R1 R30 operand.kerr
REGSET R0 1114111
IFGT R2 R0 operand.kerr
JUMP operand.intok
operand.kerr:
REGCOPY R0 R12
REGSET R1 39
CALL diagtext
JUMP operand.fail
operand.basis:
ADD R0 R12 R31
LOAD R0 R0
IFNE R0 R31 operand.berr
LOAD R0 R12
LOAD R0 R0
CALL upper
REGSET R1 88
SUB R0 R0 R1
IFLT R0 R30 operand.berr
REGSET R1 2
IFGT R0 R1 operand.berr
REGSET R1 10
STORE R1 R11
ADD R1 R11 R31
STORE R0 R1
JUMP operand.ok
operand.berr:
REGCOPY R0 R12
REGSET R1 40
CALL diagtok
REGCOPY R13 R0
CALL opname
LOAD R2 R12
ADD R3 R12 R31
LOAD R3 R3
REGCOPY R0 R13
REGSET R1 6
CALL dtext
JUMP operand.fail
operand.ok:
REGSET R0 1
JUMP operand.ret
operand.fail:
REGSET R0 0
operand.ret:
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; opname: R13 = diagnostikoa, R10 = eragigai-zehaztapena -> eragigaiaren izena p0-p1-en (taulako byteak).
; aldatzen ditu R0-R3
opname:
ADD R2 R10 R31
LOAD R1 R2
ADD R3 R2 R31
LOAD R3 R3
REGCOPY R0 R13
REGCOPY R2 R1
REGSET R1 4
CALL dset
REGCOPY R0 R13
REGSET R1 5
REGCOPY R2 R3
JUMP dset

; experr: R0 = diagnostikoa -> adierazpenaren errorea p2-tik aurrera: p2 = kodea, eta haren parametroak
; (p3 karakterea, edo p3-p4 testua; 1. kodean p3 karakterea eta p4-p5 adierazpena)
experr:
PUSH R8
REGCOPY R8 R0
REGSET R0 55
LOAD R2 R0
REGCOPY R0 R8
REGSET R1 6
CALL dset
REGSET R0 55
LOAD R0 R0
REGSET R1 1
IFEQ R0 R1 experr.char
REGSET R1 8
IFEQ R0 R1 experr.char
REGSET R1 6
IFEQ R0 R1 experr.char
REGSET R1 2
IFEQ R0 R1 experr.src
REGSET R1 7
IFEQ R0 R1 experr.text
REGSET R1 9
IFEQ R0 R1 experr.text
JUMP experr.done
experr.char:
REGSET R0 58
LOAD R2 R0
REGCOPY R0 R8
REGSET R1 7
CALL dset
REGSET R0 55
LOAD R0 R0
REGSET R1 1
IFNE R0 R1 experr.done
experr.src:
REGSET R0 56
LOAD R2 R0
REGSET R0 57
LOAD R3 R0
REGCOPY R0 R8
REGSET R1 8
CALL dtext
JUMP experr.done
experr.text:
REGSET R0 59
LOAD R2 R0
REGSET R0 60
LOAD R3 R0
REGCOPY R0 R8
REGSET R1 7
CALL dtext
experr.done:
POP R8
RETSUB

; index: R0 = tokena, R1 = mota (q 113, o 111, c 99, r 114) -> R0 = 1 eta R1 = indizea, mugak egiaztatuta;
; bestela R0 = 0 (errorea jakinarazita)
index:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
REGCOPY R9 R1
LOAD R10 R8
ADD R11 R8 R31
LOAD R11 R11
; aurrizkia (minuskula edo maiuskula)
REGSET R12 0
IFEQ R11 R30 index.parse
LOAD R0 R10
IFEQ R0 R9 index.pre
REGSET R1 32
SUB R1 R9 R1
IFEQ R0 R1 index.pre
; beste letra batekin hasten bada, ez da indizea
CALL isalpha
IFEQ R0 R31 index.bad
JUMP index.parse
index.pre:
REGSET R12 1
ADD R10 R10 R31
SUB R11 R11 R31
index.parse:
; bit klasikoek aurrizkia behar dute (c0): zenbaki hutsa anbiguoa litzateke
REGSET R0 99
IFNE R9 R0 index.digits
IFEQ R12 R30 index.bad
index.digits:
REGCOPY R0 R10
REGCOPY R1 R11
CALL parseu32
IFEQ R0 R30 index.bad
REGCOPY R10 R1
REGSET R0 113
IFEQ R9 R0 index.q
REGSET R0 111
IFEQ R9 R0 index.o
REGSET R0 99
IFEQ R9 R0 index.c
; erregistroa: R0..R31
REGSET R0 32
IFLT R10 R0 index.ok
REGCOPY R0 R8
REGSET R1 51
CALL diagtok
REGSET R1 4
REGCOPY R2 R10
CALL dset
REGSET R1 5
REGSET R2 31
CALL dset
JUMP index.fail
index.q:
REGSET R0 25
LOAD R11 R0
IFEQ R11 R29 index.q64
IFLT R10 R11 index.qmax
REGSET R0 34
LOAD R0 R0
IFEQ R0 R31 index.fail
REGSET R0 34
STORE R31 R0
REGCOPY R0 R8
REGSET R1 46
IFNE R11 R30 index.qmsg
REGSET R1 45
index.qmsg:
CALL diagtok
REGSET R1 4
REGCOPY R2 R10
CALL dset
REGSET R1 5
REGCOPY R2 R11
CALL dset
REGSET R1 6
SUB R2 R11 R31
CALL dset
REGSET R1 14
REGSET R2 45
CALL dset
REGSET R1 33
LOAD R2 R1
REGSET R1 15
CALL dset
REGSET R1 16
ADD R2 R10 R31
CALL dset
JUMP index.fail
index.q64:
REGSET R0 64
IFLT R10 R0 index.qmax
REGCOPY R0 R8
REGSET R1 47
CALL diagtok
JUMP index.fail
index.qmax:
REGSET R0 29
JUMP index.max
index.o:
REGSET R0 26
LOAD R11 R0
IFEQ R11 R29 index.o64
IFLT R10 R11 index.omax
REGCOPY R0 R8
REGSET R1 48
CALL diagtok
REGSET R1 4
REGCOPY R2 R10
CALL dset
REGSET R1 5
REGCOPY R2 R11
CALL dset
JUMP index.fail
index.o64:
REGSET R0 64
IFLT R10 R0 index.omax
REGCOPY R0 R8
REGSET R1 49
CALL diagtok
JUMP index.fail
index.omax:
REGSET R0 30
JUMP index.max
index.c:
REGSET R0 4096
IFLT R10 R0 index.cmax
REGCOPY R0 R8
REGSET R1 50
CALL diagtok
JUMP index.fail
index.cmax:
REGSET R0 31
index.max:
LOAD R1 R0
IFGT R10 R1 index.setmax
JUMP index.ok
index.setmax:
STORE R10 R0
index.ok:
REGSET R0 1
REGCOPY R1 R10
JUMP index.ret
index.bad:
; mezua eta laguntza motaren arabera: q 41, o 42, c 43, r 44
REGSET R1 41
REGSET R0 111
IFNE R9 R0 index.b2
REGSET R1 42
index.b2:
REGSET R0 99
IFNE R9 R0 index.b3
REGSET R1 43
index.b3:
REGSET R0 114
IFNE R9 R0 index.b4
REGSET R1 44
index.b4:
PUSH R1
REGCOPY R0 R8
CALL diagtext
POP R2
REGSET R1 14
CALL dset
index.fail:
REGSET R0 0
index.ret:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; indexlist: R0 = tokena, R1 = mota -> q0..q3 tartea edo indize bakarra: R0 = 1, R1 = lo, R2 = hi; edo R0 = 0
indexlist:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
REGCOPY R9 R1
LOAD R10 R8
ADD R11 R8 R31
LOAD R11 R11
REGCOPY R0 R10
REGCOPY R1 R11
CALL findrange
IFLT R0 R30 indexlist.one
REGCOPY R12 R0
; a: 90-92 tokena, b: 93-95 (zutabea bera)
REGSET R0 90
STORE R10 R0
ADD R0 R0 R31
STORE R12 R0
ADD R0 R0 R31
REGSET R1 2
ADD R1 R8 R1
LOAD R1 R1
STORE R1 R0
REGSET R0 95
STORE R1 R0
ADD R0 R10 R12
REGSET R1 2
ADD R0 R0 R1
SUB R1 R11 R12
REGSET R2 2
SUB R1 R1 R2
; amaieran aurrizkia aukerakoa da: q0..3 eta q0..q3 berdinak dira
IFEQ R12 R30 indexlist.plainb
IFEQ R1 R30 indexlist.plainb
PUSH R0
PUSH R1
LOAD R0 R10
CALL isalpha
REGCOPY R2 R0
POP R1
POP R0
IFEQ R2 R30 indexlist.plainb
PUSH R0
PUSH R1
LOAD R0 R0
CALL isdigit
REGCOPY R2 R0
POP R1
POP R0
IFEQ R2 R30 indexlist.plainb
; SCR2 = aurrizkia + b
REGSET R2 43
LOAD R2 R2
LOAD R3 R10
STORE R3 R2
PUSH R1
ADD R2 R2 R31
CALL copyraw
POP R1
ADD R1 R1 R31
REGSET R0 43
LOAD R0 R0
indexlist.plainb:
REGSET R2 93
STORE R0 R2
ADD R2 R2 R31
STORE R1 R2
REGSET R0 90
REGCOPY R1 R9
CALL index
IFEQ R0 R30 indexlist.fail
REGCOPY R11 R1
REGSET R0 93
REGCOPY R1 R9
CALL index
IFEQ R0 R30 indexlist.fail
IFLT R1 R11 indexlist.down
REGCOPY R2 R1
REGCOPY R1 R11
REGSET R0 1
JUMP indexlist.ret
indexlist.down:
REGCOPY R0 R8
REGSET R1 52
CALL diagtok
JUMP indexlist.fail
indexlist.one:
REGCOPY R0 R8
REGCOPY R1 R9
CALL index
IFEQ R0 R30 indexlist.fail
REGCOPY R2 R1
JUMP indexlist.ret
indexlist.fail:
REGSET R0 0
indexlist.ret:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; destlist: R0 = tokena (c0..c2 edo R0..R2) -> R0 = 1, R1 = aurrizkia (idatzi bezala), R2 = lo, R3 = hi
destlist:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
LOAD R9 R8
ADD R10 R8 R31
LOAD R10 R10
REGCOPY R0 R9
REGCOPY R1 R10
CALL findrange
REGCOPY R11 R0
IFEQ R11 R30 destlist.bad
LOAD R12 R9
REGCOPY R0 R12
CALL lower
REGSET R1 99
IFEQ R0 R1 destlist.lo
REGSET R1 114
IFEQ R0 R1 destlist.lo
JUMP destlist.bad
destlist.lo:
ADD R0 R9 R31
SUB R1 R11 R31
CALL parseu32
IFEQ R0 R30 destlist.bad
PUSH R1
; b, hasierako c/C/r/R guztiak kenduta
ADD R0 R9 R11
REGSET R1 2
ADD R0 R0 R1
SUB R1 R10 R11
REGSET R2 2
SUB R1 R1 R2
destlist.trim:
IFEQ R1 R30 destlist.hi
LOAD R2 R0
REGSET R3 99
IFEQ R2 R3 destlist.cut
REGSET R3 67
IFEQ R2 R3 destlist.cut
REGSET R3 114
IFEQ R2 R3 destlist.cut
REGSET R3 82
IFEQ R2 R3 destlist.cut
JUMP destlist.hi
destlist.cut:
ADD R0 R0 R31
SUB R1 R1 R31
JUMP destlist.trim
destlist.hi:
CALL parseu32
POP R2
IFEQ R0 R30 destlist.bad
IFLT R1 R2 destlist.bad
REGCOPY R3 R1
REGCOPY R1 R12
REGSET R0 1
JUMP destlist.ret
destlist.bad:
REGCOPY R0 R8
REGSET R1 53
CALL diagtok
REGSET R0 0
destlist.ret:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; dest: R0 = tokena -> c3 (bita) edo R2 (erregistroa): R0 = 1, R1 = 1 bita / 2 erregistroa, R2 = n
dest:
PUSH R8
REGCOPY R8 R0
LOAD R0 R8
LOAD R0 R0
CALL lower
REGSET R1 99
IFEQ R0 R1 dest.bit
REGSET R1 114
IFEQ R0 R1 dest.reg
REGCOPY R0 R8
REGSET R1 54
CALL diagtext
REGSET R1 14
REGSET R2 54
CALL dset
REGSET R0 0
JUMP dest.ret
dest.bit:
REGCOPY R0 R8
REGSET R1 99
CALL index
REGCOPY R2 R1
REGSET R1 1
JUMP dest.ret
dest.reg:
REGCOPY R0 R8
REGSET R1 114
CALL index
REGCOPY R2 R1
REGSET R1 2
dest.ret:
POP R8
RETSUB

; string: R0 = tokena -> komatxo arteko testua, ihes-sekuentziekin (\n \t \" \\): R0 = 1, R1 = kode-puntuak,
; R2 = kopurua; edo R0 = 0
string:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
LOAD R9 R8
ADD R10 R8 R31
LOAD R10 R10
REGSET R0 2
IFLT R10 R0 string.bad
LOAD R0 R9
REGSET R1 34
IFNE R0 R1 string.bad
ADD R0 R9 R10
SUB R0 R0 R31
LOAD R0 R0
IFNE R0 R1 string.bad
REGCOPY R0 R10
CALL alloc
REGCOPY R11 R0
ADD R9 R9 R31
REGSET R0 2
SUB R10 R10 R0
ADD R10 R9 R10
REGCOPY R2 R11
string.next:
IFEQ R9 R10 string.done
LOAD R0 R9
ADD R9 R9 R31
REGSET R1 92
IFNE R0 R1 string.put
IFEQ R9 R10 string.put
LOAD R0 R9
ADD R9 R9 R31
REGSET R1 110
IFNE R0 R1 string.t
REGSET R0 10
JUMP string.put
string.t:
REGSET R1 116
IFNE R0 R1 string.q
REGSET R0 9
JUMP string.put
string.q:
REGSET R1 34
IFEQ R0 R1 string.put
REGSET R1 92
IFEQ R0 R1 string.put
; beste bat: \ eta karakterea bere horretan
REGSET R1 92
STORE R1 R2
ADD R2 R2 R31
string.put:
STORE R0 R2
ADD R2 R2 R31
JUMP string.next
string.done:
SUB R2 R2 R11
REGCOPY R1 R11
REGSET R0 1
JUMP string.ret
string.bad:
REGCOPY R0 R8
REGSET R1 55
CALL diagtext
REGSET R0 0
string.ret:
POP R11
POP R10
POP R9
POP R8
RETSUB

; suggest: R0, R1 = hitza -> R0 = editatze-distantzia txikieneko agindua (hitz laburretan akats bakarra,
; bestela bi), edo 0. aldatzen ditu R0-R7
suggest:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
PUSH R15
PUSH R16
REGCOPY R8 R1
REGSET R2 43
LOAD R2 R2
CALL copyup
REGSET R9 43
LOAD R9 R9
; muga: utf-8 luzera <= 4 bada 1, bestela 2
REGSET R10 0
REGSET R0 0
suggest.blen:
IFEQ R0 R8 suggest.limit
ADD R1 R9 R0
LOAD R1 R1
PUSH R0
REGCOPY R0 R1
CALL u8len
ADD R10 R10 R0
POP R0
ADD R0 R0 R31
JUMP suggest.blen
suggest.limit:
REGSET R11 2
REGSET R0 4
IFGT R10 R0 suggest.scan
REGSET R11 1
suggest.scan:
; R12 = onena, R13 = haren distantzia, R14 = zehaztapena, R15 = geratzen direnak
REGSET R12 0
REGSET R13 1000000
REGSET R0 8
LOAD R14 R0
REGSET R0 9
LOAD R15 R0
suggest.spec:
IFEQ R15 R30 suggest.done
REGSET R0 5
ADD R0 R14 R0
LOAD R0 R0
IFEQ R0 R31 suggest.nextspec
LOAD R2 R14
ADD R3 R14 R31
LOAD R3 R3
CALL suggest.try
; ezizenak
REGSET R16 0
suggest.alias:
REGSET R0 17
ADD R0 R14 R0
LOAD R0 R0
IFEQ R16 R0 suggest.nextspec
REGSET R0 16
ADD R0 R14 R0
LOAD R0 R0
ADD R1 R16 R16
ADD R0 R0 R1
LOAD R2 R0
ADD R0 R0 R31
LOAD R3 R0
CALL suggest.try
ADD R16 R16 R31
JUMP suggest.alias
suggest.nextspec:
REGSET R0 24
ADD R14 R14 R0
SUB R15 R15 R31
JUMP suggest.spec
suggest.try:
; R2, R3 = hautagaia
REGCOPY R0 R9
REGCOPY R1 R8
CALL editdist
IFGT R0 R11 suggest.tried
IFLT R0 R13 suggest.better
JUMP suggest.tried
suggest.better:
REGCOPY R13 R0
REGCOPY R12 R14
suggest.tried:
RETSUB
suggest.done:
REGCOPY R0 R12
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; editdist: R0, R1 = a; R2, R3 = b -> R0 = editatze-distantzia (levenshtein). aldatzen ditu R0-R7
editdist:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGCOPY R11 R3
; aurreko errenkada: 0..|b|, eta unekoa
ADD R0 R11 R31
ADD R0 R0 R0
CALL alloc
REGCOPY R12 R0
ADD R13 R12 R11
ADD R13 R13 R31
REGSET R0 0
editdist.init:
IFGT R0 R11 editdist.rows
ADD R1 R12 R0
STORE R0 R1
ADD R0 R0 R31
JUMP editdist.init
editdist.rows:
REGSET R4 1
editdist.row:
IFGT R4 R9 editdist.end
STORE R4 R13
REGSET R5 1
editdist.col:
IFGT R5 R11 editdist.swap
; kostua: a[i-1] != b[j-1]
ADD R0 R8 R4
SUB R0 R0 R31
LOAD R0 R0
ADD R1 R10 R5
SUB R1 R1 R31
LOAD R1 R1
REGSET R6 0
IFEQ R0 R1 editdist.cost
REGSET R6 1
editdist.cost:
; min(prev[j] + 1, cur[j-1] + 1, prev[j-1] + kostua)
ADD R0 R12 R5
LOAD R0 R0
ADD R0 R0 R31
ADD R1 R13 R5
SUB R1 R1 R31
LOAD R1 R1
ADD R1 R1 R31
IFLT R1 R0 editdist.m1
JUMP editdist.m2
editdist.m1:
REGCOPY R0 R1
editdist.m2:
ADD R1 R12 R5
SUB R1 R1 R31
LOAD R1 R1
ADD R1 R1 R6
IFLT R1 R0 editdist.m3
JUMP editdist.m4
editdist.m3:
REGCOPY R0 R1
editdist.m4:
ADD R1 R13 R5
STORE R0 R1
ADD R5 R5 R31
JUMP editdist.col
editdist.swap:
REGCOPY R7 R12
REGCOPY R12 R13
REGCOPY R13 R7
ADD R4 R4 R31
JUMP editdist.row
editdist.end:
ADD R0 R12 R11
LOAD R0 R0
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- adierazpenak
; expr.rs bezala, eragiketa berak ordena berean (ieee 754 bit berberak):
;   expr = term (('+' | '-') term)*     term = unary (('*' | '/') unary)*
;   unary = ('-' | '+') unary | power   power = atom ('^' unary)?
;   atom = zenbakia | konstantea | funtzioa '(' expr ')' | '(' expr ')'
; egoera: EPOS (53) uneko helbidea, EEND (54), EERR (55) errore-kodea (0 ondo), ESRC/ESRCN (56-57) adierazpen
; osoa, EP1 (58) karakterea, EP2-EP3 (59-60) testua. kodeak: 1 ustekabeko karakterea amaieran, 2 ez finitua,
; 3 zeroz zatitzea, 4 goizegi amaitu da, 5 ')' falta, 6 funtzioak parentesiak behar ditu (EP1 = funtzioa),
; 7 izen ezezaguna, 8 ustekabeko karakterea, 9 ez da zenbaki bat, 10 100 maila baino gehiago habiaratuta

; evalexpr: R0, R1 = testua -> R0 = 1 eta R1 = balioa, edo R0 = 0 (EERR eta parametroak)
evalexpr:
REGSET R2 89
STORE R30 R2
REGSET R2 53
STORE R0 R2
ADD R3 R0 R1
REGSET R2 54
STORE R3 R2
REGSET R2 55
STORE R30 R2
REGSET R2 56
STORE R0 R2
REGSET R2 57
STORE R1 R2
CALL ex.expr
REGSET R1 55
LOAD R1 R1
IFNE R1 R30 evalexpr.fail
PUSH R0
CALL ex.peek
REGCOPY R2 R0
POP R0
IFEQ R2 R29 evalexpr.end
; ustekabeko karakterea amaieran
REGSET R1 58
STORE R2 R1
REGSET R1 55
REGSET R2 1
STORE R2 R1
JUMP evalexpr.fail
evalexpr.end:
; finitua: x - x = 0
SUB R1 R0 R0
IFEQ R1 R30 evalexpr.ok
REGSET R1 55
REGSET R2 2
STORE R2 R1
JUMP evalexpr.fail
evalexpr.ok:
REGCOPY R1 R0
REGSET R0 1
RETSUB
evalexpr.fail:
REGSET R0 0
RETSUB

; ex.err: R0 = errore-kodea. aldatzen ditu R1
ex.err:
REGSET R1 55
STORE R0 R1
RETSUB

; ex.peek: hutsuneak saltatu -> R0 = hurrengo karakterea, edo -1 amaieran. aldatzen ditu R0-R3
ex.peek:
REGSET R2 53
LOAD R3 R2
REGSET R1 54
LOAD R1 R1
ex.peek.next:
IFEQ R3 R1 ex.peek.end
LOAD R0 R3
PUSH R1
CALL isws
POP R1
IFEQ R0 R30 ex.peek.got
ADD R3 R3 R31
JUMP ex.peek.next
ex.peek.got:
STORE R3 R2
LOAD R0 R3
RETSUB
ex.peek.end:
STORE R3 R2
REGSET R0 -1
RETSUB

; ex.skip: karaktere bat aurrera. aldatzen ditu R1, R2
ex.skip:
REGSET R1 53
LOAD R2 R1
ADD R2 R2 R31
STORE R2 R1
RETSUB

; ex.failed: -> R1 = 1 errore bat badago. aldatzen ditu R1
ex.failed:
REGSET R1 55
LOAD R1 R1
RETSUB

ex.expr:
PUSH R8
CALL ex.term
CALL ex.failed
IFNE R1 R30 ex.expr.ret
REGCOPY R8 R0
ex.expr.loop:
CALL ex.peek
REGSET R1 43
IFEQ R0 R1 ex.expr.add
REGSET R1 45
IFEQ R0 R1 ex.expr.sub
JUMP ex.expr.ret
ex.expr.add:
CALL ex.skip
CALL ex.term
CALL ex.failed
IFNE R1 R30 ex.expr.ret
ADD R8 R8 R0
JUMP ex.expr.loop
ex.expr.sub:
CALL ex.skip
CALL ex.term
CALL ex.failed
IFNE R1 R30 ex.expr.ret
SUB R8 R8 R0
JUMP ex.expr.loop
ex.expr.ret:
REGCOPY R0 R8
POP R8
RETSUB

ex.term:
PUSH R8
CALL ex.unary
CALL ex.failed
IFNE R1 R30 ex.term.ret
REGCOPY R8 R0
ex.term.loop:
CALL ex.peek
REGSET R1 42
IFEQ R0 R1 ex.term.mul
REGSET R1 47
IFEQ R0 R1 ex.term.div
JUMP ex.term.ret
ex.term.mul:
CALL ex.skip
CALL ex.unary
CALL ex.failed
IFNE R1 R30 ex.term.ret
MUL R8 R8 R0
JUMP ex.term.loop
ex.term.div:
CALL ex.skip
CALL ex.unary
CALL ex.failed
IFNE R1 R30 ex.term.ret
IFNE R0 R30 ex.term.divide
REGSET R0 3
CALL ex.err
JUMP ex.term.ret
ex.term.divide:
DIV R8 R8 R0
JUMP ex.term.loop
ex.term.ret:
REGCOPY R0 R8
POP R8
RETSUB

; ex.unary: habiaraketa zenbatu (expr.rs-eko MAX_DEPTH bera) eta ex.signed exekutatu
ex.unary:
REGSET R1 89
LOAD R2 R1
ADD R2 R2 R31
STORE R2 R1
IFGT R2 (100) ex.unary.deep
CALL ex.signed
REGSET R1 89
LOAD R2 R1
SUB R2 R2 R31
STORE R2 R1
RETSUB
ex.unary.deep:
REGSET R0 10
CALL ex.err
RETSUB

ex.signed:
CALL ex.peek
REGSET R1 45
IFEQ R0 R1 ex.unary.neg
REGSET R1 43
IFEQ R0 R1 ex.unary.pos
JUMP ex.power
ex.unary.neg:
CALL ex.skip
CALL ex.unary
; -x zeinu-bita aldatuta: -1 * x (0-tik -0)
MUL R0 R0 R29
RETSUB
ex.unary.pos:
CALL ex.skip
JUMP ex.unary

ex.power:
PUSH R8
CALL ex.atom
CALL ex.failed
IFNE R1 R30 ex.power.ret
REGCOPY R8 R0
CALL ex.peek
REGSET R1 94
IFNE R0 R1 ex.power.ret
CALL ex.skip
CALL ex.unary
CALL ex.failed
IFNE R1 R30 ex.power.ret
POW R8 R8 R0
ex.power.ret:
REGCOPY R0 R8
POP R8
RETSUB

ex.atom:
PUSH R8
PUSH R9
CALL ex.peek
IFNE R0 R29 ex.atom.some
REGSET R0 4
CALL ex.err
JUMP ex.atom.ret
ex.atom.some:
REGSET R1 40
IFNE R0 R1 ex.atom.num
CALL ex.skip
CALL ex.expr
CALL ex.failed
IFNE R1 R30 ex.atom.ret
REGCOPY R8 R0
CALL ex.peek
REGSET R1 41
IFEQ R0 R1 ex.atom.close
REGSET R0 5
CALL ex.err
JUMP ex.atom.ret
ex.atom.close:
CALL ex.skip
REGCOPY R0 R8
JUMP ex.atom.ret
ex.atom.num:
REGCOPY R9 R0
CALL isdigit
IFEQ R0 R31 ex.atom.number
REGSET R1 46
IFEQ R9 R1 ex.atom.number
REGSET R1 95
IFEQ R9 R1 ex.atom.name
REGCOPY R0 R9
CALL isletter
IFEQ R0 R31 ex.atom.name
; ustekabeko karakterea
REGSET R1 58
STORE R9 R1
REGSET R0 8
CALL ex.err
JUMP ex.atom.ret
ex.atom.number:
CALL ex.number
JUMP ex.atom.ret
ex.atom.name:
; izena: letrak, zenbakiak eta _
REGSET R0 53
LOAD R8 R0
REGCOPY R9 R8
ex.atom.scan:
ADD R9 R9 R31
REGSET R0 54
LOAD R0 R0
IFEQ R9 R0 ex.atom.named
LOAD R0 R9
REGSET R1 95
IFEQ R0 R1 ex.atom.scan
CALL isalnumu
IFEQ R0 R31 ex.atom.scan
ex.atom.named:
REGSET R0 53
STORE R9 R0
; CONST-en konstanteak lehenik, izen zehatzarekin
REGSET R0 84
LOAD R0 R0
REGCOPY R1 R8
SUB R2 R9 R8
REGSET R3 19
LOAD R3 R3
CALL htfind
IFEQ R1 R30 ex.atom.builtin
REGSET R2 2
ADD R2 R1 R2
LOAD R0 R2
JUMP ex.atom.ret
ex.atom.builtin:
REGCOPY R0 R8
SUB R1 R9 R8
PUSH R1
CALL fname
POP R1
IFNE R0 R30 ex.atom.known
REGSET R2 59
STORE R8 R2
REGSET R2 60
STORE R1 R2
REGSET R0 7
CALL ex.err
JUMP ex.atom.ret
ex.atom.known:
REGSET R1 1
IFEQ R0 R1 ex.atom.pi
REGSET R1 2
IFEQ R0 R1 ex.atom.tau
REGSET R1 3
IFEQ R0 R1 ex.atom.e
; funtzioa: parentesiak behar ditu
REGCOPY R8 R0
CALL ex.peek
REGSET R1 40
IFEQ R0 R1 ex.atom.call
REGSET R1 58
STORE R8 R1
REGSET R0 6
CALL ex.err
JUMP ex.atom.ret
ex.atom.call:
CALL ex.atom
CALL ex.failed
IFNE R1 R30 ex.atom.ret
REGSET R1 4
IFEQ R8 R1 ex.atom.sqrt
REGSET R1 5
IFEQ R8 R1 ex.atom.sin
REGSET R1 6
IFEQ R8 R1 ex.atom.cos
REGSET R1 7
IFEQ R8 R1 ex.atom.tan
REGSET R1 8
IFEQ R8 R1 ex.atom.exp
; ln: x <= 0 bada rust-ek -inf (0) edo NaN ematen du; makinak ez du onartzen, beraz hemen
IFGT R0 R30 ex.atom.log
IFEQ R0 R30 ex.atom.minf
CALL ex.nan
JUMP ex.atom.ret
ex.atom.minf:
CALL ex.inf
MUL R0 R0 R29
JUMP ex.atom.ret
ex.atom.log:
LOG R0 R0
JUMP ex.atom.ret
ex.atom.sqrt:
IFLT R0 R30 ex.atom.sqrtnan
SQRT R0 R0
JUMP ex.atom.ret
ex.atom.sqrtnan:
CALL ex.nan
JUMP ex.atom.ret
ex.atom.sin:
SIN R0 R0
JUMP ex.atom.ret
ex.atom.cos:
COS R0 R0
JUMP ex.atom.ret
ex.atom.tan:
TAN R0 R0
JUMP ex.atom.ret
ex.atom.exp:
EXP R0 R0
JUMP ex.atom.ret
ex.atom.pi:
REGSET R0 3.141592653589793
JUMP ex.atom.ret
ex.atom.tau:
REGSET R0 6.283185307179586
JUMP ex.atom.ret
ex.atom.e:
REGSET R0 2.718281828459045
ex.atom.ret:
POP R9
POP R8
RETSUB

; ex.inf / ex.nan: -> R0 = +inf / NaN. aldatzen ditu R0, R1
ex.inf:
REGSET R0 1e308
REGSET R1 10
MUL R0 R0 R1
RETSUB
ex.nan:
CALL ex.inf
SUB R0 R0 R0
RETSUB

; ex.number: digituak eta puntuak, aukeran e/E [+-] digituak -> R0 = balioa, zuzen biribilduta
ex.number:
PUSH R8
PUSH R9
REGSET R0 53
LOAD R8 R0
REGCOPY R9 R8
REGSET R0 54
LOAD R3 R0
ex.number.mant:
IFEQ R9 R3 ex.number.text
LOAD R0 R9
REGSET R1 46
IFEQ R0 R1 ex.number.mstep
PUSH R3
CALL isdigit
POP R3
IFEQ R0 R30 ex.number.exp
ex.number.mstep:
ADD R9 R9 R31
JUMP ex.number.mant
ex.number.exp:
LOAD R0 R9
REGSET R1 101
IFEQ R0 R1 ex.number.e
REGSET R1 69
IFNE R0 R1 ex.number.text
ex.number.e:
; berretzailea digituekin bakarrik ("2e" e konstantea zen, eta ez dago onartuta)
ADD R4 R9 R31
IFEQ R4 R3 ex.number.text
LOAD R0 R4
REGSET R1 43
IFEQ R0 R1 ex.number.sign
REGSET R1 45
IFNE R0 R1 ex.number.edig
ex.number.sign:
ADD R4 R4 R31
IFEQ R4 R3 ex.number.text
ex.number.edig:
LOAD R0 R4
PUSH R3
PUSH R4
CALL isdigit
POP R4
POP R3
IFEQ R0 R30 ex.number.text
REGCOPY R9 R4
ex.number.edigs:
IFEQ R9 R3 ex.number.text
LOAD R0 R9
PUSH R3
CALL isdigit
POP R3
IFEQ R0 R30 ex.number.text
ADD R9 R9 R31
JUMP ex.number.edigs
ex.number.text:
REGSET R0 53
STORE R9 R0
REGCOPY R0 R8
SUB R1 R9 R8
CALL decimal
IFEQ R0 R31 ex.number.ok
REGSET R0 59
STORE R8 R0
SUB R1 R9 R8
REGSET R0 60
STORE R1 R0
REGSET R0 9
CALL ex.err
JUMP ex.number.ret
ex.number.ok:
REGCOPY R0 R1
ex.number.ret:
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- zenbaki hamartarrak
; decimal: R0, R1 = testua ([0-9.]+ eta aukeran [eE][+-]?[0-9]+) -> R0 = 1 eta R1 = f64 zuzen biribildua
; (rust-en `str::parse::<f64>` bezala), edo R0 = 0 testua ez bada zenbaki bat. bide azkarra: 15 digitu arte eta
; |berretzailea| <= 22, eragiketa bakar zehatz batekin; bestela zatiketa osoa bigint-ekin, erdia bikoitira.
; aldagaiak: R8 kurtsorea, R9 amaiera, R10 digitu esanguratsuak, R11 zatiki-digituak, R12 berretzailea,
; R13 DIGP, R14 k10
decimal:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
PUSH R15
PUSH R16
PUSH R17
REGCOPY R8 R0
ADD R9 R0 R1
REGSET R10 0
REGSET R11 0
REGSET R12 0
REGSET R0 44
LOAD R13 R0
; R15 = puntua ikusi da, R16 = digituren bat
REGSET R15 0
REGSET R16 0
decimal.mant:
IFEQ R8 R9 decimal.mdone
LOAD R0 R8
REGSET R1 46
IFEQ R0 R1 decimal.dot
REGSET R1 48
IFLT R0 R1 decimal.mdone
REGSET R1 57
IFGT R0 R1 decimal.mdone
REGSET R1 48
SUB R0 R0 R1
REGSET R16 1
IFEQ R15 R30 decimal.nofrac
ADD R11 R11 R31
decimal.nofrac:
IFNE R10 R30 decimal.keep
IFEQ R0 R30 decimal.mstep
decimal.keep:
ADD R1 R13 R10
STORE R0 R1
ADD R10 R10 R31
JUMP decimal.mstep
decimal.dot:
IFEQ R15 R31 decimal.bad
REGSET R15 1
decimal.mstep:
ADD R8 R8 R31
JUMP decimal.mant
decimal.mdone:
IFEQ R16 R30 decimal.bad
IFEQ R8 R9 decimal.exp
; e/E, zeinua, digituak (asetuta 10^9-n)
ADD R8 R8 R31
REGSET R17 1
LOAD R0 R8
REGSET R1 43
IFEQ R0 R1 decimal.esign
REGSET R1 45
IFNE R0 R1 decimal.edig
REGSET R17 -1
decimal.esign:
ADD R8 R8 R31
decimal.edig:
IFEQ R8 R9 decimal.esigned
LOAD R0 R8
REGSET R1 48
SUB R0 R0 R1
REGSET R1 100000000
IFLT R12 R1 decimal.emore
REGSET R12 1000000000
JUMP decimal.estep
decimal.emore:
REGSET R1 10
MUL R12 R12 R1
ADD R12 R12 R0
decimal.estep:
ADD R8 R8 R31
JUMP decimal.edig
decimal.esigned:
MUL R12 R12 R17
decimal.exp:
IFEQ R10 R30 decimal.zero
; amaierako zeroak berretzailera
SUB R14 R12 R11
decimal.tz:
ADD R0 R13 R10
SUB R0 R0 R31
LOAD R0 R0
IFNE R0 R30 decimal.mag
SUB R10 R10 R31
ADD R14 R14 R31
JUMP decimal.tz
decimal.mag:
; balioa [10^(n-1+k), 10^(n+k)) tartean
ADD R0 R10 R14
REGSET R1 310
IFGT R0 R1 decimal.inf
IFEQ R0 R1 decimal.inf
REGSET R1 -324
IFGT R0 R1 decimal.path
JUMP decimal.zero
decimal.path:
REGSET R0 15
IFGT R10 R0 decimal.big
REGSET R0 22
IFGT R14 R0 decimal.big
REGSET R0 -22
IFLT R14 R0 decimal.big
; bide azkarra: M zehatza (< 10^15), 10^|k| zehatza, eragiketa bakarra
REGSET R0 0
REGSET R1 0
REGSET R2 10
decimal.fm:
IFEQ R1 R10 decimal.fk
MUL R0 R0 R2
ADD R3 R13 R1
LOAD R3 R3
ADD R0 R0 R3
ADD R1 R1 R31
JUMP decimal.fm
decimal.fk:
REGSET R1 65
LOAD R1 R1
IFLT R14 R30 decimal.fdiv
ADD R1 R1 R14
LOAD R1 R1
MUL R1 R0 R1
JUMP decimal.ok
decimal.fdiv:
SUB R1 R1 R14
LOAD R1 R1
DIV R1 R0 R1
JUMP decimal.ok
decimal.big:
REGCOPY R0 R13
REGCOPY R1 R10
REGCOPY R2 R14
CALL bigdec
REGCOPY R1 R0
JUMP decimal.ok
decimal.inf:
CALL ex.inf
REGCOPY R1 R0
JUMP decimal.ok
decimal.zero:
REGSET R1 0
decimal.ok:
REGSET R0 1
JUMP decimal.ret
decimal.bad:
REGSET R0 0
decimal.ret:
POP R17
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; bigdec: R0 = digituak (0..9), R1 = kopurua (lehena eta azkena ez 0), R2 = k10 -> R0 = digituak * 10^k10,
; zuzen biribilduta. q = floor(N * 2^s / D) 2^54..2^56 tartean, hondarra itsaskor gisa
bigdec:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
PUSH R15
PUSH R16
PUSH R17
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
; 800 digitu baino gehiago: lehen 800ak eta 1 bat (moztutako zatian beti dago 0 ez den digitu bat)
REGSET R0 800
IFGT R9 R0 bigdec.cut
JUMP bigdec.num
bigdec.cut:
SUB R1 R9 R0
SUB R1 R1 R31
ADD R10 R10 R1
ADD R1 R8 R0
STORE R31 R1
REGSET R9 801
bigdec.num:
; R11 = BIGR = N, R12 = BIGD = 1
REGSET R0 66
LOAD R11 R0
REGSET R0 67
LOAD R12 R0
STORE R30 R11
REGSET R13 0
bigdec.chunk:
IFEQ R13 R9 bigdec.scale
; 7 digitu arteko zatia
REGSET R14 0
REGSET R15 1
REGSET R0 7
bigdec.c7:
IFEQ R13 R9 bigdec.cput
IFEQ R0 R30 bigdec.cput
ADD R1 R8 R13
LOAD R1 R1
REGSET R2 10
MUL R14 R14 R2
ADD R14 R14 R1
MUL R15 R15 R2
ADD R13 R13 R31
SUB R0 R0 R31
JUMP bigdec.c7
bigdec.cput:
REGCOPY R0 R11
REGCOPY R1 R15
REGCOPY R2 R14
CALL bmuladd
JUMP bigdec.chunk
bigdec.scale:
REGCOPY R0 R12
REGSET R1 1
CALL bset
IFLT R10 R30 bigdec.den
REGCOPY R0 R11
REGCOPY R1 R10
CALL bpow10
JUMP bigdec.shift
bigdec.den:
REGCOPY R0 R12
MUL R1 R10 R29
CALL bpow10
bigdec.shift:
; s = 55 - (bitlen(N) - bitlen(D))
REGCOPY R0 R11
CALL bbitlen
REGCOPY R13 R0
REGCOPY R0 R12
CALL bbitlen
SUB R13 R13 R0
REGSET R0 55
SUB R13 R0 R13
IFLT R13 R30 bigdec.shd
REGCOPY R0 R11
REGCOPY R1 R13
CALL bshl
JUMP bigdec.div
bigdec.shd:
REGCOPY R0 R12
MUL R1 R13 R29
CALL bshl
bigdec.div:
; zatiketa bitez bit: D * 2^55-etik behera
REGCOPY R0 R12
REGSET R1 55
CALL bshl
REGSET R14 0
REGSET R15 0
REGSET R16 134217728
REGSET R17 56
bigdec.bit:
IFEQ R17 R30 bigdec.round
REGCOPY R0 R11
REGCOPY R1 R12
CALL bcmp
IFLT R0 R30 bigdec.nobit
REGCOPY R0 R11
REGCOPY R1 R12
CALL bsub
REGSET R0 28
IFGT R17 R0 bigdec.hibit
ADD R15 R15 R16
JUMP bigdec.nobit
bigdec.hibit:
ADD R14 R14 R16
bigdec.nobit:
REGCOPY R0 R12
CALL bshr1
SUB R17 R17 R31
; 2^k: goiko zatian 2^27..2^0, gero berriz 2^27..2^0 behekoan
REGSET R0 28
IFEQ R17 R0 bigdec.lowhalf
REGSET R0 0.5
MUL R16 R16 R0
JUMP bigdec.bit
bigdec.lowhalf:
REGSET R16 134217728
JUMP bigdec.bit
bigdec.round:
; R14 = q-ren goiko 28 bitak, R15 = behekoak; L = 56 bit 55 piztuta badago, bestela 55
REGSET R0 55
REGSET R1 134217728
IFLT R14 R1 bigdec.l55
REGSET R0 56
bigdec.l55:
; e2 = L - 1 - s; desplazamendua = L - 53, gehi azpinormaletan -1022 - e2
SUB R1 R0 R31
SUB R1 R1 R13
REGSET R2 53
SUB R2 R0 R2
REGSET R3 -1022
IFLT R1 R3 bigdec.sub
JUMP bigdec.shifted
bigdec.sub:
SUB R3 R3 R1
ADD R2 R2 R3
bigdec.shifted:
; R2 = desplazamendua (2..60)
REGSET R0 58
IFGT R2 R0 bigdec.tiny
REGCOPY R16 R2
; itsaskorra: hondarra ez da 0
REGSET R17 0
LOAD R0 R11
IFEQ R0 R30 bigdec.split
REGSET R17 1
bigdec.split:
REGSET R0 28
IFGT R16 R0 bigdec.wide
; desplazamendua <= 28: m = hi * 2^(28-d) + lo >> d; behekoak = lo mod 2^d, erdia = 2^(d-1)
SUB R0 R0 R16
SHL R1 R31 R0
MUL R3 R14 R1
SHR R4 R15 R16
ADD R3 R3 R4
SHL R5 R31 R16
SUB R5 R5 R31
ANDBITS R4 R15 R5
SUB R5 R16 R31
SHL R5 R31 R5
; konparazioa: R6 = sign(behekoak - erdia)
REGSET R6 0
IFEQ R4 R5 bigdec.rounding
REGSET R6 1
IFGT R4 R5 bigdec.rounding
REGSET R6 -1
JUMP bigdec.rounding
bigdec.wide:
; desplazamendua > 28: t = d - 28; m = hi >> t; behekoak = (hi mod 2^t) * 2^28 + lo, erdia = 2^(t-1) * 2^28
SUB R0 R16 R0
SHR R3 R14 R0
SHL R5 R31 R0
SUB R5 R5 R31
ANDBITS R4 R14 R5
SUB R5 R0 R31
SHL R5 R31 R5
REGSET R6 1
IFGT R4 R5 bigdec.rounding
REGSET R6 -1
IFLT R4 R5 bigdec.rounding
REGSET R6 0
IFEQ R15 R30 bigdec.rounding
REGSET R6 1
bigdec.rounding:
; gora: behekoak > erdia, edo berdinak eta (itsaskorra edo m bakoitia)
IFGT R6 R30 bigdec.up
IFLT R6 R30 bigdec.value
IFEQ R17 R31 bigdec.up
ANDBITS R0 R3 R31
IFEQ R0 R30 bigdec.value
bigdec.up:
ADD R3 R3 R31
bigdec.value:
; balioa = m * 2^(desplazamendua - s), zehazki
REGCOPY R0 R3
SUB R1 R16 R13
CALL scale2
JUMP bigdec.ret
bigdec.tiny:
REGSET R0 0
bigdec.ret:
POP R17
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; scale2: R0 = x, R1 = t -> R0 = x * 2^t, urratsez urrats (tarteko balio guztiak zehatzak dira, emaitza baino
; handiagoak edo berdinak baitira). aldatzen ditu R0-R3
scale2:
REGSET R2 64
REGSET R3 18446744073709551616
scale2.up64:
IFLT R1 R2 scale2.up1
MUL R0 R0 R3
SUB R1 R1 R2
JUMP scale2.up64
scale2.up1:
IFGT R1 R30 scale2.up1do
JUMP scale2.down
scale2.up1do:
ADD R0 R0 R0
SUB R1 R1 R31
JUMP scale2.up1
scale2.down:
REGSET R2 -64
REGSET R3 5.421010862427522e-20
scale2.dn64:
IFGT R1 R2 scale2.dn1
MUL R0 R0 R3
REGSET R2 64
ADD R1 R1 R2
REGSET R2 -64
JUMP scale2.dn64
scale2.dn1:
IFLT R1 R30 scale2.dn1do
RETSUB
scale2.dn1do:
REGSET R2 0.5
MUL R0 R0 R2
ADD R1 R1 R31
REGSET R2 -64
JUMP scale2.dn1

; ---------------------------------------------------------------- bigint-ak
; [n, zati0, zati1, ...]: 24 biteko zatiak, txikiena lehenik

; bset: R0 = bigint, R1 = balioa (< 2^24). aldatzen ditu R2
bset:
STORE R30 R0
IFEQ R1 R30 bset.done
STORE R31 R0
ADD R2 R0 R31
STORE R1 R2
bset.done:
RETSUB

; bmuladd: R0 = bigint, R1 = m (<= 10^7), R2 = a (< 2^24) -> bigint * m + a. aldatzen ditu R0-R7
bmuladd:
PUSH R8
PUSH R9
REGCOPY R8 R0
REGCOPY R9 R1
LOAD R3 R8
REGSET R4 1
REGCOPY R5 R2
REGSET R6 16777215
REGSET R7 24
bmuladd.next:
IFGT R4 R3 bmuladd.carry
ADD R0 R8 R4
LOAD R1 R0
MUL R1 R1 R9
ADD R1 R1 R5
ANDBITS R2 R1 R6
STORE R2 R0
SHR R5 R1 R7
ADD R4 R4 R31
JUMP bmuladd.next
bmuladd.carry:
IFEQ R5 R30 bmuladd.done
ADD R3 R3 R31
ADD R0 R8 R3
ANDBITS R2 R5 R6
STORE R2 R0
SHR R5 R5 R7
JUMP bmuladd.carry
bmuladd.done:
STORE R3 R8
POP R9
POP R8
RETSUB

; bpow10: R0 = bigint, R1 = k -> bigint * 10^k. aldatzen ditu R0-R7
bpow10:
PUSH R8
PUSH R9
REGCOPY R8 R0
REGCOPY R9 R1
bpow10.seven:
REGSET R0 7
IFLT R9 R0 bpow10.rest
REGCOPY R0 R8
REGSET R1 10000000
REGSET R2 0
CALL bmuladd
REGSET R0 7
SUB R9 R9 R0
JUMP bpow10.seven
bpow10.rest:
IFEQ R9 R30 bpow10.done
REGSET R0 65
LOAD R0 R0
ADD R0 R0 R9
LOAD R1 R0
REGCOPY R0 R8
REGSET R2 0
CALL bmuladd
bpow10.done:
POP R9
POP R8
RETSUB

; bbitlen: R0 = bigint -> R0 = bit-kopurua. aldatzen ditu R0-R3
bbitlen:
LOAD R1 R0
IFEQ R1 R30 bbitlen.zero
ADD R2 R0 R1
LOAD R2 R2
REGSET R3 0
bbitlen.loop:
IFEQ R2 R30 bbitlen.done
SHR R2 R2 R31
ADD R3 R3 R31
JUMP bbitlen.loop
bbitlen.done:
SUB R1 R1 R31
REGSET R0 24
MUL R0 R1 R0
ADD R0 R0 R3
RETSUB
bbitlen.zero:
REGSET R0 0
RETSUB

; bshl: R0 = bigint, R1 = k -> bigint * 2^k. aldatzen ditu R0-R7
bshl:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
LOAD R9 R8
IFEQ R9 R30 bshl.done
; zati osoak (k div 24) eta bitak (k mod 24)
REGSET R2 24
DIV R10 R1 R2
REGSET R3 0
SHR R10 R10 R3
MUL R3 R10 R2
SUB R11 R1 R3
IFEQ R11 R30 bshl.limbs
SHL R6 R31 R11
REGSET R5 0
REGSET R4 1
REGSET R7 16777215
bshl.bits:
IFGT R4 R9 bshl.bcarry
ADD R0 R8 R4
LOAD R1 R0
MUL R1 R1 R6
ADD R1 R1 R5
ANDBITS R2 R1 R7
STORE R2 R0
REGSET R2 24
SHR R5 R1 R2
ADD R4 R4 R31
JUMP bshl.bits
bshl.bcarry:
IFEQ R5 R30 bshl.limbs
ADD R9 R9 R31
ADD R0 R8 R9
STORE R5 R0
bshl.limbs:
IFEQ R10 R30 bshl.store
REGCOPY R4 R9
bshl.move:
IFEQ R4 R30 bshl.zeros
ADD R0 R8 R4
LOAD R1 R0
ADD R0 R0 R10
STORE R1 R0
SUB R4 R4 R31
JUMP bshl.move
bshl.zeros:
REGSET R4 1
bshl.z:
IFGT R4 R10 bshl.n
ADD R0 R8 R4
STORE R30 R0
ADD R4 R4 R31
JUMP bshl.z
bshl.n:
ADD R9 R9 R10
bshl.store:
STORE R9 R8
bshl.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; bshr1: R0 = bigint -> bigint / 2 (beherantz). aldatzen ditu R1-R7
bshr1:
LOAD R1 R0
REGCOPY R2 R1
REGSET R3 0
REGSET R6 16777216
bshr1.loop:
IFEQ R2 R30 bshr1.trim
ADD R4 R0 R2
LOAD R5 R4
MUL R7 R3 R6
ADD R5 R5 R7
ANDBITS R3 R5 R31
SHR R5 R5 R31
STORE R5 R4
SUB R2 R2 R31
JUMP bshr1.loop
bshr1.trim:
IFEQ R1 R30 bshr1.done
ADD R4 R0 R1
LOAD R5 R4
IFNE R5 R30 bshr1.done
SUB R1 R1 R31
JUMP bshr1.trim
bshr1.done:
STORE R1 R0
RETSUB

; bcmp: R0 = a, R1 = b -> R0 = 1 (a > b), 0 (berdinak), -1 (a < b). aldatzen ditu R0-R5
bcmp:
LOAD R2 R0
LOAD R3 R1
IFGT R2 R3 bcmp.gt
IFLT R2 R3 bcmp.lt
bcmp.loop:
IFEQ R2 R30 bcmp.eq
ADD R4 R0 R2
LOAD R4 R4
ADD R5 R1 R2
LOAD R5 R5
IFGT R4 R5 bcmp.gt
IFLT R4 R5 bcmp.lt
SUB R2 R2 R31
JUMP bcmp.loop
bcmp.gt:
REGSET R0 1
RETSUB
bcmp.lt:
REGSET R0 -1
RETSUB
bcmp.eq:
REGSET R0 0
RETSUB

; bsub: R0 = a, R1 = b (a >= b) -> a - b a-n. aldatzen ditu R2-R7
bsub:
PUSH R8
LOAD R2 R0
LOAD R3 R1
REGSET R4 1
REGSET R5 0
REGSET R7 16777216
bsub.loop:
IFGT R4 R2 bsub.trim
ADD R8 R0 R4
LOAD R6 R8
SUB R6 R6 R5
IFGT R4 R3 bsub.nob
ADD R5 R1 R4
LOAD R5 R5
SUB R6 R6 R5
bsub.nob:
REGSET R5 0
IFLT R6 R30 bsub.borrow
JUMP bsub.put
bsub.borrow:
ADD R6 R6 R7
REGSET R5 1
bsub.put:
STORE R6 R8
ADD R4 R4 R31
JUMP bsub.loop
bsub.trim:
IFEQ R2 R30 bsub.done
ADD R6 R0 R2
LOAD R6 R6
IFNE R6 R30 bsub.done
SUB R2 R2 R31
JUMP bsub.trim
bsub.done:
STORE R2 R0
POP R8
RETSUB

; ---------------------------------------------------------------- eragiketak sortu
; vget: R0 = eragigaiaren zenbakia -> R0 = mota, R1 = a, R2 = b, R3 = c. aldatzen ditu R0-R4
vget:
REGSET R4 73
LOAD R4 R4
ADD R0 R0 R0
ADD R0 R0 R0
ADD R4 R4 R0
LOAD R0 R4
ADD R4 R4 R31
LOAD R1 R4
ADD R4 R4 R31
LOAD R2 R4
ADD R4 R4 R31
LOAD R3 R4
RETSUB

; vidx: R0 = eragigaia -> R0 = haren indizea (a). aldatzen ditu R0-R4
vidx:
CALL vget
REGCOPY R0 R1
RETSUB

; vflt: R0 = eragigaia, R1 = lehenetsia -> R0 = zenbakia (falta bada, lehenetsia). aldatzen ditu R0-R5
vflt:
REGCOPY R5 R1
CALL vget
IFEQ R0 R30 vflt.default
REGCOPY R0 R1
RETSUB
vflt.default:
REGCOPY R0 R5
RETSUB

; vtok: R0 = eragigaia -> R0 = haren taldeko lehen tokena, edo burua talde hutsa bada. aldatzen ditu R0-R2
vtok:
REGSET R1 74
LOAD R1 R1
ADD R0 R0 R0
ADD R1 R1 R0
LOAD R0 R1
ADD R1 R1 R31
LOAD R1 R1
IFEQ R1 R30 vtok.head
REGSET R1 3
MUL R0 R0 R1
REGSET R1 75
LOAD R1 R1
ADD R0 R1 R0
RETSUB
vtok.head:
REGSET R0 83
LOAD R0 R0
RETSUB

; oidx: R0 = eragigaia -> haren indizea u32 gisa. aldatzen ditu R0-R7
oidx:
CALL vidx
JUMP ou32

; oflt: R0 = eragigaia, R1 = lehenetsia -> f64. aldatzen ditu R0-R7
oflt:
CALL vflt
JUMP of64

; odest: R0 = eragigaia -> Dest (Own 0, Bit 1 n, Reg 2 n). aldatzen ditu R0-R7
odest:
CALL vget
IFEQ R0 R30 odest.own
PUSH R2
REGCOPY R0 R1
CALL ou32
POP R0
JUMP ou32
odest.own:
REGSET R0 0
JUMP ou32

; oopt: R0 = eragigaia -> Option<u32> (0, edo 1 eta erregistroa). aldatzen ditu R0-R7
oopt:
CALL vget
IFEQ R0 R30 oopt.none
PUSH R1
REGSET R0 1
CALL ob
POP R0
JUMP ou32
oopt.none:
REGSET R0 0
JUMP ob

; olist: R0 = eragigaia -> Vec<u32>: u64 kopurua eta balioak. aldatzen ditu R0-R7
olist:
PUSH R8
PUSH R9
CALL vget
REGCOPY R8 R1
REGCOPY R9 R2
IFNE R0 R30 olist.go
REGSET R9 0
olist.go:
REGCOPY R0 R9
CALL ou64
olist.next:
IFEQ R9 R30 olist.done
LOAD R0 R8
CALL ou32
ADD R8 R8 R31
SUB R9 R9 R31
JUMP olist.next
olist.done:
POP R9
POP R8
RETSUB

; ogate: R0 = atearen aldaera (0..14), R1-R3 = parametroak -> Gate. aldatzen ditu R0-R7
ogate:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGCOPY R11 R3
CALL ou32
REGSET R0 10
IFLT R8 R0 ogate.done
REGCOPY R0 R9
CALL of64
REGSET R0 14
IFLT R8 R0 ogate.done
REGCOPY R0 R10
CALL of64
REGCOPY R0 R11
CALL of64
ogate.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; opnew: R0 = Op-en aldaera -> eragiketa berria hasi eta aldaera idatzi (61-etik aurrera 2. formatua,
; 71-tik aurrera 3.a). R0 = eragiketaren indizea. aldatzen ditu R0-R7
opnew:
PUSH R8
PUSH R9
REGCOPY R8 R0
CALL opbegin
REGCOPY R9 R0
IFLT R8 (61) opnew.v1
CALL setv2
IFLT R8 (71) opnew.v1
CALL setv3
opnew.v1:
REGCOPY R0 R8
CALL ou32
REGCOPY R0 R9
POP R9
POP R8
RETSUB

; distinct: R0 = [balioa, taldea] bikoteak, R1 = kopurua, R2 = 1 qubitak / 0 moduak -> R0 = 1 desberdinak badira;
; bestela errorea (lehen errepikapena, haren taldeko tokenean). aldatzen ditu R0-R7
distinct:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
; ikusitakoen hash-taula: 2^k >= 2n zirrikitu, balioa + 1
REGSET R11 2
distinct.size:
ADD R0 R9 R9
IFGT R11 R0 distinct.alloc
ADD R11 R11 R11
JUMP distinct.size
distinct.alloc:
REGCOPY R0 R11
CALL alloc
REGCOPY R12 R0
SUB R11 R11 R31
distinct.next:
IFEQ R9 R30 distinct.ok
LOAD R2 R8
ADD R3 R2 R31
ANDBITS R4 R2 R11
distinct.probe:
ADD R5 R12 R4
LOAD R6 R5
IFEQ R6 R30 distinct.put
IFEQ R6 R3 distinct.dup
ADD R4 R4 R31
ANDBITS R4 R4 R11
JUMP distinct.probe
distinct.put:
STORE R3 R5
REGSET R0 2
ADD R8 R8 R0
SUB R9 R9 R31
JUMP distinct.next
distinct.dup:
; R2 = balioa; tokena haren taldetik
PUSH R2
ADD R0 R8 R31
LOAD R0 R0
CALL vtok
REGSET R1 57
IFEQ R10 R30 distinct.msg
REGSET R1 56
distinct.msg:
CALL diagtok
REGSET R1 82
LOAD R2 R1
REGSET R1 4
CALL dset
POP R2
REGSET R1 5
CALL dset
REGSET R0 0
JUMP distinct.ret
distinct.ok:
REGSET R0 1
distinct.ret:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; ipair: R0 = bikote-taula, R1 = posizioa, R2 = eragigaia (indizea) -> [indizea, eragigaia]. aldatzen ditu R0-R7
ipair:
PUSH R8
PUSH R9
ADD R8 R1 R1
ADD R8 R0 R8
REGCOPY R9 R2
REGCOPY R0 R2
CALL vidx
STORE R0 R8
ADD R8 R8 R31
STORE R9 R8
POP R9
POP R8
RETSUB

; ilist: R0 = bikote-taula, R1 = posizioa, R2 = eragigaia (zerrenda) -> balio guztiak [balioa, eragigaia];
; R0 = posizio berria. aldatzen ditu R0-R7
ilist:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGCOPY R0 R2
CALL vget
REGCOPY R11 R1
REGCOPY R7 R2
ilist.next:
IFEQ R7 R30 ilist.done
ADD R0 R9 R9
ADD R0 R8 R0
LOAD R1 R11
STORE R1 R0
ADD R0 R0 R31
STORE R10 R0
ADD R9 R9 R31
ADD R11 R11 R31
SUB R7 R7 R31
JUMP ilist.next
ilist.done:
REGCOPY R0 R9
POP R11
POP R10
POP R9
POP R8
RETSUB

; dist2 / dist3 / dist4: lehen 2, 3 edo 4 eragigaiak (indizeak) desberdinak. R0 = 1 qubitak / 0 moduak ->
; R0 = 1 ondo. aldatzen ditu R0-R7
dist2:
REGSET R1 2
JUMP distn
dist3:
REGSET R1 3
JUMP distn
dist4:
REGSET R1 4
distn:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
ADD R0 R9 R9
CALL alloc
REGCOPY R10 R0
REGSET R11 0
distn.next:
IFEQ R11 R9 distn.check
REGCOPY R0 R10
REGCOPY R1 R11
REGCOPY R2 R11
CALL ipair
ADD R11 R11 R31
JUMP distn.next
distn.check:
REGCOPY R0 R10
REGCOPY R1 R9
REGCOPY R2 R8
CALL distinct
POP R11
POP R10
POP R9
POP R8
RETSUB

; distlist: R0 = zerrendaren eragigaia, R1 = 1 qubitak / 0 moduak, R2 = -1 edo amaierako indize baten eragigaia
; -> R0 = 1 desberdinak. aldatzen ditu R0-R7
distlist:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
CALL vget
ADD R0 R2 R31
ADD R0 R0 R0
CALL alloc
REGCOPY R11 R0
REGCOPY R0 R11
REGSET R1 0
REGCOPY R2 R8
CALL ilist
IFEQ R10 R29 distlist.check
REGCOPY R1 R0
PUSH R1
REGCOPY R0 R11
REGCOPY R2 R10
CALL ipair
POP R0
ADD R0 R0 R31
distlist.check:
REGCOPY R1 R0
REGCOPY R0 R11
REGCOPY R2 R9
CALL distinct
POP R11
POP R10
POP R9
POP R8
RETSUB

; build: R0 = zehaztapena, R1 = burua -> eraikitzailearen arabera (buildtext). aldagaiak: R8 zehaztapena,
; R9 parametroa
build:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGSET R0 15
ADD R0 R8 R0
LOAD R9 R0
REGSET R0 14
ADD R0 R8 R0
LOAD R10 R0
REGSET R0 1
IFEQ R10 R0 b.g1
REGSET R0 2
IFEQ R10 R0 b.g1f
REGSET R0 3
IFEQ R10 R0 b.u
REGSET R0 4
IFEQ R10 R0 b.rot
REGSET R0 5
IFEQ R10 R0 b.mrot
REGSET R0 6
IFEQ R10 R0 b.gate
REGSET R0 7
IFEQ R10 R0 b.c1
REGSET R0 8
IFEQ R10 R0 b.c1f
REGSET R0 9
IFEQ R10 R0 b.cu
REGSET R0 10
IFEQ R10 R0 b.cph
REGSET R0 11
IFEQ R10 R0 b.swap
REGSET R0 12
IFEQ R10 R0 b.cswap
REGSET R0 13
IFEQ R10 R0 b.ccx
REGSET R0 14
IFEQ R10 R0 b.mcx
REGSET R0 15
IFEQ R10 R0 b.mcz
REGSET R0 16
IFEQ R10 R0 b.bell
REGSET R0 17
IFEQ R10 R0 b.multi
REGSET R0 18
IFEQ R10 R0 b.eswap
REGSET R0 19
IFEQ R10 R0 b.measure
REGSET R0 20
IFEQ R10 R0 b.measurein
REGSET R0 21
IFEQ R10 R0 b.noop
REGSET R0 22
IFEQ R10 R0 b.idx1
REGSET R0 23
IFEQ R10 R0 b.idx2
REGSET R0 24
IFEQ R10 R0 b.idx3
REGSET R0 25
IFEQ R10 R0 b.tobasis
REGSET R0 26
IFEQ R10 R0 b.of2
REGSET R0 27
IFEQ R10 R0 b.modephase
REGSET R0 28
IFEQ R10 R0 b.kerr
REGSET R0 29
IFEQ R10 R0 b.mode2
REGSET R0 30
IFEQ R10 R0 b.loss
REGSET R0 31
IFEQ R10 R0 b.fock
REGSET R0 32
IFEQ R10 R0 b.single
REGSET R0 33
IFEQ R10 R0 b.count
REGSET R0 34
IFEQ R10 R0 b.odest
REGSET R0 35
IFEQ R10 R0 b.coinc
REGSET R0 36
IFEQ R10 R0 b.dispersive
REGSET R0 37
IFEQ R10 R0 b.expect
REGSET R0 38
IFEQ R10 R0 b.bellcheck
REGSET R0 39
IFEQ R10 R0 b.meanphoton
REGSET R0 40
IFEQ R10 R0 b.regset
REGSET R0 41
IFEQ R10 R0 b.bin
REGSET R0 42
IFEQ R10 R0 b.un
REGSET R0 43
IFEQ R10 R0 b.seed
REGSET R0 44
IFEQ R10 R0 b.charload
REGSET R0 45
IFEQ R10 R0 b.packbits
REGSET R0 46
IFEQ R10 R0 b.jump
REGSET R0 47
IFEQ R10 R0 b.jumpif
REGSET R0 48
IFEQ R10 R0 b.branch
REGSET R0 49
IFEQ R10 R0 b.loopstart
REGSET R0 50
IFEQ R10 R0 b.loopend
REGSET R0 51
IFEQ R10 R0 b.print
REGSET R0 52
IFEQ R10 R0 b.printf
REGSET R0 53
IFEQ R10 R0 b.log
REGSET R0 54
IFEQ R10 R0 b.storetext
REGSET R0 55
IFEQ R10 R0 b.stream
REGSET R0 56
IFEQ R10 R0 b.exit
REGSET R0 57
IFEQ R10 R0 b.regcopy
REGSET R0 58
IFEQ R10 R0 b.load
REGSET R0 59
IFEQ R10 R0 b.store
REGSET R0 60
IFEQ R10 R0 b.push
REGSET R0 61
IFEQ R10 R0 b.charout
REGSET R0 62
IFEQ R10 R0 b.putc
REGSET R0 63
IFEQ R10 R0 b.argbyte
JUMP b.done

b.g1:
; Gate { q, atea }
REGSET R0 0
CALL opnew
REGSET R0 0
CALL oidx
REGCOPY R0 R9
CALL ogate
JUMP b.done
b.g1f:
REGSET R0 0
CALL opnew
REGSET R0 0
CALL oidx
REGSET R0 1
REGSET R1 0
CALL vflt
REGCOPY R1 R0
REGCOPY R0 R9
CALL ogate
JUMP b.done
b.u:
REGSET R0 0
CALL opnew
REGSET R0 0
CALL oidx
CALL b.uparams
REGSET R0 14
CALL ogate
JUMP b.done
; b.uparams: 1-3 eragigaiak (lehenetsia 0) R1-R3-n; CU-rentzat 2-4 (R11 = desplazamendua)
b.uparams:
REGSET R11 0
b.uparams2:
ADD R0 R11 R31
REGSET R1 0
CALL vflt
PUSH R0
ADD R0 R11 R31
ADD R0 R0 R31
REGSET R1 0
CALL vflt
PUSH R0
REGSET R0 3
ADD R0 R11 R0
REGSET R1 0
CALL vflt
REGCOPY R3 R0
POP R2
POP R1
RETSUB
b.rot:
REGSET R0 0
CALL opnew
REGSET R0 0
CALL oidx
REGSET R0 2
REGSET R1 0
CALL vflt
PUSH R0
REGSET R0 1
CALL vidx
REGSET R1 10
ADD R0 R0 R1
POP R1
CALL ogate
JUMP b.done
b.mrot:
REGSET R0 2
REGSET R1 1
REGSET R2 -1
CALL distlist
IFEQ R0 R30 b.done
REGSET R0 2
CALL vget
REGCOPY R10 R1
REGCOPY R11 R2
b.mrot.next:
IFEQ R11 R30 b.done
REGSET R0 0
CALL opnew
LOAD R0 R10
CALL ou32
REGSET R0 1
REGSET R1 0
CALL vflt
PUSH R0
REGSET R0 0
CALL vidx
REGSET R1 10
ADD R0 R0 R1
POP R1
CALL ogate
ADD R10 R10 R31
SUB R11 R11 R31
JUMP b.mrot.next
b.gate:
REGSET R0 0
CALL vget
REGCOPY R10 R1
REGCOPY R11 R2
REGCOPY R0 R10
REGCOPY R1 R11
CALL gatename
IFNE R0 R29 b.gate.ok
REGSET R0 0
CALL vtok
REGSET R1 58
CALL diagtok
