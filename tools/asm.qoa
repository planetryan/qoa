; QOA-ren mihiztatzailea, QOAn idatzia (QOA 0.4.4). QOA-k QOA eraikitzen du: programa honek .qoa iturburu
; bat .qx bitar bihurtzen du, `qoa compile`-k bezala, byte berberak idatziz, eta akatsak daudenean errore
; berberak inprimatzen ditu, testu berberarekin, bi hizkuntzetan.
;
;   qoa compile --assembler tools/asm.qoa programa.qoa      (qoa-k iturburua eta izena ematen dizkio)
;   qoa compile tools/asm.qoa                               (mihiztatzailea bera, rust-en mihiztatzailearekin)
;   qoa run tools/asm.qx --quiet -- programa.qoa < programa.qoa > programa.qx
;
; sarrera: iturburua sarrera estandarrean; 0. argumentua fitxategi-izena da (.qx-an gordetzen da).
; irteera: .qx-a irteera estandarrean; erroreak errore-irteeran, eta EXIT 1.
;
; erregistroen ohitura:
;   R0-R7   argumentuak, emaitzak eta behin-behinekoak: edozein deik alda ditzake
;   R8-R24  deiek gordetzen dituzte: erabiltzen dituen errutinak PUSH/POP egiten ditu
;   R28 hizkuntza (1 euskara, 0 ingelesa)   R29 = -1   R30 = 0   R31 = 1
;
; memoria-mapa (gelaxkak; idatzi gabeak 0):
;   0 HP hurrengo gelaxka librea (ez da inoiz askatzen)
;   1 NAMEP 2 NAMEN fitxategi-izena (byteak)        3 CHP 4 CHN iturburua kode-puntutan
;   5 LINEP 6 NLINES lerroak: [hasiera, amaiera)   7 MAXLEN lerro luzeena
;   8 SPECP 9 NSPECS aginduak (24 gelaxka bakoitza) 10 MNHT 11 MNMASK izen eta ezizenen hash-taula
;   13 LNV eragiketen lerroak 14 NOPS eragiketa-kopurua
;   15 DIAGV diagnostikoak 16 NDIAG                 17 FIXV jauzi-zuzenketak
;   18 LBLHT etiketak 19 HTMASK 20 LNHT etiketa-izenak (1. pasaldia)
;   21 NAMEDHT izendun erregistroak 22 NAMEDV haien ordena   23 LOOPP 24 LOOPN begizta-pila
;   25 DECLQ (-1 ez) 26 DECLMN (-1 ez) 27 DECLMC 28 DECLMD
;   29 MAXQ 30 MAXM 31 MAXB (-1 ez)   32 QREP 33 QLINE 34 QLIMREP
;   35 NEXTQ 36 NEXTC 37 NEXTO   38 FMT (formatua ken 1)   39 CURLINE
;   40 TOKP 41 NTOK uneko lerroaren tokenak   42 SCR1 43 SCR2 44 DIGP lerro-luzerako bufferrak
;   45 BEST 46 NBEST 47 SEQ diagnostiko txikienak   48 FNAMES adierazpenetako izenak
;   49 ALPHAP 50 NALPHA 51 ALNUMP 52 NALNUM unicode-taulak
;   53 EPOS 54 EEND 55 EERR 56 ESRC 57 ESRCN 58 EP1 59 EP2 60 EP3   adierazpenaren egoera
;   61 OCUR 62 OEND 63 OTAIL 64 OHEAD   eragiketen byte-korrontea
;   65 P10 10^0..10^22   66 BIGR 67 BIGD 68 BIGT bigint-ak   69 P2_32 70 N2_32 71 P2_64 72 N2_64
;   73 VALP balioak (eragigai bakoitzeko 4 gelaxka) 74 GRPP taldeak 75 TP 76 NT 77 ABP geziak
;   78 LISTP 79 NLIST   84 CONSTHT konstanteak 85 NEXTR 86 CONSTV haien ordena 87 "value" 88 erabili gabea
;   89 EDEPTH adierazpenaren habiaraketa (ex.unary aktiboak)
;   1000-tik aurrera: memoria dinamikoa

; ---------------------------------------------------------------- nagusia
main:
REGSET R29 -1
REGSET R30 0
REGSET R31 1
GETLANG R28
REGSET R0 0
REGSET R1 1000
STORE R1 R0
CALL readname
CALL readsource
CALL decode
CALL splitlines
CALL setup
CALL isaload
CALL pass1
CALL fit
CALL clash
CALL pass2
CALL post
REGSET R0 16
LOAD R0 R0
IFGT R0 R30 main.fail
CALL output
EXIT 0
main.fail:
CALL report
EXIT 1

; ---------------------------------------------------------------- memoria
; alloc: R0 = gelaxka-kopurua -> R0 = haien hasiera. aldatzen ditu R0-R3
alloc:
REGSET R1 0
LOAD R2 R1
ADD R3 R2 R0
STORE R3 R1
REGCOPY R0 R2
RETSUB

; vnew: -> R0 = bektore huts baten goiburua [kopurua, lehen zatia, azken zatia, azkenean erabilitakoak].
; zati bakoitza 4096 gelaxka: [hurrengoa, 4095 balio]. aldatzen ditu R0-R5
vnew:
REGSET R0 4
CALL alloc
REGCOPY R4 R0
REGSET R0 4096
CALL alloc
ADD R5 R4 R31
STORE R0 R5
ADD R5 R5 R31
STORE R0 R5
REGCOPY R0 R4
RETSUB

; vpush: R0 = goiburua, R1 = balioa. aldatzen ditu R0-R7
vpush:
REGCOPY R6 R0
REGCOPY R7 R1
REGSET R2 3
ADD R2 R6 R2
LOAD R5 R2
REGSET R3 4095
IFLT R5 R3 vpush.room
REGSET R0 4096
CALL alloc
REGSET R2 2
ADD R2 R6 R2
LOAD R3 R2
STORE R0 R3
STORE R0 R2
REGSET R5 0
vpush.room:
REGSET R2 2
ADD R2 R6 R2
LOAD R3 R2
ADD R4 R3 R5
ADD R4 R4 R31
STORE R7 R4
ADD R5 R5 R31
REGSET R2 3
ADD R2 R6 R2
STORE R5 R2
LOAD R5 R6
ADD R5 R5 R31
STORE R5 R6
RETSUB

; vfirst: R0 = goiburua -> R0 = lehen balioaren helbidea, R1 = zati horren amaiera (erabilitakoen ondoren),
; R2 = geratzen diren balioak. vnext-ekin batera: R0 = uneko helbidea. aldatzen ditu R0-R4
vfirst:
LOAD R2 R0
ADD R3 R0 R31
LOAD R3 R3
ADD R0 R3 R31
REGSET R4 4096
ADD R1 R3 R4
RETSUB

; vnext: R0 = uneko helbidea, R1 = zatiaren amaiera -> hurrengo balioaren helbidea R0-n (eta R1 eguneratua).
; aldatzen ditu R0, R1, R3, R4
vnext:
ADD R0 R0 R31
IFLT R0 R1 vnext.ok
REGSET R4 4096
SUB R3 R1 R4
LOAD R3 R3
ADD R0 R3 R31
ADD R1 R3 R4
vnext.ok:
RETSUB

; htfind: R0 = taula, R1 = gakoa (kode-puntuak), R2 = luzera, R3 = maskara -> R0 = zirrikituaren helbidea,
; R1 = erregistroa (0 ez badago). erregistroen lehen bi gelaxkak: gakoaren helbidea eta luzera.
; aldatzen ditu R0-R7
htfind:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGCOPY R11 R3
REGSET R4 0
REGSET R5 0
REGSET R7 16777215
REGSET R3 31
htfind.h:
IFEQ R5 R10 htfind.probe
ADD R6 R9 R5
LOAD R6 R6
MUL R4 R4 R3
ADD R4 R4 R6
ANDBITS R4 R4 R7
ADD R5 R5 R31
JUMP htfind.h
htfind.probe:
ANDBITS R4 R4 R11
htfind.next:
ADD R0 R8 R4
LOAD R1 R0
IFEQ R1 R30 htfind.done
LOAD R2 R1
ADD R3 R1 R31
LOAD R3 R3
IFNE R3 R10 htfind.skip
REGSET R5 0
htfind.cmp:
IFEQ R5 R10 htfind.done
ADD R6 R2 R5
LOAD R6 R6
ADD R7 R9 R5
LOAD R7 R7
IFNE R6 R7 htfind.skip
ADD R5 R5 R31
JUMP htfind.cmp
htfind.skip:
ADD R4 R4 R31
ANDBITS R4 R4 R11
JUMP htfind.next
htfind.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- eragiketen byte-korrontea
; zatiak: [hurrengoa, amaiera, 65534 byte]. OCUR hurrengo bytearen helbidea da, OEND zatiaren amaiera

; ostart: lehen zatia sortu. aldatzen ditu R0-R3
ostart:
REGSET R0 65536
CALL alloc
REGSET R1 63
STORE R0 R1
REGSET R1 64
STORE R0 R1
REGSET R1 2
ADD R2 R0 R1
REGSET R1 61
STORE R2 R1
REGSET R1 65536
ADD R3 R0 R1
REGSET R1 62
STORE R3 R1
RETSUB

; ochunk: zati berria; aurrekoaren amaiera gorde. -> R2 = OCUR berria. aldatzen ditu R0-R3
ochunk:
REGSET R0 65536
CALL alloc
REGSET R1 63
LOAD R2 R1
STORE R0 R2
ADD R3 R2 R31
REGSET R2 61
LOAD R2 R2
STORE R2 R3
STORE R0 R1
REGSET R1 2
ADD R2 R0 R1
REGSET R1 65536
ADD R3 R0 R1
REGSET R1 62
STORE R3 R1
REGSET R1 61
STORE R2 R1
RETSUB

; ob: R0 = byte bat korrontera. aldatzen ditu R0-R3
ob:
REGSET R1 61
LOAD R2 R1
REGSET R3 62
LOAD R3 R3
IFLT R2 R3 ob.put
PUSH R0
CALL ochunk
POP R0
ob.put:
STORE R0 R2
ADD R2 R2 R31
REGSET R1 61
STORE R2 R1
RETSUB

; oreserve: R0 = byte-kopurua, zati berean jarraian egon behar dutenak -> R0 = lehenaren helbidea.
; aldatzen ditu R0-R4
oreserve:
REGSET R1 61
LOAD R2 R1
ADD R4 R2 R0
REGSET R3 62
LOAD R3 R3
IFGT R4 R3 oreserve.new
REGCOPY R0 R2
RETSUB
oreserve.new:
CALL ochunk
REGCOPY R0 R2
RETSUB

; ou32: R0 = zenbaki osoa (0..2^32-1) -> 4 byte, txikiena lehenik. aldatzen ditu R0-R7
ou32:
REGCOPY R4 R0
REGSET R6 255
REGSET R7 8
LOOPSTART 4
ANDBITS R0 R4 R6
CALL ob
SHR R4 R4 R7
LOOPEND
RETSUB

; ou64: R0 = zenbaki osoa (0..2^53) -> 8 byte. aldatzen ditu R0-R7
ou64:
REGCOPY R4 R0
REGSET R6 255
REGSET R7 8
LOOPSTART 8
ANDBITS R0 R4 R6
CALL ob
SHR R4 R4 R7
LOOPEND
RETSUB

; ou64hl: R0 = goiko 32 bitak, R1 = beheko 32 bitak -> 8 byte. aldatzen ditu R0-R7
ou64hl:
PUSH R8
REGCOPY R8 R0
REGCOPY R0 R1
CALL ou32
REGCOPY R0 R8
CALL ou32
POP R8
RETSUB

; okind: R0 = enum-aldaera (u32). ou32 bera
okind:
JUMP ou32

; of64: R0 = x (finitua, ±0 edo ±inf) -> haren 8 byte ieee 754. aldatzen ditu R0-R7
of64:
PUSH R8
PUSH R9
PUSH R10
REGSET R8 0
REGCOPY R9 R0
IFLT R0 R30 of64.neg
IFNE R0 R30 of64.abs
; zeroaren zeinua: (±0)^-1 = ±inf
POW R1 R0 R29
IFGT R1 R30 of64.zero
REGSET R8 1
JUMP of64.zero
of64.neg:
REGSET R8 1
MUL R9 R0 R29
of64.abs:
REGSET R1 1.7976931348623157e308
IFGT R9 R1 of64.inf
; R9 = y * 2^e, 1 <= y < 2
REGSET R10 0
REGSET R2 4294967296
REGSET R3 2.3283064365386963e-10
REGSET R4 2
REGSET R5 0.5
of64.d32:
IFLT R9 R2 of64.d1
MUL R9 R9 R3
REGSET R6 32
ADD R10 R10 R6
JUMP of64.d32
of64.d1:
IFLT R9 R4 of64.u32
MUL R9 R9 R5
ADD R10 R10 R31
JUMP of64.d1
of64.u32:
IFGT R9 R3 of64.u1
IFEQ R9 R3 of64.u1
MUL R9 R9 R2
REGSET R6 32
SUB R10 R10 R6
JUMP of64.u32
of64.u1:
IFGT R9 R31 of64.normed
IFEQ R9 R31 of64.normed
MUL R9 R9 R4
SUB R10 R10 R31
JUMP of64.u1
of64.normed:
REGSET R6 -1022
IFLT R10 R6 of64.sub
; normala: alborapena e + 1023, zatikia (y - 1) * 2^52
REGSET R6 1023
ADD R6 R10 R6
SUB R9 R9 R31
REGSET R7 4503599627370496
MUL R9 R9 R7
JUMP of64.out
of64.sub:
; azpinormala: zatikia |x| * 2^1074 = y * 2^(e + 1074)
REGSET R7 1074
ADD R7 R10 R7
of64.sub2:
IFEQ R7 R30 of64.subdone
MUL R9 R9 R4
SUB R7 R7 R31
JUMP of64.sub2
of64.subdone:
REGSET R6 0
JUMP of64.out
of64.zero:
REGSET R6 0
REGSET R9 0
JUMP of64.out
of64.inf:
REGSET R6 2047
REGSET R9 0
of64.out:
; R6 = alborapena, R9 = zatikia (< 2^52), R8 = zeinua
REGCOPY R10 R6
REGSET R4 255
REGSET R5 8
LOOPSTART 6
ANDBITS R0 R9 R4
CALL ob
SHR R9 R9 R5
LOOPEND
; 6. bytea: zatikiaren 4 bit eta alborapenaren 4 bit baxuenak
REGSET R4 15
ANDBITS R0 R9 R4
ANDBITS R1 R10 R4
REGSET R4 16
MUL R1 R1 R4
ADD R0 R0 R1
CALL ob
; 7. bytea: zeinua eta alborapenaren 7 bit altuenak
REGSET R4 4
SHR R0 R10 R4
REGSET R4 128
MUL R1 R8 R4
ADD R0 R0 R1
CALL ob
POP R10
POP R9
POP R8
RETSUB

; obcp: R0 = kode-puntua -> haren utf-8 byteak korrontera. aldatzen ditu R0-R7
obcp:
REGSET R1 128
IFLT R0 R1 ob
REGCOPY R4 R0
REGSET R1 2048
IFLT R4 R1 obcp.2
REGSET R1 65536
IFLT R4 R1 obcp.3
REGSET R1 18
SHR R0 R4 R1
REGSET R1 240
ADD R0 R0 R1
CALL ob
REGSET R5 12
JUMP obcp.tail
obcp.3:
REGSET R1 12
SHR R0 R4 R1
REGSET R1 224
ADD R0 R0 R1
CALL ob
REGSET R5 6
JUMP obcp.tail
obcp.2:
REGSET R1 6
SHR R0 R4 R1
REGSET R1 192
ADD R0 R0 R1
CALL ob
REGSET R5 0
JUMP obcp.last
obcp.tail:
; jarraipen-byteak: 10xxxxxx, R5 = desplazamendua
SHR R0 R4 R5
REGSET R1 63
ANDBITS R0 R0 R1
REGSET R1 128
ADD R0 R0 R1
CALL ob
REGSET R1 6
SUB R5 R5 R1
IFLT R5 R30 obcp.done
IFEQ R5 R30 obcp.last
JUMP obcp.tail
obcp.last:
REGSET R1 63
ANDBITS R0 R4 R1
REGSET R1 128
ADD R0 R0 R1
CALL ob
obcp.done:
RETSUB

; u8len: R0 = kode-puntua -> R0 = haren utf-8 byte-kopurua. aldatzen ditu R0, R1
u8len:
REGSET R1 128
IFLT R0 R1 u8len.1
REGSET R1 2048
IFLT R0 R1 u8len.2
REGSET R1 65536
IFLT R0 R1 u8len.3
REGSET R0 4
RETSUB
u8len.1:
REGSET R0 1
RETSUB
u8len.2:
REGSET R0 2
RETSUB
u8len.3:
REGSET R0 3
RETSUB

; ostr: R0 = kode-puntuen helbidea, R1 = kopurua -> String bincode: u64 byte-luzera eta utf-8 byteak.
; aldatzen ditu R0-R7
ostr:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGSET R10 0
REGSET R11 0
ostr.len:
IFEQ R11 R9 ostr.write
ADD R0 R8 R11
LOAD R0 R0
CALL u8len
ADD R10 R10 R0
ADD R11 R11 R31
JUMP ostr.len
ostr.write:
REGCOPY R0 R10
CALL ou64
REGSET R11 0
ostr.bytes:
IFEQ R11 R9 ostr.done
ADD R0 R8 R11
LOAD R0 R0
CALL obcp
ADD R11 R11 R31
JUMP ostr.bytes
ostr.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; opbegin: eragiketa berria hasi: haren lerroa gorde eta kopurua handitu. -> R0 = eragiketaren indizea.
; aldatzen ditu R0-R7
opbegin:
REGSET R0 13
LOAD R0 R0
REGSET R1 39
LOAD R1 R1
CALL vpush
REGSET R1 14
LOAD R0 R1
ADD R2 R0 R31
STORE R2 R1
RETSUB

; setv2: programak gutxienez 2. formatua behar du (QOA 0.4.3-ko aginduak). aldatzen ditu R0
setv2:
REGSET R0 38
LOAD R0 R0
IFNE R0 R30 setv2.done
REGSET R0 38
STORE R31 R0
setv2.done:
RETSUB

; setv3: programak 3. formatua behar du (QOA 0.4.4-ko (zenbaki) eragigaiak). aldatzen ditu R0
setv3:
REGSET R0 38
STORE (2) R0
RETSUB

; ---------------------------------------------------------------- sarrera
; readname: 0. argumentua (fitxategi-izena) memoriara, byteak. argumenturik ez badago, erabilera azaldu
readname:
ARGC R0
IFGT R0 R30 readname.ok
STREAM 2
IFEQ R28 R31 readname.eu
PRINTLN "usage: qoa compile --assembler tools/asm.qoa FILE.qoa (or: qoa run tools/asm.qx --quiet -- FILE.qoa < FILE.qoa > FILE.qx)"
EXIT 2
readname.eu:
PRINTLN "erabilera: qoa compile --assembler tools/asm.qoa FITXATEGIA.qoa (edo: qoa run tools/asm.qx --quiet -- FITXATEGIA.qoa < FITXATEGIA.qoa > FITXATEGIA.qx)"
EXIT 2
readname.ok:
REGSET R0 0
LOAD R4 R0
REGSET R0 1
STORE R4 R0
REGSET R5 0
REGSET R6 0
readname.next:
ARGBYTE R0 R6 R5
IFEQ R0 R29 readname.done
ADD R1 R4 R5
STORE R0 R1
ADD R5 R5 R31
JUMP readname.next
readname.done:
REGSET R0 2
STORE R5 R0
ADD R1 R4 R5
REGSET R0 0
STORE R1 R0
RETSUB

; readsource: sarrera osoa memoriara (byte bat gelaxka bakoitzean). -> SRC: R0 helbidea, gordeta 80/81-n
readsource:
REGSET R0 0
LOAD R4 R0
REGCOPY R5 R4
readsource.next:
GETC R0
IFEQ R0 R29 readsource.done
STORE R0 R5
ADD R5 R5 R31
JUMP readsource.next
readsource.done:
REGSET R0 80
STORE R4 R0
SUB R1 R5 R4
REGSET R0 81
STORE R1 R0
REGSET R0 0
STORE R5 R0
RETSUB

; decode: utf-8 byteak kode-puntu bihurtu, rust-en from_utf8 bezain zorrotz. baliogabea bada, `qoa compile`-ren
; errore bera: "cannot read X: stream did not contain valid UTF-8"
decode:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGSET R0 80
LOAD R8 R0
REGSET R0 81
LOAD R9 R0
ADD R9 R8 R9
REGCOPY R0 R9
SUB R0 R0 R8
ADD R0 R0 R31
CALL alloc
REGCOPY R10 R0
REGSET R1 3
STORE R10 R1
REGCOPY R11 R10
decode.next:
IFEQ R8 R9 decode.done
LOAD R0 R8
ADD R8 R8 R31
REGSET R1 128
IFLT R0 R1 decode.put
; lehen bytea: luzera eta bigarrenaren mugak
REGSET R1 194
IFLT R0 R1 decode.bad
REGSET R1 224
IFLT R0 R1 decode.two
REGSET R1 240
IFLT R0 R1 decode.three
REGSET R1 245
IFLT R0 R1 decode.four
JUMP decode.bad
decode.two:
REGSET R1 31
ANDBITS R12 R0 R1
REGSET R2 128
REGSET R3 191
REGSET R4 0
JUMP decode.cont
decode.three:
REGSET R1 15
ANDBITS R12 R0 R1
REGSET R2 128
REGSET R3 191
REGSET R4 1
REGSET R1 224
IFNE R0 R1 decode.three2
REGSET R2 160
decode.three2:
REGSET R1 237
IFNE R0 R1 decode.cont
REGSET R3 159
JUMP decode.cont
decode.four:
REGSET R1 7
ANDBITS R12 R0 R1
REGSET R2 128
REGSET R3 191
REGSET R4 2
REGSET R1 240
IFNE R0 R1 decode.four2
REGSET R2 144
decode.four2:
REGSET R1 244
IFNE R0 R1 decode.cont
REGSET R3 143
decode.cont:
; bigarren bytea [R2, R3] tartean, gero R4 jarraipen-byte gehiago 128..191 tartean
IFEQ R8 R9 decode.bad
LOAD R0 R8
ADD R8 R8 R31
IFLT R0 R2 decode.bad
IFGT R0 R3 decode.bad
REGSET R1 63
ANDBITS R0 R0 R1
REGSET R1 64
MUL R12 R12 R1
ADD R12 R12 R0
decode.more:
IFEQ R4 R30 decode.cp
IFEQ R8 R9 decode.bad
LOAD R0 R8
ADD R8 R8 R31
REGSET R1 128
IFLT R0 R1 decode.bad
REGSET R1 191
IFGT R0 R1 decode.bad
REGSET R1 63
ANDBITS R0 R0 R1
REGSET R1 64
MUL R12 R12 R1
ADD R12 R12 R0
SUB R4 R4 R31
JUMP decode.more
decode.cp:
REGCOPY R0 R12
decode.put:
STORE R0 R11
ADD R11 R11 R31
JUMP decode.next
decode.bad:
STREAM 2
IFEQ R28 R31 decode.eu
PRINT "error: cannot read "
CALL printname
PRINTLN ": stream did not contain valid UTF-8"
EXIT 1
decode.eu:
PRINT "errorea: ezin da "
CALL printname
PRINTLN " irakurri: stream did not contain valid UTF-8"
EXIT 1
decode.done:
SUB R0 R11 R10
REGSET R1 4
STORE R0 R1
REGSET R0 0
STORE R11 R0
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; splitlines: str::lines() bezala: \n-n banatu, \n aurreko \r bakarra kendu, amaierako \n-k ez du lerro hutsik sortzen
splitlines:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGSET R0 3
LOAD R8 R0
REGSET R0 4
LOAD R9 R0
ADD R9 R8 R9
; \n-ak zenbatu taularen tamainarako
REGSET R10 1
REGCOPY R1 R8
REGSET R2 10
splitlines.count:
IFEQ R1 R9 splitlines.alloc
LOAD R0 R1
ADD R1 R1 R31
IFNE R0 R2 splitlines.count
ADD R10 R10 R31
JUMP splitlines.count
splitlines.alloc:
REGSET R0 2
MUL R0 R10 R0
CALL alloc
REGCOPY R10 R0
REGSET R1 5
STORE R10 R1
REGSET R11 0
REGSET R12 0
; R8 = lerroaren hasiera, R1 = kurtsorea
REGCOPY R1 R8
splitlines.scan:
IFEQ R1 R9 splitlines.end
LOAD R0 R1
REGSET R2 10
IFEQ R0 R2 splitlines.nl
ADD R1 R1 R31
JUMP splitlines.scan
splitlines.nl:
; lerroa [R8, R1), aurreko \r bat kenduta
REGCOPY R3 R1
IFEQ R3 R8 splitlines.store
SUB R4 R3 R31
LOAD R4 R4
REGSET R2 13
IFNE R4 R2 splitlines.store
SUB R3 R3 R31
splitlines.store:
REGSET R2 2
MUL R2 R11 R2
ADD R2 R10 R2
STORE R8 R2
ADD R2 R2 R31
STORE R3 R2
SUB R4 R3 R8
IFLT R4 R12 splitlines.short
REGCOPY R12 R4
splitlines.short:
ADD R11 R11 R31
ADD R1 R1 R31
REGCOPY R8 R1
JUMP splitlines.scan
splitlines.end:
; azken lerroa \n gabe (bere \r-arekin)
IFEQ R8 R9 splitlines.done
REGSET R2 2
MUL R2 R11 R2
ADD R2 R10 R2
STORE R8 R2
ADD R2 R2 R31
STORE R9 R2
SUB R4 R9 R8
IFLT R4 R12 splitlines.short2
REGCOPY R12 R4
splitlines.short2:
ADD R11 R11 R31
splitlines.done:
REGSET R0 6
STORE R11 R0
REGSET R0 7
STORE R12 R0
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; printname: fitxategi-izena uneko irteerara (byteak). aldatzen ditu R0-R3
printname:
REGSET R0 1
LOAD R1 R0
REGSET R0 2
LOAD R2 R0
ADD R2 R1 R2
printname.next:
IFEQ R1 R2 printname.done
LOAD R0 R1
PUTC R0
ADD R1 R1 R31
JUMP printname.next
printname.done:
RETSUB

; setup: bufferrak, hash-taulak, bektoreak eta konstanteak
setup:
PUSH R8
PUSH R9
; lerro-luzerako bufferrak: MAXLEN + 64
REGSET R0 7
LOAD R8 R0
REGSET R0 64
ADD R8 R8 R0
REGCOPY R0 R8
CALL alloc
REGSET R1 42
STORE R0 R1
REGCOPY R0 R8
CALL alloc
REGSET R1 43
STORE R0 R1
REGCOPY R0 R8
CALL alloc
REGSET R1 44
STORE R0 R1
; hash-taulen maskara: 2^k - 1 >= 2 * (lerroak + 1), gutxienez 63
REGSET R0 6
LOAD R8 R0
ADD R8 R8 R31
ADD R8 R8 R8
REGSET R9 64
setup.mask:
IFGT R9 R8 setup.masked
ADD R9 R9 R9
JUMP setup.mask
setup.masked:
SUB R0 R9 R31
REGSET R1 19
STORE R0 R1
REGCOPY R0 R9
CALL alloc
REGSET R1 18
STORE R0 R1
REGCOPY R0 R9
CALL alloc
REGSET R1 20
STORE R0 R1
REGCOPY R0 R9
CALL alloc
REGSET R1 21
STORE R0 R1
; begizta-pila: lerro bakoitzeko gehienez bat, 5 gelaxka
REGSET R0 6
LOAD R0 R0
ADD R0 R0 R31
REGSET R1 5
MUL R0 R0 R1
CALL alloc
REGSET R1 23
STORE R0 R1
; bektoreak
CALL vnew
REGSET R1 13
STORE R0 R1
CALL vnew
REGSET R1 15
STORE R0 R1
CALL vnew
REGSET R1 17
STORE R0 R1
CALL vnew
REGSET R1 22
STORE R0 R1
CALL ostart
; egoera: -1 = ez dago
REGSET R0 25
STORE R29 R0
REGSET R0 26
STORE R29 R0
REGSET R0 29
STORE R29 R0
REGSET R0 30
STORE R29 R0
REGSET R0 31
STORE R29 R0
; 10^0 .. 10^22, zehatzak
REGSET R0 23
CALL alloc
REGSET R1 65
STORE R0 R1
REGSET R1 1
REGSET R2 10
LOOPSTART 23
STORE R1 R0
MUL R1 R1 R2
ADD R0 R0 R31
LOOPEND
; bigint-ak: 300 gelaxka bakoitza (24 biteko 299 zati)
REGSET R0 300
CALL alloc
REGSET R1 66
STORE R0 R1
REGSET R0 300
CALL alloc
REGSET R1 67
STORE R0 R1
REGSET R0 300
CALL alloc
REGSET R1 68
STORE R0 R1
; eragigaien balioak eta taldeak: gehienez 8 eragigai
REGSET R0 64
CALL alloc
REGSET R1 73
STORE R0 R1
REGSET R0 32
CALL alloc
REGSET R1 74
STORE R0 R1
; konstanteak: hash-taula [gakoa, luzera, balioa], ordena [izena, luzera, lerroa, zutabea, luzera]
REGSET R0 19
LOAD R0 R0
ADD R0 R0 R31
CALL alloc
REGSET R1 84
STORE R0 R1
CALL vnew
REGSET R1 86
STORE R0 R1
REGSET R0 0
LOAD R1 R0
REGSET R2 87
STORE R1 R2
STORETEXT R1 "value"
STORE R1 R0
; adierazpenetako izenak
CALL fnames
REGSET R1 48
STORE R0 R1
POP R9
POP R8
RETSUB

; fnames: adierazpenetako konstante eta funtzioen izenak, 0-z amaituak, ordena honetan (1..9):
; pi tau e sqrt sin cos tan exp ln (π kode-puntu gisa bereizten da, 960). -> R0 = hasiera
fnames:
REGSET R0 0
LOAD R1 R0
REGCOPY R2 R1
STORETEXT R1 "pi"
STORETEXT R1 "tau"
STORETEXT R1 "e"
STORETEXT R1 "sqrt"
STORETEXT R1 "sin"
STORETEXT R1 "cos"
STORETEXT R1 "tan"
STORETEXT R1 "exp"
STORETEXT R1 "ln"
STORE R1 R0
REGCOPY R0 R2
RETSUB

; ---------------------------------------------------------------- testua
; isws: R0 = kode-puntua -> R0 = 1 unicode-ko White_Space bada (char::is_whitespace), bestela 0. aldatzen ditu R0, R1
isws:
REGSET R1 32
IFEQ R0 R1 isws.yes
IFGT R0 R1 isws.high
REGSET R1 9
IFLT R0 R1 isws.no
REGSET R1 13
IFGT R0 R1 isws.no
JUMP isws.yes
isws.high:
REGSET R1 133
IFLT R0 R1 isws.no
IFEQ R0 R1 isws.yes
REGSET R1 160
IFEQ R0 R1 isws.yes
REGSET R1 5760
IFEQ R0 R1 isws.yes
REGSET R1 8192
IFLT R0 R1 isws.no
REGSET R1 8202
IFGT R0 R1 isws.h2
JUMP isws.yes
isws.h2:
REGSET R1 8232
IFEQ R0 R1 isws.yes
REGSET R1 8233
IFEQ R0 R1 isws.yes
REGSET R1 8239
IFEQ R0 R1 isws.yes
REGSET R1 8287
IFEQ R0 R1 isws.yes
REGSET R1 12288
IFEQ R0 R1 isws.yes
isws.no:
REGSET R0 0
RETSUB
isws.yes:
REGSET R0 1
RETSUB

; isdigit: R0 -> R0 = 1 ascii digitua bada. aldatzen ditu R0, R1
isdigit:
REGSET R1 48
IFLT R0 R1 isws.no
REGSET R1 57
IFGT R0 R1 isws.no
JUMP isws.yes

; isalpha: R0 -> R0 = 1 ascii letra bada. aldatzen ditu R0, R1
isalpha:
REGSET R1 65
IFLT R0 R1 isws.no
REGSET R1 90
IFGT R0 R1 isalpha.low
JUMP isws.yes
isalpha.low:
REGSET R1 97
IFLT R0 R1 isws.no
REGSET R1 122
IFGT R0 R1 isws.no
JUMP isws.yes

; isalnum: R0 -> R0 = 1 ascii letra edo digitua bada. aldatzen ditu R0-R2
isalnum:
REGCOPY R2 R0
CALL isdigit
IFEQ R0 R31 isws.yes
REGCOPY R0 R2
JUMP isalpha

; upper / lower: R0 = kode-puntua -> ascii maiuskula/minuskula. aldatzen ditu R0, R1
upper:
REGSET R1 97
IFLT R0 R1 upper.done
REGSET R1 122
IFGT R0 R1 upper.done
REGSET R1 32
SUB R0 R0 R1
upper.done:
RETSUB
lower:
REGSET R1 65
IFLT R0 R1 lower.done
REGSET R1 90
IFGT R0 R1 lower.done
REGSET R1 32
ADD R0 R0 R1
lower.done:
RETSUB

; copyup / copylow: R0 = iturria, R1 = luzera, R2 = helburua: kopia ascii maiuskulaz/minuskulaz.
; aldatzen ditu R0-R6
copyup:
REGSET R6 0
JUMP copycase
copylow:
REGSET R6 1
copycase:
REGCOPY R3 R0
REGCOPY R4 R1
REGCOPY R5 R2
copycase.next:
IFEQ R4 R30 copycase.done
LOAD R0 R3
IFEQ R6 R31 copycase.low
CALL upper
JUMP copycase.put
copycase.low:
CALL lower
copycase.put:
STORE R0 R5
ADD R3 R3 R31
ADD R5 R5 R31
SUB R4 R4 R31
JUMP copycase.next
copycase.done:
RETSUB

; textcopy: R0 = iturria, R1 = luzera -> R0 = kopia iraunkorra memoria dinamikoan. aldatzen ditu R0-R6
textcopy:
REGCOPY R5 R0
REGCOPY R6 R1
REGCOPY R0 R1
ADD R0 R0 R31
CALL alloc
REGCOPY R4 R0
REGSET R2 0
textcopy.next:
IFEQ R2 R6 textcopy.done
ADD R1 R5 R2
LOAD R1 R1
ADD R3 R4 R2
STORE R1 R3
ADD R2 R2 R31
JUMP textcopy.next
textcopy.done:
REGCOPY R0 R4
RETSUB

; streq: R0, R1 = lehen testua; R2, R3 = bigarrena -> R0 = 1 berdinak badira. aldatzen ditu R0-R6
streq:
IFNE R1 R3 streq.no
REGSET R4 0
streq.next:
IFEQ R4 R1 isws.yes
ADD R5 R0 R4
LOAD R5 R5
ADD R6 R2 R4
LOAD R6 R6
IFNE R5 R6 streq.no
ADD R4 R4 R31
JUMP streq.next
streq.no:
REGSET R0 0
RETSUB

; findrange: R0, R1 = testua -> R0 = ".." lehenaren posizioa (indizea), edo -1. aldatzen ditu R0-R5
findrange:
REGSET R2 0
REGSET R5 46
findrange.next:
ADD R3 R2 R31
IFLT R3 R1 findrange.test
REGSET R0 -1
RETSUB
findrange.test:
ADD R4 R0 R2
LOAD R4 R4
IFNE R4 R5 findrange.skip
ADD R4 R0 R3
LOAD R4 R4
IFNE R4 R5 findrange.skip
REGCOPY R0 R2
RETSUB
findrange.skip:
ADD R2 R2 R31
JUMP findrange.next

; endscolon: R0, R1 = testua -> R0 = 1 ':'-z amaitzen bada. aldatzen ditu R0, R1
endscolon:
IFEQ R1 R30 streq.no
ADD R0 R0 R1
SUB R0 R0 R31
LOAD R0 R0
REGSET R1 58
IFEQ R0 R1 isws.yes
JUMP streq.no

; islabel: R0, R1 = testua -> R0 = 1 etiketa-izen baliozkoa bada (letra, _ edo . lehenik; gero letrak,
; digituak, _ edo .). aldatzen ditu R0-R5
islabel:
IFEQ R1 R30 streq.no
REGCOPY R3 R0
REGCOPY R4 R1
REGSET R5 0
islabel.next:
IFEQ R5 R4 isws.yes
ADD R0 R3 R5
LOAD R0 R0
REGSET R1 95
IFEQ R0 R1 islabel.ok
REGSET R1 46
IFEQ R0 R1 islabel.ok
IFEQ R5 R30 islabel.first
CALL isalnum
IFEQ R0 R30 streq.no
JUMP islabel.ok
islabel.first:
CALL isalpha
IFEQ R0 R30 streq.no
islabel.ok:
ADD R5 R5 R31
JUMP islabel.next

; parseu32: R0, R1 = testua -> R0 = 1 eta R1 = balioa, `str::parse::<u32>()` bezala (aukerako '+',
; digituak, gainezkarik gabe); bestela R0 = 0. aldatzen ditu R0-R6
parseu32:
CALL parsedec
IFEQ R0 R30 parseu32.done
IFGT R1 R30 streq.no
parseu32.done:
REGCOPY R1 R2
RETSUB

; parsedec: R0, R1 = testua -> R0 = 1, R1 = goiko 32 bitak, R2 = behekoak, `u64` hamartar bezala; bestela
; R0 = 0. aldatzen ditu R0-R6
parsedec:
REGSET R5 10
JUMP parseradix
; parsehex: R0, R1 = testua -> `u64::from_str_radix(_, 16)` bezala. aldatzen ditu R0-R6
parsehex:
REGSET R5 16
parseradix:
PUSH R8
PUSH R9
PUSH R10
REGCOPY R3 R0
REGCOPY R4 R1
IFEQ R4 R30 parseradix.bad
LOAD R0 R3
REGSET R1 43
IFNE R0 R1 parseradix.start
ADD R3 R3 R31
SUB R4 R4 R31
IFEQ R4 R30 parseradix.bad
parseradix.start:
REGSET R8 0
REGSET R9 0
parseradix.next:
IFEQ R4 R30 parseradix.ok
LOAD R0 R3
CALL digitval
IFLT R0 R30 parseradix.bad
IFLT R0 R5 parseradix.digit
JUMP parseradix.bad
parseradix.digit:
; (R8, R9) = (R8, R9) * oinarria + digitua, 32 biteko bi zatitan
MUL R9 R9 R5
ADD R9 R9 R0
REGSET R1 4294967296
REGSET R2 32
SHR R10 R9 R2
MUL R2 R10 R1
SUB R9 R9 R2
MUL R8 R8 R5
ADD R8 R8 R10
IFLT R8 R1 parseradix.fits
JUMP parseradix.bad
parseradix.fits:
ADD R3 R3 R31
SUB R4 R4 R31
JUMP parseradix.next
parseradix.ok:
REGSET R0 1
REGCOPY R1 R8
REGCOPY R2 R9
POP R10
POP R9
POP R8
RETSUB
parseradix.bad:
REGSET R0 0
POP R10
POP R9
POP R8
RETSUB

; digitval: R0 = kode-puntua -> R0 = haren balioa digitu hamaseitar gisa (0..15), edo -1. aldatzen ditu R0, R1
digitval:
REGSET R1 48
IFLT R0 R1 digitval.no
REGSET R1 57
IFGT R0 R1 digitval.alpha
REGSET R1 48
SUB R0 R0 R1
RETSUB
digitval.alpha:
CALL lower
REGSET R1 97
IFLT R0 R1 digitval.no
REGSET R1 102
IFGT R0 R1 digitval.no
REGSET R1 87
SUB R0 R0 R1
RETSUB
digitval.no:
REGSET R0 -1
RETSUB

; parseint: R0, R1 = testua -> asm.rs-ko parse_int: "0x"/"0X" hamaseitarra, bestela hamartarra (u64).
; R0 = 1, R1 = goikoak, R2 = behekoak; edo R0 = 0. aldatzen ditu R0-R6
parseint:
REGSET R2 2
IFLT R1 R2 parsedec
LOAD R2 R0
REGSET R3 48
IFNE R2 R3 parsedec
ADD R2 R0 R31
LOAD R2 R2
REGSET R3 120
IFEQ R2 R3 parseint.hex
REGSET R3 88
IFNE R2 R3 parsedec
parseint.hex:
REGSET R2 2
ADD R0 R0 R2
SUB R1 R1 R2
JUMP parsehex

; ---------------------------------------------------------------- lerroak eta tokenak
; stripcomment: R0 = lerroaren hasiera, R1 = amaiera -> R0 = iruzkinaren hasiera (edo amaiera).
; byteka, asm.rs bezala: komatxo bakoitzak testu-egoera aldatzen du. aldatzen ditu R0-R5
stripcomment:
REGCOPY R2 R0
REGSET R3 0
stripcomment.next:
IFEQ R2 R1 stripcomment.end
LOAD R4 R2
REGSET R5 34
IFNE R4 R5 stripcomment.other
SUB R3 R31 R3
JUMP stripcomment.skip
stripcomment.other:
IFEQ R3 R31 stripcomment.skip
REGSET R5 59
IFEQ R4 R5 stripcomment.here
REGSET R5 35
IFEQ R4 R5 stripcomment.here
REGSET R5 47
IFNE R4 R5 stripcomment.skip
ADD R4 R2 R31
IFEQ R4 R1 stripcomment.skip
LOAD R4 R4
IFEQ R4 R5 stripcomment.here
stripcomment.skip:
ADD R2 R2 R31
JUMP stripcomment.next
stripcomment.here:
REGCOPY R0 R2
RETSUB
stripcomment.end:
REGCOPY R0 R1
RETSUB

; tokenize: R0 = hasiera, R1 = amaiera (iruzkinik gabe) -> tokenak TOKP/NTOK-en ([testua, luzera, zutabea]
; bakoitza). R0 = 0 ondo; 1 testu batek amaierako komatxoa falta badu, eta R1 = haren zutabea.
; aldatzen ditu R0-R7
tokenize:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
REGCOPY R8 R0
REGCOPY R9 R1
SUB R0 R9 R8
ADD R0 R0 R31
REGSET R1 3
MUL R0 R0 R1
CALL alloc
REGSET R1 40
STORE R0 R1
REGCOPY R10 R0
REGSET R11 0
REGCOPY R12 R8
tokenize.next:
IFEQ R12 R9 tokenize.done
LOAD R0 R12
REGSET R1 44
IFEQ R0 R1 tokenize.sep
CALL isws
IFEQ R0 R30 tokenize.start
tokenize.sep:
ADD R12 R12 R31
JUMP tokenize.next
tokenize.start:
REGCOPY R13 R12
LOAD R0 R12
REGSET R1 34
IFEQ R0 R1 tokenize.string
REGSET R1 45
IFNE R0 R1 tokenize.word
ADD R2 R12 R31
IFEQ R2 R9 tokenize.word
LOAD R2 R2
REGSET R1 62
IFNE R2 R1 tokenize.word
REGSET R1 2
ADD R12 R12 R1
JUMP tokenize.push
tokenize.string:
ADD R12 R12 R31
tokenize.sloop:
IFLT R12 R9 tokenize.sin
JUMP tokenize.unterminated
tokenize.sin:
LOAD R0 R12
REGSET R1 34
IFEQ R0 R1 tokenize.sclose
REGSET R1 92
IFNE R0 R1 tokenize.sstep
ADD R12 R12 R31
tokenize.sstep:
ADD R12 R12 R31
JUMP tokenize.sloop
tokenize.sclose:
ADD R12 R12 R31
JUMP tokenize.push
tokenize.word:
; parentesien sakonera: 0-n bakarrik bereizten dute hutsuneek, komek eta -> geziak
REGSET R7 0
tokenize.wloop:
IFEQ R12 R9 tokenize.push
LOAD R0 R12
REGSET R1 40
IFNE R0 R1 tokenize.wclose
ADD R7 R7 R31
JUMP tokenize.wstep
tokenize.wclose:
REGSET R1 41
IFNE R0 R1 tokenize.wsep
SUB R7 R7 R31
JUMP tokenize.wstep
tokenize.wsep:
IFNE R7 R30 tokenize.wstep
REGSET R1 44
IFEQ R0 R1 tokenize.push
REGSET R1 45
IFNE R0 R1 tokenize.wws
ADD R2 R12 R31
IFEQ R2 R9 tokenize.wws
LOAD R2 R2
REGSET R1 62
IFEQ R2 R1 tokenize.push
tokenize.wws:
PUSH R7
CALL isws
POP R7
IFEQ R0 R31 tokenize.push
tokenize.wstep:
ADD R12 R12 R31
JUMP tokenize.wloop
tokenize.push:
REGSET R1 3
MUL R1 R11 R1
ADD R1 R10 R1
STORE R13 R1
ADD R1 R1 R31
SUB R2 R12 R13
STORE R2 R1
ADD R1 R1 R31
SUB R2 R13 R8
ADD R2 R2 R31
STORE R2 R1
ADD R11 R11 R31
JUMP tokenize.next
tokenize.done:
REGSET R1 41
STORE R11 R1
REGSET R0 0
JUMP tokenize.ret
tokenize.unterminated:
REGSET R1 41
STORE R11 R1
REGSET R0 1
SUB R1 R13 R8
ADD R1 R1 R31
tokenize.ret:
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- agindu-taula
; zehaztapen bakoitza (24 gelaxka): 0 izena 1 luzera 2 eragigaiak 3 kopurua 4 hedapena (q0..q3) 5 kendua
; 6-7 kentzearen arrazoia ingelesez 8-9 euskaraz 10-11 erabilera ingelesez 12-13 euskaraz 14 eraikitzailea
; 15 parametroa 16 ezizenak ([helbidea, luzera] bikoteak) 17 ezizen-kopurua.
; eragigai bakoitza (5 gelaxka): 0 mota (karakterea) 1-2 izena 3 aukerakoa 4 errepikapena (0 bat, 1 bat edo
; gehiago, 2 zero edo gehiago). izen-taulako erregistroak: [gakoa, luzera, zehaztapena]

; isatext: src/isa.rs-eko taula testu gisa memoriara. erregistro bakoitza: izena|ezizenak|eragigaiak|hedapena|
; kendua|arrazoia (en)|arrazoia (eu)|erabilera (en)|erabilera (eu); erregistro hutsak amaitzen du. -> R0 = hasiera
isatext:
REGSET R0 0
LOAD R1 R0
REGCOPY R2 R1
; @isa-begin
STORETEXT R1 "QINIT|QI INITQUBIT IQ QINITQ|i:qubits|0|0|||QINIT qubits|QINIT qubitak"
STORETEXT R1 "QMODE|MODES|i:modes i:cutoff?|0|0|||QMODE modes [cutoff]|QMODE moduak [muga]"
STORETEXT R1 "QREG||w:name i:size i:first?|0|0|||QREG name size [first]|QREG izena size [first]"
STORETEXT R1 "CREG||w:name i:size i:first?|0|0|||CREG name size [first]|CREG izena size [first]"
STORETEXT R1 "OREG||w:name i:size i:first?|0|0|||OREG name size [first]|OREG izena size [first]"
STORETEXT R1 "RREG||w:name i:size i:first?|0|0|||RREG name size [first]|RREG izena size [first]"
STORETEXT R1 "CONST||w:name f:value|0|0|||CONST name value|CONST izena balioa"
STORETEXT R1 "H|HAD APPLYHADAMARD|q:qubit|1|0|||H qubit|H qubita"
STORETEXT R1 "X|APPLYBITFLIP|q:qubit|1|0|||X qubit|X qubita"
STORETEXT R1 "Y||q:qubit|1|0|||Y qubit|Y qubita"
STORETEXT R1 "Z|APPLYPHASEFLIP|q:qubit|1|0|||Z qubit|Z qubita"
STORETEXT R1 "S|APPLYSGATE|q:qubit|1|0|||S qubit|S qubita"
STORETEXT R1 "SDG|SDAG|q:qubit|1|0|||SDG qubit|SDG qubita"
STORETEXT R1 "T|APPLYTGATE|q:qubit|1|0|||T qubit|T qubita"
STORETEXT R1 "TDG|TDAG|q:qubit|1|0|||TDG qubit|TDG qubita"
