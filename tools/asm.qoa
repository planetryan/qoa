SETR1 6
IEQR8 R1 ex.atom.cos
SETR1 7
IEQR8 R1 ex.atom.tan
SETR1 8
IEQR8 R1 ex.atom.exp
; ln: x <= 0 bada rust-ek -inf (0) edo NaN ematen du; makinak ez du onartzen, beraz hemen
IGTR0 R30 ex.atom.log
IEQR0 R30 ex.atom.minf
C ex.nan
J ex.atom.ret
ex.atom.minf:
C ex.inf
MULR0 R0 R29
J ex.atom.ret
ex.atom.log:
LNR0 R0
J ex.atom.ret
ex.atom.sqrt:
ILTR0 R30 ex.atom.sqrtnan
SQRTR0 R0
J ex.atom.ret
ex.atom.sqrtnan:
C ex.nan
J ex.atom.ret
ex.atom.sin:
SINR0 R0
J ex.atom.ret
ex.atom.cos:
COSR0 R0
J ex.atom.ret
ex.atom.tan:
TANR0 R0
J ex.atom.ret
ex.atom.exp:
EXPR0 R0
J ex.atom.ret
ex.atom.pi:
SETR0 3.141592653589793
J ex.atom.ret
ex.atom.tau:
SETR0 6.283185307179586
J ex.atom.ret
ex.atom.e:
SETR0 2.718281828459045
ex.atom.ret:
POPR9
POPR8
RET

; ex.inf / ex.nan: -> R0 = +inf / NaN. aldatzen ditu R0, R1
ex.inf:
SETR0 1e308
SETR1 10
MULR0 R0 R1
RET
ex.nan:
C ex.inf
SUBR0 R0 R0
RET

; ex.number: digituak eta puntuak, aukeran e/E [+-] digituak -> R0 = balioa, zuzen biribilduta
ex.number:
PUSHR8
PUSHR9
SETR0 53
LDR8 R0
RCR9 R8
SETR0 54
LDR3 R0
ex.number.mant:
IEQR9 R3 ex.number.text
LDR0 R9
SETR1 46
IEQR0 R1 ex.number.mstep
PUSHR3
C isdigit
POPR3
IEQR0 R30 ex.number.exp
ex.number.mstep:
ADDR9 R9 R31
J ex.number.mant
ex.number.exp:
LDR0 R9
SETR1 101
IEQR0 R1 ex.number.e
SETR1 69
INER0 R1 ex.number.text
ex.number.e:
; berretzailea digituekin bakarrik ("2e" e konstantea zen, eta ez dago onartuta)
ADDR4 R9 R31
IEQR4 R3 ex.number.text
LDR0 R4
SETR1 43
IEQR0 R1 ex.number.sign
SETR1 45
INER0 R1 ex.number.edig
ex.number.sign:
ADDR4 R4 R31
IEQR4 R3 ex.number.text
ex.number.edig:
LDR0 R4
PUSHR3
PUSHR4
C isdigit
POPR4
POPR3
IEQR0 R30 ex.number.text
RCR9 R4
ex.number.edigs:
IEQR9 R3 ex.number.text
LDR0 R9
PUSHR3
C isdigit
POPR3
IEQR0 R30 ex.number.text
ADDR9 R9 R31
J ex.number.edigs
ex.number.text:
SETR0 53
STR9 R0
RCR0 R8
SUBR1 R9 R8
C decimal
IEQR0 R31 ex.number.ok
SETR0 59
STR8 R0
SUBR1 R9 R8
SETR0 60
STR1 R0
SETR0 9
C ex.err
J ex.number.ret
ex.number.ok:
RCR0 R1
ex.number.ret:
POPR9
POPR8
RET

; ---------------------------------------------------------------- zenbaki hamartarrak
; decimal: R0, R1 = testua ([0-9.]+ eta aukeran [eE][+-]?[0-9]+) -> R0 = 1 eta R1 = f64 zuzen biribildua
; (rust-en `str::parse::<f64>` bezala), edo R0 = 0 testua ez bada zenbaki bat. bide azkarra: 15 digitu arte eta
; |berretzailea| <= 22, eragiketa bakar zehatz batekin; bestela zatiketa osoa bigint-ekin, erdia bikoitira.
; aldagaiak: R8 kurtsorea, R9 amaiera, R10 digitu esanguratsuak, R11 zatiki-digituak, R12 berretzailea,
; R13 DIGP, R14 k10
decimal:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
PUSHR13
PUSHR14
PUSHR15
PUSHR16
PUSHR17
RCR8 R0
ADDR9 R0 R1
SETR10 0
SETR11 0
SETR12 0
SETR0 44
LDR13 R0
; R15 = puntua ikusi da, R16 = digituren bat
SETR15 0
SETR16 0
decimal.mant:
IEQR8 R9 decimal.mdone
LDR0 R8
SETR1 46
IEQR0 R1 decimal.dot
SETR1 48
ILTR0 R1 decimal.mdone
SETR1 57
IGTR0 R1 decimal.mdone
SETR1 48
SUBR0 R0 R1
SETR16 1
IEQR15 R30 decimal.nofrac
ADDR11 R11 R31
decimal.nofrac:
INER10 R30 decimal.keep
IEQR0 R30 decimal.mstep
decimal.keep:
ADDR1 R13 R10
STR0 R1
ADDR10 R10 R31
J decimal.mstep
decimal.dot:
IEQR15 R31 decimal.bad
SETR15 1
decimal.mstep:
ADDR8 R8 R31
J decimal.mant
decimal.mdone:
IEQR16 R30 decimal.bad
IEQR8 R9 decimal.exp
; e/E, zeinua, digituak (asetuta 10^9-n)
ADDR8 R8 R31
SETR17 1
LDR0 R8
SETR1 43
IEQR0 R1 decimal.esign
SETR1 45
INER0 R1 decimal.edig
SETR17 -1
decimal.esign:
ADDR8 R8 R31
decimal.edig:
IEQR8 R9 decimal.esigned
LDR0 R8
SETR1 48
SUBR0 R0 R1
SETR1 100000000
ILTR12 R1 decimal.emore
SETR12 1000000000
J decimal.estep
decimal.emore:
SETR1 10
MULR12 R12 R1
ADDR12 R12 R0
decimal.estep:
ADDR8 R8 R31
J decimal.edig
decimal.esigned:
MULR12 R12 R17
decimal.exp:
IEQR10 R30 decimal.zero
; amaierako zeroak berretzailera
SUBR14 R12 R11
decimal.tz:
ADDR0 R13 R10
SUBR0 R0 R31
LDR0 R0
INER0 R30 decimal.mag
SUBR10 R10 R31
ADDR14 R14 R31
J decimal.tz
decimal.mag:
; balioa [10^(n-1+k), 10^(n+k)) tartean
ADDR0 R10 R14
SETR1 310
IGTR0 R1 decimal.inf
IEQR0 R1 decimal.inf
SETR1 -324
IGTR0 R1 decimal.path
J decimal.zero
decimal.path:
SETR0 15
IGTR10 R0 decimal.big
SETR0 22
IGTR14 R0 decimal.big
SETR0 -22
ILTR14 R0 decimal.big
; bide azkarra: M zehatza (< 10^15), 10^|k| zehatza, eragiketa bakarra
SETR0 0
SETR1 0
SETR2 10
decimal.fm:
IEQR1 R10 decimal.fk
MULR0 R0 R2
ADDR3 R13 R1
LDR3 R3
ADDR0 R0 R3
ADDR1 R1 R31
J decimal.fm
decimal.fk:
SETR1 65
LDR1 R1
ILTR14 R30 decimal.fdiv
ADDR1 R1 R14
LDR1 R1
MULR1 R0 R1
J decimal.ok
decimal.fdiv:
SUBR1 R1 R14
LDR1 R1
DIVR1 R0 R1
J decimal.ok
decimal.big:
RCR0 R13
RCR1 R10
RCR2 R14
C bigdec
RCR1 R0
J decimal.ok
decimal.inf:
C ex.inf
RCR1 R0
J decimal.ok
decimal.zero:
SETR1 0
decimal.ok:
SETR0 1
J decimal.ret
decimal.bad:
SETR0 0
decimal.ret:
POPR17
POPR16
POPR15
POPR14
POPR13
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; bigdec: R0 = digituak (0..9), R1 = kopurua (lehena eta azkena ez 0), R2 = k10 -> R0 = digituak * 10^k10,
; zuzen biribilduta. q = floor(N * 2^s / D) 2^54..2^56 tartean, hondarra itsaskor gisa
bigdec:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
PUSHR13
PUSHR14
PUSHR15
PUSHR16
PUSHR17
RCR8 R0
RCR9 R1
RCR10 R2
; 800 digitu baino gehiago: lehen 800ak eta 1 bat (moztutako zatian beti dago 0 ez den digitu bat)
SETR0 800
IGTR9 R0 bigdec.cut
J bigdec.num
bigdec.cut:
SUBR1 R9 R0
SUBR1 R1 R31
ADDR10 R10 R1
ADDR1 R8 R0
STR31 R1
SETR9 801
bigdec.num:
; R11 = BIGR = N, R12 = BIGD = 1
SETR0 66
LDR11 R0
SETR0 67
LDR12 R0
STR30 R11
SETR13 0
bigdec.chunk:
IEQR13 R9 bigdec.scale
; 7 digitu arteko zatia
SETR14 0
SETR15 1
SETR0 7
bigdec.c7:
IEQR13 R9 bigdec.cput
IEQR0 R30 bigdec.cput
ADDR1 R8 R13
LDR1 R1
SETR2 10
MULR14 R14 R2
ADDR14 R14 R1
MULR15 R15 R2
ADDR13 R13 R31
SUBR0 R0 R31
J bigdec.c7
bigdec.cput:
RCR0 R11
RCR1 R15
RCR2 R14
C bmuladd
J bigdec.chunk
bigdec.scale:
RCR0 R12
SETR1 1
C bset
ILTR10 R30 bigdec.den
RCR0 R11
RCR1 R10
C bpow10
J bigdec.shift
bigdec.den:
RCR0 R12
MULR1 R10 R29
C bpow10
bigdec.shift:
; s = 55 - (bitlen(N) - bitlen(D))
RCR0 R11
C bbitlen
RCR13 R0
RCR0 R12
C bbitlen
SUBR13 R13 R0
SETR0 55
SUBR13 R0 R13
ILTR13 R30 bigdec.shd
RCR0 R11
RCR1 R13
C bshl
J bigdec.div
bigdec.shd:
RCR0 R12
MULR1 R13 R29
C bshl
bigdec.div:
; zatiketa bitez bit: D * 2^55-etik behera
RCR0 R12
SETR1 55
C bshl
SETR14 0
SETR15 0
SETR16 134217728
SETR17 56
bigdec.bit:
IEQR17 R30 bigdec.round
RCR0 R11
RCR1 R12
C bcmp
ILTR0 R30 bigdec.nobit
RCR0 R11
RCR1 R12
C bsub
SETR0 28
IGTR17 R0 bigdec.hibit
ADDR15 R15 R16
J bigdec.nobit
bigdec.hibit:
ADDR14 R14 R16
bigdec.nobit:
RCR0 R12
C bshr1
SUBR17 R17 R31
; 2^k: goiko zatian 2^27..2^0, gero berriz 2^27..2^0 behekoan
SETR0 28
IEQR17 R0 bigdec.lowhalf
SETR0 0.5
MULR16 R16 R0
J bigdec.bit
bigdec.lowhalf:
SETR16 134217728
J bigdec.bit
bigdec.round:
; R14 = q-ren goiko 28 bitak, R15 = behekoak; L = 56 bit 55 piztuta badago, bestela 55
SETR0 55
SETR1 134217728
ILTR14 R1 bigdec.l55
SETR0 56
bigdec.l55:
; e2 = L - 1 - s; desplazamendua = L - 53, gehi azpinormaletan -1022 - e2
SUBR1 R0 R31
SUBR1 R1 R13
SETR2 53
SUBR2 R0 R2
SETR3 -1022
ILTR1 R3 bigdec.sub
J bigdec.shifted
bigdec.sub:
SUBR3 R3 R1
ADDR2 R2 R3
bigdec.shifted:
; R2 = desplazamendua (2..60)
SETR0 58
IGTR2 R0 bigdec.tiny
RCR16 R2
; itsaskorra: hondarra ez da 0
SETR17 0
LDR0 R11
IEQR0 R30 bigdec.split
SETR17 1
bigdec.split:
SETR0 28
IGTR16 R0 bigdec.wide
; desplazamendua <= 28: m = hi * 2^(28-d) + lo >> d; behekoak = lo mod 2^d, erdia = 2^(d-1)
SUBR0 R0 R16
SHLR1 R31 R0
MULR3 R14 R1
SHRR4 R15 R16
ADDR3 R3 R4
SHLR5 R31 R16
SUBR5 R5 R31
ANDR4 R15 R5
SUBR5 R16 R31
SHLR5 R31 R5
; konparazioa: R6 = sign(behekoak - erdia)
SETR6 0
IEQR4 R5 bigdec.rounding
SETR6 1
IGTR4 R5 bigdec.rounding
SETR6 -1
J bigdec.rounding
bigdec.wide:
; desplazamendua > 28: t = d - 28; m = hi >> t; behekoak = (hi mod 2^t) * 2^28 + lo, erdia = 2^(t-1) * 2^28
SUBR0 R16 R0
SHRR3 R14 R0
SHLR5 R31 R0
SUBR5 R5 R31
ANDR4 R14 R5
SUBR5 R0 R31
SHLR5 R31 R5
SETR6 1
IGTR4 R5 bigdec.rounding
SETR6 -1
ILTR4 R5 bigdec.rounding
SETR6 0
IEQR15 R30 bigdec.rounding
SETR6 1
bigdec.rounding:
; gora: behekoak > erdia, edo berdinak eta (itsaskorra edo m bakoitia)
IGTR6 R30 bigdec.up
ILTR6 R30 bigdec.value
IEQR17 R31 bigdec.up
ANDR0 R3 R31
IEQR0 R30 bigdec.value
bigdec.up:
ADDR3 R3 R31
bigdec.value:
; balioa = m * 2^(desplazamendua - s), zehazki
RCR0 R3
SUBR1 R16 R13
C scale2
J bigdec.ret
bigdec.tiny:
SETR0 0
bigdec.ret:
POPR17
POPR16
POPR15
POPR14
POPR13
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; scale2: R0 = x, R1 = t -> R0 = x * 2^t, urratsez urrats (tarteko balio guztiak zehatzak dira, emaitza baino
; handiagoak edo berdinak baitira). aldatzen ditu R0-R3
scale2:
SETR2 64
SETR3 18446744073709551616
scale2.up64:
ILTR1 R2 scale2.up1
MULR0 R0 R3
SUBR1 R1 R2
J scale2.up64
scale2.up1:
IGTR1 R30 scale2.up1do
J scale2.down
scale2.up1do:
ADDR0 R0 R0
SUBR1 R1 R31
J scale2.up1
scale2.down:
SETR2 -64
SETR3 5.421010862427522e-20
scale2.dn64:
IGTR1 R2 scale2.dn1
MULR0 R0 R3
SETR2 64
ADDR1 R1 R2
SETR2 -64
J scale2.dn64
scale2.dn1:
ILTR1 R30 scale2.dn1do
RET
scale2.dn1do:
SETR2 0.5
MULR0 R0 R2
ADDR1 R1 R31
SETR2 -64
J scale2.dn1

; ---------------------------------------------------------------- bigint-ak
; [n, zati0, zati1, ...]: 24 biteko zatiak, txikiena lehenik

; bset: R0 = bigint, R1 = balioa (< 2^24). aldatzen ditu R2
bset:
STR30 R0
IEQR1 R30 bset.done
STR31 R0
ADDR2 R0 R31
STR1 R2
bset.done:
RET

; bmuladd: R0 = bigint, R1 = m (<= 10^7), R2 = a (< 2^24) -> bigint * m + a. aldatzen ditu R0-R7
bmuladd:
PUSHR8
PUSHR9
RCR8 R0
RCR9 R1
LDR3 R8
SETR4 1
RCR5 R2
SETR6 16777215
SETR7 24
bmuladd.next:
IGTR4 R3 bmuladd.carry
ADDR0 R8 R4
LDR1 R0
MULR1 R1 R9
ADDR1 R1 R5
ANDR2 R1 R6
STR2 R0
SHRR5 R1 R7
ADDR4 R4 R31
J bmuladd.next
bmuladd.carry:
IEQR5 R30 bmuladd.done
ADDR3 R3 R31
ADDR0 R8 R3
ANDR2 R5 R6
STR2 R0
SHRR5 R5 R7
J bmuladd.carry
bmuladd.done:
STR3 R8
POPR9
POPR8
RET

; bpow10: R0 = bigint, R1 = k -> bigint * 10^k. aldatzen ditu R0-R7
bpow10:
PUSHR8
PUSHR9
RCR8 R0
RCR9 R1
bpow10.seven:
SETR0 7
ILTR9 R0 bpow10.rest
RCR0 R8
SETR1 10000000
SETR2 0
C bmuladd
SETR0 7
SUBR9 R9 R0
J bpow10.seven
bpow10.rest:
IEQR9 R30 bpow10.done
SETR0 65
LDR0 R0
ADDR0 R0 R9
LDR1 R0
RCR0 R8
SETR2 0
C bmuladd
bpow10.done:
POPR9
POPR8
RET

; bbitlen: R0 = bigint -> R0 = bit-kopurua. aldatzen ditu R0-R3
bbitlen:
LDR1 R0
IEQR1 R30 bbitlen.zero
ADDR2 R0 R1
LDR2 R2
SETR3 0
bbitlen.loop:
IEQR2 R30 bbitlen.done
SHRR2 R2 R31
ADDR3 R3 R31
J bbitlen.loop
bbitlen.done:
SUBR1 R1 R31
SETR0 24
MULR0 R1 R0
ADDR0 R0 R3
RET
bbitlen.zero:
SETR0 0
RET

; bshl: R0 = bigint, R1 = k -> bigint * 2^k. aldatzen ditu R0-R7
bshl:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
RCR8 R0
LDR9 R8
IEQR9 R30 bshl.done
; zati osoak (k div 24) eta bitak (k mod 24)
SETR2 24
DIVR10 R1 R2
SETR3 0
SHRR10 R10 R3
MULR3 R10 R2
SUBR11 R1 R3
IEQR11 R30 bshl.limbs
SHLR6 R31 R11
SETR5 0
SETR4 1
SETR7 16777215
bshl.bits:
IGTR4 R9 bshl.bcarry
ADDR0 R8 R4
LDR1 R0
MULR1 R1 R6
ADDR1 R1 R5
ANDR2 R1 R7
STR2 R0
SETR2 24
SHRR5 R1 R2
ADDR4 R4 R31
J bshl.bits
bshl.bcarry:
IEQR5 R30 bshl.limbs
ADDR9 R9 R31
ADDR0 R8 R9
STR5 R0
bshl.limbs:
IEQR10 R30 bshl.store
RCR4 R9
bshl.move:
IEQR4 R30 bshl.zeros
ADDR0 R8 R4
LDR1 R0
ADDR0 R0 R10
STR1 R0
SUBR4 R4 R31
J bshl.move
bshl.zeros:
SETR4 1
bshl.z:
IGTR4 R10 bshl.n
ADDR0 R8 R4
STR30 R0
ADDR4 R4 R31
J bshl.z
bshl.n:
ADDR9 R9 R10
bshl.store:
STR9 R8
bshl.done:
POPR11
POPR10
POPR9
POPR8
RET

; bshr1: R0 = bigint -> bigint / 2 (beherantz). aldatzen ditu R1-R7
bshr1:
LDR1 R0
RCR2 R1
SETR3 0
SETR6 16777216
bshr1.loop:
IEQR2 R30 bshr1.trim
ADDR4 R0 R2
LDR5 R4
MULR7 R3 R6
ADDR5 R5 R7
ANDR3 R5 R31
SHRR5 R5 R31
STR5 R4
SUBR2 R2 R31
J bshr1.loop
bshr1.trim:
IEQR1 R30 bshr1.done
ADDR4 R0 R1
LDR5 R4
INER5 R30 bshr1.done
SUBR1 R1 R31
J bshr1.trim
bshr1.done:
STR1 R0
RET

; bcmp: R0 = a, R1 = b -> R0 = 1 (a > b), 0 (berdinak), -1 (a < b). aldatzen ditu R0-R5
bcmp:
LDR2 R0
LDR3 R1
IGTR2 R3 bcmp.gt
ILTR2 R3 bcmp.lt
bcmp.loop:
IEQR2 R30 bcmp.eq
ADDR4 R0 R2
LDR4 R4
ADDR5 R1 R2
LDR5 R5
IGTR4 R5 bcmp.gt
ILTR4 R5 bcmp.lt
SUBR2 R2 R31
J bcmp.loop
bcmp.gt:
SETR0 1
RET
bcmp.lt:
SETR0 -1
RET
bcmp.eq:
SETR0 0
RET

; bsub: R0 = a, R1 = b (a >= b) -> a - b a-n. aldatzen ditu R2-R7
bsub:
PUSHR8
LDR2 R0
LDR3 R1
SETR4 1
SETR5 0
SETR7 16777216
bsub.loop:
IGTR4 R2 bsub.trim
ADDR8 R0 R4
LDR6 R8
SUBR6 R6 R5
IGTR4 R3 bsub.nob
ADDR5 R1 R4
LDR5 R5
SUBR6 R6 R5
bsub.nob:
SETR5 0
ILTR6 R30 bsub.borrow
J bsub.put
bsub.borrow:
ADDR6 R6 R7
SETR5 1
bsub.put:
STR6 R8
ADDR4 R4 R31
J bsub.loop
bsub.trim:
IEQR2 R30 bsub.done
ADDR6 R0 R2
LDR6 R6
INER6 R30 bsub.done
SUBR2 R2 R31
J bsub.trim
bsub.done:
STR2 R0
POPR8
RET

; ---------------------------------------------------------------- eragiketak sortu
; vget: R0 = eragigaiaren zenbakia -> R0 = mota, R1 = a, R2 = b, R3 = c. aldatzen ditu R0-R4
vget:
SETR4 73
LDR4 R4
ADDR0 R0 R0
ADDR0 R0 R0
ADDR4 R4 R0
LDR0 R4
ADDR4 R4 R31
LDR1 R4
ADDR4 R4 R31
LDR2 R4
ADDR4 R4 R31
LDR3 R4
RET

; vidx: R0 = eragigaia -> R0 = haren indizea (a). aldatzen ditu R0-R4
vidx:
C vget
RCR0 R1
RET

; vflt: R0 = eragigaia, R1 = lehenetsia -> R0 = zenbakia (falta bada, lehenetsia). aldatzen ditu R0-R5
vflt:
RCR5 R1
C vget
IEQR0 R30 vflt.default
RCR0 R1
RET
vflt.default:
RCR0 R5
RET

; vtok: R0 = eragigaia -> R0 = haren taldeko lehen tokena, edo burua talde hutsa bada. aldatzen ditu R0-R2
vtok:
SETR1 74
LDR1 R1
ADDR0 R0 R0
ADDR1 R1 R0
LDR0 R1
ADDR1 R1 R31
LDR1 R1
IEQR1 R30 vtok.head
SETR1 3
MULR0 R0 R1
SETR1 75
LDR1 R1
ADDR0 R1 R0
RET
vtok.head:
SETR0 83
LDR0 R0
RET

; oidx: R0 = eragigaia -> haren indizea u32 gisa. aldatzen ditu R0-R7
oidx:
C vidx
J ou32

; oflt: R0 = eragigaia, R1 = lehenetsia -> f64. aldatzen ditu R0-R7
oflt:
C vflt
J of64

; odest: R0 = eragigaia -> Dest (Own 0, Bit 1 n, Reg 2 n). aldatzen ditu R0-R7
odest:
C vget
IEQR0 R30 odest.own
PUSHR2
RCR0 R1
C ou32
POPR0
J ou32
odest.own:
SETR0 0
J ou32

; oopt: R0 = eragigaia -> Option<u32> (0, edo 1 eta erregistroa). aldatzen ditu R0-R7
oopt:
C vget
IEQR0 R30 oopt.none
PUSHR1
