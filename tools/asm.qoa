tokenize.sstep:
ADDR12 R12 R31
J tokenize.sloop
tokenize.sclose:
ADDR12 R12 R31
J tokenize.push
tokenize.word:
; parentesien sakonera: 0-n bakarrik bereizten dute hutsuneek, komek eta -> geziak
SETR7 0
