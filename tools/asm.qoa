ADD R1 R8 R8
ADD R1 R0 R1
LOAD R0 R1
ADD R1 R1 R31
LOAD R1 R1
REGCOPY R9 R0
CALL stripcomment
REGCOPY R1 R0
REGCOPY R0 R9
CALL tokenize
IFNE R0 R30 pass1.next
REGSET R0 41
LOAD R10 R0
IFEQ R10 R30 pass1.next
REGSET R0 40
LOAD R11 R0
; "izena:" lehen tokenean: izena etiketa-izenetara (minuskulaz), eta saltatu
REGSET R12 0
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
CALL endscolon
IFEQ R0 R30 pass1.head
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
SUB R1 R1 R31
CALL lnput
REGSET R12 1
pass1.head:
IFEQ R12 R10 pass1.next
REGSET R0 3
MUL R0 R12 R0
ADD R9 R11 R0
LOAD R0 R9
ADD R1 R9 R31
LOAD R1 R1
CALL lookup
IFEQ R0 R30 pass1.next
REGCOPY R11 R0
REGSET R1 14
ADD R1 R11 R1
LOAD R1 R1
REGSET R2 99
IFNE R1 R2 pass1.next
REGSET R1 15
ADD R1 R11 R1
LOAD R1 R1
; eragigaiak: buruaren ondorengo tokenak
REGSET R2 3
ADD R2 R9 R2
SUB R3 R10 R12
SUB R3 R3 R31
REGSET R4 1
IFEQ R1 R4 pass1.qinit
REGSET R4 2
IFEQ R1 R4 pass1.qmode
REGSET R4 6
IFEQ R1 R4 pass1.next
REGSET R4 8
IFEQ R1 R4 pass1.const
; QREG / CREG / OREG / RREG
REGCOPY R4 R1
REGCOPY R0 R9
REGCOPY R1 R2
REGCOPY R2 R3
REGCOPY R3 R11
CALL register
JUMP pass1.next
pass1.qinit:
REGCOPY R0 R9
REGCOPY R1 R2
REGCOPY R2 R3
CALL declq
JUMP pass1.next
pass1.const:
REGCOPY R0 R9
REGCOPY R1 R2
REGCOPY R2 R3
CALL constant
JUMP pass1.next
pass1.qmode:
REGCOPY R0 R9
REGCOPY R1 R2
REGCOPY R2 R3
CALL declm
pass1.next:
ADD R8 R8 R31
JUMP pass1.line
pass1.done:
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; lnput: R0, R1 = izena -> etiketa-izenen multzoan, minuskulaz. aldatzen ditu R0-R7
lnput:
