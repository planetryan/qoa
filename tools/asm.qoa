; QOA-ren mihiztatzailea, QOAn idatzia (QOA 0.4.4). QOA-k QOA eraikitzen du: programa honek .qoa iturburu
; bat .qx bitar bihurtzen du, `qoa compile`-k bezala, byte berberak idatziz, eta akatsak daudenean errore
; berberak inprimatzen ditu, testu berberarekin, bi hizkuntzetan.
;
;   qoa compile --assembler tools/asm.qoa programa.qoa      (qoa-k iturburua eta izena ematen dizkio)
;   qoa compile tools/asm.qoa                               (mihiztatzailea bera, rust-en mihiztatzailearekin)
;   qoa run tools/asm.qx --quiet -- programa.qoa < programa.qoa > programa.qx
;
; sarrera: iturburua sarrera estandarrean; 0. argumentua fitxategi-izena da (.qx-an gordetzen da).
; irteera: .qx-a irteera estandarrean; erroreak errore-irteeran, eta EXIT 1.
;
; erregistroen ohitura:
;   R0-R7   argumentuak, emaitzak eta behin-behinekoak: edozein deik alda ditzake
;   R8-R24  deiek gordetzen dituzte: erabiltzen dituen errutinak PUSH/POP egiten ditu
;   R28 hizkuntza (1 euskara, 0 ingelesa)   R29 = -1   R30 = 0   R31 = 1
;
; memoria-mapa (gelaxkak; idatzi gabeak 0):
;   0 HP hurrengo gelaxka librea (ez da inoiz askatzen)
;   1 NAMEP 2 NAMEN fitxategi-izena (byteak)        3 CHP 4 CHN iturburua kode-puntutan
;   5 LINEP 6 NLINES lerroak: [hasiera, amaiera)   7 MAXLEN lerro luzeena
;   8 SPECP 9 NSPECS aginduak (24 gelaxka bakoitza) 10 MNHT 11 MNMASK izen eta ezizenen hash-taula
;   13 LNV eragiketen lerroak 14 NOPS eragiketa-kopurua
;   15 DIAGV diagnostikoak 16 NDIAG                 17 FIXV jauzi-zuzenketak
;   18 LBLHT etiketak 19 HTMASK 20 LNHT etiketa-izenak (1. pasaldia)
;   21 NAMEDHT izendun erregistroak 22 NAMEDV haien ordena   23 LOOPP 24 LOOPN begizta-pila
;   25 DECLQ (-1 ez) 26 DECLMN (-1 ez) 27 DECLMC 28 DECLMD
;   29 MAXQ 30 MAXM 31 MAXB (-1 ez)   32 QREP 33 QLINE 34 QLIMREP
;   35 NEXTQ 36 NEXTC 37 NEXTO   38 FMT (formatua ken 1)   39 CURLINE
;   40 TOKP 41 NTOK uneko lerroaren tokenak   42 SCR1 43 SCR2 44 DIGP lerro-luzerako bufferrak
;   45 BEST 46 NBEST 47 SEQ diagnostiko txikienak   48 FNAMES adierazpenetako izenak
;   49 ALPHAP 50 NALPHA 51 ALNUMP 52 NALNUM unicode-taulak
;   53 EPOS 54 EEND 55 EERR 56 ESRC 57 ESRCN 58 EP1 59 EP2 60 EP3   adierazpenaren egoera
;   61 OCUR 62 OEND 63 OTAIL 64 OHEAD   eragiketen byte-korrontea
;   65 P10 10^0..10^22   66 BIGR 67 BIGD 68 BIGT bigint-ak   69 P2_32 70 N2_32 71 P2_64 72 N2_64
;   73 VALP balioak (eragigai bakoitzeko 4 gelaxka) 74 GRPP taldeak 75 TP 76 NT 77 ABP geziak
;   78 LISTP 79 NLIST   84 CONSTHT konstanteak 85 NEXTR 86 CONSTV haien ordena 87 "value" 88 "->" (forma laburrak)
;   89 EDEPTH adierazpenaren habiaraketa (ex.unary aktiboak)   96 SHA SHA-256-aren egoera (sha.init)
;   1000-tik aurrera: memoria dinamikoa

; ---------------------------------------------------------------- nagusia
main:
SETR29 -1
SETR30 0
SETR31 1
GETLANGR28
SETR0 0
SETR1 1000
STR1 R0
C readname
C readsource
C decode
C splitlines
C setup
C isaload
C seal
SETR0 16
LDR0 R0
IGTR0 R30 main.fail
C pass1
C fit
C clash
C pass2
C post
SETR0 16
LDR0 R0
IGTR0 R30 main.fail
C output
EXIT 0
main.fail:
C report
EXIT 1

; ---------------------------------------------------------------- memoria
; alloc: R0 = gelaxka-kopurua -> R0 = haien hasiera. aldatzen ditu R0-R3
alloc:
SETR1 0
LDR2 R1
ADDR3 R2 R0
STR3 R1
RCR0 R2
RET

; vnew: -> R0 = bektore huts baten goiburua [kopurua, lehen zatia, azken zatia, azkenean erabilitakoak].
; zati bakoitza 4096 gelaxka: [hurrengoa, 4095 balio]. aldatzen ditu R0-R5
vnew:
SETR0 4
C alloc
RCR4 R0
SETR0 4096
C alloc
ADDR5 R4 R31
STR0 R5
ADDR5 R5 R31
STR0 R5
RCR0 R4
RET

; vpush: R0 = goiburua, R1 = balioa. aldatzen ditu R0-R7
vpush:
RCR6 R0
RCR7 R1
SETR2 3
ADDR2 R6 R2
LDR5 R2
SETR3 4095
ILTR5 R3 vpush.room
SETR0 4096
C alloc
SETR2 2
ADDR2 R6 R2
LDR3 R2
STR0 R3
STR0 R2
SETR5 0
vpush.room:
SETR2 2
ADDR2 R6 R2
LDR3 R2
ADDR4 R3 R5
ADDR4 R4 R31
STR7 R4
ADDR5 R5 R31
SETR2 3
ADDR2 R6 R2
STR5 R2
LDR5 R6
ADDR5 R5 R31
STR5 R6
RET

; vfirst: R0 = goiburua -> R0 = lehen balioaren helbidea, R1 = zati horren amaiera (erabilitakoen ondoren),
; R2 = geratzen diren balioak. vnext-ekin batera: R0 = uneko helbidea. aldatzen ditu R0-R4
vfirst:
LDR2 R0
ADDR3 R0 R31
LDR3 R3
ADDR0 R3 R31
SETR4 4096
ADDR1 R3 R4
RET

; vnext: R0 = uneko helbidea, R1 = zatiaren amaiera -> hurrengo balioaren helbidea R0-n (eta R1 eguneratua).
; aldatzen ditu R0, R1, R3, R4
vnext:
ADDR0 R0 R31
ILTR0 R1 vnext.ok
SETR4 4096
SUBR3 R1 R4
LDR3 R3
ADDR0 R3 R31
ADDR1 R3 R4
vnext.ok:
RET

; htfind: R0 = taula, R1 = gakoa (kode-puntuak), R2 = luzera, R3 = maskara -> R0 = zirrikituaren helbidea,
; R1 = erregistroa (0 ez badago). erregistroen lehen bi gelaxkak: gakoaren helbidea eta luzera.
; aldatzen ditu R0-R7
htfind:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
RCR8 R0
RCR9 R1
RCR10 R2
RCR11 R3
SETR4 0
SETR5 0
SETR7 16777215
SETR3 31
htfind.h:
IEQR5 R10 htfind.probe
ADDR6 R9 R5
LDR6 R6
MULR4 R4 R3
ADDR4 R4 R6
ANDR4 R4 R7
ADDR5 R5 R31
J htfind.h
htfind.probe:
ANDR4 R4 R11
htfind.next:
ADDR0 R8 R4
LDR1 R0
IEQR1 R30 htfind.done
LDR2 R1
ADDR3 R1 R31
LDR3 R3
INER3 R10 htfind.skip
SETR5 0
htfind.cmp:
IEQR5 R10 htfind.done
ADDR6 R2 R5
LDR6 R6
ADDR7 R9 R5
LDR7 R7
INER6 R7 htfind.skip
ADDR5 R5 R31
J htfind.cmp
htfind.skip:
ADDR4 R4 R31
ANDR4 R4 R11
J htfind.next
htfind.done:
POPR11
POPR10
POPR9
POPR8
RET

; ---------------------------------------------------------------- eragiketen byte-korrontea
; zatiak: [hurrengoa, amaiera, 65534 byte]. OCUR hurrengo bytearen helbidea da, OEND zatiaren amaiera

; ostart: lehen zatia sortu. aldatzen ditu R0-R3
ostart:
SETR0 65536
C alloc
SETR1 63
STR0 R1
SETR1 64
STR0 R1
SETR1 2
ADDR2 R0 R1
SETR1 61
STR2 R1
SETR1 65536
ADDR3 R0 R1
SETR1 62
STR3 R1
RET

; ochunk: zati berria; aurrekoaren amaiera gorde. -> R2 = OCUR berria. aldatzen ditu R0-R3
ochunk:
SETR0 65536
C alloc
SETR1 63
LDR2 R1
STR0 R2
ADDR3 R2 R31
SETR2 61
LDR2 R2
STR2 R3
STR0 R1
SETR1 2
ADDR2 R0 R1
SETR1 65536
ADDR3 R0 R1
SETR1 62
STR3 R1
SETR1 61
STR2 R1
RET

; ob: R0 = byte bat korrontera. aldatzen ditu R0-R3
ob:
SETR1 61
LDR2 R1
SETR3 62
LDR3 R3
ILTR2 R3 ob.put
PUSHR0
C ochunk
POPR0
ob.put:
STR0 R2
ADDR2 R2 R31
SETR1 61
STR2 R1
RET

; oreserve: R0 = byte-kopurua, zati berean jarraian egon behar dutenak -> R0 = lehenaren helbidea.
; aldatzen ditu R0-R4
oreserve:
SETR1 61
LDR2 R1
ADDR4 R2 R0
SETR3 62
LDR3 R3
IGTR4 R3 oreserve.new
RCR0 R2
RET
oreserve.new:
C ochunk
RCR0 R2
RET

; ou32: R0 = zenbaki osoa (0..2^32-1) -> 4 byte, txikiena lehenik. aldatzen ditu R0-R7
ou32:
RCR4 R0
SETR6 255
SETR7 8
LS 4
ANDR0 R4 R6
C ob
SHRR4 R4 R7
LE
RET

; ou64: R0 = zenbaki osoa (0..2^53) -> 8 byte. aldatzen ditu R0-R7
ou64:
RCR4 R0
SETR6 255
SETR7 8
LS 8
ANDR0 R4 R6
C ob
SHRR4 R4 R7
LE
RET

; ou64hl: R0 = goiko 32 bitak, R1 = beheko 32 bitak -> 8 byte. aldatzen ditu R0-R7
ou64hl:
PUSHR8
RCR8 R0
RCR0 R1
C ou32
RCR0 R8
C ou32
POPR8
RET

; okind: R0 = enum-aldaera (u32). ou32 bera
okind:
J ou32

; of64: R0 = x (finitua, ±0 edo ±inf) -> haren 8 byte ieee 754. aldatzen ditu R0-R7
of64:
PUSHR8
PUSHR9
PUSHR10
SETR8 0
RCR9 R0
ILTR0 R30 of64.neg
INER0 R30 of64.abs
; zeroaren zeinua: (±0)^-1 = ±inf
POWR1 R0 R29
IGTR1 R30 of64.zero
SETR8 1
J of64.zero
of64.neg:
SETR8 1
MULR9 R0 R29
of64.abs:
SETR1 1.7976931348623157e308
IGTR9 R1 of64.inf
; R9 = y * 2^e, 1 <= y < 2
SETR10 0
SETR2 4294967296
SETR3 2.3283064365386963e-10
SETR4 2
SETR5 0.5
of64.d32:
ILTR9 R2 of64.d1
MULR9 R9 R3
SETR6 32
ADDR10 R10 R6
J of64.d32
of64.d1:
ILTR9 R4 of64.u32
MULR9 R9 R5
ADDR10 R10 R31
J of64.d1
of64.u32:
IGTR9 R3 of64.u1
IEQR9 R3 of64.u1
MULR9 R9 R2
SETR6 32
SUBR10 R10 R6
J of64.u32
of64.u1:
IGTR9 R31 of64.normed
IEQR9 R31 of64.normed
MULR9 R9 R4
SUBR10 R10 R31
J of64.u1
of64.normed:
SETR6 -1022
ILTR10 R6 of64.sub
; normala: alborapena e + 1023, zatikia (y - 1) * 2^52
SETR6 1023
ADDR6 R10 R6
SUBR9 R9 R31
SETR7 4503599627370496
MULR9 R9 R7
J of64.out
of64.sub:
; azpinormala: zatikia |x| * 2^1074 = y * 2^(e + 1074)
SETR7 1074
ADDR7 R10 R7
of64.sub2:
IEQR7 R30 of64.subdone
MULR9 R9 R4
SUBR7 R7 R31
J of64.sub2
of64.subdone:
SETR6 0
J of64.out
of64.zero:
SETR6 0
SETR9 0
J of64.out
of64.inf:
SETR6 2047
SETR9 0
of64.out:
; R6 = alborapena, R9 = zatikia (< 2^52), R8 = zeinua
RCR10 R6
SETR4 255
SETR5 8
LS 6
ANDR0 R9 R4
C ob
SHRR9 R9 R5
LE
; 6. bytea: zatikiaren 4 bit eta alborapenaren 4 bit baxuenak
SETR4 15
ANDR0 R9 R4
ANDR1 R10 R4
SETR4 16
MULR1 R1 R4
ADDR0 R0 R1
C ob
; 7. bytea: zeinua eta alborapenaren 7 bit altuenak
SETR4 4
SHRR0 R10 R4
SETR4 128
MULR1 R8 R4
ADDR0 R0 R1
C ob
POPR10
POPR9
POPR8
RET

; obcp: R0 = kode-puntua -> haren utf-8 byteak korrontera. aldatzen ditu R0-R7
obcp:
SETR1 128
ILTR0 R1 ob
RCR4 R0
SETR1 2048
ILTR4 R1 obcp.2
SETR1 65536
ILTR4 R1 obcp.3
SETR1 18
SHRR0 R4 R1
SETR1 240
ADDR0 R0 R1
C ob
SETR5 12
J obcp.tail
obcp.3:
SETR1 12
SHRR0 R4 R1
SETR1 224
ADDR0 R0 R1
C ob
SETR5 6
J obcp.tail
obcp.2:
SETR1 6
SHRR0 R4 R1
SETR1 192
ADDR0 R0 R1
C ob
SETR5 0
J obcp.last
obcp.tail:
; jarraipen-byteak: 10xxxxxx, R5 = desplazamendua
SHRR0 R4 R5
SETR1 63
ANDR0 R0 R1
SETR1 128
ADDR0 R0 R1
C ob
SETR1 6
SUBR5 R5 R1
ILTR5 R30 obcp.done
IEQR5 R30 obcp.last
J obcp.tail
obcp.last:
SETR1 63
ANDR0 R4 R1
SETR1 128
ADDR0 R0 R1
C ob
obcp.done:
RET

; u8len: R0 = kode-puntua -> R0 = haren utf-8 byte-kopurua. aldatzen ditu R0, R1
u8len:
SETR1 128
ILTR0 R1 u8len.1
SETR1 2048
ILTR0 R1 u8len.2
SETR1 65536
ILTR0 R1 u8len.3
SETR0 4
RET
u8len.1:
SETR0 1
RET
u8len.2:
SETR0 2
RET
u8len.3:
SETR0 3
RET

; ostr: R0 = kode-puntuen helbidea, R1 = kopurua -> String bincode: u64 byte-luzera eta utf-8 byteak.
; aldatzen ditu R0-R7
ostr:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
RCR8 R0
RCR9 R1
SETR10 0
SETR11 0
ostr.len:
IEQR11 R9 ostr.write
ADDR0 R8 R11
LDR0 R0
C u8len
ADDR10 R10 R0
ADDR11 R11 R31
J ostr.len
ostr.write:
RCR0 R10
C ou64
SETR11 0
ostr.bytes:
IEQR11 R9 ostr.done
ADDR0 R8 R11
LDR0 R0
C obcp
ADDR11 R11 R31
J ostr.bytes
ostr.done:
POPR11
POPR10
POPR9
POPR8
RET

; opbegin: eragiketa berria hasi: haren lerroa gorde eta kopurua handitu. -> R0 = eragiketaren indizea.
; aldatzen ditu R0-R7
opbegin:
SETR0 13
LDR0 R0
SETR1 39
LDR1 R1
C vpush
SETR1 14
LDR0 R1
ADDR2 R0 R31
STR2 R1
RET

; setv2: programak gutxienez 2. formatua behar du (QOA 0.4.3-ko aginduak). aldatzen ditu R0
setv2:
SETR0 38
LDR0 R0
INER0 R30 setv2.done
SETR0 38
STR31 R0
setv2.done:
RET

; setv3: programak 3. formatua behar du (QOA 0.4.4-ko (zenbaki) eragigaiak). aldatzen ditu R0
setv3:
SETR0 38
ST (2) R0
RET

; ---------------------------------------------------------------- sarrera
; readname: 0. argumentua (fitxategi-izena) memoriara, byteak. argumenturik ez badago, erabilera azaldu
readname:
ARGCR0
IGTR0 R30 readname.ok
STREAM 2
IEQR28 R31 readname.eu
PLN "usage: qoa compile --assembler tools/asm.qoa FILE.qoa (or: qoa run tools/asm.qx --quiet -- FILE.qoa < FILE.qoa > FILE.qx)"
EXIT 2
readname.eu:
PLN "erabilera: qoa compile --assembler tools/asm.qoa FITXATEGIA.qoa (edo: qoa run tools/asm.qx --quiet -- FITXATEGIA.qoa < FITXATEGIA.qoa > FITXATEGIA.qx)"
EXIT 2
readname.ok:
SETR0 0
LDR4 R0
SETR0 1
STR4 R0
SETR5 0
SETR6 0
readname.next:
ARGBYTER0 R6 R5
IEQR0 R29 readname.done
ADDR1 R4 R5
STR0 R1
ADDR5 R5 R31
J readname.next
readname.done:
SETR0 2
STR5 R0
ADDR1 R4 R5
SETR0 0
STR1 R0
RET

; readsource: sarrera osoa memoriara (byte bat gelaxka bakoitzean). -> SRC: R0 helbidea, gordeta 80/81-n
readsource:
SETR0 0
LDR4 R0
RCR5 R4
readsource.next:
GCR0
IEQR0 R29 readsource.done
STR0 R5
ADDR5 R5 R31
J readsource.next
readsource.done:
SETR0 80
STR4 R0
SUBR1 R5 R4
SETR0 81
STR1 R0
SETR0 0
STR5 R0
RET

; decode: utf-8 byteak kode-puntu bihurtu, rust-en from_utf8 bezain zorrotz. baliogabea bada, `qoa compile`-ren
; errore bera: "cannot read X: stream did not contain valid UTF-8"
decode:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
SETR0 80
LDR8 R0
SETR0 81
LDR9 R0
ADDR9 R8 R9
RCR0 R9
SUBR0 R0 R8
ADDR0 R0 R31
C alloc
RCR10 R0
SETR1 3
STR10 R1
RCR11 R10
decode.next:
IEQR8 R9 decode.done
LDR0 R8
ADDR8 R8 R31
SETR1 128
ILTR0 R1 decode.put
; lehen bytea: luzera eta bigarrenaren mugak
SETR1 194
ILTR0 R1 decode.bad
SETR1 224
ILTR0 R1 decode.two
SETR1 240
ILTR0 R1 decode.three
SETR1 245
ILTR0 R1 decode.four
J decode.bad
decode.two:
SETR1 31
ANDR12 R0 R1
SETR2 128
SETR3 191
SETR4 0
J decode.cont
decode.three:
SETR1 15
ANDR12 R0 R1
SETR2 128
SETR3 191
SETR4 1
SETR1 224
INER0 R1 decode.three2
SETR2 160
decode.three2:
SETR1 237
INER0 R1 decode.cont
SETR3 159
J decode.cont
decode.four:
SETR1 7
ANDR12 R0 R1
SETR2 128
SETR3 191
SETR4 2
SETR1 240
INER0 R1 decode.four2
SETR2 144
decode.four2:
SETR1 244
INER0 R1 decode.cont
SETR3 143
decode.cont:
; bigarren bytea [R2, R3] tartean, gero R4 jarraipen-byte gehiago 128..191 tartean
IEQR8 R9 decode.bad
LDR0 R8
ADDR8 R8 R31
ILTR0 R2 decode.bad
IGTR0 R3 decode.bad
SETR1 63
ANDR0 R0 R1
SETR1 64
MULR12 R12 R1
ADDR12 R12 R0
decode.more:
IEQR4 R30 decode.cp
IEQR8 R9 decode.bad
LDR0 R8
ADDR8 R8 R31
SETR1 128
ILTR0 R1 decode.bad
SETR1 191
IGTR0 R1 decode.bad
SETR1 63
ANDR0 R0 R1
SETR1 64
MULR12 R12 R1
ADDR12 R12 R0
SUBR4 R4 R31
J decode.more
decode.cp:
RCR0 R12
decode.put:
STR0 R11
ADDR11 R11 R31
J decode.next
decode.bad:
STREAM 2
IEQR28 R31 decode.eu
PRINT "error: cannot read "
C printname
PLN ": stream did not contain valid UTF-8"
EXIT 1
decode.eu:
PRINT "errorea: ezin da "
C printname
PLN " irakurri: stream did not contain valid UTF-8"
EXIT 1
decode.done:
SUBR0 R11 R10
SETR1 4
STR0 R1
SETR0 0
STR11 R0
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; splitlines: str::lines() bezala: \n-n banatu, \n aurreko \r bakarra kendu, amaierako \n-k ez du lerro hutsik sortzen
splitlines:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
SETR0 3
LDR8 R0
SETR0 4
LDR9 R0
ADDR9 R8 R9
; \n-ak zenbatu taularen tamainarako
SETR10 1
RCR1 R8
SETR2 10
splitlines.count:
IEQR1 R9 splitlines.alloc
LDR0 R1
ADDR1 R1 R31
INER0 R2 splitlines.count
ADDR10 R10 R31
J splitlines.count
splitlines.alloc:
SETR0 2
MULR0 R10 R0
C alloc
RCR10 R0
SETR1 5
STR10 R1
SETR11 0
SETR12 0
; R8 = lerroaren hasiera, R1 = kurtsorea
RCR1 R8
splitlines.scan:
IEQR1 R9 splitlines.end
LDR0 R1
SETR2 10
IEQR0 R2 splitlines.nl
ADDR1 R1 R31
J splitlines.scan
splitlines.nl:
; lerroa [R8, R1), aurreko \r bat kenduta
RCR3 R1
IEQR3 R8 splitlines.store
SUBR4 R3 R31
LDR4 R4
SETR2 13
INER4 R2 splitlines.store
SUBR3 R3 R31
splitlines.store:
SETR2 2
MULR2 R11 R2
ADDR2 R10 R2
STR8 R2
ADDR2 R2 R31
STR3 R2
SUBR4 R3 R8
ILTR4 R12 splitlines.short
RCR12 R4
splitlines.short:
ADDR11 R11 R31
ADDR1 R1 R31
RCR8 R1
J splitlines.scan
splitlines.end:
; azken lerroa \n gabe (bere \r-arekin)
IEQR8 R9 splitlines.done
SETR2 2
MULR2 R11 R2
ADDR2 R10 R2
STR8 R2
ADDR2 R2 R31
STR9 R2
SUBR4 R9 R8
ILTR4 R12 splitlines.short2
RCR12 R4
splitlines.short2:
ADDR11 R11 R31
splitlines.done:
SETR0 6
STR11 R0
SETR0 7
STR12 R0
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; printname: fitxategi-izena uneko irteerara (byteak). aldatzen ditu R0-R3
printname:
SETR0 1
LDR1 R0
SETR0 2
LDR2 R0
ADDR2 R1 R2
printname.next:
IEQR1 R2 printname.done
LDR0 R1
PUTCR0
ADDR1 R1 R31
J printname.next
printname.done:
RET

; setup: bufferrak, hash-taulak, bektoreak eta konstanteak
setup:
PUSHR8
PUSHR9
; lerro-luzerako bufferrak: MAXLEN + 64
SETR0 7
LDR8 R0
SETR0 64
ADDR8 R8 R0
RCR0 R8
C alloc
SETR1 42
STR0 R1
RCR0 R8
C alloc
SETR1 43
STR0 R1
RCR0 R8
C alloc
SETR1 44
STR0 R1
; hash-taulen maskara: 2^k - 1 >= 2 * (lerroak + 1), gutxienez 63
SETR0 6
LDR8 R0
ADDR8 R8 R31
ADDR8 R8 R8
SETR9 64
setup.mask:
IGTR9 R8 setup.masked
ADDR9 R9 R9
J setup.mask
setup.masked:
SUBR0 R9 R31
SETR1 19
STR0 R1
RCR0 R9
C alloc
SETR1 18
STR0 R1
RCR0 R9
C alloc
SETR1 20
STR0 R1
RCR0 R9
C alloc
SETR1 21
STR0 R1
; begizta-pila: lerro bakoitzeko gehienez bat, 5 gelaxka
SETR0 6
LDR0 R0
ADDR0 R0 R31
SETR1 5
MULR0 R0 R1
C alloc
SETR1 23
STR0 R1
; bektoreak
C vnew
SETR1 13
STR0 R1
C vnew
SETR1 15
STR0 R1
C vnew
SETR1 17
STR0 R1
C vnew
SETR1 22
STR0 R1
C ostart
; egoera: -1 = ez dago
SETR0 25
STR29 R0
SETR0 26
STR29 R0
SETR0 29
STR29 R0
SETR0 30
STR29 R0
SETR0 31
STR29 R0
; 10^0 .. 10^22, zehatzak
SETR0 23
C alloc
SETR1 65
STR0 R1
SETR1 1
SETR2 10
LS 23
STR1 R0
MULR1 R1 R2
ADDR0 R0 R31
LE
; bigint-ak: 300 gelaxka bakoitza (24 biteko 299 zati)
SETR0 300
C alloc
SETR1 66
STR0 R1
SETR0 300
C alloc
SETR1 67
STR0 R1
SETR0 300
C alloc
SETR1 68
STR0 R1
; eragigaien balioak eta taldeak: gehienez 8 eragigai
SETR0 64
C alloc
SETR1 73
STR0 R1
SETR0 32
C alloc
SETR1 74
STR0 R1
; konstanteak: hash-taula [gakoa, luzera, balioa], ordena [izena, luzera, lerroa, zutabea, luzera]
SETR0 19
LDR0 R0
ADDR0 R0 R31
C alloc
SETR1 84
STR0 R1
C vnew
SETR1 86
STR0 R1
SETR0 0
LDR1 R0
SETR2 87
STR1 R2
STXR1 "value"
SETR2 88
STR1 R2
STXR1 "->"
STR1 R0
; adierazpenetako izenak
C fnames
SETR1 48
STR0 R1
POPR9
POPR8
RET

; fnames: adierazpenetako konstante eta funtzioen izenak, 0-z amaituak, ordena honetan (1..9):
; pi tau e sqrt sin cos tan exp ln (π kode-puntu gisa bereizten da, 960). -> R0 = hasiera
fnames:
SETR0 0
LDR1 R0
RCR2 R1
STXR1 "pi"
STXR1 "tau"
STXR1 "e"
STXR1 "sqrt"
STXR1 "sin"
STXR1 "cos"
STXR1 "tan"
STXR1 "exp"
STXR1 "ln"
STR1 R0
RCR0 R2
RET

; ---------------------------------------------------------------- testua
; isws: R0 = kode-puntua -> R0 = 1 unicode-ko White_Space bada (char::is_whitespace), bestela 0. aldatzen ditu R0, R1
isws:
SETR1 32
IEQR0 R1 isws.yes
IGTR0 R1 isws.high
SETR1 9
ILTR0 R1 isws.no
SETR1 13
IGTR0 R1 isws.no
J isws.yes
isws.high:
SETR1 133
ILTR0 R1 isws.no
IEQR0 R1 isws.yes
SETR1 160
IEQR0 R1 isws.yes
SETR1 5760
IEQR0 R1 isws.yes
SETR1 8192
ILTR0 R1 isws.no
SETR1 8202
IGTR0 R1 isws.h2
J isws.yes
isws.h2:
SETR1 8232
IEQR0 R1 isws.yes
SETR1 8233
IEQR0 R1 isws.yes
SETR1 8239
IEQR0 R1 isws.yes
SETR1 8287
IEQR0 R1 isws.yes
SETR1 12288
IEQR0 R1 isws.yes
isws.no:
SETR0 0
RET
isws.yes:
SETR0 1
RET

; isdigit: R0 -> R0 = 1 ascii digitua bada. aldatzen ditu R0, R1
isdigit:
SETR1 48
ILTR0 R1 isws.no
SETR1 57
IGTR0 R1 isws.no
J isws.yes

; isalpha: R0 -> R0 = 1 ascii letra bada. aldatzen ditu R0, R1
isalpha:
SETR1 65
ILTR0 R1 isws.no
SETR1 90
IGTR0 R1 isalpha.low
J isws.yes
isalpha.low:
SETR1 97
ILTR0 R1 isws.no
SETR1 122
IGTR0 R1 isws.no
J isws.yes

; isalnum: R0 -> R0 = 1 ascii letra edo digitua bada. aldatzen ditu R0-R2
isalnum:
RCR2 R0
C isdigit
IEQR0 R31 isws.yes
RCR0 R2
J isalpha

; upper / lower: R0 = kode-puntua -> ascii maiuskula/minuskula. aldatzen ditu R0, R1
upper:
SETR1 97
ILTR0 R1 upper.done
SETR1 122
IGTR0 R1 upper.done
SETR1 32
SUBR0 R0 R1
upper.done:
RET
lower:
SETR1 65
ILTR0 R1 lower.done
SETR1 90
IGTR0 R1 lower.done
SETR1 32
ADDR0 R0 R1
lower.done:
RET

; copyup / copylow: R0 = iturria, R1 = luzera, R2 = helburua: kopia ascii maiuskulaz/minuskulaz.
; aldatzen ditu R0-R6
copyup:
SETR6 0
J copycase
copylow:
SETR6 1
copycase:
RCR3 R0
RCR4 R1
RCR5 R2
copycase.next:
IEQR4 R30 copycase.done
LDR0 R3
IEQR6 R31 copycase.low
C upper
J copycase.put
copycase.low:
C lower
copycase.put:
STR0 R5
ADDR3 R3 R31
ADDR5 R5 R31
SUBR4 R4 R31
J copycase.next
copycase.done:
RET

; textcopy: R0 = iturria, R1 = luzera -> R0 = kopia iraunkorra memoria dinamikoan. aldatzen ditu R0-R6
textcopy:
RCR5 R0
RCR6 R1
RCR0 R1
ADDR0 R0 R31
C alloc
RCR4 R0
SETR2 0
textcopy.next:
IEQR2 R6 textcopy.done
ADDR1 R5 R2
LDR1 R1
ADDR3 R4 R2
STR1 R3
ADDR2 R2 R31
J textcopy.next
textcopy.done:
RCR0 R4
RET

; streq: R0, R1 = lehen testua; R2, R3 = bigarrena -> R0 = 1 berdinak badira. aldatzen ditu R0-R6
streq:
INER1 R3 streq.no
SETR4 0
streq.next:
IEQR4 R1 isws.yes
ADDR5 R0 R4
LDR5 R5
ADDR6 R2 R4
LDR6 R6
INER5 R6 streq.no
ADDR4 R4 R31
J streq.next
streq.no:
SETR0 0
RET

; findrange: R0, R1 = testua -> R0 = ".." lehenaren posizioa (indizea), edo -1. aldatzen ditu R0-R5
findrange:
SETR2 0
SETR5 46
findrange.next:
ADDR3 R2 R31
ILTR3 R1 findrange.test
SETR0 -1
RET
findrange.test:
ADDR4 R0 R2
LDR4 R4
INER4 R5 findrange.skip
ADDR4 R0 R3
LDR4 R4
INER4 R5 findrange.skip
RCR0 R2
RET
findrange.skip:
ADDR2 R2 R31
J findrange.next

; endscolon: R0, R1 = testua -> R0 = 1 ':'-z amaitzen bada. aldatzen ditu R0, R1
endscolon:
IEQR1 R30 streq.no
ADDR0 R0 R1
SUBR0 R0 R31
LDR0 R0
SETR1 58
IEQR0 R1 isws.yes
J streq.no

; islabel: R0, R1 = testua -> R0 = 1 etiketa-izen baliozkoa bada (letra, _ edo . lehenik; gero letrak,
; digituak, _ edo .). aldatzen ditu R0-R5
islabel:
IEQR1 R30 streq.no
RCR3 R0
RCR4 R1
SETR5 0
islabel.next:
IEQR5 R4 isws.yes
ADDR0 R3 R5
LDR0 R0
SETR1 95
IEQR0 R1 islabel.ok
SETR1 46
IEQR0 R1 islabel.ok
IEQR5 R30 islabel.first
C isalnum
IEQR0 R30 streq.no
J islabel.ok
islabel.first:
C isalpha
IEQR0 R30 streq.no
islabel.ok:
ADDR5 R5 R31
J islabel.next

; parseu32: R0, R1 = testua -> R0 = 1 eta R1 = balioa, `str::parse::<u32>()` bezala (aukerako '+',
; digituak, gainezkarik gabe); bestela R0 = 0. aldatzen ditu R0-R6
parseu32:
C parsedec
IEQR0 R30 parseu32.done
IGTR1 R30 streq.no
parseu32.done:
RCR1 R2
RET

; parsedec: R0, R1 = testua -> R0 = 1, R1 = goiko 32 bitak, R2 = behekoak, `u64` hamartar bezala; bestela
; R0 = 0. aldatzen ditu R0-R6
parsedec:
SETR5 10
J parseradix
; parsehex: R0, R1 = testua -> `u64::from_str_radix(_, 16)` bezala. aldatzen ditu R0-R6
parsehex:
SETR5 16
parseradix:
PUSHR8
PUSHR9
PUSHR10
RCR3 R0
RCR4 R1
IEQR4 R30 parseradix.bad
LDR0 R3
SETR1 43
INER0 R1 parseradix.start
ADDR3 R3 R31
SUBR4 R4 R31
IEQR4 R30 parseradix.bad
parseradix.start:
SETR8 0
SETR9 0
parseradix.next:
IEQR4 R30 parseradix.ok
LDR0 R3
C digitval
ILTR0 R30 parseradix.bad
ILTR0 R5 parseradix.digit
J parseradix.bad
parseradix.digit:
; (R8, R9) = (R8, R9) * oinarria + digitua, 32 biteko bi zatitan
MULR9 R9 R5
ADDR9 R9 R0
SETR1 4294967296
SETR2 32
SHRR10 R9 R2
MULR2 R10 R1
SUBR9 R9 R2
MULR8 R8 R5
ADDR8 R8 R10
ILTR8 R1 parseradix.fits
J parseradix.bad
parseradix.fits:
ADDR3 R3 R31
SUBR4 R4 R31
J parseradix.next
parseradix.ok:
SETR0 1
RCR1 R8
RCR2 R9
POPR10
POPR9
POPR8
RET
parseradix.bad:
SETR0 0
POPR10
POPR9
POPR8
RET

; digitval: R0 = kode-puntua -> R0 = haren balioa digitu hamaseitar gisa (0..15), edo -1. aldatzen ditu R0, R1
digitval:
SETR1 48
ILTR0 R1 digitval.no
SETR1 57
IGTR0 R1 digitval.alpha
SETR1 48
SUBR0 R0 R1
RET
