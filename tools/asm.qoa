ADDR4 R4 R31
LDR5 R4
ADDR2 R4 (3)
STR5 R2
ADDR4 R4 R31
LDR5 R4
ADDR2 R4 (3)
STR5 R2
J tokins.loop
tokins.done:
RET

; singledot: R0, R1 = testua -> R0 = `.` bakar baten posizioa (ez `..` baten zatia), edo -1. aldatzen ditu R0-R4
singledot:
SETR2 0
singledot.next:
IEQR2 R1 singledot.no
ADDR3 R0 R2
LDR4 R3
INER4 (46) singledot.step
IEQR2 R30 singledot.after
