STORETEXT R1 "FREE|FRE||0|1|memory needs no freeing: LOAD and STORE use cells 0, 1, 2, ... directly|memoria ez da askatu behar: LOAD eta STORE 0, 1, 2, ... gelaxkak zuzenean erabiltzen dituzte|FREE|FREE"
STORETEXT R1 "BREAKPOINT|BP||0|1|use DUMPSTATE and DUMPREGS to look at a point in the program|erabili DUMPSTATE eta DUMPREGS programaren puntu bat ikusteko|BREAKPOINT|BREAKPOINT"
STORETEXT R1 "EXITCODE|EXC EX||0|1|use HALT|erabili HALT|EXITCODE|EXITCODE"
STORETEXT R1 "QUBITS|QUBIT||0|1|use QINIT with the qubit count, e.g. QINIT 25|erabili QINIT qubit-kopuruarekin, adib. QINIT 25|QUBITS|QUBITS"
STORETEXT R1 "QGATE|||0|1|use GATE name qubit, or the gate's own instruction|erabili GATE izena qubita, edo atearen agindu propioa|QGATE|QGATE"
; @isa-end
STORETEXT R1 ""
STORE R1 R0
REGCOPY R0 R2
RETSUB

; buildtext: agindu bakoitza zein eraikitzailek sortzen duen (eta haren parametroa), izen nagusiaren arabera.
; hau mihiztatzailearen logika da, ez src/isa.rs-eko datua: eraikitzaileak `build` atalean daude.
buildtext:
REGSET R0 0
LOAD R1 R0
REGCOPY R2 R1
STORETEXT R1 "H 1 0 X 1 1 Y 1 2 Z 1 3 S 1 4 SDG 1 5 T 1 6 TDG 1 7 SX 1 8 SXDG 1 9"
STORETEXT R1 "PHASE 2 13 RX 2 10 RY 2 11 RZ 2 12 U 3 0 ROT 4 0 MROT 5 0 GATE 6 0"
STORETEXT R1 "CNOT 7 1 CY 7 2 CH 7 0 CSX 7 8 CRX 8 10 CRY 8 11 CRZ 8 12 CU 9 0 CZ 10 0 CPHASE 10 1"
STORETEXT R1 "SWAP 11 0 CSWAP 12 0 CCX 13 0 MCX 14 0 MCZ 15 0 BELL 16 0 GHZ 17 5 CLUSTER 17 6 ESWAP 18 0"
STORETEXT R1 "MEASURE 19 0 MEASUREIN 20 0 MEASUREALL 21 9 RESETALL 21 11 DUMPSTATE 21 32 DUMPREGS 21 33"
STORETEXT R1 "RETSUB 21 52 HALT 21 55 BARRIER 21 56"
STORETEXT R1 "RESET 22 10 ADDPHOTON 22 27 SUBPHOTON 22 28 RAND 22 41 INPUT 22 43 GETTIME 22 44 PUSH 60 0"
STORETEXT R1 "POP 22 46 CHAROUT 61 0 GETC 22 64 PUTC 62 0 GETLANG 22 68 ARGC 22 69"
STORETEXT R1 "EMIT 23 13 DISPLACEREG 23 19 SQUEEZEREG 23 21 REGCOPY 57 0 LOAD 58 0 STORE 59 0 ARGBYTE 63 0"
STORETEXT R1 "TOBASIS 25 0 DISPLACE 26 18 SQUEEZE 26 20 MODEPHASE 27 0 KERR 28 0 CROSSKERR 29 0 BS 29 1"
STORETEXT R1 "MODESWAP 29 2 LOSS 30 0 FOCK 31 0 SINGLEPHOTON 32 0 COUNT 33 0 DETECT 34 15 PARITY 34 16"
STORETEXT R1 "COINCIDENCE 35 0 DISPERSIVE 36 0 EXPECT 37 0 BELLCHECK 38 0 MEANPHOTON 39 0 REGSET 40 0"
STORETEXT R1 "ADD 41 0 SUB 41 1 MUL 41 2 DIV 41 3 ANDBITS 41 4 ORBITS 41 5 XORBITS 41 6 SHL 41 7 SHR 41 8"
STORETEXT R1 "POW 41 9 SQRT 42 0 EXP 42 1 LOG 42 2 NOTBITS 42 3 SIN 42 4 COS 42 5 TAN 42 6 SEEDRNG 43 0"
STORETEXT R1 "CHARLOAD 44 0 PACKBITS 45 0 JUMP 46 48 CALL 46 51 JUMPIFZERO 47 0 JUMPIFONE 47 1"
STORETEXT R1 "IFEQ 48 0 IFNE 48 1 IFGT 48 2 IFLT 48 3 LOOPSTART 49 0 LOOPEND 50 0 PRINT 51 0 PRINTLN 51 1"
STORETEXT R1 "PRINTF 52 0 VERBOSELOG 53 0 STORETEXT 54 0 STREAM 55 0 EXIT 56 0"
STORETEXT R1 "QINIT 99 1 QMODE 99 2 QREG 99 3 CREG 99 4 OREG 99 5 COMMENT 99 6 RREG 99 7 CONST 99 8"
STORETEXT R1 ""
STORE R1 R0
REGCOPY R0 R2
RETSUB

; field: R0 = testuaren kurtsorea (byteak, 0-z amaitua) -> R0 = eremuaren hasiera, R1 = luzera, R2 = hurrengo
; eremuaren kurtsorea ('|' ondoren, edo 0-an geratzen da). aldatzen ditu R0-R4
field:
REGCOPY R2 R0
REGSET R4 124
field.next:
LOAD R3 R2
IFEQ R3 R30 field.end
IFEQ R3 R4 field.bar
ADD R2 R2 R31
JUMP field.next
field.bar:
SUB R1 R2 R0
ADD R2 R2 R31
RETSUB
field.end:
SUB R1 R2 R0
RETSUB

; isaload: taula irakurri eta izen-taula bete; gero eraikitzaileak lotu
isaload:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
; zehaztapenak: gehienez 512
REGSET R0 12288
CALL alloc
REGSET R1 8
STORE R0 R1
REGCOPY R10 R0
; izen-taula: 2048 zirrikitu
REGSET R0 2048
CALL alloc
REGSET R1 10
STORE R0 R1
REGSET R0 2047
REGSET R1 11
STORE R0 R1
CALL isatext
REGCOPY R8 R0
REGSET R9 0
isaload.rec:
LOAD R0 R8
IFEQ R0 R30 isaload.end
REGSET R0 24
MUL R11 R9 R0
ADD R11 R10 R11
; 0 izena
REGCOPY R0 R8
CALL field
STORE R0 R11
ADD R3 R11 R31
STORE R1 R3
REGCOPY R12 R2
; 1 ezizenak: geroago (R13, R14 = testua)
REGCOPY R0 R12
CALL field
REGCOPY R13 R0
REGCOPY R14 R1
REGCOPY R12 R2
; 2 eragigaiak
REGCOPY R0 R12
CALL field
PUSH R2
REGCOPY R2 R11
CALL operands
POP R12
; 3 hedapena, 4 kendua
REGCOPY R0 R12
CALL field
LOAD R0 R0
REGSET R3 48
SUB R0 R0 R3
REGSET R3 4
ADD R3 R11 R3
STORE R0 R3
REGCOPY R12 R2
REGCOPY R0 R12
CALL field
LOAD R0 R0
REGSET R3 48
SUB R0 R0 R3
REGSET R3 5
ADD R3 R11 R3
STORE R0 R3
REGCOPY R12 R2
; 5..8: arrazoiak eta erabilerak, 6. gelaxkatik aurrera bikoteka
REGSET R5 6
ADD R5 R11 R5
LOOPSTART 4
REGCOPY R0 R12
CALL field
STORE R0 R5
ADD R5 R5 R31
STORE R1 R5
ADD R5 R5 R31
REGCOPY R12 R2
LOOPEND
; hurrengo erregistroa: 0aren ondoren
isaload.skip:
LOAD R0 R12
IFEQ R0 R30 isaload.next
ADD R12 R12 R31
JUMP isaload.skip
isaload.next:
ADD R8 R12 R31
; izena eta ezizenak izen-taulan
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
REGCOPY R2 R11
CALL mnput
REGCOPY R0 R13
REGCOPY R1 R14
REGCOPY R2 R11
CALL aliases
ADD R9 R9 R31
JUMP isaload.rec
isaload.end:
REGSET R0 9
STORE R9 R0
CALL builders
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; mnput: R0, R1 = izena, R2 = zehaztapena -> izen-taulan (izen bera berriz agertzen bada, azkenak irabazten du,
; rust-en HashMap::insert bezala). aldatzen ditu R0-R7
mnput:
PUSH R8
PUSH R9
PUSH R10
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGSET R0 10
LOAD R0 R0
REGCOPY R1 R8
REGCOPY R2 R9
REGSET R3 2047
CALL htfind
IFEQ R1 R30 mnput.new
ADD R1 R1 R31
ADD R1 R1 R31
STORE R10 R1
JUMP mnput.done
mnput.new:
REGCOPY R4 R0
REGSET R0 3
PUSH R4
CALL alloc
POP R4
STORE R8 R0
ADD R1 R0 R31
STORE R9 R1
ADD R1 R1 R31
STORE R10 R1
STORE R0 R4
mnput.done:
POP R10
POP R9
POP R8
RETSUB

; aliases: R0, R1 = hutsunez bereizitako ezizenak, R2 = zehaztapena -> zerrenda (16-17) eta izen-taula
aliases:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
ADD R9 R0 R1
REGCOPY R10 R2
; gehienez luzera/2 + 1 ezizen
REGCOPY R0 R1
ADD R0 R0 R31
CALL alloc
REGSET R1 16
ADD R1 R10 R1
STORE R0 R1
REGCOPY R11 R0
REGSET R12 0
aliases.next:
IFEQ R8 R9 aliases.done
LOAD R0 R8
REGSET R1 32
IFNE R0 R1 aliases.word
ADD R8 R8 R31
JUMP aliases.next
aliases.word:
REGCOPY R3 R8
aliases.scan:
IFEQ R8 R9 aliases.got
LOAD R0 R8
REGSET R1 32
IFEQ R0 R1 aliases.got
ADD R8 R8 R31
JUMP aliases.scan
aliases.got:
REGSET R0 2
MUL R0 R12 R0
ADD R0 R11 R0
STORE R3 R0
SUB R1 R8 R3
ADD R0 R0 R31
STORE R1 R0
ADD R12 R12 R31
REGCOPY R0 R3
REGCOPY R2 R10
CALL mnput
JUMP aliases.next
aliases.done:
REGSET R1 17
ADD R1 R10 R1
STORE R12 R1
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; operands: R0, R1 = "q:control q:target" bezalako testua, R2 = zehaztapena -> eragigai-zerrenda (2-3)
operands:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
REGCOPY R8 R0
ADD R9 R0 R1
REGCOPY R10 R2
REGSET R0 40
CALL alloc
REGSET R1 2
ADD R1 R10 R1
STORE R0 R1
REGCOPY R11 R0
REGSET R12 0
operands.next:
IFEQ R8 R9 operands.done
LOAD R0 R8
REGSET R1 32
IFNE R0 R1 operands.item
ADD R8 R8 R31
JUMP operands.next
operands.item:
; mota:izena[?+*]
REGSET R0 5
MUL R0 R12 R0
ADD R7 R11 R0
LOAD R0 R8
STORE R0 R7
REGSET R0 2
ADD R8 R8 R0
REGCOPY R3 R8
operands.scan:
IFEQ R8 R9 operands.got
LOAD R0 R8
REGSET R1 32
IFEQ R0 R1 operands.got
ADD R8 R8 R31
JUMP operands.scan
operands.got:
SUB R4 R8 R3
SUB R0 R8 R31
LOAD R0 R0
REGSET R5 0
REGSET R6 0
REGSET R1 63
IFNE R0 R1 operands.plus
REGSET R5 1
SUB R4 R4 R31
JUMP operands.set
operands.plus:
REGSET R1 43
IFNE R0 R1 operands.star
REGSET R6 1
SUB R4 R4 R31
JUMP operands.set
operands.star:
REGSET R1 42
IFNE R0 R1 operands.set
REGSET R5 1
REGSET R6 2
SUB R4 R4 R31
operands.set:
ADD R0 R7 R31
STORE R3 R0
ADD R0 R0 R31
STORE R4 R0
ADD R0 R0 R31
STORE R5 R0
ADD R0 R0 R31
STORE R6 R0
ADD R12 R12 R31
JUMP operands.next
operands.done:
REGSET R1 3
ADD R1 R10 R1
STORE R12 R1
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; lookup: R0, R1 = mnemonikoa (kode-puntuak) -> R0 = zehaztapena, edo 0 ez badago (maiuskula/minuskula
; berdin). aldatzen ditu R0-R7
lookup:
PUSH R8
REGCOPY R8 R1
REGSET R2 42
LOAD R2 R2
CALL copyup
REGSET R0 10
LOAD R0 R0
REGSET R1 42
LOAD R1 R1
REGCOPY R2 R8
REGSET R3 2047
CALL htfind
REGCOPY R0 R1
IFEQ R0 R30 lookup.done
ADD R0 R0 R31
ADD R0 R0 R31
LOAD R0 R0
lookup.done:
POP R8
RETSUB

; builders: buildtext irakurri eta zehaztapen bakoitzari eraikitzailea eman; agindu bizi bakoitzak bat behar du
builders:
PUSH R8
PUSH R9
PUSH R10
CALL buildtext
REGCOPY R8 R0
builders.next:
LOAD R0 R8
IFNE R0 R30 builders.byte
; erregistroen artean 0 bat; bi jarraian amaiera dira
ADD R8 R8 R31
LOAD R0 R8
IFEQ R0 R30 builders.check
JUMP builders.next
builders.byte:
REGSET R1 32
IFNE R0 R1 builders.word
ADD R8 R8 R31
JUMP builders.next
builders.word:
; izena
REGCOPY R9 R8
builders.scan:
LOAD R0 R8
REGSET R1 32
IFEQ R0 R1 builders.name
ADD R8 R8 R31
JUMP builders.scan
builders.name:
REGCOPY R0 R9
SUB R1 R8 R9
CALL lookup
IFEQ R0 R30 builders.unknown
REGCOPY R10 R0
ADD R8 R8 R31
CALL buildnum
REGSET R1 14
ADD R1 R10 R1
STORE R0 R1
CALL buildnum
REGSET R1 15
ADD R1 R10 R1
STORE R0 R1
JUMP builders.next
builders.unknown:
STREAM 2
PRINT "tools/asm.qoa: buildtext names an instruction that is not in the table: "
REGCOPY R0 R9
SUB R1 R8 R9
CALL printbytes
PRINTLN ""
EXIT 70
builders.check:
; agindu bizi guztiek eraikitzailea dute
REGSET R0 9
LOAD R9 R0
REGSET R0 8
LOAD R8 R0
builders.each:
IFEQ R9 R30 builders.done
REGSET R0 5
ADD R0 R8 R0
LOAD R0 R0
IFEQ R0 R31 builders.skip
REGSET R0 14
ADD R0 R8 R0
LOAD R0 R0
IFNE R0 R30 builders.skip
STREAM 2
PRINT "tools/asm.qoa: buildtext has no builder for "
LOAD R0 R8
ADD R1 R8 R31
LOAD R1 R1
CALL printbytes
PRINTLN ""
EXIT 70
builders.skip:
REGSET R0 24
ADD R8 R8 R0
SUB R9 R9 R31
JUMP builders.each
builders.done:
POP R10
POP R9
POP R8
RETSUB

; buildnum: R8 = kurtsorea -> R0 = hurrengo zenbaki hamartarra (hutsuneak saltatuta), R8 haren ondoren
buildnum:
LOAD R0 R8
REGSET R1 32
IFNE R0 R1 buildnum.start
ADD R8 R8 R31
JUMP buildnum
buildnum.start:
REGSET R2 0
buildnum.next:
LOAD R0 R8
REGSET R1 48
IFLT R0 R1 buildnum.done
REGSET R1 57
IFGT R0 R1 buildnum.done
REGSET R1 48
SUB R0 R0 R1
REGSET R1 10
MUL R2 R2 R1
ADD R2 R2 R0
ADD R8 R8 R31
JUMP buildnum.next
buildnum.done:
REGCOPY R0 R2
RETSUB

; printbytes: R0 = helbidea, R1 = luzera -> byteak uneko irteerara. aldatzen ditu R0-R2
printbytes:
ADD R1 R0 R1
printbytes.next:
IFEQ R0 R1 printbytes.done
LOAD R2 R0
PUTC R2
ADD R0 R0 R31
JUMP printbytes.next
printbytes.done:
RETSUB

; printtext: R0 = kode-puntuen helbidea, R1 = kopurua -> uneko irteerara (utf-8). aldatzen ditu R0-R2
printtext:
ADD R1 R0 R1
printtext.next:
IFEQ R0 R1 printtext.done
LOAD R2 R0
CHAROUT R2
ADD R0 R0 R31
JUMP printtext.next
printtext.done:
RETSUB

; ---------------------------------------------------------------- unicode-ko letrak
; adierazpenetako izenak rust-ek bezala: letra batekin edo _-rekin hasten dira (char::is_alphabetic) eta letrak,
; zenbakiak edo _ jarraitzen dute (char::is_alphanumeric). ascii ez direnetarako taulak rust-etik sortuak dira,
; lehen aldiz behar direnean irakurtzen dira

; alphatext / alnumtext: tarteak hamaseitarrez ("a-b"), 0-z amaitutako erregistroetan; hutsak amaitzen du
alphatext:
REGSET R0 0
LOAD R1 R0
REGCOPY R2 R1
; @alpha-begin
STORETEXT R1 "aa-aa b5-b5 ba-ba c0-d6 d8-f6 f8-2c1 2c6-2d1 2e0-2e4 2ec-2ec 2ee-2ee 345-345 363-374"
STORETEXT R1 "376-377 37a-37d 37f-37f 386-386 388-38a 38c-38c 38e-3a1 3a3-3f5 3f7-481 48a-52f 531-556 559-559"
STORETEXT R1 "560-588 5b0-5bd 5bf-5bf 5c1-5c2 5c4-5c5 5c7-5c7 5d0-5ea 5ef-5f2 610-61a 620-657 659-65f 66e-6d3"
STORETEXT R1 "6d5-6dc 6e1-6e8 6ed-6ef 6fa-6fc 6ff-6ff 710-73f 74d-7b1 7ca-7ea 7f4-7f5 7fa-7fa 800-817 81a-82c"
STORETEXT R1 "840-858 860-86a 870-887 889-88f 897-897 8a0-8c9 8d4-8df 8e3-8e9 8f0-93b 93d-94c 94e-950 955-963"
STORETEXT R1 "971-983 985-98c 98f-990 993-9a8 9aa-9b0 9b2-9b2 9b6-9b9 9bd-9c4 9c7-9c8 9cb-9cc 9ce-9ce 9d7-9d7"
STORETEXT R1 "9dc-9dd 9df-9e3 9f0-9f1 9fc-9fc a01-a03 a05-a0a a0f-a10 a13-a28 a2a-a30 a32-a33 a35-a36 a38-a39"
STORETEXT R1 "a3e-a42 a47-a48 a4b-a4c a51-a51 a59-a5c a5e-a5e a70-a75 a81-a83 a85-a8d a8f-a91 a93-aa8 aaa-ab0"
STORETEXT R1 "ab2-ab3 ab5-ab9 abd-ac5 ac7-ac9 acb-acc ad0-ad0 ae0-ae3 af9-afc b01-b03 b05-b0c b0f-b10 b13-b28"
STORETEXT R1 "b2a-b30 b32-b33 b35-b39 b3d-b44 b47-b48 b4b-b4c b56-b57 b5c-b5d b5f-b63 b71-b71 b82-b83 b85-b8a"
STORETEXT R1 "b8e-b90 b92-b95 b99-b9a b9c-b9c b9e-b9f ba3-ba4 ba8-baa bae-bb9 bbe-bc2 bc6-bc8 bca-bcc bd0-bd0"
STORETEXT R1 "bd7-bd7 c00-c0c c0e-c10 c12-c28 c2a-c39 c3d-c44 c46-c48 c4a-c4c c55-c56 c58-c5a c5c-c5d c60-c63"
STORETEXT R1 "c80-c83 c85-c8c c8e-c90 c92-ca8 caa-cb3 cb5-cb9 cbd-cc4 cc6-cc8 cca-ccc cd5-cd6 cdc-cde ce0-ce3"
STORETEXT R1 "cf1-cf3 d00-d0c d0e-d10 d12-d3a d3d-d44 d46-d48 d4a-d4c d4e-d4e d54-d57 d5f-d63 d7a-d7f d81-d83"
STORETEXT R1 "d85-d96 d9a-db1 db3-dbb dbd-dbd dc0-dc6 dcf-dd4 dd6-dd6 dd8-ddf df2-df3 e01-e3a e40-e46 e4d-e4d"
STORETEXT R1 "e81-e82 e84-e84 e86-e8a e8c-ea3 ea5-ea5 ea7-eb9 ebb-ebd ec0-ec4 ec6-ec6 ecd-ecd edc-edf f00-f00"
STORETEXT R1 "f40-f47 f49-f6c f71-f83 f88-f97 f99-fbc 1000-1036 1038-1038 103b-103f 1050-108f 109a-109d 10a0-10c5 10c7-10c7"
STORETEXT R1 "10cd-10cd 10d0-10fa 10fc-1248 124a-124d 1250-1256 1258-1258 125a-125d 1260-1288 128a-128d 1290-12b0 12b2-12b5 12b8-12be"
STORETEXT R1 "12c0-12c0 12c2-12c5 12c8-12d6 12d8-1310 1312-1315 1318-135a 1380-138f 13a0-13f5 13f8-13fd 1401-166c 166f-167f 1681-169a"
STORETEXT R1 "16a0-16ea 16ee-16f8 1700-1713 171f-1733 1740-1753 1760-176c 176e-1770 1772-1773 1780-17b3 17b6-17c8 17d7-17d7 17dc-17dc"
STORETEXT R1 "1820-1878 1880-18aa 18b0-18f5 1900-191e 1920-192b 1930-1938 1950-196d 1970-1974 1980-19ab 19b0-19c9 1a00-1a1b 1a20-1a5e"
STORETEXT R1 "1a61-1a74 1aa7-1aa7 1abf-1ac0 1acc-1ace 1b00-1b33 1b35-1b43 1b45-1b4c 1b80-1ba9 1bac-1baf 1bba-1be5 1be7-1bf1 1c00-1c36"
STORETEXT R1 "1c4d-1c4f 1c5a-1c7d 1c80-1c8a 1c90-1cba 1cbd-1cbf 1ce9-1cec 1cee-1cf3 1cf5-1cf6 1cfa-1cfa 1d00-1dbf 1dd3-1df4 1e00-1f15"
STORETEXT R1 "1f18-1f1d 1f20-1f45 1f48-1f4d 1f50-1f57 1f59-1f59 1f5b-1f5b 1f5d-1f5d 1f5f-1f7d 1f80-1fb4 1fb6-1fbc 1fbe-1fbe 1fc2-1fc4"
STORETEXT R1 "1fc6-1fcc 1fd0-1fd3 1fd6-1fdb 1fe0-1fec 1ff2-1ff4 1ff6-1ffc 2071-2071 207f-207f 2090-209c 2102-2102 2107-2107 210a-2113"
STORETEXT R1 "2115-2115 2119-211d 2124-2124 2126-2126 2128-2128 212a-212d 212f-2139 213c-213f 2145-2149 214e-214e 2160-2188 24b6-24e9"
STORETEXT R1 "2c00-2ce4 2ceb-2cee 2cf2-2cf3 2d00-2d25 2d27-2d27 2d2d-2d2d 2d30-2d67 2d6f-2d6f 2d80-2d96 2da0-2da6 2da8-2dae 2db0-2db6"
STORETEXT R1 "2db8-2dbe 2dc0-2dc6 2dc8-2dce 2dd0-2dd6 2dd8-2dde 2de0-2dff 2e2f-2e2f 3005-3007 3021-3029 3031-3035 3038-303c 3041-3096"
STORETEXT R1 "309d-309f 30a1-30fa 30fc-30ff 3105-312f 3131-318e 31a0-31bf 31f0-31ff 3400-4dbf 4e00-a48c a4d0-a4fd a500-a60c a610-a61f"
