helptext:
RCR6 R0
SETR1 14
ADDR1 R6 R1
LDR5 R1
SETR1 2
IEQR5 R1 helptext.2
SETR1 3
IEQR5 R1 helptext.3
SETR1 8
IEQR5 R1 helptext.8
SETR1 11
IEQR5 R1 helptext.11
SETR1 14
IEQR5 R1 helptext.14
SETR1 24
IEQR5 R1 helptext.24
SETR1 25
IEQR5 R1 helptext.25
SETR1 41
IEQR5 R1 helptext.41
SETR1 42
IEQR5 R1 helptext.42
SETR1 43
IEQR5 R1 helptext.43
SETR1 44
IEQR5 R1 helptext.44
SETR1 45
IEQR5 R1 helptext.45
SETR1 54
IEQR5 R1 helptext.54
SETR1 58
IEQR5 R1 helptext.58
SETR1 60
IEQR5 R1 helptext.60
SETR1 61
IEQR5 R1 helptext.61
SETR1 90
IEQR5 R1 helptext.90
SETR1 124
IEQR5 R1 helptext.124
SETR1 160
IEQR5 R1 helptext.160
SETR1 161
IEQR5 R1 helptext.161
RET
helptext.161:
IEQR28 R31 helptext.161.eu
PRINT "a seal must be the last line of the file: it seals the lines above it"
RET
helptext.161.eu:
PRINT "zigilu batek fitxategiaren azken lerroa izan behar du: haren gaineko lerroak zigilatzen ditu"
RET
helptext.2:
IEQR28 R31 helptext.2.eu
PRINT "it was first defined on line "
SETR0 15
C mnum
RET
helptext.2.eu:
PRINT "lehen aldiz "
SETR0 15
C mnum
PRINT ". lerroan definitu zen"
RET
helptext.3:
IEQR28 R31 helptext.3.eu
PRINT "labels start with a letter or _ and contain letters, digits, _ or ."
RET
helptext.3.eu:
PRINT "etiketak letra batekin edo _-rekin hasten dira, eta letrak, digituak, _ edo . dituzte"
RET
helptext.8:
IEQR28 R31 helptext.8.eu
PRINT "since QOA 0.4, QINIT takes the qubit count once (QINIT 3); it no longer allocates one qubit per line"
RET
helptext.8.eu:
PRINT "QOA 0.4-tik aurrera, QINIT-ek qubit-kopurua hartzen du behin (QINIT 3); jada ez du lerro bakoitzeko qubit bat sortzen"
RET
helptext.11:
IEQR28 R31 helptext.11.eu
PRINT "for example: QINIT 3"
RET
helptext.11.eu:
PRINT "adibidez: QINIT 3"
RET
helptext.14:
IEQR28 R31 helptext.14.eu
PRINT "for example: QMODE 2 6"
RET
helptext.14.eu:
PRINT "adibidez: QMODE 2 6"
RET
helptext.24:
IEQR28 R31 helptext.24.eu
PRINT "did you mean "
SETR0 15
C mspec
PRINT "?"
RET
helptext.24.eu:
SETR0 15
C mspec
PRINT " esan nahi zenuen?"
RET
helptext.25:
IEQR28 R31 helptext.25.eu
SETR0 15
C mreason
RET
helptext.25.eu:
SETR0 15
C mreason
RET
helptext.41:
IEQR28 R31 helptext.41.eu
PRINT "write a qubit as q3 (or just 3)"
RET
helptext.41.eu:
PRINT "idatzi qubit bat q3 gisa (edo 3 besterik ez)"
RET
helptext.42:
IEQR28 R31 helptext.42.eu
PRINT "write an optical mode as o1 (or just 1)"
RET
helptext.42.eu:
PRINT "idatzi modu optiko bat o1 gisa (edo 1 besterik ez)"
RET
helptext.43:
IEQR28 R31 helptext.43.eu
PRINT "write a classical bit as c0"
RET
helptext.43.eu:
PRINT "idatzi bit klasiko bat c0 gisa"
RET
helptext.44:
IEQR28 R31 helptext.44.eu
PRINT "write a register as R2 (or just 2)"
RET
helptext.44.eu:
PRINT "idatzi erregistro bat R2 gisa (edo 2 besterik ez)"
RET
helptext.45:
IEQR28 R31 helptext.45.eu
PRINT "QINIT (line "
SETR0 15
C mnum
PRINT ") takes the number of qubits; this program needs at least "
SETR0 16
C mnum
PRINT ". Later uses of missing qubits are not reported again"
RET
helptext.45.eu:
PRINT "QINIT-ek ("
SETR0 15
C mnum
PRINT ". lerroa) qubit-kopurua hartzen du; programa honek gutxienez "
SETR0 16
C mnum
PRINT " behar ditu. Falta diren qubiten hurrengo erabilerak ez dira berriz jakinarazten"
RET
helptext.54:
IEQR28 R31 helptext.54.eu
PRINT "write a classical bit as c0 or a register as R2"
RET
helptext.54.eu:
PRINT "idatzi bit klasiko bat c0 gisa edo erregistro bat R2 gisa"
RET
helptext.58:
IEQR28 R31 helptext.58.eu
PRINT "GATE takes one of: h x y z s sdg t tdg sx sxdg (two-qubit gates have their own instructions)"
RET
helptext.58.eu:
PRINT "GATE-k hauetako bat hartzen du: h x y z s sdg t tdg sx sxdg (bi qubiteko ateek beren agindu propioak dituzte)"
RET
helptext.60:
IEQR28 R31 helptext.60.eu
PRINT "raise the cutoff with QMODE"
RET
helptext.60.eu:
PRINT "handitu muga QMODE bidez"
RET
helptext.61:
