RET

; ---------------------------------------------------------------- erroreen txostena
; asm.rs bezala: (lerroa, zutabea) ordenan (ordena egonkorra: sortu ziren ordena berdinketetan), gehienez 30,
; gainerakoak lerro batean; gero "N error(s) in IZENA"

; dless: R0, R1 = diagnostikoak -> R0 = 1 lehena lehenago badoa. aldatzen ditu R0-R5
dless:
LDR2 R0
LDR3 R1
ILTR2 R3 dless.yes
IGTR2 R3 dless.no
ADDR2 R0 R31
LDR2 R2
ADDR3 R1 R31
LDR3 R3
ILTR2 R3 dless.yes
IGTR2 R3 dless.no
SETR4 19
ADDR2 R0 R4
LDR2 R2
ADDR3 R1 R4
LDR3 R3
ILTR2 R3 dless.yes
dless.no:
SETR0 0
RET
dless.yes:
SETR0 1
RET

