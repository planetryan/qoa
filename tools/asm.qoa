STORE R9 R1
STORE R0 R10
lnput.done:
POP R10
POP R9
POP R8
RETSUB

; lnhas: R0, R1 = izena -> R0 = 1 etiketa-izenen multzoan badago (minuskulaz konparatuta). aldatzen ditu R0-R7
lnhas:
REGSET R3 20
JUMP lowfind
; lblfind: R0, R1 = izena -> R0 = zirrikitua, R1 = etiketa (edo 0), minuskulaz. aldatzen ditu R0-R7
