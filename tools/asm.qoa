PRINT ": expected "
CALL mexpected
PRINT ", found "
REGSET R0 7
CALL mnum
RETSUB
message.29.eu:
PRINT "eragigai gutxiegi "
REGSET R0 4
CALL mspec
PRINT "-rentzat: "
CALL mexpected
PRINT " espero ziren, "
REGSET R0 7
CALL mnum
PRINT " daude"
RETSUB
message.30:
IFEQ R28 R31 message.30.eu
PRINT "too many operands for "
REGSET R0 4
CALL mspec
PRINT ": expected "
