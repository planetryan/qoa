PRINT ", found "
REGSET R0 7
CALL mnum
RETSUB
message.30.eu:
PRINT "eragigai gehiegi "
REGSET R0 4
CALL mspec
PRINT "-rentzat: "
CALL mexpected
PRINT " espero ziren, "
REGSET R0 7
CALL mnum
PRINT " daude"
RETSUB
message.31:
