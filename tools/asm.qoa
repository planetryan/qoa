uniranges.sep:
ADDR8 R8 R31
J uniranges.next
uniranges.num:
SETR1 32
IEQR0 R1 uniranges.sep
SETR1 45
IEQR0 R1 uniranges.sep
; zenbaki hamaseitar bat
SETR2 0
