IFLT R0 R30 line.plain
REGCOPY R0 R11
REGSET R1 113
CALL indexlist
IFEQ R0 R30 line.done
REGCOPY R13 R1
REGCOPY R14 R2
; helmuga ere tartea bada (MEASURE q0..q2 -> c0..c2), bikoteka: beste zutabe bateko lehen tartea
REGSET R15 -1
REGSET R16 0
line.dest:
IFEQ R16 R12 line.expand
REGSET R0 3
MUL R0 R16 R0
ADD R17 R11 R0
