CALL mbytes
PRINT "-rentzat, baina '"
REGSET R0 6
CALL mtext
PRINT "' dago"
RETSUB
message.36:
IFEQ R28 R31 message.36.eu
PRINT "expected a count (a number or a register like R1), found '"
REGSET R0 4
CALL mtext
PRINT "'"
RETSUB
message.36.eu:
PRINT "kopuru bat espero zen (zenbaki bat edo R1 bezalako erregistro bat), baina '"
REGSET R0 4
CALL mtext
PRINT "' dago"
RETSUB
message.37:
IFEQ R28 R31 message.37.eu
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' is not a label name"
RETSUB
message.37.eu:
PRINT "'"
REGSET R0 4
CALL mtext
PRINT "' ez da etiketa-izen bat"
RETSUB
message.38:
