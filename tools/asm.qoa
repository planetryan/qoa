POPR12
POPR11
POPR10
POPR9
POPR8
RET

; gluereg: R0 = eragigai-mota, R1, R2 = testua -> R0 = 1 mota horretako erregistro bat (q0) edo tarte bat (q0..q3)
; bada. aldatzen ditu R0-R7
gluereg:
PUSHR8
PUSHR9
PUSHR10
RCR8 R0
RCR9 R1
RCR10 R2
; lehen ".."
SETR3 0
gluereg.find:
ADDR4 R3 R31
ILTR4 R10 gluereg.look
J gluereg.whole
gluereg.look:
ADDR5 R9 R3
LDR6 R5
INER6 (46) gluereg.fstep
ADDR5 R5 R31
LDR6 R5
IEQR6 (46) gluereg.range
gluereg.fstep:
ADDR3 R3 R31
J gluereg.find
gluereg.range:
; [0, R3) eta [R3+2, luzera)
PUSHR3
RCR0 R8
RCR1 R9
RCR2 R3
SETR3 1
C gluepart
POPR3
IEQR0 R30 gluereg.ret
RCR0 R8
ADDR1 R9 R3
ADDR1 R1 (2)
SUBR2 R10 R3
SUBR2 R2 (2)
SETR3 0
C gluepart
J gluereg.ret
gluereg.whole:
RCR0 R8
RCR1 R9
RCR2 R10
SETR3 1
C gluepart
gluereg.ret:
POPR10
POPR9
POPR8
RET

; gluepart: R0 = mota, R1, R2 = testua, R3 = 1 lehena bada -> R0 = 1 mota horren letra eta digituak badira (edo,
; lehena ez bada, digituak bakarrik). aldatzen ditu R0-R7
gluepart:
IEQR2 R30 gluepart.no
LDR4 R1
; R5 = letra egokia
SETR5 0
INER0 (113) gluepart.o
IEQR4 (113) gluepart.l
IEQR4 (81) gluepart.l
gluepart.o:
INER0 (111) gluepart.c
IEQR4 (111) gluepart.l
IEQR4 (79) gluepart.l
gluepart.c:
IEQR0 (99) gluepart.cc
INER0 (118) gluepart.r
gluepart.cc:
IEQR4 (99) gluepart.l
IEQR4 (67) gluepart.l
gluepart.r:
IEQR0 (114) gluepart.rr
IEQR0 (120) gluepart.rr
IEQR0 (118) gluepart.rr
J gluepart.kind
gluepart.rr:
IEQR4 (114) gluepart.l
IEQR4 (82) gluepart.l
J gluepart.kind
gluepart.l:
SETR5 1
gluepart.kind:
; letrarekin: gutxienez digitu bat; digituarekin (lehena ez bada): onartua
IEQR5 R30 gluepart.num
ILTR2 (2) gluepart.no
J gluepart.digits
gluepart.num:
INER3 R30 gluepart.no
ILTR4 (48) gluepart.no
IGTR4 (57) gluepart.no
gluepart.digits:
SETR6 1
gluepart.d:
IEQR6 R2 gluepart.yes
ADDR7 R1 R6
LDR7 R7
ILTR7 (48) gluepart.no
IGTR7 (57) gluepart.no
ADDR6 R6 R31
J gluepart.d
gluepart.yes:
SETR0 1
RET
gluepart.no:
SETR0 0
RET

; ---------------------------------------------------------------- agindu-taula
; zehaztapen bakoitza (24 gelaxka): 0 izena 1 luzera 2 eragigaiak 3 kopurua 4 hedapena (q0..q3) 5 kendua
; 6-7 kentzearen arrazoia ingelesez 8-9 euskaraz 10-11 erabilera ingelesez 12-13 euskaraz 14 eraikitzailea
; 15 parametroa 16 ezizenak ([helbidea, luzera] bikoteak) 17 ezizen-kopurua.
; eragigai bakoitza (5 gelaxka): 0 mota (karakterea) 1-2 izena 3 aukerakoa 4 errepikapena (0 bat, 1 bat edo
; gehiago, 2 zero edo gehiago). izen-taulako erregistroak: [gakoa, luzera, zehaztapena]

; isatext: src/isa.rs-eko taula testu gisa memoriara. erregistro bakoitza: izena|ezizenak|eragigaiak|hedapena|
; kendua|arrazoia (en)|arrazoia (eu)|erabilera (en)|erabilera (eu)|izen labur leuna; erregistro hutsak amaitzen
; du. -> R0 = hasiera
isatext:
SETR0 0
LDR1 R0
RCR2 R1
; @isa-begin
STXR1 "QINIT|QI INITQUBIT IQ QINITQ|i:qubits|0|0|||QINIT qubits|QINIT qubitak|"
STXR1 "QMODE|MODES|i:modes i:cutoff?|0|0|||QMODE modes [cutoff]|QMODE moduak [muga]|QO"
