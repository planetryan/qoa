IEQR28 R31 helptext.124.eu
PRINT "`qoa isa` lists every instruction"
RET
helptext.124.eu:
PRINT "`qoa isa`-k agindu guztiak zerrendatzen ditu"
RET
helptext.160:
IEQR28 R31 helptext.160.eu
PRINT "declare a larger cutoff, e.g. QMODE 1 16"
RET
helptext.160.eu:
PRINT "adierazi muga handiago bat, adib. QMODE 1 16"
RET

; mtext: R0 = gelaxka -> R6-ko testu-parametroa (kode-puntuak). aldatzen ditu R0-R3
mtext:
ADDR3 R6 R0
LDR0 R3
ADDR3 R3 R31
LDR1 R3
J printtext

; mbytes: R0 = gelaxka -> byteen parametroa (taulako izena). aldatzen ditu R0-R3
mbytes:
ADDR3 R6 R0
LDR0 R3
ADDR3 R3 R31
LDR1 R3
J printbytes

; mnum: R0 = gelaxka -> zenbakia (osoak hamartarrik gabe, besteak rust-ek bezala). aldatzen ditu R0
mnum:
ADDR0 R6 R0
LDR0 R0
PF "{}" R0
RET

; mchar: R0 = gelaxka -> karaktere bat (kode-puntua; r erregistroa R gisa). aldatzen ditu R0
mchar:
ADDR0 R6 R0
LDR0 R0
INER0 (114) mchar.out
SETR0 82
mchar.out:
COR0
RET

; mquote: komatxo bikoitza. aldatzen ditu R0
mquote:
SETR0 34
PUTCR0
RET

; mspec: R0 = gelaxka -> agindu-zehaztapenaren izena. aldatzen ditu R0-R3
mspec:
ADDR0 R6 R0
LDR3 R0
LDR0 R3
ADDR1 R3 R31
LDR1 R1
J printbytes

; mreason / musage: R0 = gelaxka -> zehaztapenaren kentze-arrazoia / erabilera, uneko hizkuntzan. aldatzen ditu R0-R3
mreason:
SETR2 6
J mspectext
musage:
SETR2 10
mspectext:
ADDR0 R6 R0
LDR3 R0
INER28 R31 mspectext.en
SETR0 2
ADDR2 R2 R0
mspectext.en:
ADDR3 R3 R2
LDR0 R3
ADDR1 R3 R31
LDR1 R1
J printbytes

; mwhat: R0 = gelaxka -> "QINIT" (0) edo "QMODE" (1). aldatzen ditu R0
mwhat:
ADDR0 R6 R0
LDR0 R0
IEQR0 R30 mwhat.q
PRINT "QMODE"
RET
mwhat.q:
PRINT "QINIT"
RET

; mexpected: beharrezkoak (5) eta guztiak (6): "2" edo "1-2". aldatzen ditu R0-R2
mexpected:
SETR0 5
ADDR0 R6 R0
LDR1 R0
ADDR0 R0 R31
LDR2 R0
IEQR1 R2 mexpected.one
PF "{}-{}" R1 R2
RET
mexpected.one:
PF "{}" R1
RET

; mu64at: R0 = gelaxka -> u64 zenbakia (goikoak, behekoak). aldatzen ditu R0-R5
mu64at:
ADDR2 R6 R0
LDR0 R2
ADDR2 R2 R31
LDR1 R2
; mu64: R0 = goikoak, R1 = behekoak -> zenbaki hamartarra (100-119 gelaxkak). aldatzen ditu R0-R5
mu64:
IGTR0 R30 mu64.big
PF "{}" R1
RET
mu64.big:
SETR4 0
mu64.loop:
SETR2 10
DIVR3 R0 R2
SETR5 0
SHRR3 R3 R5
MULR5 R3 R2
SUBR5 R0 R5
SETR2 4294967296
MULR5 R5 R2
ADDR5 R5 R1
SETR2 10
DIVR1 R5 R2
SETR0 0
SHRR1 R1 R0
MULR0 R1 R2
SUBR5 R5 R0
SETR0 100
ADDR0 R0 R4
STR5 R0
ADDR4 R4 R31
RCR0 R3
IGTR0 R30 mu64.loop
IGTR1 R30 mu64.loop
mu64.print:
SUBR4 R4 R31
SETR0 100
ADDR0 R0 R4
LDR0 R0
SETR2 48
ADDR0 R0 R2
PUTCR0
IGTR4 R30 mu64.print
RET

; mexpr: adierazpenaren errorea (6 kodea, 7.. parametroak), expr.rs-en testuekin. aldatzen ditu R0-R5
mexpr:
SETR0 6
ADDR0 R6 R0
LDR5 R0
IEQR28 R31 mexpr.eu
SETR1 1
IEQR5 R1 mexpr.1
SETR1 2
IEQR5 R1 mexpr.2
SETR1 3
IEQR5 R1 mexpr.3
SETR1 4
IEQR5 R1 mexpr.4
SETR1 5
IEQR5 R1 mexpr.5
SETR1 6
IEQR5 R1 mexpr.6
SETR1 7
IEQR5 R1 mexpr.7
SETR1 8
IEQR5 R1 mexpr.8
IEQR5 (10) mexpr.10
PRINT "'"
SETR0 7
C mtext
PRINT "' is not a number"
RET
mexpr.1:
PRINT "unexpected '"
SETR0 7
C mchar
PRINT "' in expression '"
SETR0 8
C mtext
PRINT "'"
RET
mexpr.2:
PRINT "expression '"
SETR0 8
C mtext
PRINT "' is not a finite number"
RET
mexpr.3:
PRINT "division by zero in expression"
RET
mexpr.4:
PRINT "expression ended early"
RET
mexpr.5:
PRINT "missing ')' in expression"
RET
mexpr.6:
C mfunc
PRINT " needs parentheses, e.g. "
C mfunc
PRINT "(2)"
RET
mexpr.7:
PRINT "unknown name '"
SETR0 7
C mtext
PRINT "' in expression"
RET
mexpr.8:
PRINT "unexpected '"
SETR0 7
C mchar
PRINT "' in expression"
RET
mexpr.10:
PRINT "the expression nests more than 100 levels deep"
RET
mexpr.eu:
SETR1 1
IEQR5 R1 mexpr.eu1
SETR1 2
IEQR5 R1 mexpr.eu2
SETR1 3
IEQR5 R1 mexpr.eu3
SETR1 4
IEQR5 R1 mexpr.eu4
SETR1 5
IEQR5 R1 mexpr.eu5
SETR1 6
IEQR5 R1 mexpr.eu6
SETR1 7
IEQR5 R1 mexpr.eu7
SETR1 8
IEQR5 R1 mexpr.eu8
IEQR5 (10) mexpr.eu10
PRINT "'"
SETR0 7
C mtext
PRINT "' ez da zenbaki bat"
RET
mexpr.eu1:
PRINT "ustekabeko '"
SETR0 7
C mchar
PRINT "' '"
SETR0 8
C mtext
PRINT "' adierazpenean"
RET
mexpr.eu2:
PRINT "'"
SETR0 8
C mtext
PRINT "' adierazpena ez da zenbaki finitu bat"
RET
mexpr.eu3:
PRINT "zeroz zatitzea adierazpenean"
RET
mexpr.eu4:
PRINT "adierazpena goizegi amaitu da"
RET
mexpr.eu5:
PRINT "')' falta da adierazpenean"
RET
mexpr.eu6:
C mfunc
PRINT "-k parentesiak behar ditu, adib. "
C mfunc
PRINT "(2)"
RET
mexpr.eu7:
PRINT "'"
SETR0 7
C mtext
PRINT "' izen ezezaguna adierazpenean"
RET
mexpr.eu8:
PRINT "ustekabeko '"
SETR0 7
C mchar
PRINT "' adierazpenean"
RET
mexpr.eu10:
PRINT "adierazpenak 100 maila baino gehiago ditu bata bestearen barruan"
RET

; mfunc: funtzioaren izena (7. gelaxka: 4 sqrt .. 9 ln). aldatzen ditu R0, R1
mfunc:
SETR0 7
ADDR0 R6 R0
LDR0 R0
SETR1 4
IEQR0 R1 mfunc.sqrt
SETR1 5
IEQR0 R1 mfunc.sin
SETR1 6
IEQR0 R1 mfunc.cos
SETR1 7
IEQR0 R1 mfunc.tan
SETR1 8
IEQR0 R1 mfunc.exp
PRINT "ln"
RET
mfunc.sqrt:
PRINT "sqrt"
RET
mfunc.sin:
PRINT "sin"
RET
mfunc.cos:
PRINT "cos"
RET
mfunc.tan:
PRINT "tan"
RET
mfunc.exp:
PRINT "exp"
RET
