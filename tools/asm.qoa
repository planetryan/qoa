; sha.block: 64 byteko blokea egoerara. aldatzen ditu R0-R3
sha.block:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
PUSHR13
PUSHR14
PUSHR15
PUSHR16
PUSHR17
PUSHR18
PUSHR19
PUSHR20
SETR0 96
LDR20 R0
; W[0..15]: blokeko byteak big-endian
ADDR16 R20 (16)
ADDR17 R20 (80)
SETR18 0
sha.block.w:
LDR0 R16
SHLR0 R0 (24)
ADDR1 R16 R31
LDR1 R1
SHLR1 R1 (16)
ORR0 R0 R1
ADDR1 R16 (2)
LDR1 R1
SHLR1 R1 (8)
ORR0 R0 R1
ADDR1 R16 (3)
LDR1 R1
ORR0 R0 R1
STR0 R17
ADDR16 R16 (4)
ADDR17 R17 R31
ADDR18 R18 R31
ILTR18 (16) sha.block.w
; W[16..63] = s1(W[t-2]) + W[t-7] + s0(W[t-15]) + W[t-16]
sha.block.x:
SUBR3 R17 (15)
LDR3 R3
SHRR2 R3 (7)
ANDR1 R3 (127)
SHLR1 R1 (25)
XORR2 R2 R1
SHRR1 R3 (18)
