outname.done:
RET

; ---------------------------------------------------------------- zigilua
; seal: src/seal.rs bezala. iturburuaren azken lerro ez-hutsa (hutsuneak: zuriunea, tabulazioa, \r, \n) SEAL
; bada, haren aurreko byte guztien SHA-256-a egiaztatu: zuzena bada, lerro hori eta ondorengoak ez dira
; mihiztatzen; bestela diagnostiko bat (75 forma okerra, 76 aldatua). aldatzen ditu R0-R7
seal:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
PUSHR13
PUSHR14
SETR0 80
LDR8 R0
SETR0 81
LDR9 R0
ADDR9 R8 R9
; R9 = azken byte ez-hutsaren ondorengoa
seal.trim:
IEQR9 R8 seal.done
SUBR0 R9 R31
LDR0 R0
IEQR0 (32) seal.trim1
IEQR0 (9) seal.trim1
IEQR0 (13) seal.trim1
IEQR0 (10) seal.trim1
J seal.end
seal.trim1:
SUBR9 R9 R31
J seal.trim
seal.end:
; R10 = lerroaren hasiera
RCR10 R9
seal.back:
IEQR10 R8 seal.lead0
SUBR0 R10 R31
LDR0 R0
IEQR0 (10) seal.lead0
SUBR10 R10 R31
J seal.back
seal.lead0:
; R11 = hasierako zuriune eta tabulazioen ondoren
RCR11 R10
seal.lead:
LDR0 R11
IEQR0 (32) seal.lead1
IEQR0 (9) seal.lead1
J seal.word
seal.lead1:
ADDR11 R11 R31
J seal.lead
seal.word:
SUBR0 R9 R11
ILTR0 (4) seal.done
ADDR0 R11 (0)
LDR0 R0
INER0 (83) seal.done
ADDR0 R11 (1)
LDR0 R0
INER0 (69) seal.done
ADDR0 R11 (2)
LDR0 R0
INER0 (65) seal.done
ADDR0 R11 (3)
LDR0 R0
INER0 (76) seal.done
ADDR12 R11 (4)
IEQR12 R9 seal.sp
LDR0 R12
IEQR0 (32) seal.sp
IEQR0 (9) seal.sp
J seal.done
seal.sp:
IEQR12 R9 seal.form
LDR0 R12
IEQR0 (32) seal.sp1
IEQR0 (9) seal.sp1
J seal.form
seal.sp1:
ADDR12 R12 R31
J seal.sp
; zigilu bat da: lerro-zenbakia (R13) eta forma
seal.form:
SETR13 1
RCR0 R8
seal.count:
IEQR0 R10 seal.check
LDR1 R0
INER1 (10) seal.count1
ADDR13 R13 R31
seal.count1:
ADDR0 R0 R31
J seal.count
seal.check:
SUBR0 R9 R12
INER0 (71) seal.bad
ADDR0 R12 (0)
LDR0 R0
INER0 (115) seal.bad
ADDR0 R12 (1)
LDR0 R0
INER0 (104) seal.bad
ADDR0 R12 (2)
LDR0 R0
INER0 (97) seal.bad
ADDR0 R12 (3)
LDR0 R0
INER0 (50) seal.bad
ADDR0 R12 (4)
LDR0 R0
INER0 (53) seal.bad
ADDR0 R12 (5)
LDR0 R0
INER0 (54) seal.bad
ADDR0 R12 (6)
LDR0 R0
INER0 (58) seal.bad
ADDR12 R12 (7)
RCR0 R12
seal.hexok:
IEQR0 R9 seal.hash
LDR1 R0
ILTR1 (48) seal.bad
ILTR1 (58) seal.hexok1
ILTR1 (97) seal.bad
IGTR1 (102) seal.bad
seal.hexok1:
ADDR0 R0 R31
J seal.hexok
; aurreko byteen laburpena
seal.hash:
C sha.init
RCR14 R8
seal.feed:
IEQR14 R10 seal.fed
LDR0 R14
C sha.byte
ADDR14 R14 R31
J seal.feed
seal.fed:
C sha.final
SETR0 96
LDR1 R0
ADDR0 R1 (208)
STR12 R0
; hitz bakoitza zigiluko 8 digituekin alderatu
ADDR3 R1 (8)
seal.cmpw:
SETR2 0
SETR4 8
seal.cmpd:
LDR0 R12
SUBR0 R0 (48)
ILTR0 (10) seal.cmpd1
SUBR0 R0 (39)
seal.cmpd1:
MULR2 R2 (16)
ADDR2 R2 R0
ADDR12 R12 R31
SUBR4 R4 R31
IGTR4 R30 seal.cmpd
LDR0 R1
INER0 R2 seal.changed
ADDR1 R1 R31
ILTR1 R3 seal.cmpw
; zuzena: zigiluaren lerrotik aurrera ez da mihiztatzen
SUBR0 R13 R31
SETR1 6
STR0 R1
J seal.done
seal.bad:
SETR3 75
J seal.diag
seal.changed:
SETR3 76
; diagnostikoa: lerroa, zutabea (hutsuneen ondoren), luzera karaktereetan
seal.diag:
SETR2 0
RCR0 R11
seal.len:
IEQR0 R9 seal.len2
LDR1 R0
ILTR1 (128) seal.len1
IGTR1 (191) seal.len1
J seal.len3
seal.len1:
ADDR2 R2 R31
seal.len3:
ADDR0 R0 R31
J seal.len
seal.len2:
SUBR1 R11 R10
ADDR1 R1 R31
RCR0 R13
C diagat
seal.done:
POPR14
POPR13
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; isseal: R0 = kode-puntuen helbidea, R1 = kopurua -> R0 = 1 SEAL bada (maiuskula/minuskula berdin).
