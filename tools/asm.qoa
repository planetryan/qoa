PUSHR8
PUSHR9
PUSHR10
PUSHR11
PUSHR12
PUSHR13
; BEST: 31 txikienak, ordenatuta
SETR0 31
C alloc
RCR11 R0
SETR12 0
SETR0 15
LDR0 R0
C vfirst
RCR8 R0
RCR9 R1
RCR10 R2
report.scan:
IEQR10 R30 report.print
LDR13 R8
; txertatze-posizioa: atzetik aurrera
RCR7 R12
report.place:
IEQR7 R30 report.put
ADDR0 R11 R7
SUBR0 R0 R31
LDR1 R0
RCR0 R13
PUSHR7
C dless
POPR7
IEQR0 R30 report.put
; mugitu bat atzera (31. postutik kanpora erortzen bada, galdu)
SETR0 31
IEQR7 R0 report.shift
ADDR0 R11 R7
SUBR1 R0 R31
LDR1 R1
STR1 R0
report.shift:
SUBR7 R7 R31
J report.place
report.put:
SETR0 31
IEQR7 R0 report.skip
ADDR0 R11 R7
STR13 R0
SETR0 31
IEQR12 R0 report.skip
ADDR12 R12 R31
report.skip:
SUBR10 R10 R31
RCR0 R8
RCR1 R9
C vnext
RCR8 R0
RCR9 R1
J report.scan
report.print:
STREAM 2
SETR8 0
SETR0 30
ILTR12 R0 report.count
RCR12 R0
SETR0 31
SETR1 16
LDR1 R1
IGTR1 R12 report.count
SETR12 30
report.count:
; R12 = erakusten direnak (gehienez 30); R13 = 1 laburpen-lerroa behar bada
SETR13 0
SETR0 16
LDR0 R0
SETR1 30
IGTR0 R1 report.more
J report.each
report.more:
SETR13 1
report.each:
IEQR8 R12 report.summary
ADDR0 R11 R8
LDR0 R0
C render
ADDR8 R8 R31
J report.each
report.summary:
IEQR13 R30 report.total
; `... and N more error(s) not shown`, 31.aren lerroan
SETR0 30
ADDR0 R11 R0
LDR0 R0
LDR0 R0
SETR1 1
SETR2 0
SETR3 7
C diagat
SETR1 16
LDR2 R1
SETR1 1
SUBR2 R2 R1
SETR1 30
SUBR2 R2 R1
SETR1 4
C dset
C render
report.total:
ADDR0 R12 R13
IEQR28 R31 report.eu
PF "{} error(s) in " R0
C printname
PLN ""
J report.done
report.eu:
PF "{} errore " R0
C printname
PLN " fitxategian"
report.done:
POPR13
POPR12
POPR11
POPR10
POPR9
POPR8
RET

; render: R0 = diagnostikoa -> asm::render-en formatua
;   error: mezua
;     --> izena:lerroa:zutabea
;      |
;    3 | CNOT q0 q0
;      |         ^^
;     = help: laguntza
render:
PUSHR8
PUSHR9
PUSHR10
PUSHR11
RCR8 R0
IEQR28 R31 render.eu
PRINT "error: "
J render.msg
render.eu:
PRINT "errorea: "
render.msg:
RCR0 R8
C message
PLN ""
PRINT "  --> "
C printname
LDR9 R8
ADDR10 R8 R31
LDR10 R10
PF ":{}:{}\n" R9 R10
; iturburuko lerroa, badago
ILTR9 R31 render.help
SETR0 6
LDR0 R0
IGTR9 R0 render.help
; R11 = lerro-zenbakiaren digituak
SETR11 0
RCR0 R9
SETR1 10
render.digits:
ADDR11 R11 R31
DIVR0 R0 R1
SETR2 0
SHRR0 R0 R2
IGTR0 R30 render.digits
PRINT " "
RCR0 R11
C spaces
PLN " |"
PF " {} | " R9
SETR0 5
LDR0 R0
SUBR1 R9 R31
ADDR1 R1 R1
ADDR0 R0 R1
LDR2 R0
ADDR0 R0 R31
LDR1 R0
SUBR1 R1 R2
RCR0 R2
PUSHR2
PUSHR1
C printtext
PLN ""
PRINT " "
RCR0 R11
C spaces
PRINT " | "
POPR1
POPR2
; zutabe-1 karaktere: tabulazioak bere horretan, besteak hutsune
SUBR10 R10 R31
ILTR10 R1 render.pad
RCR10 R1
render.pad:
IEQR10 R30 render.carets
LDR0 R2
SETR3 9
IEQR0 R3 render.tab
PRINT " "
J render.padstep
render.tab:
PUTCR3
render.padstep:
ADDR2 R2 R31
SUBR10 R10 R31
J render.pad
render.carets:
SETR0 2
ADDR0 R8 R0
LDR10 R0
render.caret:
IEQR10 R30 render.caretdone
PRINT "^"
SUBR10 R10 R31
J render.caret
render.caretdone:
PLN ""
render.help:
SETR0 14
ADDR0 R8 R0
LDR0 R0
IEQR0 R30 render.end
IEQR28 R31 render.heu
PRINT "  = help: "
J render.hmsg
render.heu:
PRINT "  = laguntza: "
render.hmsg:
RCR0 R8
C helptext
PLN ""
render.end:
PLN ""
POPR11
POPR10
POPR9
POPR8
RET

; spaces: R0 = kopurua -> hainbat hutsune. aldatzen ditu R0
spaces:
IEQR0 R30 spaces.done
PRINT " "
SUBR0 R0 R31
J spaces
spaces.done:
RET

