SETR2 89
STR30 R2
SETR2 53
STR0 R2
ADDR3 R0 R1
SETR2 54
STR3 R2
SETR2 55
STR30 R2
SETR2 56
STR0 R2
SETR2 57
STR1 R2
C ex.expr
SETR1 55
LDR1 R1
INER1 R30 evalexpr.fail
PUSHR0
C ex.peek
RCR2 R0
POPR0
IEQR2 R29 evalexpr.end
; ustekabeko karakterea amaieran
SETR1 58
STR2 R1
SETR1 55
SETR2 1
STR2 R1
J evalexpr.fail
evalexpr.end:
; finitua: x - x = 0
SUBR1 R0 R0
IEQR1 R30 evalexpr.ok
SETR1 55
SETR2 2
STR2 R1
J evalexpr.fail
evalexpr.ok:
RCR1 R0
SETR0 1
RET
evalexpr.fail:
SETR0 0
RET

; ex.err: R0 = errore-kodea. aldatzen ditu R1
ex.err:
SETR1 55
STR0 R1
RET

; ex.peek: hutsuneak saltatu -> R0 = hurrengo karakterea, edo -1 amaieran. aldatzen ditu R0-R3
