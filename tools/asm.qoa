LOAD R3 R3
REGCOPY R0 R13
REGSET R1 9
CALL dtext
REGSET R0 3
ADD R0 R17 R0
LOAD R2 R0
REGCOPY R0 R13
REGSET R1 11
CALL dset
REGSET R0 3
ADD R0 R17 R0
LOAD R2 R0
ADD R0 R0 R31
LOAD R0 R0
ADD R2 R2 R0
SUB R2 R2 R31
REGCOPY R0 R13
REGSET R1 12
CALL dset
JUMP register.done
register.ok:
; hurrengo librea = max(hurrengoa, lehena + tamaina); handiena = max(handiena, azkena)
LOAD R17 R13
ADD R0 R15 R16
IFLT R0 R17 register.keep
STORE R0 R13
register.keep:
ADD R0 R15 R16
SUB R0 R0 R31
LOAD R1 R14
IFLT R0 R1 register.keepmax
STORE R0 R14
register.keepmax:
REGSET R0 8
CALL alloc
REGCOPY R13 R0
LOAD R1 R9
STORE R1 R13
ADD R2 R13 R31
ADD R1 R9 R31
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
STORE R12 R2
ADD R2 R2 R31
STORE R15 R2
ADD R2 R2 R31
STORE R16 R2
ADD R2 R2 R31
REGSET R1 39
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
REGSET R1 2
ADD R1 R9 R1
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
ADD R1 R9 R31
LOAD R1 R1
IFGT R1 R30 register.len
REGSET R1 1
register.len:
STORE R1 R2
REGSET R0 21
LOAD R0 R0
LOAD R1 R9
ADD R2 R9 R31
LOAD R2 R2
REGSET R3 19
LOAD R3 R3
CALL htfind
STORE R13 R0
REGSET R0 22
LOAD R0 R0
REGCOPY R1 R13
CALL vpush
register.done:
POP R17
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; regname: R0, R1 = izena -> R0 = 1 erregistro-izen gisa onargarria bada: letrak, digituak eta _, letra edo _
; lehenik; ez q3 bezalako eragigaia, ez pi bezalako konstantea, ez agindu bat. aldatzen ditu R0-R7
regname:
PUSH R8
PUSH R9
PUSH R10
REGCOPY R8 R0
REGCOPY R9 R1
IFEQ R9 R30 regname.no
REGSET R10 0
regname.chars:
IFEQ R10 R9 regname.operand
ADD R0 R8 R10
LOAD R0 R0
REGSET R1 95
IFEQ R0 R1 regname.cok
IFEQ R10 R30 regname.c0
CALL isalnum
IFEQ R0 R30 regname.no
JUMP regname.cok
regname.c0:
CALL isalpha
IFEQ R0 R30 regname.no
regname.cok:
ADD R10 R10 R31
JUMP regname.chars
regname.operand:
; q3, O12, c0, R5: aurrizki bat eta digituak bakarrik
IFEQ R9 R31 regname.reserved
LOAD R0 R8
CALL lower
REGSET R1 113
IFEQ R0 R1 regname.digits
REGSET R1 111
IFEQ R0 R1 regname.digits
REGSET R1 99
IFEQ R0 R1 regname.digits
REGSET R1 114
IFEQ R0 R1 regname.digits
JUMP regname.reserved
regname.digits:
REGSET R10 1
regname.d:
IFEQ R10 R9 regname.no
ADD R0 R8 R10
LOAD R0 R0
CALL isdigit
IFEQ R0 R30 regname.reserved
ADD R10 R10 R31
JUMP regname.d
regname.reserved:
REGCOPY R0 R8
REGCOPY R1 R9
CALL fname
IFNE R0 R30 regname.no
REGCOPY R0 R8
REGCOPY R1 R9
CALL lookup
IFNE R0 R30 regname.no
REGSET R0 1
JUMP regname.done
regname.no:
REGSET R0 0
regname.done:
POP R10
POP R9
POP R8
RETSUB

; fname: R0, R1 = izena -> R0 = haren zenbakia fnames-en (1 pi .. 9 ln), minuskulaz konparatuta; π = 1; bestela 0.
; aldatzen ditu R0-R7
fname:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
IFNE R9 R31 fname.ascii
LOAD R0 R8
REGSET R1 960
IFNE R0 R1 fname.ascii
REGSET R0 1
JUMP fname.done
fname.ascii:
REGCOPY R0 R8
REGCOPY R1 R9
REGSET R2 43
LOAD R2 R2
CALL copylow
REGSET R0 48
LOAD R10 R0
REGSET R11 1
fname.next:
REGSET R0 10
IFEQ R11 R0 fname.none
; R10 = izena (0-z amaitua): luzera
REGCOPY R1 R10
fname.len:
LOAD R0 R1
IFEQ R0 R30 fname.cmp
ADD R1 R1 R31
JUMP fname.len
fname.cmp:
SUB R3 R1 R10
PUSH R1
REGSET R0 43
LOAD R0 R0
REGCOPY R1 R9
REGCOPY R2 R10
CALL streq
POP R1
IFEQ R0 R31 fname.found
ADD R10 R1 R31
ADD R11 R11 R31
JUMP fname.next
fname.found:
REGCOPY R0 R11
JUMP fname.done
fname.none:
REGSET R0 0
fname.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; constant: R0 = CONST tokena, R1 = eragigaiak, R2 = kopurua -> CONST izena balioa, ordenan (balioak bere
; gainetik definitutako konstanteak erabil ditzake)
constant:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGSET R0 2
IFEQ R10 R0 constant.name
REGCOPY R0 R8
REGSET R1 70
CALL diagtok
JUMP constant.done
constant.name:
LOAD R0 R9
ADD R1 R9 R31
LOAD R1 R1
CALL regname
IFEQ R0 R31 constant.unique
REGCOPY R0 R9
REGSET R1 71
CALL diagtext
JUMP constant.done
constant.unique:
CALL constant.find
IFEQ R1 R30 constant.value
REGCOPY R0 R9
REGSET R1 72
CALL diagtext
JUMP constant.done
constant.value:
REGSET R0 3
ADD R11 R9 R0
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
CALL evalexpr
IFEQ R0 R31 constant.put
; "expected a number for value: ..."
REGCOPY R0 R11
REGSET R1 34
CALL diagtok
REGCOPY R11 R0
REGSET R1 87
LOAD R2 R1
REGSET R1 4
CALL dset
REGSET R1 5
REGSET R2 5
CALL dset
REGCOPY R0 R11
CALL experr
JUMP constant.done
constant.put:
; [gakoa, luzera, balioa] taulan, eta [izena, luzera, lerroa, zutabea, luzera] ordenan
REGCOPY R11 R1
CALL constant.find
REGCOPY R10 R0
REGSET R0 3
CALL alloc
LOAD R1 R9
STORE R1 R0
ADD R2 R0 R31
ADD R1 R9 R31
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
STORE R11 R2
STORE R0 R10
REGSET R0 5
CALL alloc
REGCOPY R10 R0
LOAD R1 R9
STORE R1 R10
ADD R2 R10 R31
ADD R1 R9 R31
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
REGSET R1 39
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
REGSET R1 2
ADD R1 R9 R1
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
ADD R1 R9 R31
LOAD R1 R1
IFGT R1 R30 constant.len
REGSET R1 1
constant.len:
STORE R1 R2
REGSET R0 86
LOAD R0 R0
REGCOPY R1 R10
CALL vpush
constant.done:
POP R11
POP R10
POP R9
POP R8
RETSUB
; constant.find: R9 = izenaren tokena -> R0 = zirrikitua, R1 = erregistroa (edo 0)
constant.find:
REGSET R0 84
LOAD R0 R0
LOAD R1 R9
ADD R2 R9 R31
LOAD R2 R2
REGSET R3 19
LOAD R3 R3
JUMP htfind

; clash: konstante bat ezin da erregistro-izen bat ere izan (izena erregistro gisa ordezkatuko litzateke)
clash:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGSET R0 86
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
clash.next:
IFEQ R10 R30 clash.done
LOAD R11 R8
REGSET R0 21
LOAD R0 R0
LOAD R1 R11
ADD R2 R11 R31
LOAD R2 R2
REGSET R3 19
LOAD R3 R3
CALL htfind
IFEQ R1 R30 clash.step
REGSET R0 2
ADD R0 R11 R0
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 73
CALL diagat
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
REGSET R1 4
CALL dtext
clash.step:
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP clash.next
clash.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; fit: izendun erregistroak QINIT eta QMODE-k adierazitakoaren barruan
fit:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGSET R0 22
LOAD R0 R0
CALL vfirst
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
fit.next:
IFEQ R10 R30 fit.done
LOAD R11 R8
REGSET R0 2
ADD R0 R11 R0
LOAD R0 R0
REGSET R1 113
IFEQ R0 R1 fit.q
REGSET R1 111
IFEQ R0 R1 fit.o
REGSET R1 114
IFEQ R0 R1 fit.r
JUMP fit.step
fit.r:
; RREG: R0..R31-en barruan
REGSET R3 3
ADD R3 R11 R3
LOAD R4 R3
ADD R3 R3 R31
LOAD R5 R3
ADD R6 R4 R5
REGSET R1 32
IFGT R6 R1 fit.rbad
JUMP fit.step
fit.rbad:
PUSH R4
PUSH R6
REGSET R0 5
ADD R0 R11 R0
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 74
CALL diagat
REGCOPY R7 R0
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
REGSET R1 4
PUSH R7
CALL dtext
POP R0
POP R6
SUB R2 R6 R31
REGSET R1 7
CALL dset
POP R2
REGSET R1 6
CALL dset
JUMP fit.step
fit.q:
REGSET R1 25
LOAD R1 R1
REGSET R2 0
JUMP fit.check
fit.o:
REGSET R1 26
LOAD R1 R1
REGSET R2 1
fit.check:
IFEQ R1 R29 fit.step
REGSET R3 3
ADD R3 R11 R3
LOAD R4 R3
ADD R3 R3 R31
LOAD R5 R3
ADD R6 R4 R5
IFGT R6 R1 fit.bad
JUMP fit.step
fit.bad:
PUSH R1
PUSH R2
PUSH R4
PUSH R6
REGSET R0 5
ADD R0 R11 R0
LOAD R3 R0
ADD R0 R0 R31
LOAD R1 R0
ADD R0 R0 R31
LOAD R2 R0
REGCOPY R0 R3
REGSET R3 21
CALL diagat
REGCOPY R7 R0
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
REGSET R1 4
PUSH R7
CALL dtext
POP R0
REGSET R1 2
ADD R1 R11 R1
LOAD R2 R1
REGSET R1 6
CALL dset
POP R6
SUB R2 R6 R31
REGSET R1 8
CALL dset
POP R4
REGCOPY R2 R4
REGSET R1 7
CALL dset
POP R2
REGSET R1 9
CALL dset
POP R2
REGSET R1 10
CALL dset
fit.step:
SUB R10 R10 R31
REGCOPY R0 R8
REGCOPY R1 R9
CALL vnext
REGCOPY R8 R0
REGCOPY R9 R1
JUMP fit.next
fit.done:
POP R11
POP R10
POP R9
POP R8
RETSUB

; ---------------------------------------------------------------- bigarren pasaldia
; aldagai globalak: 82 CURSPEC uneko zehaztapena, 83 CURHEAD haren tokena; 90-92 eta 93-95 behin-behineko
; tokenak (tarteen bi aldeak)
pass2:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
REGSET R8 0
pass2.line:
REGSET R0 6
LOAD R0 R0
IFEQ R8 R0 pass2.done
ADD R1 R8 R31
REGSET R0 39
STORE R1 R0
REGSET R0 5
LOAD R0 R0
ADD R1 R8 R8
ADD R1 R0 R1
LOAD R0 R1
ADD R1 R1 R31
LOAD R1 R1
REGCOPY R9 R0
CALL stripcomment
REGCOPY R1 R0
REGCOPY R0 R9
CALL tokenize
IFEQ R0 R30 pass2.toks
; testu bati amaierako komatxoa falta zaio
REGSET R0 39
LOAD R0 R0
REGSET R2 1
REGSET R3 1
CALL diagat
JUMP pass2.next
pass2.toks:
REGSET R0 41
LOAD R10 R0
IFEQ R10 R30 pass2.next
REGSET R0 40
LOAD R11 R0
REGSET R12 0
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
CALL endscolon
IFEQ R0 R30 pass2.body
; etiketa: "izena:" lerroaren hasieran (agindu bat jarrai dezake)
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
SUB R1 R1 R31
CALL islabel
IFEQ R0 R31 pass2.label
REGCOPY R0 R11
REGSET R1 3
CALL diagtok
REGCOPY R13 R0
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
SUB R3 R3 R31
REGSET R1 4
CALL dtext
REGCOPY R0 R13
REGSET R1 14
REGSET R2 3
CALL dset
JUMP pass2.next
pass2.label:
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
SUB R1 R1 R31
CALL lblfind
IFEQ R1 R30 pass2.newlabel
REGCOPY R12 R1
REGCOPY R0 R11
REGSET R1 2
CALL diagtok
REGCOPY R13 R0
LOAD R2 R11
ADD R3 R11 R31
LOAD R3 R3
SUB R3 R3 R31
REGSET R1 4
CALL dtext
REGCOPY R0 R13
REGSET R1 14
REGSET R2 2
CALL dset
REGSET R1 3
ADD R1 R12 R1
LOAD R2 R1
REGSET R1 15
CALL dset
REGSET R12 1
JUMP pass2.body
pass2.newlabel:
; [gakoa minuskulaz, luzera, eragiketa, lerroa, zutabea, luzera]
REGCOPY R12 R0
ADD R1 R11 R31
LOAD R0 R1
CALL alloc
REGCOPY R13 R0
LOAD R0 R11
ADD R1 R11 R31
LOAD R1 R1
SUB R1 R1 R31
REGCOPY R2 R13
CALL copylow
REGSET R0 6
CALL alloc
STORE R13 R0
ADD R2 R0 R31
ADD R1 R11 R31
LOAD R1 R1
SUB R1 R1 R31
STORE R1 R2
ADD R2 R2 R31
REGSET R1 14
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
REGSET R1 39
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
REGSET R1 2
ADD R1 R11 R1
LOAD R1 R1
STORE R1 R2
ADD R2 R2 R31
ADD R1 R11 R31
LOAD R1 R1
STORE R1 R2
STORE R0 R12
REGSET R12 1
pass2.body:
IFEQ R12 R10 pass2.next
REGSET R0 3
MUL R0 R12 R0
ADD R0 R11 R0
SUB R1 R10 R12
CALL rename
IFEQ R0 R30 pass2.next
REGCOPY R0 R1
REGCOPY R1 R2
CALL line
pass2.next:
ADD R8 R8 R31
JUMP pass2.line
pass2.done:
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; textfind: R0, R1 = testua, R2 = karakterea -> R0 = lehen agerpenaren indizea, edo -1. aldatzen ditu R0-R4
textfind:
REGSET R3 0
textfind.next:
IFEQ R3 R1 textfind.none
ADD R4 R0 R3
LOAD R4 R4
IFEQ R4 R2 textfind.found
ADD R3 R3 R31
JUMP textfind.next
textfind.found:
REGCOPY R0 R3
RETSUB
textfind.none:
REGSET R0 -1
RETSUB

; putnum: R0 = zenbaki osoa (>= 0), R1 = helburua -> digitu hamartarrak idatzita, R0 = kopurua.
; aldatzen ditu R0-R6
putnum:
REGCOPY R4 R0
REGCOPY R5 R1
REGSET R6 0
REGSET R2 10
putnum.count:
DIV R4 R4 R2
REGSET R3 0
SHR R4 R4 R3
ADD R6 R6 R31
IFGT R4 R30 putnum.count
; idatzi atzetik aurrera
REGCOPY R4 R0
ADD R5 R5 R6
putnum.write:
SUB R5 R5 R31
DIV R3 R4 R2
REGSET R1 0
SHR R3 R3 R1
MUL R1 R3 R2
SUB R1 R4 R1
REGSET R0 48
ADD R1 R1 R0
STORE R1 R5
REGCOPY R4 R3
IFGT R4 R30 putnum.write
REGCOPY R0 R6
RETSUB

; synth: R0 = aurrizkia (karakterea), R1 = zenbakia, R2 = zutabea -> R0 = token berria "q12", testu
; iraunkorrarekin. aldatzen ditu R0-R7
synth:
PUSH R8
REGCOPY R8 R2
REGCOPY R2 R1
REGCOPY R1 R2
CALL rangetext
REGCOPY R4 R0
REGCOPY R5 R1
REGSET R0 3
CALL alloc
STORE R4 R0
ADD R1 R0 R31
STORE R5 R1
ADD R1 R1 R31
STORE R8 R1
POP R8
RETSUB

; rangetext: R0 = mota (karakterea), R1 = a, R2 = b -> R0, R1 = "q3" (a = b) edo "q3..q5" testu iraunkorra.
; aldatzen ditu R0-R7
rangetext:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
REGCOPY R10 R2
REGSET R0 32
CALL alloc
REGCOPY R11 R0
STORE R8 R11
REGCOPY R0 R9
ADD R1 R11 R31
CALL putnum
ADD R7 R0 R31
IFEQ R9 R10 rangetext.done
ADD R1 R11 R7
REGSET R0 46
STORE R0 R1
ADD R1 R1 R31
STORE R0 R1
ADD R1 R1 R31
STORE R8 R1
ADD R1 R1 R31
REGSET R0 3
ADD R7 R7 R0
PUSH R7
REGCOPY R0 R10
CALL putnum
POP R7
ADD R7 R7 R0
rangetext.done:
REGCOPY R0 R11
REGCOPY R1 R7
POP R11
POP R10
POP R9
POP R8
RETSUB

; innerrange: R0, R1 = parentesi barrukoa ("1" edo "0..2") -> R0 = 1 irakurri bada, R1 = a, R2 = b
; (parse_int-en u64 balioak u32-ra mozten dira, asm.rs-en `as u32` bezala). aldatzen ditu R0-R7
innerrange:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
REGCOPY R8 R0
REGCOPY R9 R1
CALL findrange
IFLT R0 R30 innerrange.one
REGCOPY R10 R0
REGCOPY R0 R8
REGCOPY R1 R10
CALL parseint
IFEQ R0 R30 innerrange.bad
REGCOPY R11 R2
ADD R0 R8 R10
REGSET R1 2
ADD R0 R0 R1
SUB R1 R9 R10
REGSET R3 2
SUB R1 R1 R3
CALL parseint
IFEQ R0 R30 innerrange.bad
REGCOPY R1 R11
JUMP innerrange.ret
innerrange.one:
REGCOPY R0 R8
REGCOPY R1 R9
CALL parseint
IFEQ R0 R30 innerrange.bad
REGCOPY R1 R2
JUMP innerrange.ret
innerrange.bad:
REGSET R0 0
innerrange.ret:
POP R11
POP R10
POP R9
POP R8
RETSUB

; rename: R0 = tokenak, R1 = kopurua -> izendun erregistroak indize arrunt: data[1] -> q4, data -> q3..q5
; (mnemonikoa eta testuak ez). R0 = 1 eta R1, R2 = tokenak; R0 = 0 errore bat izan bada
rename:
PUSH R8
PUSH R9
PUSH R10
PUSH R11
PUSH R12
PUSH R13
PUSH R14
PUSH R15
PUSH R16
PUSH R17
PUSH R18
PUSH R19
REGCOPY R8 R0
REGCOPY R9 R1
REGSET R0 22
LOAD R0 R0
LOAD R0 R0
IFGT R0 R30 rename.work
REGSET R0 1
REGCOPY R1 R8
REGCOPY R2 R9
JUMP rename.ret
rename.work:
REGSET R0 3
MUL R0 R9 R0
CALL alloc
REGCOPY R10 R0
REGSET R11 1
REGSET R12 0
rename.tok:
IFEQ R12 R9 rename.end
REGSET R0 3
MUL R0 R12 R0
ADD R13 R8 R0
ADD R14 R10 R0
; kopia lehenik (aldatzen ez bada, horrela geratzen da)
LOAD R0 R13
STORE R0 R14
ADD R1 R13 R31
LOAD R1 R1
ADD R2 R14 R31
STORE R1 R2
REGSET R2 2
ADD R2 R13 R2
LOAD R2 R2
REGSET R3 2
ADD R3 R14 R3
STORE R2 R3
IFEQ R12 R30 rename.next
; R15, R16 = oinarria; R17, R18 = barrukoa (R17 = -1 parentesirik ez badago)
LOAD R15 R13
ADD R16 R13 R31
LOAD R16 R16
REGSET R17 -1
LOAD R0 R15
REGSET R1 34
IFEQ R0 R1 rename.next
REGCOPY R0 R15
REGCOPY R1 R16
REGSET R2 91
CALL textfind
IFLT R0 R30 rename.base
ADD R1 R15 R16
SUB R1 R1 R31
LOAD R1 R1
REGSET R2 93
IFNE R1 R2 rename.base
ADD R17 R15 R0
ADD R17 R17 R31
SUB R18 R16 R0
REGSET R1 2
SUB R18 R18 R1
REGCOPY R16 R0
rename.base:
IFNE R17 R29 rename.named
; parentesirik gabe: etiketa-izen bat bada, ez da erregistroa
REGCOPY R0 R15
REGCOPY R1 R16
CALL lnhas
IFEQ R0 R31 rename.next
rename.named:
REGSET R0 21
LOAD R0 R0
REGCOPY R1 R15
REGCOPY R2 R16
REGSET R3 19
LOAD R3 R3
CALL htfind
IFEQ R1 R30 rename.next
REGCOPY R19 R1
; tartea: R0 = irakurrita, R1 = a, R2 = b
IFNE R17 R29 rename.inner
REGSET R0 4
ADD R0 R19 R0
LOAD R2 R0
SUB R2 R2 R31
REGSET R1 0
REGSET R0 1
JUMP rename.range
rename.inner:
REGCOPY R0 R17
REGCOPY R1 R18
CALL innerrange
rename.range:
IFEQ R0 R30 rename.expected
REGSET R3 4
ADD R3 R19 R3
LOAD R3 R3
IFLT R2 R3 rename.inside
; amaieratik kanpo: R2 = b, R3 = tamaina
PUSH R2
PUSH R3
REGCOPY R0 R13
REGSET R1 22
CALL diagtok
REGCOPY R7 R0
REGCOPY R2 R15
REGCOPY R3 R16
REGSET R1 4
PUSH R7
CALL dtext
POP R0
POP R2
REGSET R1 6
CALL dset
POP R2
REGSET R1 7
CALL dset
REGSET R11 0
JUMP rename.next
rename.inside:
IFGT R1 R2 rename.expected
; testu berria: mota + (lehena + a) [.. mota + (lehena + b)]
REGSET R3 3
ADD R3 R19 R3
LOAD R3 R3
ADD R1 R1 R3
ADD R2 R2 R3
REGSET R0 2
ADD R0 R19 R0
LOAD R0 R0
CALL rangetext
STORE R0 R14
ADD R2 R14 R31
STORE R1 R2
JUMP rename.next
rename.expected:
REGCOPY R0 R13
REGSET R1 23
CALL diagtok
REGCOPY R2 R15
REGCOPY R3 R16
REGSET R1 4
CALL dtext
REGSET R11 0
rename.next:
ADD R12 R12 R31
JUMP rename.tok
rename.end:
REGCOPY R0 R11
REGCOPY R1 R10
REGCOPY R2 R9
rename.ret:
POP R19
POP R18
POP R17
POP R16
POP R15
POP R14
POP R13
POP R12
POP R11
POP R10
POP R9
POP R8
RETSUB

; copyraw: R0 = iturria, R1 = luzera, R2 = helburua -> kopia; R2 helburuaren amaieran. aldatzen ditu R0-R3
copyraw:
