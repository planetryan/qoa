; grover-en bilaketa 3 qubitetan, |101> bilatuz (8 aukeratik 1)
; 2 iterazio: arrakasta-probabilitatea ~94.5%
; expect-share: 101 0.945 0.02
QI 3
Hq0..q2
LS 2
  ; orakulua: fasea -1 |101>-n (q1 0 da, beraz X-z inguratu)
  Xq1
  MCZq0 q1 q2
  Xq1
  ; difusioa: 2|s><s| - 1
  Hq0..q2
  Xq0..q2
  MCZq0 q1 q2
  Xq0..q2
  Hq0..q2
LE
Mq0..q2
