; angelu-ekorketa: RY(theta)-ren <Z> zehatza theta-ren funtzio gisa; cos(theta) izan behar du.
; EXPECT simulagailuan bakarrik dabil; hemen begizta klasiko batekin konbinatuta.
; RY(a) eta gero RY(b) = RY(a+b), beraz biraketa pausoka metatzen da.
; expect-output: theta = 0  <Z> = 1
; expect-output: theta = 1.5707963267948966  <Z> = 0\n
; expect-output: <Z> = 0.7071067811865476
QI 1
SETR0 0                         ; theta
SETR1 pi/8                      ; pausoa
LS 9
  EVq0 Z R3                     ; R3 = <Z>, egoera aldatu gabe
  PF "theta = {}  <Z> = {}\n" R0 R3
  RYq0 pi/8
  ADDR0 R0 R1
LE
