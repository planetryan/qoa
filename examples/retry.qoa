; errepikatu arrakasta lortu arte: qubit bat RY(pi/3)-rekin prestatu (P(1) = 25%)
; eta neurtu 1 atera arte. R1-ek saiakerak zenbatzen ditu. kontrol klasikoa eta erdiko neurketak.
; expect-only: 1
QI 1
SETR1 0
SETR2 1
saiatu:
ADDR1 R1 R2             ; saiakera bat gehiago
RSTq0
RYq0 pi/3
Mq0.R0
JZR0 saiatu             ; 0 bada, berriz saiatu
PF "1 lortu da {} saiakeraren ondoren\n" R1
Mq0                     ; c0-ra ere, kopuruetan agertzeko (beti 1)
