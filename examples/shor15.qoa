; shor-en algoritmoa 15 faktorizatzeko, a = 7 oinarriarekin. algoritmo osoa da, ez eskema bat:
;   1. zatitze kuantikoa: 4 qubit kontatzeko (q0..q3) eta 4 qubit lanerako (q4..q7, hasieran |1>)
;   2. berreketa modularra: U|y> = |7y mod 15>, U^(2^j) kontrolatua q_j-rekin (begiztekin)
;   3. qft alderantzizkoa kontatzeko erregistroan, eta neurketa: m = s·16/r
;   4. zati klasikoa erregistroetan: r periodoa aurkitu, 7^r mod 15 = 1 egiaztatu, eta
;      faktoreak = zkh(7^(r/2) - 1, 15) eta zkh(7^(r/2) + 1, 15). huts eginez gero, berriz saiatu.
; U-ren deskonposizioa (qiskit-en testuliburukoa, a = 7): swap(0,1) swap(1,2) swap(2,3), gero X guztiei.
; m = 4 edo 12 denean arrakasta (r = 4); m = 0 edo 8 denean berriz saiatzen da.
;
; shots: 300
; expect-output: 15 = 3 x 5
; expect-only: ----0100 ----1100
; expect-share: ----0100 0.5 0.1

QI 8
SETR10 1
SETR11 2
SETR12 15
SETR13 16
SETR14 7
SETR15 0
SETR7 0                         ; saiakerak

saiakera:
RA
ADDR7 R7 R10
Hq0..q3
Xq4                             ; lan-erregistroa = 1

; U^1, q0-k kontrolatuta
CSq0 q4 q5
CSq0 q5 q6
CSq0 q6 q7
CXq0 q4
CXq0 q5
CXq0 q6
CXq0 q7
; U^2, q1-ek kontrolatuta
LS 2
  CSq1 q4 q5
  CSq1 q5 q6
  CSq1 q6 q7
  CXq1 q4
  CXq1 q5
  CXq1 q6
  CXq1 q7
LE
; U^4, q2-k kontrolatuta
LS 4
  CSq2 q4 q5
  CSq2 q5 q6
  CSq2 q6 q7
  CXq2 q4
  CXq2 q5
  CXq2 q6
  CXq2 q7
LE
; U^8, q3-k kontrolatuta
LS 8
  CSq3 q4 q5
  CSq3 q5 q6
  CSq3 q6 q7
  CXq3 q4
  CXq3 q5
  CXq3 q6
  CXq3 q7
LE

; qft alderantzizkoa q0..q3 gainean
SWAPq0 q3
SWAPq1 q2
Hq0
CPq0 q1 -pi/2
Hq1
CPq0 q2 -pi/4
CPq1 q2 -pi/2
Hq2
CPq0 q3 -pi/8
CPq1 q3 -pi/4
CPq2 q3 -pi/2
Hq3
Mq0..q3
PBR0 c0..c3                     ; m
IEQR0 R15 saiakera              ; m = 0: ez du informaziorik, berriz

; r: (m * r) mod 16 = 0 egiten duen r txikiena
SETR1 0
bilatu_r:
ADDR1 R1 R10
MULR20 R0 R1
RCR21 R13
C modulua
INER20 R15 bilatu_r

; r bikoitia izan behar du
RCR20 R1
RCR21 R11
C modulua
INER20 R15 saiakera

; x = 7^(r/2) mod 15
DIVR2 R1 R11
SETR3 1
LS R2
  MULR20 R3 R14
  RCR21 R12
  C modulua
  RCR3 R20
LE

; egiaztatu benetako periodoa dela: x^2 = 7^r mod 15 = 1
MULR20 R3 R3
RCR21 R12
C modulua
INER20 R10 saiakera
; x = 1 edo x = 14 (-1) badira, faktoreak hutsalak dira
IEQR3 R10 saiakera
SETR4 14
IEQR3 R4 saiakera

; faktoreak: zkh(x - 1, 15) eta zkh(x + 1, 15)
SUBR22 R3 R10
RCR23 R12
C zkh
RCR5 R22
ADDR22 R3 R10
RCR23 R12
C zkh
RCR6 R22
PF "15 = {} x {}  (m = {}, r = {}, {} saiakera)\n" R5 R6 R0 R1 R7
END

; R20 = R20 mod R21, kenketa errepikatuz (biak positiboak)
modulua:
ILTR20 R21 modulua_amaitu
SUBR20 R20 R21
J modulua
modulua_amaitu:
RET

; R22 = zkh(R22, R23), euklidesen algoritmoa kenketekin (biak positiboak)
zkh:
IEQR22 R23 zkh_amaitu
IGTR22 R23 zkh_a
SUBR23 R23 R22
J zkh
zkh_a:
SUBR22 R22 R23
J zkh
zkh_amaitu:
RET
